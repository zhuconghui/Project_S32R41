       <xsd:attribute name="sr31-bist-mixer-gaindiff-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr31-bist-lna-phasediff-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr31-bist-lna-gaindiff-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr3-reg-crc" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr34-cal-adc1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr34-cal-adc2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr34-cal-adc3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr34-cal-adc4" type="fusaMask_t" use="required" />
    </xsd:complexType> 
    
    <xsd:complexType name="fuSaFaultMaskElement10">
       <xsd:attribute name="sr31-bist-mixer-phasediff-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr44-cafc-intgerity-level-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr44-cafc-intgerity-unlock-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr44-cafc-integrity-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr70-tx-integrity-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr72-tx-pr-cal-sw" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr72-tx1-pr-cal-sw" type="fusaMask_t" use="required" />
