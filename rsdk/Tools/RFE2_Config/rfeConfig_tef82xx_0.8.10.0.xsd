       <xsd:attribute name="sr65-sr67-supply-low-1v1-rx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-rx4" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-rx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-rx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-rx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-rx4" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr27-bb-tx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr27-bb-tx2" type="fusaMask_t" use="required" />
    </xsd:complexType> 
    
    <xsd:complexType name="fuSaFaultMaskElement3">
