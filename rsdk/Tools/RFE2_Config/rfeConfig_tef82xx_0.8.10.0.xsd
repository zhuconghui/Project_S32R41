       <xsd:attribute name="sr9-bb-rx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr9-bb-rx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr9-bb-rx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr9-bb-rx4" type="fusaMask_t" use="required" />
       <xsd:attribute name="s47-lo-level-min-rx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="s47-lo-level-min-rx2" type="fusaMask_t" use="required" />
    </xsd:complexType> 
	
    <xsd:complexType name="fuSaFaultMaskElement5">
       <xsd:attribute name="sr43-unlock-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr45-level-min-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr45-level-max-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr42-vco-freq-480-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr7-interface-stuck-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-pll-1v8-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-vco-1v8-chirp" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-chirp" type="fusaMask_t" use="required" />
    </xsd:complexType> 
    
    <xsd:complexType name="fuSaFaultMaskElement6">
       <xsd:attribute name="sr18-bb-lo-out-loi" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr17-bb-lo-in-loi" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-loi" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr19-wr-spi-crc" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr19-rd-spi-crc" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr48-level-min-loi" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr48-level-max-loi" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr7-lock-step-chirp" type="fusaMask_t" use="required" />
    </xsd:complexType>
	
