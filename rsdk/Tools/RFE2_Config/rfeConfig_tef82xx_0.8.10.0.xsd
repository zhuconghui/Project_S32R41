       <xsd:attribute name="sr57-supply-high-1v1-gldo" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr35-pll-lock-mclk" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr39-dig-freq-mclk" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-mclk" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr36-mspc-mclk" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr11-xo-no-clock-mclk" type="fusaMask_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="fuSaFaultMaskElement8">
       <xsd:attribute name="sr65-67-supply-low-1v8-adc12" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v8-adc34" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v8-ssb" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v8-gbias" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v1-ser" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v1-csi2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-67-supply-low-1v8-ser" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr63-supply-low-1v8-gldo" type="fusaMask_t" use="required" />
