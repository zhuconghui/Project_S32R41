       <xsd:attribute name="s47-lo-level-max-rx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="s47-lo-level-max-rx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="s47-lo-level-max-rx4" type="fusaMask_t" use="required" />
