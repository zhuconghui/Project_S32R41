<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.1">

    <!-- root node definition -->
    <xsd:element name="rfeConfig">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="generalConfig" type="generalConfigElement" />
                <xsd:element name="monitorAndSafetyConfig" type="monitorAndSafetyConfigElement" />
                <xsd:element name="radarCycleConfig" type="radarCycleConfigElement" />
                <xsd:element name="chirpSequenceConfigs" type="chirpSequenceConfigsElement" />
                <xsd:element name="chirpProfiles" type="chirpProfilesElement" />
                <xsd:element name="dynamicTables" type="dynamicTablesElement" minOccurs="0" maxOccurs="1" />
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>


    <!-- top-level generalConfigElement definition -->
    <xsd:complexType name="generalConfigElement">
        <xsd:sequence>
            <xsd:element name="power" type="powerElement" />
            <xsd:element name="ioSignals" type="ioSignalsElement" />
            <xsd:element name="clkInOut" type="clkInOutElement" />
            <xsd:element name="pdc" type="pdcElement" />
            <xsd:element name="dataOut" type="dataOutElement" />
            <xsd:element name="jumpbackTiming" type="jumpbackTimingElement" />
            <xsd:element name="txCalibration" type="txCalibrationElement" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="powerElement">
        <xsd:attribute name="mode" type="rfeApi_powerMode_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="ioSignalsElement">
        <xsd:attribute name="radar-cycle-start" type="rfe_gpio_t" use="required" />
        <xsd:attribute name="chirp-sequence-active" type="rfe_gpio_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="clkInOutElement">
        <xsd:attribute name="in" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="out" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="reduce-driver-level" type="boolean" use="required" />
    </xsd:complexType>

    <xsd:complexType name="pdcElement">
        <xsd:attribute name="decimation-filter" type="rfe_pdcDecimationFilter_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="dataOutElement">
        <xsd:sequence>
            <xsd:element name="metadata" type="metadataElement" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="metadataElement">
        <xsd:attribute name="packet" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="hardware-field" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="software-content" type="rfe_metadataPacketSwContent_t" use="required" />
        <xsd:attribute name="virtual-channel" type="rfe_virtualChannel_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="jumpbackTimingElement">
        <xsd:attribute name="time-ticks" type="staticConfigJumpbackTimeTicks" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="txCalibrationElement">
        <xsd:attribute name="mode" type="rfeApi_txCalibration_t" use="required" />
    </xsd:complexType>




    <!-- top-level monitorAndSafetyConfigElement definition -->
    <xsd:complexType name="monitorAndSafetyConfigElement">
        <xsd:sequence>
            <xsd:element name="rxSaturation" type="rxSaturationElement" />
            <xsd:element name="adcClippingCounter" type="pdcClippingCounterElement" />
            <xsd:element name="temperatureThresholds" type="temperatureThresholdsElement" />
            <xsd:element name="r1FaultPromotion" type="r1FaultPromotionElement" />
            <xsd:element name="frequencyForBist" type="bistFrequencyElement"/>
            <xsd:element name="rxBist" type="rxBistElement"/>
            <xsd:element name="checkBBD" type="checkBBDElement"/>
            <xsd:element name="txPpdThreshold" type="ppdThresholdElement"/>
            <xsd:element name="fuSaFaultMask0" type="fuSaFaultMaskElement0"/>
            <xsd:element name="fuSaFaultMask1" type="fuSaFaultMaskElement1"/>
            <xsd:element name="fuSaFaultMask2" type="fuSaFaultMaskElement2"/>
            <xsd:element name="fuSaFaultMask3" type="fuSaFaultMaskElement3"/>
            <xsd:element name="fuSaFaultMask4" type="fuSaFaultMaskElement4"/>
            <xsd:element name="fuSaFaultMask5" type="fuSaFaultMaskElement5"/>
            <xsd:element name="fuSaFaultMask6" type="fuSaFaultMaskElement6"/>
            <xsd:element name="fuSaFaultMask7" type="fuSaFaultMaskElement7"/>
            <xsd:element name="fuSaFaultMask8" type="fuSaFaultMaskElement8"/>
            <xsd:element name="fuSaFaultMask9" type="fuSaFaultMaskElement9"/>
            <xsd:element name="fuSaFaultMask10" type="fuSaFaultMaskElement10"/>
            <xsd:element name="fuSaFaultMask11" type="fuSaFaultMaskElement11"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="rxSaturationElement">
        <xsd:sequence>
            <xsd:element name="rxSaturationCounter" type="rxSaturationCounterElement" />
            <xsd:element name="rxSaturationThresholds" type="rxSaturationThresholdsElement" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="rxSaturationCounterElement">
        <xsd:attribute name="reset-every-sequence" type="boolean" use="required" />
    </xsd:complexType>

    <xsd:complexType name="rxSaturationThresholdsElement">
        <xsd:sequence>
            <xsd:element name="rxSaturationThresholdRx1" type="rxSaturationThresholdElement"/>
            <xsd:element name="rxSaturationThresholdRx2" type="rxSaturationThresholdElement"/>
            <xsd:element name="rxSaturationThresholdRx3" type="rxSaturationThresholdElement"/>
            <xsd:element name="rxSaturationThresholdRx4" type="rxSaturationThresholdElement"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="rxSaturationThresholdElement">
        <xsd:attribute name="power-stage-1" type="rfeApi_rxSaturationThreshold_t" use="required" />
        <xsd:attribute name="max-count-stage-1" type="rxSaturationCountLimit" use="required" />
        <xsd:attribute name="power-stage-2" type="rfeApi_rxSaturationThreshold_t" use="required" />
        <xsd:attribute name="max-count-stage-2" type="rxSaturationCountLimit" use="required" />
    </xsd:complexType>

    <xsd:complexType name="pdcClippingCounterElement">
        <xsd:attribute name="reset-every-sequence" type="boolean" use="required" />
        <xsd:attribute name="limit-adc1" type="rxSaturationCountLimit" use="required" />
        <xsd:attribute name="limit-adc2" type="rxSaturationCountLimit" use="required" />
        <xsd:attribute name="limit-adc3" type="rxSaturationCountLimit" use="required" />
        <xsd:attribute name="limit-adc4" type="rxSaturationCountLimit" use="required" />
    </xsd:complexType>

    <xsd:complexType name="pdcClippingCountResetEveryChirpSequenceElement">
        <xsd:attribute name="value" type="boolean" use="required" />
    </xsd:complexType>


    <xsd:complexType name="temperatureThresholdsElement">
        <xsd:sequence>
            <xsd:element name="temperatureThresholdTx12" type="temperatureThresholdElement"/>
            <xsd:element name="temperatureThresholdTx3" type="temperatureThresholdElement"/>
            <xsd:element name="temperatureThresholdXo" type="temperatureThresholdElement"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="temperatureThresholdElement">
        <xsd:attribute name="under-error-celsius" type="rfeApi_temperature_t" use="required" />
        <xsd:attribute name="high-warning-celsius" type="rfeApi_temperature_t" use="required" />
        <xsd:attribute name="over-error-celsius" type="rfeApi_temperature_t" use="required" />
    </xsd:complexType>

    
    <xsd:complexType name="r1FaultPromotionElement">
       <xsd:attribute name="threshold-value" type="uint8_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="bistFrequencyElement">        
       <xsd:attribute name="frequency-in-kHz" type="frequency_t" use="required" />
    </xsd:complexType>
    
   <xsd:complexType name="rxBistElement">
       <xsd:sequence>
           <xsd:element name="rxPhaseDiffLna" type="rxPhaseDiffElement"/>
           <xsd:element name="rxGainDiffLna" type="rxGainDiffElement"/>
           <xsd:element name="rxPhaseDiffMixer" type="rxPhaseDiffElement"/>
           <xsd:element name="rxGainDiffMixer" type="rxGainDiffElement"/>
           <xsd:element name="injectTestTone" type="injectTestToneElement"/>
       </xsd:sequence>
    </xsd:complexType>
    
    <xsd:complexType name="checkBBDElement">
       <xsd:sequence>
           <xsd:element name="loiBbd" type="loiBbdElement"/>
           <xsd:element name="txBbd" type="txBbdElement"/>
           <xsd:element name="rxBbd" type="rxBbdElement"/>
       </xsd:sequence>
    </xsd:complexType>
	
    <xsd:complexType name="rxPhaseDiffElement">        
       <xsd:attribute name="phase-diff-threshold-tolerance" type="phaseThreshold_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx12" type="phaseDiff_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx13" type="phaseDiff_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx14" type="phaseDiff_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="rxGainDiffElement">        
       <xsd:attribute name="gain-diff-threshold-tolerance" type="phaseThreshold_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx12" type="gainDiff_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx13" type="gainDiff_t" use="required" />
       <xsd:attribute name="zero-hr-ref-rx14" type="gainDiff_t" use="required" />
    </xsd:complexType>
    	
    <xsd:complexType name="injectTestToneElement">        
       <xsd:attribute name="mode" type="injectTone_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="loiBbdElement">        
       <xsd:attribute name="loi-bbd-enable" type="disabledOrEnabled" use="required" />
       <xsd:attribute name="loout-sensitivity" type="sensitivity_t" use="required" />
       <xsd:attribute name="loout-grounded" type="grounding_t" use="required" />
       <xsd:attribute name="loin-sensitivity" type="sensitivity_t" use="required" />
       <xsd:attribute name="loin-grounded" type="grounding_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="txBbdElement">        
       <xsd:attribute name="tx-bbd-enable" type="disabledOrEnabled" use="required" />
       <xsd:attribute name="tx-sensitivity" type="sensitivity_t" use="required" />
       <xsd:attribute name="tx-grounded" type="grounding_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="rxBbdElement">        
       <xsd:attribute name="rx-bbd-enable" type="disabledOrEnabled" use="required" />
       <xsd:attribute name="rx-sensitivity" type="sensitivity_t" use="required" />
       <xsd:attribute name="rx-grounded" type="grounding_t" use="required" />
    </xsd:complexType>
   
    <xsd:complexType name="ppdThresholdElement">
       <xsd:attribute name="profile0-dBm" type="txPower_dBm" use="required" />
       <xsd:attribute name="profile1-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile2-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile3-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile4-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile5-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile6-dBm" type="txPower_dBm" use="optional" />
       <xsd:attribute name="profile7-dBm" type="txPower_dBm" use="optional" />       
    </xsd:complexType> 
    
    <xsd:complexType name="fuSaFaultMaskElement0">
       <xsd:attribute name="sr65-sr67-supply-low-1v8-tx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-tx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr72-pr-tx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr72-pr-tx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr72-pr-tx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-tx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-tx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v1-tx3" type="fusaMask_t" use="required" />
    </xsd:complexType> 
	
    <xsd:complexType name="fuSaFaultMaskElement1">
       <xsd:attribute name="sr27-bb-tx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-min-tx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-min-tx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-min-tx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-max-tx1" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-max-tx2" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr69-rf-level-max-tx3" type="fusaMask_t" use="required" />
       <xsd:attribute name="sr65-sr67-supply-low-1v8-tx1" type="fusaMask_t" use="required" /> 
    </xsd:complexType>
    
