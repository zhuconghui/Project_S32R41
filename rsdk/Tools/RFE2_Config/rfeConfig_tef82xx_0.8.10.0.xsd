    </xsd:complexType> 
    
    
    <!-- top-level radarCycleConfigElement definition -->
    <xsd:complexType name="radarCycleConfigElement">
        <xsd:sequence>
            <xsd:element name="radarCycleDuration" type="radarCycleDurationElement" />
            <xsd:element name="chirpSequences" type="chirpSequencesElement" />
            <xsd:element name="recalibration" type="recalibrationElement" />
            <xsd:element name="bistInterval" type="bistIntervalElement" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="radarCycleDurationElement">
        <xsd:attribute name="ticks" type="rfeApi_radarCycleDuration_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="chirpSequencesElement">
        <xsd:attribute name="chirp-sequence-config-index" type="chirpSequenceConfigIndexListArgument" use="required" />
        <xsd:attribute name="start-time-offset" type="chirpSequenceStartTimeOffsetListArgument" use="required" />
    </xsd:complexType>

    <xsd:complexType name="recalibrationElement">
        <xsd:sequence>
            <xsd:element name="recalibrationProfileIndependent" type="recalibrationProfileIndependentElement" minOccurs="0" maxOccurs="1" />
            <xsd:element name="recalibrationProfileDependent" type="recalibrationProfileDependentElement" minOccurs="0" maxOccurs="8" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="recalibrationProfileIndependentElement">
        <xsd:attribute name="chirp-sequences" type="chirpSequencesSelectListArgument" use="required" />
    </xsd:complexType>

    <xsd:complexType name="recalibrationProfileDependentElement">
        <xsd:attribute name="chirp-sequence" type="rfeApi_chirpSequenceConfigIndex_t" use="required" />
        <xsd:attribute name="chirp-profiles" type="chirpProfilesSelectListArgument" use="required" />
    </xsd:complexType>

    <xsd:complexType name="bistIntervalElement">
        <xsd:attribute name="interval" type="rfeApi_bistInterval_t" use="required" />
    </xsd:complexType>




    <!-- top-level chirpSequenceConfigsElement definition -->
    <xsd:complexType name="chirpSequenceConfigsElement">
        <xsd:sequence>
            <xsd:element name="chirpSequenceConfig" type="chirpSequenceConfigElement" minOccurs="1" maxOccurs="8" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="chirpSequenceConfigElement">
        <xsd:sequence>
            <xsd:element name="chirpCount" type="chirpCountElement" />
            <xsd:element name="chirpProfileSequence" type="chirpProfileSequenceElement" />
            <xsd:element name="profileRepeatCount" type="profileRepeatCountElement" />
            <xsd:element name="dynamicUpdate" type="dynamicUpdateElement" />
            <xsd:element name="ddma" type="rfeApi_ddma_t" />
            <xsd:element name="rxEnable" type="rxEnableElement" />
            <xsd:element name="pdc" type="chirpSeqPdcElement" />
            <xsd:element name="txCalibrationThresholds" type="chirpSeqTxCalibElement" minOccurs="0" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="chirpCountElement">
        <xsd:attribute name="count" type="chirpSequenceConfigChirpCount" use="required" />
    </xsd:complexType>

    <xsd:complexType name="chirpProfileSequenceElement">
        <xsd:attribute name="sequence" type="chirpProfileIndexListArgument" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="profileRepeatCountElement">
        <xsd:attribute name="count" type="chirpSequenceProfileRepeatCount" use="required" />
    </xsd:complexType>

    <xsd:complexType name="dynamicUpdateElement">
        <xsd:attribute name="dynamic-updates" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="dynamic-table-index" type="dynamicTableIndex" use="required" />
    </xsd:complexType>
    
    
    <xsd:complexType name="rfeApi_ddma_t">
        <xsd:attribute name="mode" type="rfeApi_ddma-mode_t" use="required" />
        <xsd:attribute name="tx-1-use-ddma" type="boolean" use="required" />
        <xsd:attribute name="tx-2-use-ddma" type="boolean" use="required" />
        <xsd:attribute name="tx-3-use-ddma" type="boolean" use="required" />
        <xsd:attribute name="tx-1-ddma-init-phase" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-2-ddma-init-phase" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-3-ddma-init-phase" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-1-ddma-phase-update" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-2-ddma-phase-update" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-3-ddma-phase-update" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-1-final-pc-gen-mode" type="rfeApi_pc-gen-mode_t" use="required" />
        <xsd:attribute name="tx-2-final-pc-gen-mode" type="rfeApi_pc-gen-mode_t" use="required" />
        <xsd:attribute name="tx-3-final-pc-gen-mode" type="rfeApi_pc-gen-mode_t" use="required" />
    </xsd:complexType>
    
            

    <xsd:complexType name="rxEnableElement">
        <xsd:attribute name="rx-1" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="rx-2" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="rx-3" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="rx-4" type="disabledOrEnabled" use="required" />
    </xsd:complexType>

    <xsd:complexType name="chirpSeqPdcElement">
        <xsd:attribute name="notch-filter-enable" type="boolean" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="chirpSeqTxCalibElement">
        <xsd:attribute name="tx-rf-threshold-high-dB" type="rfeApi_txCalibrationThreshold_t" use="required" />
        <xsd:attribute name="tx-rf-threshold-low-dB" type="rfeApi_txCalibrationThreshold_t" use="required" />
    </xsd:complexType>

    <xsd:simpleType name="chirpProfileIndexListArgument">
        <xsd:restriction base="chirpProfileIndexList">
            <xsd:minLength value="1" />
            <xsd:maxLength value="8" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="chirpProfileIndexList">
        <xsd:list itemType="rfeApi_chirpProfileIndex_t" />
    </xsd:simpleType>


    <!-- top-level chirpProfilesElement definition -->
    <xsd:complexType name="chirpProfilesElement">
        <xsd:sequence>
            <xsd:element name="chirpProfile" type="chirpProfileElement" minOccurs="1" maxOccurs="8" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="chirpProfileElement">
        <xsd:sequence>
            <xsd:element name="effectiveSamplingFrequency" type="effectiveSamplingFrequencyElement" />
            <xsd:element name="chirpTiming" type="chirpTimingElement" />
            <xsd:element name="chirpGenerator" type="chirpGeneratorElement" />
            <xsd:element name="txTransmissionEnable" type="txTransmissionEnableElement" />
            <xsd:element name="txPower" type="txPowerElement" />
            <xsd:element name="txPhaseRotation" type="txPhaseRotationElement" />
            <xsd:element name="chirpFrequency" type="chirpFrequencyElement" />
            <xsd:element name="rxGain" type="rxGainElement" />
            <xsd:element name="rxFilter" type="rxFilterElement" />
            <xsd:element name="csi2VirtualChannel" type="csi2VirtualChannelElement" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="effectiveSamplingFrequencyElement">
        <xsd:attribute name="frequency" type="rfeApi_effectiveSamplingFrequency_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="chirpTimingElement">
        <xsd:attribute name="chirp-interval-time-ticks" type="chirpProfileChirpIntervalTimeTicks" use="required" />
        <xsd:attribute name="dwell-time-ticks" type="chirpProfileDwellTimeTicks" use="required" />
        <xsd:attribute name="settle-time-ticks" type="chirpProfileSettleTimeTicks" use="required" />
        <xsd:attribute name="acquisition-time-ticks" type="chirpProfileAcquisitionTimeTicks" use="required" />
        <xsd:attribute name="reset-time-ticks" type="chirpProfileResetTimeTicks" use="required" />
    </xsd:complexType>

    <xsd:complexType name="chirpGeneratorElement">
        <xsd:attribute name="center-frequency-kHz" type="chirpProfileCenterFrequency" use="required" />
        <xsd:attribute name="effective-chirp-bandwidth-kHz" type="chirpProfileEffectiveChirpBandwidth" use="required" />
        <xsd:attribute name="vco" type="rfeApi_chirpGenVco_t" use="required" />
        <xsd:attribute name="slope" type="rfeApi_chirpSlopeDirection_t" use="required" />
        <xsd:attribute name="pll-loop-filter-bandwidth" type="rfe_chirpPllLoopFilterBandwidth_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="txPowerElement">
        <xsd:attribute name="dBm" type="txPower_dBm" use="required" />
    </xsd:complexType>

    <xsd:complexType name="txPhaseRotationElement">
        <xsd:attribute name="tx-1" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-2" type="rfeApi_phaseRotation_t" use="required" />
        <xsd:attribute name="tx-3" type="rfeApi_phaseRotation_t" use="required" />
    </xsd:complexType>
    
    <xsd:complexType name="chirpFrequencyElement">
        <xsd:attribute name="frequency-drift-steps" type="freqDrift_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="txTransmissionEnableElement">
        <xsd:attribute name="tx-1" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="tx-2" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="tx-3" type="disabledOrEnabled" use="required" />
        <xsd:attribute name="time-reference" type="rfeApi_txEnableReferenceTime_t" use="required" />
        <xsd:attribute name="time-offset-ticks" type="chirpProfileTxEnableTimeOffset" use="required" />
    </xsd:complexType>

    <xsd:complexType name="rxGainElement">
        <xsd:attribute name="gain" type="rfeApi_rxGain_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="rxFilterElement">
        <xsd:attribute name="high-pass-filter" type="rfeApi_rxHpfCutOffFrequency_t" use="required" />
        <xsd:attribute name="low-pass-filter" type="rfeApi_rxLpfCutOffFrequency_t" use="required" />
    </xsd:complexType>

    <xsd:complexType name="csi2VirtualChannelElement">
        <xsd:attribute name="channel" type="rfe_virtualChannel_t" use="required" />
    </xsd:complexType>




    <!-- top-level dynamicTablesElement definition -->
    <xsd:complexType name="dynamicTablesElement">
        <xsd:sequence>
            <xsd:element name="dynamicTable" type="dynamicTableElement" minOccurs="1" maxOccurs="255" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="dynamicTableElement">
        <xsd:sequence>
            <xsd:element name="dynamicTableEntry" type="dynamicTableEntryElement" minOccurs="1" maxOccurs="32768" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="dynamicTableEntryElement">
        <xsd:attribute name="phase-rotation-tx-1" type="rfeApi_dynTblPhaseRotation_t" use="optional" />
        <xsd:attribute name="phase-rotation-tx-2" type="rfeApi_dynTblPhaseRotation_t" use="optional" />
        <xsd:attribute name="phase-rotation-tx-3" type="rfeApi_dynTblPhaseRotation_t" use="optional" />
    </xsd:complexType>




    <!-- camelCaseString definition -->
    <xsd:simpleType name="camelCaseString">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[a-z]([a-zA-Z0-9])*" />
            <xsd:minLength value="2" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for boolean constants -->
    <xsd:simpleType name="boolean">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="true" />
            <xsd:pattern value="false" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for disabledOrEnabled constants -->
    <xsd:simpleType name="disabledOrEnabled">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="disabled" />
            <xsd:pattern value="enabled" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for uint8_t constants -->
    <xsd:simpleType name="uint8_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="255" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for uint16_t constants -->
    <xsd:simpleType name="uint16_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="65535" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for uint32_t constants -->
    <xsd:simpleType name="uint32_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="4294967295" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for uint64_t constants -->
    <xsd:simpleType name="uint64_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="18446744073709551615" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for int8_t constants -->
    <xsd:simpleType name="int8_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="-128" />
            <xsd:maxInclusive value="127" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for int16_t constants -->
    <xsd:simpleType name="int16_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="-32768" />
            <xsd:maxInclusive value="32767" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for int32_t constants -->
    <xsd:simpleType name="int32_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="-2147483648" />
            <xsd:maxInclusive value="2147483647" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for int64_t constants -->
    <xsd:simpleType name="int64_t">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="18446744073709551615" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- constraint for integer constants -->
    <xsd:simpleType name="integer">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="([0-9_])+" />
            <xsd:pattern value="0b([0-1_])+" />
            <xsd:pattern value="0x([0-9a-fA-F_])+" />
        </xsd:restriction>
    </xsd:simpleType>




    <!-- rfeApi_powerMode_t -->
    <xsd:simpleType name="rfeApi_powerMode_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="lower power" />
            <xsd:pattern value="active" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_gpio_t -->
    <xsd:simpleType name="rfe_gpio_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="gpio 0" />
            <xsd:pattern value="gpio 1" />
            <xsd:pattern value="gpio 2" />
            <xsd:pattern value="gpio 3" />
            <xsd:pattern value="gpio 4" />
            <xsd:pattern value="gpio 5" />
            <xsd:pattern value="gpio 6" />
            <xsd:pattern value="gpio 7" />
            <xsd:pattern value="disabled" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_pdcDecimationFilter_t -->
    <xsd:simpleType name="rfe_pdcDecimationFilter_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="narrow" />
            <xsd:pattern value="wide" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_chirpPllLoopFilterBandwidth_t -->
    <xsd:simpleType name="rfe_chirpPllLoopFilterBandwidth_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="200 kHz" />
            <xsd:pattern value="250 kHz" />
            <xsd:pattern value="300 kHz" />
            <xsd:pattern value="350 kHz" />
            <xsd:pattern value="400 kHz" />
            <xsd:pattern value="450 kHz" />
            <xsd:pattern value="500 kHz" />
            <xsd:pattern value="550 kHz" />
            <xsd:pattern value="600 kHz" />
            <xsd:pattern value="650 kHz" />
            <xsd:pattern value="700 kHz" />
            <xsd:pattern value="750 kHz" />
            <xsd:pattern value="800 kHz" />
            <xsd:pattern value="850 kHz" />
            <xsd:pattern value="900 kHz" />
            <xsd:pattern value="950 kHz" />
            <xsd:pattern value="1000 kHz" />
            <xsd:pattern value="1050 kHz" />
            <xsd:pattern value="1100 kHz" />
            <xsd:pattern value="1150 kHz" />
            <xsd:pattern value="1200 kHz" />
            <xsd:pattern value="1250 kHz" />
            <xsd:pattern value="1300 kHz" />
            <xsd:pattern value="1350 kHz" />
            <xsd:pattern value="1400 kHz" />
            <xsd:pattern value="1450 kHz" />
            <xsd:pattern value="1500 kHz" />
            <xsd:pattern value="1550 kHz" />
            <xsd:pattern value="1600 kHz" />
            <xsd:pattern value="1650 kHz" />
            <xsd:pattern value="1700 kHz" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_metadataPacketSwContent_t -->
    <xsd:simpleType name="rfe_metadataPacketSwContent_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="rx stage 1 in-phase saturation count" />
            <xsd:pattern value="rx stage 1 quadrature saturation count" />
            <xsd:pattern value="rx stage 2 in-phase saturation count" />
            <xsd:pattern value="rx stage 2 quadrature saturation count" />
            <xsd:pattern value="chirp sequence timestamp" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_virtualChannel_t -->
    <xsd:simpleType name="rfe_virtualChannel_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- staticConfigJumpbackTimeTicks -->
    <xsd:simpleType name="staticConfigJumpbackTimeTicks">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="1" />
            <xsd:maxInclusive value="254" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_rxSaturationThreshold_t -->
    <xsd:simpleType name="rfeApi_rxSaturationThreshold_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="-13.05 dB" />
            <xsd:pattern value="-12.18 dB" />
            <xsd:pattern value="-11.31 dB" />
            <xsd:pattern value="-10.44 dB" />
            <xsd:pattern value="-9.57 dB" />
            <xsd:pattern value="-8.70 dB" />
            <xsd:pattern value="-7.83 dB" />
            <xsd:pattern value="-6.96 dB" />
            <xsd:pattern value="-6.09 dB" />
            <xsd:pattern value="-5.22 dB" />
            <xsd:pattern value="-4.35 dB" />
            <xsd:pattern value="-3.48 dB" />
            <xsd:pattern value="-2.61 dB" />
            <xsd:pattern value="-1.74 dB" />
            <xsd:pattern value="-0.87 dB" />
            <xsd:pattern value="0 dB" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rxSaturationCountLimit -->
    <xsd:simpleType name="rxSaturationCountLimit">
        <xsd:restriction base="xsd:integer">
            <xsd:minInclusive value="0" />
            <xsd:maxInclusive value="4194303" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_temperature_t -->
    <xsd:simpleType name="rfeApi_temperature_t">
        <!-- Temperature values are encoded as signed, two's complement, 16 bit value where bits [14:6] contain the degress and bits [5:0] the fractions of degrees in multiples of 0.015625 (=1/64) -->
        <xsd:restriction base="xsd:decimal">
            <xsd:minInclusive value="-40" />
            <xsd:maxInclusive value="150" />
            <xsd:fractionDigits value="6" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_chirpSequenceConfigIndex_t -->
    <xsd:simpleType name="rfeApi_chirpSequenceConfigIndex_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
            <xsd:pattern value="3" />
            <xsd:pattern value="4" />
            <xsd:pattern value="5" />
            <xsd:pattern value="6" />
            <xsd:pattern value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpSequenceConfigIndexListArgument -->
    <xsd:simpleType name="chirpSequenceConfigIndexListArgument">
        <xsd:restriction base="chirpSequenceConfigIndexList">
            <xsd:minLength value="1" />
            <xsd:maxLength value="8" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpSequenceConfigIndexList -->
    <xsd:simpleType name="chirpSequenceConfigIndexList">
        <xsd:list itemType="rfeApi_chirpSequenceConfigIndex_t" />
    </xsd:simpleType>

    <!-- chirpSequenceStartTimeOffsetListArgument -->
    <xsd:simpleType name="chirpSequenceStartTimeOffsetListArgument">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="((- )*((0|20000000|([1]\d{0,7})|([2-9]\d{0,6}))( )*){0,8}|-{1})" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpSequencesSelectListArgument -->
    <xsd:simpleType name="chirpSequencesSelectListArgument">
        <xsd:restriction base="chirpSequenceConfigIndexList">
            <xsd:minLength value="1" />
            <xsd:maxLength value="8" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpSequencesSelectList -->
    <xsd:simpleType name="chirpSequencesSelectList">
        <xsd:list itemType="chirpSequencesSelectItem" />
    </xsd:simpleType>

    <xsd:simpleType name="chirpSequencesSelectItem">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
            <xsd:pattern value="3" />
            <xsd:pattern value="4" />
            <xsd:pattern value="5" />
            <xsd:pattern value="6" />
            <xsd:pattern value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_chirpProfilesSelect_t -->
    <xsd:simpleType name="rfe_chirpProfilesSelect_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
            <xsd:pattern value="3" />
            <xsd:pattern value="4" />
            <xsd:pattern value="5" />
            <xsd:pattern value="6" />
            <xsd:pattern value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfe_chirpProfileIndex_t -->
    <xsd:simpleType name="rfe_chirpProfileIndex_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
            <xsd:pattern value="3" />
            <xsd:pattern value="4" />
            <xsd:pattern value="5" />
            <xsd:pattern value="6" />
            <xsd:pattern value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpProfilesSelectListArgument -->
    <xsd:simpleType name="chirpProfilesSelectListArgument">
        <xsd:restriction base="chirpSequenceConfigIndexList">
            <xsd:minLength value="0" />
            <xsd:maxLength value="8" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- chirpProfilesSelectList -->
    <xsd:simpleType name="chirpProfilesSelectList">
        <xsd:list itemType="rfe_chirpProfilesSelect_t" />
    </xsd:simpleType>

    <!-- rfeApi_bistInterval_t -->
    <xsd:simpleType name="rfeApi_bistInterval_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="every radar cycle" />
            <xsd:pattern value="once in two radar cycles" />
            <xsd:pattern value="once in four radar cycles" />
            <xsd:pattern value="no bist" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="rfeApi_chirpProfileIndex_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="0" />
            <xsd:pattern value="1" />
            <xsd:pattern value="2" />
            <xsd:pattern value="3" />
            <xsd:pattern value="4" />
            <xsd:pattern value="5" />
            <xsd:pattern value="6" />
            <xsd:pattern value="7" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_effectiveSamplingFrequency_t -->
    <xsd:simpleType name="rfeApi_effectiveSamplingFrequency_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="40 MHz" />
            <xsd:pattern value="20 MHz" />
            <xsd:pattern value="10 MHz" />
            <xsd:pattern value="5 MHz" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_chirpGenVco_t -->
    <xsd:simpleType name="rfeApi_chirpGenVco_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="1 GHz" />
            <xsd:pattern value="2 GHz" />
            <xsd:pattern value="4 GHz" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- rfeApi_chirpSlopeDirection_t -->
    <xsd:simpleType name="rfeApi_chirpSlopeDirection_t">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="falling" />
            <xsd:pattern value="rising" />
        </xsd:restriction>
    </xsd:simpleType>

    <!-- txPower_dBm -->
    <xsd:simpleType name="txPower_dBm">
        <!-- TX power is encoded as an uint8_t with a 0.1 dBm resolution -->
        <xsd:restriction base="xsd:decimal">
            <xsd:minInclusive value="3" />
            <xsd:maxInclusive value="15" />
            <xsd:fractionDigits value="1" />
        </xsd:restriction>
    </xsd:simpleType>

<!-- rfeApi_dynTblPhaseRotation_t -->
