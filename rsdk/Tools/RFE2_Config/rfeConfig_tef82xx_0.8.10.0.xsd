            <xsd:pattern value="56.25" />
            <xsd:pattern value="61.875" />
            <xsd:pattern value="67.5" />
            <xsd:pattern value="73.125" />
            <xsd:pattern value="78.75" />
            <xsd:pattern value="84.375" />
