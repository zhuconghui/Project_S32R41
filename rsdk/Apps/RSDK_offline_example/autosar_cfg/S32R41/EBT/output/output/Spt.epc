                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/TS_T40D47M8I10R0/Spt/SptGeneral/SptHaltOnError</DEFINITION-REF>
