// Additions for -mlocalmems option:
PLACE SECTIONS(.bss) WITH_SECTION(.dram0.bss)
PLACE SECTIONS(.data) WITH_SECTION(.dram0.data)
PLACE SECTIONS(.rodata) WITH_SECTION(.dram0.rodata)
PLACE SECTIONS(STACK) WITH_SECTION(.dram0.bss)
PLACE SECTIONS(HEAP) WITH_SECTION(.dram0.bss)
PLACE SECTIONS(.literal) WITH_SECTION(.iram0.literal)
PLACE SECTIONS(.text) WITH_SECTION(.iram0.text)

BEGIN srom
0x4: sysrom : srom : 0xfffffc : executable ;
 srom0 : C : 0x4 - 0xffffff : .srom.rodata .srom.literal .srom.text .rom.store;
END srom

BEGIN dram0
0x24100000: dataRam : dram0 : 0x20000 : writable ;
 dram0_0 : C : 0x24100000 - 0x2411ffff :  STACK :  HEAP : .dram0.rodata .clib.rodata .rtos.rodata .rodata .clib.data .clib.percpu.data .rtos.percpu.data .rtos.data .dram0.data .data .clib.bss .clib.percpu.bss .rtos.percpu.bss .rtos.bss .dram0.bss .bss;
END dram0

BEGIN dram1
0x24120000: dataRam : dram1 : 0x20000 : writable ;
 dram1_0 : C : 0x24120000 - 0x2413ffff : .dram1.rodata .ResetVector.literal .MemoryExceptionVector.literal .Level2InterruptVector.literal .Level3InterruptVector.literal .Level4InterruptVector.literal .DebugExceptionVector.literal .KernelExceptionVector.literal .UserExceptionVector.literal .DoubleExceptionVector.literal .dram1.data .dram1.bss;
END dram1

BEGIN iram0
0x24140000: instRam : iram0 : 0x40000 : executable, writable ;
 iram0_0 : F : 0x24140000 - 0x241402df : .ResetVector.text .ResetHandler.literal .ResetHandler.text;
 iram0_1 : C : 0x241402e0 - 0x2414030f : ;
 iram0_2 : F : 0x24140310 - 0x2414048f : .MemoryExceptionVector.text;
 iram0_3 : C : 0x24140490 - 0x241407ff : ;
 iram0_4 : F : 0x24140800 - 0x24140977 : .WindowVectors.text;
 iram0_5 : C : 0x24140978 - 0x2414097b : ;
 iram0_6 : F : 0x2414097c - 0x24140997 : .Level2InterruptVector.text;
 iram0_7 : C : 0x24140998 - 0x2414099b : ;
 iram0_8 : F : 0x2414099c - 0x241409b7 : .Level3InterruptVector.text;
 iram0_9 : C : 0x241409b8 - 0x241409bb : ;
 iram0_10 : F : 0x241409bc - 0x241409d7 : .Level4InterruptVector.text;
 iram0_11 : C : 0x241409d8 - 0x241409db : ;
 iram0_12 : F : 0x241409dc - 0x241409f7 : .DebugExceptionVector.text;
 iram0_13 : C : 0x241409f8 - 0x241409fb : ;
 iram0_14 : F : 0x241409fc - 0x24140a17 : .KernelExceptionVector.text;
 iram0_15 : C : 0x24140a18 - 0x24140a1b : ;
 iram0_16 : F : 0x24140a1c - 0x24140a37 : .UserExceptionVector.text;
 iram0_17 : C : 0x24140a38 - 0x24140a3b : ;
 iram0_18 : F : 0x24140a3c - 0x24140a57 : .DoubleExceptionVector.text;
 iram0_19 : C : 0x24140a58 - 0x2417ffff : .iram0.literal .literal .rtos.literal .clib.literal .iram0.text .text .clib.text .rtos.text;
END iram0

BEGIN sram
0x33c00000: sysram : sram : 0x800000 : executable, writable ;
 sram0 : C : 0x33c00000 - 0x343fffff : .sram.rodata .sram.literal .sram.text .sram.data __llvm_prf_names .sram.bss;
END sram

