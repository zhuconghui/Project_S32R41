<?xml version='1.0'?>
<datamodel version="3.0"
        xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
        xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
        xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
        xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

<!--
*   @file    Cte.xdm
*   @version 0.8.10
*
*   @brief   AUTOSAR Cte - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and Cte plugin.
-->
<!--
====================================================================================================
*   Project              : RTD AUTOSAR 4.7
*   Platform             : CORTEXM
*   Peripheral           : Swt
*   Dependencies         : none
*
*   Autosar Version      : 4.7.0
*   Autosar Revision     : ASR_REL_4_7_REV_0000
*   Autosar Conf.Variant :
*   SW Version           : 0.8.10
*   Build Version        : SAF85_RTD_2_0_0_CD01_D2306_ASR_REL_4_7_REV_0000_20230623
*   (c) Copyright 2023 NXP Semiconductors
*   All Rights Reserved.
====================================================================================================
====================================================================================================
====================================================================================================
-->
    <d:ctr type="AUTOSAR" factory="autosar"
                            xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
                            xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
                            xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D47M8I10R0" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:d503b77d-29f5-3052-ec01-f5beaae5de3f"/>
                <d:lst type="ELEMENTS">
                    <d:chc name="Cte" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="LABEL" value="Cte Driver Code Parameters" />
                            <a:a name="RELEASE" value="asc:4.7"/>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                            <ad:DATE>2014-10-31</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                    <html>
                                    <h1>Cte</h1><p>
                                    Configuration of the Cte (Cross Triggering Engine) module
                                    </p></html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="UPPER-MULTIPLICITY" value="*"/>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <a:a name="UUID" value="ECUC:d22e04ff-66ee-de63-95d8-fed5e96bf3c3"/>
                            <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                                <a:a name="DESC"
                                    value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                                <a:a name="LABEL" value="Post Build Variant Used"/>
                                <a:a name="ORIGIN" value="EB"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:8f2ec914-a545-7812-f022-5e5dd6250bfd"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="FALSE"/>
                                <a:da name="TOOLTIP"
                                    value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            </v:var>

                            <!--  @implements Cte_Object  -->
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:488abcbd-2c8d-34df-d6d9-57be37cbff42"/>
                                <a:da name="DEFAULT" value="VariantPostBuild"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                    <a:v>VariantPreCompile</a:v>
                                </a:da>
                            </v:var>

                            <!--  @implements   CteGeneral_Object  -->
                            <v:ctr name="CteGeneral" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <h1>CteGeneral</h1><p>
                                        All general parameters of the Cte driver are collected here.
                                        </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:8ebec482-7ceb-e340-500a-6293b433be0e"/>
                                <a:a name="LABEL" value="General Parameters for CTE Driver"/>
                                <a:da name="READONLY" value="true" />

                                <!--  @implements   CteDevErrorDetect_Object  -->
                                <v:var name="CteDevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Detection of Development Errors"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte Development Error Detect</h1><p>
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            <br><b>True</b>: Development error detection enabled
                                            <br><b>False</b>: Development error detection disabled
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:72aaaf35-2e00-4f50-4a03-a777b3cedb01"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   CteErrorHalt_Object  -->
                                <v:var name="CteErrorHalt" type="BOOLEAN">
                                    <a:a name="LABEL" value="Stop Execution after Error Detection"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte Stop execution after an error was detected</h1><p>
                                            Compile switch to enable / disable the execution lock next after the error was reported.
                                            This is intended only for debugging.
                                            <br><b>True</b>: Stop at error detection enabled
                                            <br><b>False</b>: Stop at error detection disabled
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:ade08704-894c-9e9e-e061-f66e6fdf2a4f"/>
                                    <a:da name="EDITABLE" type="XPath" expr="../CteDevErrorDetect" />
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   CteSingleThread_Object  -->
                                <v:var name="CteSingleThread" type="BOOLEAN">
                                    <a:a name="LABEL" value="Cte Driver Single Thread Used"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte is used in a single thread</h1><p>
                                            This parameter specify if the driver is used in a single thread or multiple threads.
                                            If a single thread is used, there is no need for exclusive areas.
                                            <br><b>True</b>: Single thread
                                            <br><b>False</b>: Multiple threads
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:118ddc59-09f9-45f7-36ab-df78235f69d6"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   CteVersionInfo_Object  -->
                                <v:var name="CteVersionInfo" type="BOOLEAN">
                                    <a:a name="LABEL" value="Cte Driver Version Info"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte expose the version info function</h1><p>
                                            This parameter specify if the driver expose or not the VersionInfo function.
                                            <br><b>True</b>: VersionInfo available
                                            <br><b>False</b>: VersionInfo not available
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:f22312d9-980c-54a4-be9e-78b3549b8a93"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   CteStartStop_Object  -->
                                <v:var name="CteStartStop" type="BOOLEAN">
                                    <a:a name="LABEL" value="Cte Driver Start/Stop"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte expose the Start and Stop functions</h1><p>
                                            This parameter specify if the driver expose or not the Start and Stop functions.
                                            These functions can be used only in Master mode, when the Cte signals are not used.
                                            If the Cte execution is managed only by the Cte interface, these two functions are not necessary.
                                            <br><b>True</b>: Start/Stop available
                                            <br><b>False</b>: Start/Stop not available
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:013171f1-64d7-b418-43a7-842345492881"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   CteCallbackName_Object  -->
                                <v:var name="CteCallbackName" type="STRING">
                                    <a:a name="LABEL" value="Cte Driver Callback Name"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Cte driver Callback</h1><p>
                                            This parameter specify the name of the callback driver.<br>
                                            The callback is used for events reporting, as required in "CTE Configuration List"->"CTE Events Usage Setup".<br>
                                            The call is done from the CTE events interrupt handler.<br>
                                            To avoid any possible issue, this callback must be implemented.
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:89ffa263-2568-c31b-501d-f4e4f1c4c27b"/>
                                    <a:da name="DEFAULT" value="Cte_IsrCallback"/>
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                            false="The name must be an accespted C symbol and must not start with _." />
                                </v:var>
                            </v:ctr>

                            <!--  CTE OUTPUT TYPES DEFINITIONS  >>>>>>>>> -->
                            <v:lst name="CteOutputDefList" type="MAP">
                                <a:da name="MIN" value="1" />
                                <a:a name="LABEL" value="List of All Defined CTE Output Configurations"/>
                                <v:ctr name="CteOutputDefList" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            This container contains a list of the necessary setup structures for the Cte driver.
                                            The listas are necessary to define the working mode for the CTE controlled outputs.<br>
                                            Is necessary to define at least one output list. It is possible to define more output lists,
                                            if many time tables are used, in different contexts. For each working mode there is necessary to define
                                            how the outputs are used.<br>
                                            At least one output must be used for a correct Output Configuration.
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="CTE Outputs Configuration"/>
                                    <a:da name="EDITABLE" value="false" />
                                    <a:da name="INVALID" type="XPath" expr="node:value(CteOutputSignalList/CteOutputSignalSptUsage)='SPT_SIGNALS_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep0Usage)='CTEP0_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep1Usage)='CTEP1_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep2Usage)='CTEP2_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep3Usage)='CTEP3_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep4Usage)='CTEP4_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep5Usage)='CTEP5_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep6Usage)='CTEP6_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalCtep7Usage)='CTEP7_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalSptRcsUsage)='SPTRCS_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalSptRfsUsage)='SPTRFS_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalFlex0Usage)='FLEX0_NOT_USED' and
                                                    node:value(CteOutputSignalList/CteOutputSignalFlex1Usage)='FLEX1_NOT_USED'"
                                        true="Need to use at least one output." />
                                    <a:a name="UUID" value="ECUC:14e03d24-8b23-d1f3-a973-5fec02a253f1" />

                                    <!-- implement CteOutputSignalList_object, for unit setup parameters -->
                                    <v:ctr name="CteOutputSignalList" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html>
                                                Usage definitions for all available signals.
                                            </html>]]></a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="All Output Signals Usage"/>
                                        <a:da name="EDITABLE" value="false" />
                                        <a:a name="UUID" value="ECUC:041bffab-2e39-1820-8c4a-406cd5b8327c" />

                                        <!-- implementCteOutputSignalSpt0Usage_object -->
                                        <v:var name="CteOutputSignalSptUsage" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    How the SPT_x signals are used:
                                                    <br><b>SPT_SIGNALS_NOT_USED</b> = No oneof the SPT_x signals is used
                                                    <br><b>CTE_OUT_PULSE</b>        = Output type is pulse, a short signal toggle
                                                    <br><b>CTE_OUT_LOGIC</b>        = Output type is logic, low/high/Hi-Z levels
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTE Signals SPT_x Usage"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:0375df9f-9205-72d1-84f6-f8a43a3fb0e0"/>
                                            <a:da name="DEFAULT" value="SPT_SIGNALS_NOT_USED"/>
                                            <a:da name="RANGE">
                                                <a:v>SPT_SIGNALS_NOT_USED</a:v>
                                                <a:v>CTE_OUT_LOGIC</a:v>
                                                <a:v>CTE_OUT_PULSE</a:v>
                                            </a:da>
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep0Usage_object -->
                                        <v:var name="CteOutputSignalCtep0Usage" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    How the external CTE_0 pad signal is used:
                                                    <br><b>CTEP0_NOT_USED</b>  = The signal CTEP_0 is not used
                                                    <br><b>CTE_OUT_HIZ</b>    = Output type is only High-Z
                                                    <br><b>CTE_OUT_TOGGLE</b> = Output type is toggle, low/hi/toggle
                                                    <br><b>CTE_OUT_CLOCK</b>  = Output type is clock, low/hi/toggle with[out] sync
                                                    <br><b>CTE_OUT_LOGIC</b>  = Output type is logic, low/high/Hi-Z levels
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTE Signal CTEP_0 Usage"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:02561db8-46ca-bde7-dd72-189ab432f9b4"/>
                                            <a:da name="DEFAULT" value="CTEP0_NOT_USED"/>
                                            <a:da name="RANGE">
                                                <a:v>CTEP0_NOT_USED</a:v>
                                                <a:v>CTE_OUT_HIZ</a:v>
                                                <a:v>CTE_OUT_TOGGLE</a:v>
                                                <a:v>CTE_OUT_CLOCK</a:v>
                                                <a:v>CTE_OUT_LOGIC</a:v>
                                            </a:da>
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep0Clock_object -->
                                        <v:var name="CteOutputSignalCtep0Clock" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The period of the CTEP0 signal used as clock. The clock period in ns.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTEP_0 Clock Period [ns]"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:f339dfb4-89d1-df63-3efb-4167f08ef3ca"/>
                                            <a:da name="DEFAULT" value="10000000"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../CteOutputSignalCtep0Usage) = 'CTE_OUT_CLOCK'" />
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep1Usage_object -->
                                        <v:var name="CteOutputSignalCtep1Usage" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    How the external CTE_1 pad signal is used:
                                                    <br><b>CTEP1_NOT_USED</b>  = The signal CTEP_1 is not used
                                                    <br><b>CTE_OUT_HIZ</b>    = Output type is only High-Z
                                                    <br><b>CTE_OUT_TOGGLE</b> = Output type is toggle, low/hi/toggle
                                                    <br><b>CTE_OUT_CLOCK</b>  = Output type is clock, low/hi/toggle with[out] sync
                                                    <br><b>CTE_OUT_LOGIC</b>  = Output type is logic, low/high/Hi-Z levels
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTE Signal CTEP_1 Usage"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:a44a1194-839a-ca40-fcc6-e3091fb59e14"/>
                                            <a:da name="DEFAULT" value="CTEP1_NOT_USED"/>
                                            <a:da name="RANGE">
                                                <a:v>CTEP1_NOT_USED</a:v>
                                                <a:v>CTE_OUT_HIZ</a:v>
                                                <a:v>CTE_OUT_TOGGLE</a:v>
                                                <a:v>CTE_OUT_CLOCK</a:v>
                                                <a:v>CTE_OUT_LOGIC</a:v>
                                            </a:da>
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep1Clock_object -->
                                        <v:var name="CteOutputSignalCtep1Clock" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The period of the CTEP1 signal used as clock. The clock period in ns.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTEP_1 Clock Period [ns]"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:e7b8c7b0-e3b5-be04-47f7-3206fc86b845"/>
                                            <a:da name="DEFAULT" value="10000000"/>
                                            <a:da name="EDITABLE" type="XPath" expr="node:value(../CteOutputSignalCtep1Usage) = 'CTE_OUT_CLOCK'" />
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep2Usage_object -->
                                        <v:var name="CteOutputSignalCtep2Usage" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    How the external CTE_2 pad signal is used:
                                                    <br><b>CTEP2_NOT_USED</b>  = The signal CTEP_2 is not used
                                                    <br><b>CTE_OUT_HIZ</b>    = Output type is only High-Z
                                                    <br><b>CTE_OUT_TOGGLE</b> = Output type is toggle, low/hi/toggle
                                                    <br><b>CTE_OUT_CLOCK</b>  = Output type is clock, low/hi/toggle with[out] sync
                                                    <br><b>CTE_OUT_LOGIC</b>  = Output type is logic, low/high/Hi-Z levels
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTE Signal CTEP_2 Usage"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:9a257320-56b6-36c7-7e52-7815c9458f53"/>
                                            <a:da name="DEFAULT" value="CTEP2_NOT_USED"/>
                                            <a:da name="RANGE">
                                                <a:v>CTEP2_NOT_USED</a:v>
                                                <a:v>CTE_OUT_HIZ</a:v>
                                                <a:v>CTE_OUT_TOGGLE</a:v>
                                                <a:v>CTE_OUT_CLOCK</a:v>
                                                <a:v>CTE_OUT_LOGIC</a:v>
                                            </a:da>
                                        </v:var>

                                        <!-- implementCteOutputSignalCtep2Clock_object -->
                                        <v:var name="CteOutputSignalCtep2Clock" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
