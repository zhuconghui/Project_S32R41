                            <!--  CTE FINAL CONFIG DEFINITIONS  >>>>>>>>> -->
                            <v:lst name="CteFinalConfig" type="MAP">
                                <a:da name="MIN" value="1" />
                                <a:a name="LABEL" value="List of All Defined CTE Configurations"/>
                                <v:ctr name="CteFinalConfig" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            This container contains a list of the necessary parameters for CTE setup :<br>
                                            - working mode<br>
                                            - necessary hardware parameters<br>
                                            - pairing between the defined Output Configurations and defined Timing Tables<br>
                                            - etc.
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="CTE Configurations List"/>
                                    <a:da name="EDITABLE" value="false" />
                                    <a:a name="UUID" value="ECUC:088d5fef-6011-c01e-487f-2e2ddaa8cd4b" />

                                    <!-- implement CteConfigClockFreq_object -->
                                    <v:var name="CteConfigClockFreq" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html>
                                                The value for the CTE_clock/CTE_CLK [Hz]
                                            </html>]]></a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="CTE input clock [Hz]"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:9c698564-edf0-12a4-36b2-ce0afe3411e7"/>
                                        <a:da name="DEFAULT" value="40000000"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=40000000"/>
                                            <a:tst expr="&lt;=1000000000"/>
                                        </a:da>
                                    </v:var>

                                    <!-- implements CteWorkingSetup_object -->
                                    <v:ctr name="CteWorkingSetup" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                          <a:v><![CDATA[EN: <html>
                                              Container for CTE working mode setup.
                                          </html>]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:62e5907a-757c-a361-f3dc-ed81fd28f121"/>
                                        <a:da name="EDITABLE" value="false" />
                                        <a:da name="LABEL" value="CTE Working Mode Setup" />

                                        <!-- implement CteWorkingMode_object -->
                                        <v:var name="CteWorkingMode" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The usage for the CTE module :<br>
                                                    - <b>MASTER</b>         - the CTE is started by the software<br>
                                                    - <b>SLAVE_EXTERNAL</b> - the CTE is started by the external RFS/RCS signals<br>
                                                    - <b>SLAVE_CSI2</b>     - the CTE is started by the CSI2 reception<br>
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="SPT_RFS signal final state"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:4f5bfa1e-ce86-de59-f264-71b5ae4feecb"/>
                                            <a:da name="DEFAULT" value="CTE_MASTER"/>
                                            <a:da name="RANGE">
                                                <a:v>CTE_MASTER</a:v>
                                                <a:v>CTE_SLAVE_EXTERNAL</a:v>
                                                <a:v>CTE_SLAVE_CSI2</a:v>
                                            </a:da>
                                        </v:var>

                                        <!-- implement CteWorkingSlaveCsi2Unit_object -->
                                        <v:var name="CteWorkingSlaveCsi2Unit" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                The CSI2 unit which provide the CTE start signals.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CSI2 unit to be used for start signals"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:2ddd39b7-0190-a168-ef2a-b4a17983ec7b"/>
                                            <a:da name="DEFAULT" value="CTE_CSI2_UNIT_0"/>
                                            <a:da name="RANGE">
                                                <a:v>CTE_CSI2_UNIT_0</a:v>
                                                <a:v>CTE_CSI2_UNIT_1</a:v>
                                            </a:da>
                                            <a:da name="EDITABLE" type="XPath" expr="../CteWorkingMode = 'CTE_SLAVE_CSI2'" />
                                        </v:var>

                                        <!-- implement CteWorkingSlaveCsi2Vc_object -->
                                        <v:var name="CteWorkingSlaveCsi2Vc" type="ENUMERATION">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                The Virtual Channel which provide the CTE start signals.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Virtual Channel to be used for start signals"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:b1182a5c-7485-5211-82a4-744b2a8ba696"/>
                                            <a:da name="DEFAULT" value="CTE_CSI2_VC_0"/>
                                            <a:da name="RANGE">
                                                <a:v>CTE_CSI2_VC_0</a:v>
                                                <a:v>CTE_CSI2_VC_1</a:v>
                                                <a:v>CTE_CSI2_VC_2</a:v>
                                                <a:v>CTE_CSI2_VC_3</a:v>
                                            </a:da>
                                            <a:da name="EDITABLE" type="XPath" expr="../CteWorkingMode = 'CTE_SLAVE_CSI2'" />
                                        </v:var>

                                        <!-- implement CteInternalRfsDelay_object -->
                                        <v:var name="CteInternalRfsDelay" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Internal delay after external RFS received. The value is in clock cycles.
                                                The timing values are counted after this delay pass.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Internal delay after external RFS received"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:8aa4ddec-0614-d9c9-7000-865cd5095eef"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=15"/>
                                            </a:da>
                                            <a:da name="EDITABLE" type="XPath" expr="../CteWorkingMode = 'CTE_SLAVE_EXTERNAL'" />
                                        </v:var>

                                        <!-- implement CteInternalRcsDelay_object -->
                                        <v:var name="CteInternalRcsDelay" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Internal delay after external RCS received. The value is in clock cycles.
                                                The timing values are counted after this delay pass.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Internal delay after external RCS received"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:3d54d891-a2f4-537c-a995-8d92614af461"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=15"/>
                                            </a:da>
                                            <a:da name="EDITABLE" type="XPath" expr="../CteWorkingMode = 'CTE_SLAVE_EXTERNAL'" />
                                        </v:var>
                                    </v:ctr>    <!-- CteWorkingSetup    -->

                                    <!-- implements CteEventsSetup_object -->
                                    <v:ctr name="CteEventsSetup" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                          <a:v><![CDATA[EN: <html>
                                              Container for CTE events usage.
                                          </html>]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:4da3c869-c1c4-ce7b-ae34-a3784045d14e"/>
                                        <a:da name="EDITABLE" value="false" />
                                        <a:da name="LABEL" value="CTE Events Usage Setup" />

                                        <!-- implement CteEventTT0Start_object -->
                                        <v:var name="CteEventTT0Start" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for TimeTable_0 start.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="TimeTable 0 Start"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:fa4ed92e-002c-6b2b-014f-ae978e92bf62"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <!-- implement CteEventTT0Stop_object -->
                                        <v:var name="CteEventTT0Stop" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for TimeTable_0 stop.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="TimeTable 0 Stop"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:ebfc051b-b7f2-81ab-8c7f-e4e1195c61c4"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>


                                        <!-- implement CteEventTT1Start_object -->
                                        <v:var name="CteEventTT1Start" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for TimeTable_1 start.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="TimeTable 1 Start"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:a93d72b1-3245-914e-f66a-5ed499419c43"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <!-- implement CteEventTT1Stop_object -->
                                        <v:var name="CteEventTT1Stop" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for TimeTable_1 stop.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="TimeTable 1 Stop"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:530f2a5b-879b-bceb-71f1-c62b339d7644"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <!-- implement CteEventRFS_object -->
                                        <v:var name="CteEventRFS" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for Radar Frame Start signal received.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Radar Frame Start"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:b8dea9aa-4c42-61f6-6f2a-5bd27422e713"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <!-- implement CteEventRCS_object -->
                                        <v:var name="CteEventRCS" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for Radar Chirp Start signal received.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Radar Chirp Start"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:a595d1c8-a839-6c91-ac46-95e42c097edc"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>

                                        <!-- implement CteEventEnd_object -->
                                        <v:var name="CteEventEnd" type="BOOLEAN">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                Application callback for Table Execution End.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Table Execution End"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:2010d04b-952a-d58d-a6fe-fbe218f075f1"/>
                                            <a:da name="DEFAULT" value="false"/>
                                        </v:var>
                                    </v:ctr>    <!-- CteEventsSetup    -->

                                    <!-- implements CteTableConfig_object -->
                                    <v:ctr name="CteTableConfig" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                          <a:v><![CDATA[EN: <html>
                                              Container for CTE Time Table configuration.
                                          </html>]]></a:v>
                                        </a:a>
                                        <a:a name="UUID" value="ECUC:8510e4be-9a93-52ef-04ff-90903a1964d3"/>
                                        <a:da name="EDITABLE" value="false" />
                                        <a:da name="LABEL" value="CTE Time Table Usage Setup" />

                                        <!-- implement CteConfigTableLoop_object -->
                                        <v:var name="CteConfigTableLoop" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The number for table(s) loop execution. Zero (0) means "for ever".
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Number of cycles for table executions"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:07c18dfa-6138-d7dd-69a9-212fcc034d04"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=65535"/>
                                            </a:da>
                                        </v:var>

                                        <!-- implement CteConfigTable0_object -->
                                        <v:var name="CteConfigTable0" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The associated Table Definition number.
                                                    For Time Table 0, a valid ID must be provided.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Table Definition used for TimeTable_0"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:8b4d5ab0-d5c9-15fd-3b71-763efe89af0c"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID"  type ="XPath" expr="number(node:value(.))&gt;=count(../../../../CteTable/*)"
                                                    true="The value must be less equal the number of last defined CteTable" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>

                                        <!-- implement CteConfigOutput0_object -->
                                        <v:var name="CteConfigOutput0" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The associated Output Configuration defined number.
                                                    This parameter must designate a defined Output Configuration and must be provided for Time Table 0.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Output Configuration used for TimeTable_0"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:f1cc959a-6cad-4968-5c58-62b5c90ada0f"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID"  type ="XPath" expr="number(node:value(.))&gt;=count(../../../../CteOutputDefList/*)"
                                                    true="The value must be less equal the number of last defined Output Config" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                            </a:da>
                                        </v:var>

                                        <!-- implement CteConfigTable1_object -->
                                        <v:var name="CteConfigTable1" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The associated Table Definition number.
                                                    For Time Table 1:<br>
                                                    - if TimeTable_1 is not used, a negative number must be specified
                                                    - if TimeTable_1 is used, a valid ID must be provided.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Table Definition used for TimeTable_1"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:4f5fcee8-52e0-5dad-27da-a1c4d710b28e"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="INVALID"  type ="XPath" expr="number(node:value(.))&gt;=count(../../../../CteTable/*)"
                                                    true="The value must be less equal the number of last defined CteTable" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=-1"/>
                                            </a:da>
                                        </v:var>

                                        <!-- implement CteConfigOutput1_object -->
                                        <v:var name="CteConfigOutput1" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    The associated Output Configuration defined number.
                                                    This parameter must designate a defined Output Configuration for TimeTable_1.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Output Configuration used for TimeTable_1"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:e191a38e-ca21-7279-20c3-50c3be9b0bc5"/>
                                            <a:da name="DEFAULT" value="0"/>
                                            <a:da name="EDITABLE" type="XPath" expr="../CteConfigTable1 &gt;= 0" />
                                            <a:da name="INVALID"  type ="XPath" expr="number(node:value(.))&gt;=count(../../../../CteOutputDefList/*)"
                                                    true="The value must be less equal the number of last defined Output Config" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=0"/>
                                                <a:tst expr="&lt;=65535"/>
                                            </a:da>
                                        </v:var>

                                    </v:ctr>

                                </v:ctr>
                            </v:lst>
                            <!--  <<<<<<<<< CTE FINAL CONFIG DEFINITIONS  -->

                            <!--  @implements Csi2CommonPublishedInformation_Object  -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                  <a:v><![CDATA[EN: <html>
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                  </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:4132aa47-dfab-b63c-0a95-37f82da2ff0f"/>
                            </v:ctr>
                            <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Csi2"/>
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Csi2_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="UUID" value="ECUC:baa0f0c8-7779-07e2-a754-aa3bbf8e7fe7"/>
                            <a:a name="DEF"
                                 value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                            </d:lst>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Csi2_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                                value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER" >
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                                value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
