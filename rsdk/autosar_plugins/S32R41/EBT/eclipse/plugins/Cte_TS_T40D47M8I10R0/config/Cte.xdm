                            <!--  <<<<<<<<< CTE OUTPUT TYPES DEFINITIONS  -->


                            <!--  CTE TABLES DEFINITIONS  >>>>>>>>> -->
                            <v:lst name="CteTable" type="MAP">
                                <a:da name="MIN" value="1" />
                                <a:a name="LABEL" value="List of All Defined CTE Time Tables"/>
                                <v:ctr name="CteTable" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            This container contains a list of the necessary table structures for the Cte driver.
                                            The timing tables are dfining how the output signals have to be set : the time from START,
                                            the actions to be done - signals to be processed and the new state.<br>
                                            CTE can use the time tables in two modes (please check the Reference Manual for more details) :
                                            <br><b>Single Table</b> - up to 64 events can be defined
                                            <br><b>Two Tables</b>   - each table can have up to 32 events defined<br>
                                            Is necessary to define at least one time table. It is possible to define more tables,
                                            if many time tables are used, in different contexts.
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="CTE Time Tables List"/>
                                    <a:da name="EDITABLE" value="false" />
                                    <a:a name="UUID" value="ECUC:3217037c-0704-4bd1-cb3d-0d43bd353da2" />

                                    <!-- implement CteTableTime_object -->
                                    <v:var name="CteTableTimeLimit" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html>
                                                The absolute time from START when the table execution finish.
                                                The time values is defined in ns (nanoseconds).
                                                The real time execution for a table is the minimum of this value and the last defined event in the events list.
                                            </html>]]></a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Maximum table execution time [ns from START]"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" value="ECUC:949698ed-ae76-bc1d-dcbb-c0c64dcfa807"/>
                                        <a:da name="DEFAULT" value="1000000"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=1"/>
                                            <a:tst expr="&lt;=4000000000"/>
                                        </a:da>
                                    </v:var>

                                    <!-- Table Events List -->
                                    <v:lst name="CteTableEvent" type="MAP">
                                        <a:da name="MIN" value="1" />
                                        <a:a name="LABEL" value="List of All Events of the Current Time Table"/>
                                        <v:ctr name="CteTableEvent" type="IDENTIFIABLE">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html>
                                                    This container contains a list of the actions to be done for the selected time table.
                                                </html>]]></a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="CTE Time Table Event Description"/>
                                            <a:da name="EDITABLE" value="false" />
                                            <a:da name="INVALID" type="XPath"
                                              expr="node:value(CteEventSPT_0State)='SPT_0_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventSPT_1State)='SPT_1_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventSPT_2State)='SPT_2_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventSPT_3State)='SPT_3_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_0State)='CTEP_0_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_1State)='CTEP_1_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_2State)='CTEP_2_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_3State)='CTEP_3_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_4State)='CTEP_4_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_5State)='CTEP_5_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_6State)='CTEP_6_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventCTEP_7State)='CTEP_7_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventSPT_RCSState)='SPT_RCS_NOT_CHANGED_or_NOT_USED' and
                                                    node:value(CteEventSPT_RFSState)='SPT_RFS_NOT_CHANGED_or_NOT_USED'
                                                    "
                                                    true="At least one final state must be defined."/>
                                            <a:a name="UUID" value="ECUC:b436aee5-4c63-f9b4-a334-32b263f34587" />

                                            <!-- implement CteTableTime_object -->
                                            <v:var name="CteEventTime" type="INTEGER">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:<html>
                                                        The absolute time from START when actions have to execute.
                                                        The time values is defined in ns (nanoseconds).
                                                        The time must be set in correct order, the actual event must have a time bigger than the previous event
                                                        and smaller than the next one.<br>
                                                        The maximum execution time can not exceed : <CTE_input_clock_period> * 2^29<br>
                                                        As the event resolution is only 16 bits, the real execution time is possible to not be the exact required value.
                                                    </html>]]></a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Absolut time of the event [ns from START]"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="UUID" value="ECUC:735635e6-9142-d8e5-63ae-75d6ddc59363"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&gt;=1"/>
                                                    <a:tst expr="&lt;=4000000000"/>
                                                </a:da>
                                            </v:var>

                                            <!-- implement CteEventSPT_0State_object -->
                                            <v:var name="CteEventSPT_0State" type="ENUMERATION">
                                                <a:a name="DESC">
