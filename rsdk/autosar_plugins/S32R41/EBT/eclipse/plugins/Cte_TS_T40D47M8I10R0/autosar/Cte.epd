<?xml version='1.0'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="ECUC:d503b77d-29f5-3052-ec01-f5beaae5de3f">
      <SHORT-NAME>TS_T40D47M8I10R0</SHORT-NAME>
      <ELEMENTS>
        <ECUC-DEFINITION-COLLECTION UUID="ECUC:baa0f0c8-7779-07e2-a754-aa3bbf8e7fe7">
          <SHORT-NAME>Csi2_EcuParameterDefinition</SHORT-NAME>
          <MODULE-REFS>
            <MODULE-REF DEST="ECUC-MODULE-DEF">/TS_T40D47M9I0R0/Csi2</MODULE-REF>
          </MODULE-REFS>
        </ECUC-DEFINITION-COLLECTION>
        <ECUC-MODULE-DEF UUID="ECUC:d22e04ff-66ee-de63-95d8-fed5e96bf3c3">
          <SHORT-NAME>Cte</SHORT-NAME>
          <DESC>
            <L-2 L="EN">
                                    &lt;html&gt;
                                    &lt;h1&gt;Cte&lt;/h1&gt;&lt;p&gt;
                                    Configuration of the Cte (Cross Triggering Engine) module
                                    &lt;/p&gt;&lt;/html&gt;</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>4.6.0</REVISION-LABEL>
                <ISSUED-BY>AUTOSAR</ISSUED-BY>
                <DATE>2014-10-31</DATE>
              </DOC-REVISION>
            </DOC-REVISIONS>
          </ADMIN-DATA>
          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
          <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
          <REFINED-MODULE-DEF-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Csi2</REFINED-MODULE-DEF-REF>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8ebec482-7ceb-e340-500a-6293b433be0e">
              <SHORT-NAME>CteGeneral</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                        &lt;html&gt;
                                        &lt;h1&gt;CteGeneral&lt;/h1&gt;&lt;p&gt;
                                        All general parameters of the Cte driver are collected here.
                                        &lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:72aaaf35-2e00-4f50-4a03-a777b3cedb01">
                  <SHORT-NAME>CteDevErrorDetect</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte Development Error Detect&lt;/h1&gt;&lt;p&gt;
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            &lt;br&gt;&lt;b&gt;True&lt;/b&gt;: Development error detection enabled
                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt;: Development error detection disabled
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ade08704-894c-9e9e-e061-f66e6fdf2a4f">
                  <SHORT-NAME>CteErrorHalt</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte Stop execution after an error was detected&lt;/h1&gt;&lt;p&gt;
                                            Compile switch to enable / disable the execution lock next after the error was reported.
                                            This is intended only for debugging.
                                            &lt;br&gt;&lt;b&gt;True&lt;/b&gt;: Stop at error detection enabled
                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt;: Stop at error detection disabled
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:118ddc59-09f9-45f7-36ab-df78235f69d6">
                  <SHORT-NAME>CteSingleThread</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte is used in a single thread&lt;/h1&gt;&lt;p&gt;
                                            This parameter specify if the driver is used in a single thread or multiple threads.
                                            If a single thread is used, there is no need for exclusive areas.
                                            &lt;br&gt;&lt;b&gt;True&lt;/b&gt;: Single thread
                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt;: Multiple threads
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f22312d9-980c-54a4-be9e-78b3549b8a93">
                  <SHORT-NAME>CteVersionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte expose the version info function&lt;/h1&gt;&lt;p&gt;
                                            This parameter specify if the driver expose or not the VersionInfo function.
                                            &lt;br&gt;&lt;b&gt;True&lt;/b&gt;: VersionInfo available
                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt;: VersionInfo not available
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:013171f1-64d7-b418-43a7-842345492881">
                  <SHORT-NAME>CteStartStop</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte expose the Start and Stop functions&lt;/h1&gt;&lt;p&gt;
                                            This parameter specify if the driver expose or not the Start and Stop functions.
                                            These functions can be used only in Master mode, when the Cte signals are not used.
                                            If the Cte execution is managed only by the Cte interface, these two functions are not necessary.
                                            &lt;br&gt;&lt;b&gt;True&lt;/b&gt;: Start/Stop available
                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt;: Start/Stop not available
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:89ffa263-2568-c31b-501d-f4e4f1c4c27b">
                  <SHORT-NAME>CteCallbackName</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Cte driver Callback&lt;/h1&gt;&lt;p&gt;
                                            This parameter specify the name of the callback driver.&lt;br&gt;
                                            The callback is used for events reporting, as required in &quot;CTE Configuration List&quot;-&gt;&quot;CTE Events Usage Setup&quot;.&lt;br&gt;
                                            The call is done from the CTE events interrupt handler.&lt;br&gt;
                                            To avoid any possible issue, this callback must be implemented.
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE>Cte_IsrCallback</DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:14e03d24-8b23-d1f3-a973-5fec02a253f1">
              <SHORT-NAME>CteOutputDefList</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;
                                            This container contains a list of the necessary setup structures for the Cte driver.
                                            The listas are necessary to define the working mode for the CTE controlled outputs.&lt;br&gt;
                                            Is necessary to define at least one output list. It is possible to define more output lists,
                                            if many time tables are used, in different contexts. For each working mode there is necessary to define
                                            how the outputs are used.&lt;br&gt;
                                            At least one output must be used for a correct Output Configuration.
                                        &lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:041bffab-2e39-1820-8c4a-406cd5b8327c">
                  <SHORT-NAME>CteOutputSignalList</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                                                Usage definitions for all available signals.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:0375df9f-9205-72d1-84f6-f8a43a3fb0e0">
                      <SHORT-NAME>CteOutputSignalSptUsage</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    How the SPT_x signals are used:
                                                    &lt;br&gt;&lt;b&gt;SPT_SIGNALS_NOT_USED&lt;/b&gt; = No oneof the SPT_x signals is used
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_PULSE&lt;/b&gt;        = Output type is pulse, a short signal toggle
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_LOGIC&lt;/b&gt;        = Output type is logic, low/high/Hi-Z levels
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>SPT_SIGNALS_NOT_USED</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SPT_SIGNALS_NOT_USED</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_LOGIC</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_PULSE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:02561db8-46ca-bde7-dd72-189ab432f9b4">
                      <SHORT-NAME>CteOutputSignalCtep0Usage</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    How the external CTE_0 pad signal is used:
                                                    &lt;br&gt;&lt;b&gt;CTEP0_NOT_USED&lt;/b&gt;  = The signal CTEP_0 is not used
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_HIZ&lt;/b&gt;    = Output type is only High-Z
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_TOGGLE&lt;/b&gt; = Output type is toggle, low/hi/toggle
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_CLOCK&lt;/b&gt;  = Output type is clock, low/hi/toggle with[out] sync
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_LOGIC&lt;/b&gt;  = Output type is logic, low/high/Hi-Z levels
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CTEP0_NOT_USED</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTEP0_NOT_USED</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_HIZ</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_TOGGLE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_CLOCK</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_LOGIC</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f339dfb4-89d1-df63-3efb-4167f08ef3ca">
                      <SHORT-NAME>CteOutputSignalCtep0Clock</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    The period of the CTEP0 signal used as clock. The clock period in ns.
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>10000000</DEFAULT-VALUE>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a44a1194-839a-ca40-fcc6-e3091fb59e14">
                      <SHORT-NAME>CteOutputSignalCtep1Usage</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    How the external CTE_1 pad signal is used:
                                                    &lt;br&gt;&lt;b&gt;CTEP1_NOT_USED&lt;/b&gt;  = The signal CTEP_1 is not used
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_HIZ&lt;/b&gt;    = Output type is only High-Z
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_TOGGLE&lt;/b&gt; = Output type is toggle, low/hi/toggle
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_CLOCK&lt;/b&gt;  = Output type is clock, low/hi/toggle with[out] sync
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_LOGIC&lt;/b&gt;  = Output type is logic, low/high/Hi-Z levels
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CTEP1_NOT_USED</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTEP1_NOT_USED</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_HIZ</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_TOGGLE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_CLOCK</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_LOGIC</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e7b8c7b0-e3b5-be04-47f7-3206fc86b845">
                      <SHORT-NAME>CteOutputSignalCtep1Clock</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    The period of the CTEP1 signal used as clock. The clock period in ns.
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>10000000</DEFAULT-VALUE>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9a257320-56b6-36c7-7e52-7815c9458f53">
                      <SHORT-NAME>CteOutputSignalCtep2Usage</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                    How the external CTE_2 pad signal is used:
                                                    &lt;br&gt;&lt;b&gt;CTEP2_NOT_USED&lt;/b&gt;  = The signal CTEP_2 is not used
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_HIZ&lt;/b&gt;    = Output type is only High-Z
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_TOGGLE&lt;/b&gt; = Output type is toggle, low/hi/toggle
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_CLOCK&lt;/b&gt;  = Output type is clock, low/hi/toggle with[out] sync
                                                    &lt;br&gt;&lt;b&gt;CTE_OUT_LOGIC&lt;/b&gt;  = Output type is logic, low/high/Hi-Z levels
                                                &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CTEP2_NOT_USED</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTEP2_NOT_USED</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_HIZ</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_TOGGLE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_CLOCK</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_LOGIC</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a8ef1081-ad43-331f-86db-595f563442da">
                      <SHORT-NAME>CteOutputSignalCtep2Clock</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
