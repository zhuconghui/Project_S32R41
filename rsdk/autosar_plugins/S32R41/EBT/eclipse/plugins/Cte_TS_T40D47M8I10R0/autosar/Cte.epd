                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>FLEX1_NOT_USED</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>FLEX1_NOT_USED</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CTE_OUT_LOGIC</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3217037c-0704-4bd1-cb3d-0d43bd353da2">
              <SHORT-NAME>CteTable</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;
                                            This container contains a list of the necessary table structures for the Cte driver.
                                            The timing tables are dfining how the output signals have to be set : the time from START,
                                            the actions to be done - signals to be processed and the new state.&lt;br&gt;
                                            CTE can use the time tables in two modes (please check the Reference Manual for more details) :
                                            &lt;br&gt;&lt;b&gt;Single Table&lt;/b&gt; - up to 64 events can be defined
                                            &lt;br&gt;&lt;b&gt;Two Tables&lt;/b&gt;   - each table can have up to 32 events defined&lt;br&gt;
                                            Is necessary to define at least one time table. It is possible to define more tables,
                                            if many time tables are used, in different contexts.
                                        &lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:949698ed-ae76-bc1d-dcbb-c0c64dcfa807">
                  <SHORT-NAME>CteTableTimeLimit</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                                                The absolute time from START when the table execution finish.
                                                The time values is defined in ns (nanoseconds).
                                                The real time execution for a table is the minimum of this value and the last defined event in the events list.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>1000000</DEFAULT-VALUE>
                  <MAX>4000000000</MAX>
                  <MIN>1</MIN>
                </ECUC-INTEGER-PARAM-DEF>
              </PARAMETERS>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b436aee5-4c63-f9b4-a334-32b263f34587">
                  <SHORT-NAME>CteTableEvent</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                                                    This container contains a list of the actions to be done for the selected time table.
                                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:735635e6-9142-d8e5-63ae-75d6ddc59363">
                      <SHORT-NAME>CteEventTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                        The absolute time from START when actions have to execute.
                                                        The time values is defined in ns (nanoseconds).
                                                        The time must be set in correct order, the actual event must have a time bigger than the previous event
                                                        and smaller than the next one.&lt;br&gt;
                                                        The maximum execution time can not exceed : &lt;CTE_input_clock_period&gt; * 2^29&lt;br&gt;
                                                        As the event resolution is only 16 bits, the real execution time is possible to not be the exact required value.
                                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>4000000000</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:dfc9c6a9-e3e1-4d94-e160-214a2d5cc632">
                      <SHORT-NAME>CteEventSPT_0State</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                        The status of the SPT_0 signal at the end of the event.
                                                        It must be corelated with the defined usage of SPT signals in the Output Configuration used.
