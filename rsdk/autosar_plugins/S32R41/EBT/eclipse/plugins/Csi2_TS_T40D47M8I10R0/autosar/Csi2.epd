<?xml version='1.0'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="ECUC:ded3766c-292f-0aae-6632-0efa9a86e299">
      <SHORT-NAME>TS_T40D47M8I10R0</SHORT-NAME>
      <ELEMENTS>
        <ECUC-DEFINITION-COLLECTION UUID="ECUC:b1f1e138-6483-2112-639e-aeb3bd1e7837">
          <SHORT-NAME>Csi2_EcuParameterDefinition</SHORT-NAME>
          <MODULE-REFS>
            <MODULE-REF DEST="ECUC-MODULE-DEF">/TS_T40D47M9I0R0/Csi2</MODULE-REF>
          </MODULE-REFS>
        </ECUC-DEFINITION-COLLECTION>
        <ECUC-MODULE-DEF UUID="ECUC:c2e852b0-b79b-63fc-fc77-745e045720ed">
          <SHORT-NAME>Csi2</SHORT-NAME>
          <DESC>
            <L-2 L="EN">
                                    &lt;html&gt;
                                    &lt;h1&gt;Csi2&lt;/h1&gt;&lt;p&gt;
                                    Configuration of the Csi2 (MIPI-CSI2) module
                                    &lt;/p&gt;&lt;/html&gt;</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>4.6.0</REVISION-LABEL>
                <ISSUED-BY>AUTOSAR</ISSUED-BY>
                <DATE>2014-10-31</DATE>
              </DOC-REVISION>
            </DOC-REVISIONS>
          </ADMIN-DATA>
          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
          <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
          <REFINED-MODULE-DEF-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Csi2</REFINED-MODULE-DEF-REF>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:171108bf-891a-5cb8-81c0-2210171c0b29">
              <SHORT-NAME>Csi2General</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                        &lt;html&gt;
                                        &lt;h1&gt;Csi2General&lt;/h1&gt;&lt;p&gt;
                                        All general parameters of the Csi2 driver are collected here.
                                        &lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92">
                  <SHORT-NAME>Csi2DevErrorDetect</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Csi2 Development Error Detect&lt;/h1&gt;&lt;p&gt;
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            &lt;b&gt;True&lt;/b&gt;: Development error detection enabled
                                            &lt;b&gt;False&lt;/b&gt;: Development error detection disabled
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3b50081c-7fc2-50e8-de3b-f8d97d430026">
                  <SHORT-NAME>Csi2StopAfterErrorReport</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Stop Execution After Error Report&lt;/h1&gt;&lt;p&gt;
                                               When this parameter is enabled, the Csi2 driver will stop execution after Det error report.
                                               The execution will stop in an local infinite loop.
                                          &lt;/p&gt;
                                          &lt;p&gt;If this parameter is not ediatable, that means Csi2 driver can&apos;t stop.&lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:df8b108e-fe1b-bc6f-5204-2a384d3aa06e">
                  <SHORT-NAME>Csi2SingleThreadUsed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Thread Usage Definition&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the number of threads the driver is used. It is recommended to use a single thread.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Single thread used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Multiple threads used.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fc1f8e84-7b57-8354-6fe8-f621211fe933">
                  <SHORT-NAME>Csi2VersionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Version Info Available&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the Availability of Csi2_GetVersionInfo function to the application.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Function available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Function not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:9bc97002-6423-c950-d702-e8afa41f6e74">
                  <SHORT-NAME>Csi2StatisticDataUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Statistic Data Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of statistic data and the associated features.
                                               This means : automatic DC offset adjustment, toggle bit reporting.
                                               If set to False, all the associated code will be removed from the driver.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Function available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Function not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b5db45dd-32c5-f175-3802-f63dac70b280">
                  <SHORT-NAME>Csi2HeaderDataUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Header Data Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of header data for all received data.&lt;br&gt;
                                               This means : each chirp for any Virtual Channel used, have to receive the ADC header data at the end of the chirp data.
                                               The chirp buffer length must be defined accordingly.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Function available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Function not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:234f44f6-7a91-917c-9e41-8eef48bafaa0">
                  <SHORT-NAME>Csi2FooterDataUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Footer Data Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of footer data for all received data.&lt;br&gt;
                                               This means : each chirp for any Virtual Channel used, have to receive the ADC header data at the end of the chirp data.
                                               The chirp buffer length must be defined accordingly.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Function available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Function not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:40b9dc6b-1f90-436d-fe5f-01c6a655366a">
                  <SHORT-NAME>Csi2DcAutoCompensation</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Auto DC Offset Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of DC auto offset compensation usage.
                                               This parameter can be set only if the Statistic Data Usage is set to True.
                                               If this is set to False, the code for Auto DC Offset compensation will
                                               be removed from the driver, but the other features of Statistic Data Usage
                                               will be available.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Feature available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Feature not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6809ecfb-5e2e-af99-968b-95f8c129397b">
                  <SHORT-NAME>Csi2AuxiliaryDataUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Auxiliary Data Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of auxiliary data reception.
                                               Set this parameter to False if not sure auxiliary data will be received.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Auxiliary data used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Auxiliary data not used.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e121c4e8-4910-076f-2826-6f9460d8028d">
                  <SHORT-NAME>Csi2MetaDataUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver MetaData Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of metadata reception.
                                               Set this parameter to False if not sure metadata will be received.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: MetaData data used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: MetaData data not used.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f2950491-fbba-5137-0666-64471d38d624">
                  <SHORT-NAME>Csi2SingleCallbackUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Single Callback Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the callbacks.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: A single callback is used for all three Csi2 interrupts.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Three different callbacks to be used :
                                               the &quot;first two&quot; for error reporting, the &quot;third&quot; for events reporting.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:26f6c573-f9f0-38ce-0dc5-545766812407">
                  <SHORT-NAME>Csi2RxStartStopUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Rx Start/Stop Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the Csi2_RxStop and Csi2_RxStart functions.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: The functions to be available to be used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1166fb1e-51d9-676e-9e94-64d2208fd9a4">
                  <SHORT-NAME>Csi2PowerOnOffUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Power On/Off Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the Csi2_PowerOn and Csi2_PowerOff functions.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: The functions to be available to be used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ae4e95f2-26bd-b60a-d66b-04458ce72f6a">
                  <SHORT-NAME>Csi2InterfaceFunctionsUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Interface Functions Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the Csi2_GetInterfaceStatus and Csi2_GetLaneStatus functions.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: The functions to be available to be used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:242da811-0d0a-8a54-6f90-8ca7443d222f">
                  <SHORT-NAME>Csi2FramesCounterUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver Frames Counter Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the frames counter.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Frames counter to be used, The function Csi2_FetFramesCounter will be available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: The frames counter not be used and
                                                The function Csi2_FetFramesCounter will be available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:0d0fd596-aecc-e127-ea6b-0798192647a8">
                  <SHORT-NAME>Csi2GPIOUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver GPIO Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the GPIO feature of the Csi2 hardware.
                                               The setup of the GPIO outputs must be done separately.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: GPIO to be used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: GPIO not used, the appropriate code will be removed from the build.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e6f60327-4cd9-5883-7c8c-1cec074f4c9b">
                  <SHORT-NAME>Csi2SDMAUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver SDMA Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the SDMA feature of the Csi2 hardware.
                                               The setup of the SDMA outputs must be done separately.
                                               &lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: SDMA to be used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: SDMA not used, the appropriate code will be removed from the build.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:87e24e44-c035-a309-1eaa-303eaa646e7f">
                  <SHORT-NAME>Csi2PhyUsageSaf85</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Csi2 Driver PHY Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the usage of the CSI2 PHY interface, only for SAF85XX.&lt;br&gt;
                                               For the other platforms the PHY level is used by default.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:87e24e44-c035-a309-1eaa-303eaa646e7f">
                  <SHORT-NAME>Csi2Rfe20Usage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;RFE 2.0 Abstraction Usage&lt;/h1&gt;&lt;p&gt;
                                               This parameter specify if for S32R41 platform the RFE 2.0 Abstract is used.&lt;br&gt;
                                               If this is used, the CSI2 interface needs a very specific setup, to align the needs of RFE Abstract 2.0 for Front-End (TEF82XX, etc.) BIST :&lt;br&gt;
                                               &lt;b&gt;- Virtual Channel 3 reserved for BIST data reception&lt;br&gt;
                                               - the correct setup for data to be received&lt;br&gt;
                                               - usage of a very specific physical address for data to be received, aligned to the one specified in the RFE Abstract 2.0 Tresos plugin&lt;/b&gt;&lt;br&gt;
                                               As it will be detected after files generation, this feature is connected to and needs the files generated from RFE Abstract 2.0 plugin.
                                               All necesssary Virtual Channel 3 definitions will be added to the Csi2_PBCfg.c file, but using the same &lt;b&gt;RFE_RFBIST_BUFFERS_ADDRESS&lt;/b&gt; address.
                                               As each Front-End needs the own BIST buffer and the BIST buffer memory allocation is contiguous, at file generation time the buffers will be aligned to
                                               modulo &lt;b&gt;RFE_NUM_USED_FRONT_ENDS&lt;/b&gt; basis, the BIST buffer start for the n-th CSI2 setup starting at &lt;br&gt;
                                               &lt;b&gt;RFE_RFBIST_BUFFERS_ADDRESS + (1024 * (n % RFE_NUM_USED_FRONT_ENDS))&lt;/b&gt;&lt;br&gt;
                                               If the CSI2 units setup is registered in the normal order, the resulted configuration will be perfect. If not, it will be necessary to adjust manually the
                                               BIST buffer start in the resulted Csi2_PBCfg.c file.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:cf43106f-564d-4147-a5b7-087e3aac2566">
                  <SHORT-NAME>Csi2OsIfTimerUsage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            OsIf timer used by the driver for necessary time counting. This must be aligned to the general timer for the application&lt;br&gt;
                                            Possible usage:&lt;br&gt;
                                            &lt;b&gt;OSIF_COUNTER_DUMMY&lt;/b&gt;  = no counters used from OS level&lt;br&gt;
                                            &lt;b&gt;OSIF_COUNTER_SYSTEM&lt;/b&gt; = the system counter used&lt;br&gt;
                                            &lt;b&gt;OSIF_COUNTER_CUSTOM&lt;/b&gt; = the application must implement teh custom timer
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>OSIF_COUNTER_SYSTEM</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>OSIF_COUNTER_DUMMY</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>OSIF_COUNTER_SYSTEM</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>OSIF_COUNTER_CUSTOM</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:171108bf-891a-5cb8-81c0-2210171c0b29">
              <SHORT-NAME>Csi2PinsSetup</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                        &lt;html&gt;
                                        &lt;h1&gt;Csi2PinsSetup&lt;/h1&gt;&lt;p&gt;
                                        Necessary parameters to setup the CSI2 PHY interface to receive external data.
                                        &lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92">
                  <SHORT-NAME>Csi2PinsSwapClock</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Swap Clock Pins&lt;/h1&gt;&lt;p&gt;
                                            Specify the clock polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.&lt;/p&gt;&lt;p&gt;
                                            &lt;b&gt;True&lt;/b&gt;: Swap the clock pins polarity&lt;br&gt;
                                            &lt;b&gt;False&lt;/b&gt;: Use the default pins polarity, get after the reset/power-on
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92">
                  <SHORT-NAME>Csi2PinsSwapLane0</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Swap Lane 0 Pins&lt;/h1&gt;&lt;p&gt;
                                            Specify the lane_0 polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.&lt;/p&gt;&lt;p&gt;
                                            &lt;b&gt;True&lt;/b&gt;: Swap the lane_0 pins polarity&lt;br&gt;
                                            &lt;b&gt;False&lt;/b&gt;: Use the default pins polarity, get after the reset/power-on
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92">
                  <SHORT-NAME>Csi2PinsSwapLane1</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Swap Lane 1 Pins&lt;/h1&gt;&lt;p&gt;
                                            Specify the lane_1 polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.&lt;/p&gt;&lt;p&gt;
                                            &lt;b&gt;True&lt;/b&gt;: Swap the lane_0 pins polarity&lt;br&gt;
                                            &lt;b&gt;False&lt;/b&gt;: Use the default pins polarity, get after the reset/power-on
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6255bd46-646a-8792-e6ae-c8742804a977">
              <SHORT-NAME>Csi2Callbacks</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                        &lt;html&gt;
                                        &lt;h1&gt;Csi2Callbacks&lt;/h1&gt;&lt;p&gt;
                                        The necessary definitions for CSI2 interrupt handlers callbacks.&lt;br&gt;
                                        The callback(s) are necessary for error reporting and events reporting if necessary/required.
                                        &lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:96455f3e-0576-078a-8083-ab68666c339d">
                  <SHORT-NAME>Csi2SingleCallbackName</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            The name of the single callback, if single callback selected.&lt;br&gt;
                                            All errors and/or events reported by CSI2 driver will use this single callback,
                                            setting the appropriate information on the passed variable.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE>Csi2_SingleIsrCallback</DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:6601b3e5-42a2-3cd5-089b-8f4bca48c21c">
                  <SHORT-NAME>Csi2PhyErrorCallbackName</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            The name of the callback for reporting PHY errors.&lt;br&gt;
                                            This callback receive only the PHY errors reported by the CSI2 driver.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE>Csi2_PhyIsrCallbackUnit</DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:266a4cdc-b028-aeef-e2f8-81a50ab92849">
                  <SHORT-NAME>Csi2PcktErrorCallbackName</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            The name of the callback for reporting Packet errors.&lt;br&gt;
                                            This callback receive only the Packet errors reported by the CSI2 driver.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE>Csi2_PcktIsrCallbackUnit</DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:439ef874-a8a4-c8db-3509-df6ce9f1d98e">
                  <SHORT-NAME>Csi2EvtErrorCallbackName</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            The name of the callback for reporting requested Events.&lt;br&gt;
                                            This callback receive only the requested Events reported by the CSI2 driver when triggered.
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE>Csi2_EvtIsrCallbackUnit</DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c968b229-6bf7-2145-3b77-1cc843e363a5">
              <SHORT-NAME>Csi2SetupParamsList</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;
                                            This container contains a list of the necessary setup structures for the Csi2 driver.
                                            The necessary parameters have two levels :&lt;br&gt;
                                            &lt;b&gt;Unit level&lt;/b&gt; : the specific paameters for the Csi2 unit level, mainly the interface.&lt;br&gt;
                                            &lt;b&gt;Virtual Channel level&lt;/b&gt; : the specific paameters for the Csi2 Virtual Channel level.
                                            For each setup parameter at least one and maximum four Virtual channels must be defined&lt;br&gt;
                                        &lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5e0f9088-5ba0-8a47-0eb3-eef1c9a49189">
                  <SHORT-NAME>Csi2RxFrequency</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                                &lt;html&gt;
                                                The input clock frequency of the MIPI-CSI2 unit for the current setup.
                                                The value is specified in MHz/Mbps.
                                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>240</DEFAULT-VALUE>
                  <MAX>2500</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a7bce3e3-7a58-cd9c-c5bf-44d5b6917d86">
                  <SHORT-NAME>Csi2NumLanesRx</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                                &lt;html&gt;
                                                Number of lanes to be used for the connection. 1...4 lanes available.
                                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>Four__lanes</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>One___lane</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>Two___lanes</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>Three_lanes</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>Four__lanes</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a391a50e-3684-f3f9-ab30-c740ab79cab4">
                  <SHORT-NAME>Csi2UnitInitOptions</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                                &lt;html&gt;
                                                The possible initialization options for the CSI2 unit:&lt;br&gt;&lt;br&gt;
                                                &lt;b&gt;CSI2_DPHY_INIT_SIMPLE&lt;/b&gt; : simple calibration, with hardware reset but STOP state possible not achieved on the lanes&lt;br&gt;
                                                &lt;b&gt;CSI2_DPHY_INIT_SHORT_CALIB&lt;/b&gt; : the shortest calibration, using the previous PHY values and STOP state not tested/achieved&lt;br&gt;
                                                &lt;b&gt;CSI2_DPHY_INIT_W_STOP_STATE&lt;/b&gt; : hardware reset used and STOP state not tested/achieved&lt;br&gt;
                                                &lt;b&gt;CSI2_DPHY_INIT_SHORT_AND_STOP&lt;/b&gt; : previous PHY values used and STOP state achieved&lt;br&gt;&lt;br&gt;
                                                Using previous PHY values reduce the initialization time to around 100-200 us.&lt;br&gt;
                                                The time linit to wait for the STOP state on the lanes is set to 1.2 ms.
                                                If the stop state is not achieved in this time period, the initialization will fail.
                                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>CSI2_DPHY_INIT_SIMPLE</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_DPHY_INIT_SIMPLE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_DPHY_INIT_SHORT_CALIB</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_DPHY_INIT_W_STOP_STATE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_DPHY_INIT_SHORT_AND_STOP</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:36d9b6b5-c7c7-ec67-cab3-8c7463ec4f13">
                  <SHORT-NAME>Csi2StatisticsImplOptions</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                                &lt;html&gt;
                                                The possible automatic DC compensation computation.
                                                As the statistic data is reported after each chirp,
                                                this parameter defines how often the data is processed,
                                                as the data processing is done inside the events interrupt handler.&lt;br&gt;&lt;br&gt;
                                                &lt;b&gt;CSI2_AUTODC_NO&lt;/b&gt; : auto DC compensation not done, no computation to be done&lt;br&gt;
                                                &lt;b&gt;CSI2_AUTODC_EVERY_LINE&lt;/b&gt; : auto DC compensation using all statistics received
                                                &lt;b&gt;CSI2_AUTODC_AT_FE&lt;/b&gt; : auto DC compensation done at the end of the frame (only once)
                                                    using the statistics from all lines/chirps in the receiving buffer&lt;br&gt;
                                                &lt;b&gt;CSI2_AUTODC_LAST_LINE&lt;/b&gt; : auto DC compensation done at the end of the frame (only once)
                                                    using the statistics only from the last received line/chirp
                                                &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>CSI2_AUTODC_NO</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_AUTODC_NO</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_AUTODC_EVERY_LINE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_AUTODC_AT_FE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CSI2_AUTODC_LAST_LINE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
              </PARAMETERS>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:680d6ba5-fd3e-6019-41f9-e1742cf7d20d">
                  <SHORT-NAME>Csi2LanesMapping</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:d73fb955-906c-dff9-28c1-23d8494a3c7a">
                      <SHORT-NAME>Csi2Lane1Mapping</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                    &lt;html&gt;
                                                    Input lane to be mapped as lane 1
                                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                      <MAX>4</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:67d09720-65c5-5eca-bf62-6dd57c64c365">
                      <SHORT-NAME>Csi2Lane2Mapping</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                    &lt;html&gt;
                                                    Input lane to be mapped as lane 2.
                                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>2</DEFAULT-VALUE>
                      <MAX>4</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:67f60a33-ff5d-5af2-6cb6-afa4db378941">
                      <SHORT-NAME>Csi2Lane3Mapping</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                    &lt;html&gt;
                                                    Input lane to be mapped as lane 3.
                                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>3</DEFAULT-VALUE>
                      <MAX>4</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3768ebaa-d51b-cfab-17cb-fc5c83a14e86">
                      <SHORT-NAME>Csi2Lane4Mapping</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                    &lt;html&gt;
                                                    Input lane to be mapped as lane 4.
                                                    &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>4</DEFAULT-VALUE>
                      <MAX>4</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:da9e36cd-19c5-1cc5-ea83-e36ca5e9676b">
                  <SHORT-NAME>Csi2VcParamsList</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>4</UPPER-MULTIPLICITY>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a1ac1047-87a5-3cd9-fdd6-4599e0b81137">
                      <SHORT-NAME>Csi2VcUsed</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        The Virtual Channel number for this set of parameters
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>3</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:053c8b09-d403-68b8-2ba6-cc7d40a672b0">
                      <SHORT-NAME>Csi2VcStreamType</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        Input stream type.
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CSI2_DATA_TYPE_RAW12</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_EMBD</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_YUV422_8</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_YUV422_10</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RGB565</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RGB888</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RAW8</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RAW10</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RAW12</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RAW14</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_RAW16</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR0</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR1</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR2</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR3</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR4</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR5</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_16_FROM_8</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_DATA_TYPE_USR7</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5408d318-a56e-f1d5-60c9-6e496574acb3">
                      <SHORT-NAME>Csi2VcChannels</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        The number of analog channels used for this flow. Usually this is the number of antennas,
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>4</DEFAULT-VALUE>
                      <MAX>4</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8674067d-c5d2-c6cb-ff68-944cf45ce1d9">
                      <SHORT-NAME>Csi2VcNumSamples</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        The number of samples per channel/antenna to be received in a chirp.
                                                        If Auxiliary Data is used, this number must be the effective value
                                                        to be received into the data buffer line, without the Auxiliary Data.
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>256</DEFAULT-VALUE>
                      <MAX>32500</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:d0aa0103-86eb-b1b7-da8a-ca4976100612">
                      <SHORT-NAME>Csi2VcNumChirps</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        The number of chirps to be received in a frame.
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>512</DEFAULT-VALUE>
                      <MAX>2000</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d56ad882-a18f-b916-da28-62336c37e345">
                      <SHORT-NAME>Csi2BufResetType</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        Select the buffer reset metthod at the end of the frame.&lt;br&gt;
                                                        &lt;b&gt;CSI2_BUF_RESET_NO&lt;/b&gt; = the buffer pointer is not reset, the first data line of the next frame will be put after the last line of the previous frame,
                                                        &lt;b&gt;CSI2_BUF_RESET_FS&lt;/b&gt; = always the first line/chirp of the frame will be put in the first line of the buffer
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>CSI2_BUF_RESET_FS</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_BUF_RESET_NO</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CSI2_BUF_RESET_FS</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:612eb584-a08f-123f-1f14-0e3c4b521dfa">
                      <SHORT-NAME>Csi2VcOutputMode</SHORT-NAME>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:706fe1c1-84a7-c684-b8a2-6a6393bd09f0">
                          <SHORT-NAME>Csi2BufDataOutput</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Select the output data template.&lt;br&gt;
                                                            &lt;b&gt;CSI2_VC_BUF_OUT_ILEAVED&lt;/b&gt; = data is put in the buffer as received&lt;br&gt;
                                                            &lt;b&gt;CSI2_VC_BUF_OUT_TILE8&lt;/b&gt;   = for each channel eight samples are put together, the buffer will receive data as :
                                                                chA_0, chA_1,..., chA_7, chB_0, chB_1,..., chB_7,..., chA_8, chA_9,.., chA_15, chB_8, chB_9,..., chB_15, ...
                                                            &lt;b&gt;CSI2_VC_BUF_OUT_TILE16&lt;/b&gt;   = for each channel sixteen samples are put together, the buffer will receive data as :
                                                                chA_0, chA_1,..., chA_15, chB_0, chB_1,..., chB_15,..., chA_16, chA_17,.., chA_31, chB_16, chB_17,..., chB_31, ...
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>CSI2_VC_BUF_OUT_TILE8</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_VC_BUF_OUT_ILEAVED</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_VC_BUF_OUT_TILE8</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_VC_BUF_OUT_TILE16</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1d523394-22a2-ba2a-d694-2534a5d095bd">
                          <SHORT-NAME>Csi2VcOutputComplex</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The type of the data to receive, real/complex.
                                                            If complex data to be received, the specified number of channes will be multipled by 2.
                                                            Ex.: if 4 channels specified and complex data to receive, in the data flow will be considered 8 different channels.
                                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt; : Real data will be received
                                                            &lt;br&gt;&lt;b&gt;True &lt;/b&gt; : Complex data will be received
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:cd8c69be-2740-ea7c-ad16-2029ca181968">
                          <SHORT-NAME>Csi2VcOutputFlip</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Specify if the sign of the received data will be flipped or not.
                                                            This can be applied to the data types for which the length of the
                                                            received data is less than the lenght of the data put in the memory buffer.
                                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt; : The data received will have only sign extension
                                                            &lt;br&gt;&lt;b&gt;True &lt;/b&gt; : The sign of the received data will be flipped
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:95d5fb45-db02-ddaf-02df-db33216e46c4">
                          <SHORT-NAME>Csi2VcOutputSwap8</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Swap the bytes for RAW8 data received. It applies only for RAW8 data type.
                                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt; : The data received will be put in buffer as received
                                                            &lt;br&gt;&lt;b&gt;True &lt;/b&gt; : The data received will have the bytes swapped
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:94abb08f-d144-066c-d387-66b700a24061">
                          <SHORT-NAME>Csi2VcOutputSwap16</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Swap the bytes for RAW16 data received. It applies only for RAW16 data type.
                                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt; : The data received will be put in buffer as received
                                                            &lt;br&gt;&lt;b&gt;True &lt;/b&gt; : The data received will have the bytes swapped
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:990da8fc-7138-d49a-cc61-27ae927b8b24">
                          <SHORT-NAME>Csi2VcOutputWriteAll</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Write all received data into the buffer, even it was received before FrameStart.
                                                            &lt;br&gt;&lt;b&gt;False&lt;/b&gt; : The data received will not be written
                                                            &lt;br&gt;&lt;b&gt;True &lt;/b&gt; : The data received will be written
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:608da392-5615-d70e-50b3-4dcbc8578f69">
                      <SHORT-NAME>Csi2VcDataBuffer</SHORT-NAME>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7d74a49b-d3a2-6446-8b77-5cad03e59026">
                          <SHORT-NAME>Csi2VcBufNumLines</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The number of the lines available in the memory buffer.&lt;br&gt;
                                                            The total memory reserved for CSI2 data must be :&lt;br&gt;
                                                            &lt;b&gt;NUM_LINES * (NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA)&lt;/b&gt;&lt;br&gt;
                                                            For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits.
                                                            &lt;br&gt;The received data will be put into the memory using the memory buffer lines as a cicular buffer of lines.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>2</DEFAULT-VALUE>
                          <MAX>2000</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8988753a-ad4b-30ee-23e9-8cca5a4b0db3">
                          <SHORT-NAME>Csi2VcBufLineLen</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The length of a memory buffer line.&lt;br&gt;
                                                            The lenth of a buffer line must be at least the length of the data to be put in memory for a chirp. It could be bigger. The necessary amount of memory for a buffer line is :
                                                            &lt;br&gt;&lt;b&gt;(NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA&lt;/b&gt;&lt;br&gt;
                                                            For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>2048</DEFAULT-VALUE>
                          <MAX>65000</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:82a2938a-19f2-be16-d1b2-d850d551cb4f">
                          <SHORT-NAME>Csi2VcBufMemPointer</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The name of the pointer which is initialized with the start memory address of the buffer data.&lt;br&gt;
                                                            As C code, if the specified name is &apos;pBufferData&apos;, it must be initialized like : &lt;br&gt;&lt;br&gt;
                                                            uint8_t *pBufData;&lt;br&gt;
                                                            pBufData = {start_memory_address}&lt;br&gt;
                                                            The {start_memory_address} must be a valid physically address.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-STRING-PARAM-DEF-VARIANTS>
                            <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                              <DEFAULT-VALUE></DEFAULT-VALUE>
                            </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                          </ECUC-STRING-PARAM-DEF-VARIANTS>
                        </ECUC-STRING-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7b4ca864-05c0-0747-54bc-910dd61518b4">
                      <SHORT-NAME>Csi2VcDcOffsets</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                      Common container fro all possible DC offsets.
                                                  &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:592f50d8-a498-6a25-816a-0794558b324a">
                          <SHORT-NAME>Csi2VcDcOffsetsReal</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                          Common container fro all possible DC offsets.
                                                      &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:95e45429-649e-6005-1ad3-3fef3b53db00">
                              <SHORT-NAME>Csi2VcDcOffsetReal0</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                DC offset for Real Channel A. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
