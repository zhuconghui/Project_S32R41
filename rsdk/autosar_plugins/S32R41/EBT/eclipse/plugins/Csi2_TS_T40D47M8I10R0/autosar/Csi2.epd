                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>32767</MAX>
                              <MIN>-32760</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5a743b5c-d1ca-2bf1-b229-bc407e0533b5">
                              <SHORT-NAME>Csi2VcDcOffsetReal3</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                DC offset for Real Channel D. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>32767</MAX>
                              <MIN>-32760</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1740c832-2e36-64aa-7ef4-c9cd2df260e6">
                          <SHORT-NAME>Csi2VcDcOffsetsComplex</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                          Common container fro all possible DC offsets.
                                                      &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:33a691e7-1f35-d58f-0d09-4c7b4630c7ce">
                              <SHORT-NAME>Csi2VcDcOffsetComplex0</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                DC offset for Complex Channel A. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>32767</MAX>
                              <MIN>-32760</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:83f053c3-def9-80c4-d329-d9c863e016c8">
                              <SHORT-NAME>Csi2VcDcOffsetComplex1</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                DC offset for Complex Channel B. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>32767</MAX>
                              <MIN>-32760</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6cb01a24-d42d-1320-5a38-56f261df7eb2">
