                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:55f02e5d-6e2d-ffa9-4424-67235c49d266">
                      <SHORT-NAME>Csi2VcEventsManagement</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                                      Container for Virtual Channel events management.
                                                  &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:264d8413-fb6f-3305-13e1-2f5c444288c4">
                          <SHORT-NAME>Csi2VcBufLinesTrigger</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Define the number of lines received which generate a LineReceived signal to SPT.
                                                            If CSI2_EVT_LINE_END is selected, this is the number of lines received to generate a callback signaling this eveny.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>1024</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8d71da7d-9f8b-5bae-a0d1-948c8d072fd6">
                          <SHORT-NAME>Csi2VcEventsSelection</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                          Container for selection of the reported events for Virtual Channel activities.
                                                      &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c7d8109f-f3b4-86cc-d838-26749c0aca7d">
                              <SHORT-NAME>Csi2VcFrameStartEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, when Frame Start packet is received,
                                                                it will be reported to application, using the callback.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:06863ebf-0c60-8a53-358c-5efcdf150bfa">
                              <SHORT-NAME>Csi2VcFrameEndEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, when Frame End packet is received,
                                                                it will be reported to application, using the callback.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c1fe9c65-7989-d10e-0d24-390667b537a2">
                              <SHORT-NAME>Csi2VcLineDoneEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, a LineDone event will be reported,
                                                                it will be reported to application, using the callback.
                                                                The event will be reported only after the number of lines specified in
                                                                &quot;Number of Lines to Generate a Trigger&quot;.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7f5ed3cb-1e99-598b-2e54-4d3c2f8d4ac7">
                              <SHORT-NAME>Csi2VcShortPackedEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, a Short Packet Received event will be reported,
                                                                if a short packet other then FrameStart and FrameEnd will be received.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:01b67546-08a9-85a1-de41-f8ef8e69f71a">
                              <SHORT-NAME>Csi2VcBitNotToggledEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, a Bit Not Toggled event will be reported,
                                                                if a smaple bit seems not to toggle for a chirp.
                                                                This event is available only if Statistics is enabled.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e9aef328-9559-0b95-777e-671397a8e644">
                              <SHORT-NAME>Csi2VcStartNotZeroEvt</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">
                                                                &lt;html&gt;
                                                                If selected, a Next Start Not Zero event will be reported,
                                                                if a chirp error occur and the circular buffer reception is perturbed.
                                                                This means for the next frame the first chirp data will not be put in the first buffer line.
                                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>false</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
