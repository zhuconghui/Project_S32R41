                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:761de424-cd29-b9c3-15c5-bdb3e7c4abe5">
                          <SHORT-NAME>Csi2VcMetadataInputNumLines</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The number of Metadata lines to be received in a frame.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>20</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ab0a703a-70d4-070f-135c-62244a934c6e">
                          <SHORT-NAME>Csi2VcMetadataInputLineLen</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The length of a Metadata line to be received.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>64</DEFAULT-VALUE>
                          <MAX>64</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0a2eb0d3-3fa5-479b-4ec0-d9734de05db9">
                          <SHORT-NAME>Csi2VcMetadataBufNumLines</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The number of the lines available in the memory buffer for Metadata.&lt;br&gt;
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>10</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a3532658-cb9c-a8f5-971f-9356a7a9c847">
                          <SHORT-NAME>Csi2VcMetadataBufLineLen</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The length of a memory buffer line.&lt;br&gt;
                                                            As for Metadata the received data is put into the memory as received,
                                                            this value must be at least the length of the received Metadata line.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>64</DEFAULT-VALUE>
                          <MAX>256</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:1db49147-4df5-5948-bf5c-58ed0b4927b2">
                          <SHORT-NAME>Csi2VcMetadataBufMemPointer</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The name of the pointer which is initialized with the start memory address of the Metadata buffer data.&lt;br&gt;
                                                            As C code, if the specified name is &apos;pBufferData&apos;, it must be initialized like : &lt;br&gt;&lt;br&gt;
                                                            uint8_t *pBufData;&lt;br&gt;
                                                            pBufData = {start_memory_address}&lt;br&gt;
                                                            The {start_memory_address} must be a valid physically address.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-STRING-PARAM-DEF-VARIANTS>
                            <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                              <DEFAULT-VALUE></DEFAULT-VALUE>
                            </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                          </ECUC-STRING-PARAM-DEF-VARIANTS>
                        </ECUC-STRING-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6917cb63-e195-a78d-850c-67433dde3768">
                      <SHORT-NAME>Csi2VcAuxiliaryDataSetup</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">
                                                        &lt;html&gt;
                                                        General setup for Auxiliary Data usage.
                                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:45182f88-bdbf-3436-099a-28facb122b39">
                          <SHORT-NAME>Csi2VcAuxiliaryDataUsage</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Auxiliary Data usage for this Virtual Channel setup.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:3f58f7c2-b31d-958d-1010-326cdafefba5">
                          <SHORT-NAME>Csi2VcAuxiliaryDataStreamType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            Auxiliary Data input stream split/drop type. Please check the
                                                            Reference Manual to understand which is the correct usage you need.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>CSI2_DATA_TYPE_AUX_0_DR_3OF4</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_DATA_TYPE_AUX_0_NO_DROP</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_DATA_TYPE_AUX_0_DR_1OF2</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_DATA_TYPE_AUX_0_DR_3OF4</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CSI2_DATA_TYPE_AUX_1_NO_DROP</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:51037f14-861b-8e6c-77ea-3d8d1cd09ff9">
                          <SHORT-NAME>Csi2AuxiliaryDataBufNumLines</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The number of the lines available in the memory buffer for Auxiliary Data.
                                                            It can differ from the number of lines for the radar data&lt;br&gt;
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>1000</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e97ca06d-fa2b-2864-844d-a16ad83f70eb">
                          <SHORT-NAME>Csi2VcAuxiliaryDataBufLineLen</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The length of a memory buffer line.&lt;br&gt;
                                                            For Auxiliary Data, the effective necessary buffer data length
                                                            must be the same as for teh radar data, applying the drop data schema.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>64</DEFAULT-VALUE>
                          <MAX>32000</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:12af02d4-0406-c267-84c7-f28a66eaefb6">
                          <SHORT-NAME>Csi2VcAuxDataBufMemPointer</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                                            &lt;html&gt;
                                                            The name of the pointer which is initialized with the start memory address of the Auxiliary Data buffer.&lt;br&gt;
                                                            As C code, if the specified name is &apos;pBufferData&apos;, it must be initialized like : &lt;br&gt;&lt;br&gt;
                                                            uint8_t *pBufData;&lt;br&gt;
                                                            pBufData = {start_memory_address}&lt;br&gt;
                                                            The {start_memory_address} must be a valid physically address.
                                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-STRING-PARAM-DEF-VARIANTS>
                            <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                              <DEFAULT-VALUE></DEFAULT-VALUE>
                            </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                          </ECUC-STRING-PARAM-DEF-VARIANTS>
                        </ECUC-STRING-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4132aa47-dfab-b63c-0a95-37f82da2ff0f">
              <SHORT-NAME>CommonPublishedInformation</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                  &lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
