                                                    <v:var name="Csi2Sdma1PackTypeSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the SDMA_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="SDMA_1 Specific Packet Events Selection"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:272a4816-e4b2-72be-1508-de503683d7e9"/>
                                                        <a:da name="DEFAULT" value="Embedded_Data"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Embedded_Data</a:v>
