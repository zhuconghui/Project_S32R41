====================================================================================================
====================================================================================================
====================================================================================================
-->
    <d:ctr type="AUTOSAR" factory="autosar"
                            xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
                            xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
                            xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D47M8I10R0" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:ded3766c-292f-0aae-6632-0efa9a86e299"/>
                <d:lst type="ELEMENTS">
                    <d:chc name="Csi2" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="LABEL" value="Csi2 Driver Code Parameters" />
                            <a:a name="RELEASE" value="asc:4.7"/>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                            <ad:DATE>2014-10-31</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                    <html>
                                    <h1>Csi2</h1><p>
                                    Configuration of the Csi2 (MIPI-CSI2) module
                                    </p></html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="UPPER-MULTIPLICITY" value="*"/>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <a:a name="UUID" value="ECUC:c2e852b0-b79b-63fc-fc77-745e045720ed"/>
                            <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                                <a:a name="DESC"
                                    value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                                <a:a name="LABEL" value="Post Build Variant Used"/>
                                <a:a name="ORIGIN" value="EB"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:1d8b8453-eb5f-f746-5bb0-4ed5a1e768ea"/>
                                <a:da name="DEFAULT" value="false"/>
                                <a:da name="READONLY" value="FALSE"/>
                                <a:da name="TOOLTIP"
                                    value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            </v:var>
                            <!--  @implements Csi2_Object  -->
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="LABEL" value="Config Variant"/>
                                <a:a name="UUID" value="ECUC:01bfbd27-3721-88a6-d72d-6c63603f8bde"/>
                                <a:da name="DEFAULT" value="VariantPostBuild"/>
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                    <a:v>VariantPreCompile</a:v>
                                </a:da>
                            </v:var>

                            <!--  @implements   Csi2General_Object  -->
                            <v:ctr name="Csi2General" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <h1>Csi2General</h1><p>
                                        All general parameters of the Csi2 driver are collected here.
                                        </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:171108bf-891a-5cb8-81c0-2210171c0b29"/>
                                <a:a name="LABEL" value="General Parameters for CSI2 Driver"/>
                                <a:da name="EDITABLE" value="false" />

                                <!--  @implements   Csi2DevErrorDetect_Object  -->
                                <v:var name="Csi2DevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Detection of Development Errors"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Csi2 Development Error Detect</h1><p>
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            <b>True</b>: Development error detection enabled
                                            <b>False</b>: Development error detection disabled
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>
                                <!--  @implements   Csi2StopAfterErrorReport_Object  -->
                                <v:var name="Csi2StopAfterErrorReport" type="BOOLEAN">
                                    <a:a name="LABEL" value="Stop Execution After Error Report"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Stop Execution After Error Report</h1><p>
                                               When this parameter is enabled, the Csi2 driver will stop execution after Det error report.
                                               The execution will stop in an local infinite loop.
                                          </p>
                                          <p>If this parameter is not ediatable, that means Csi2 driver can't stop.</p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:3b50081c-7fc2-50e8-de3b-f8d97d430026"/>
                                    <a:a name="READONLY" value="false"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2SingleThreadUsed_Object  -->
                                <v:var name="Csi2SingleThreadUsed" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Single Thread Used"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Thread Usage Definition</h1><p>
                                               This parameter set the number of threads the driver is used. It is recommended to use a single thread.</P>
                                               <P>
                                               <b>True</b>: Single thread used.</P>
                                               <P>
                                               <b>False</b>: Multiple threads used.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:df8b108e-fe1b-bc6f-5204-2a384d3aa06e"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2VersionInfo_Object  -->
                                <v:var name="Csi2VersionInfo" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Version Info Available"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Version Info Available</h1><p>
                                               This parameter set the Availability of Csi2_GetVersionInfo function to the application.</P>
                                               <P>
                                               <b>True</b>: Function available.</P>
                                               <P>
                                               <b>False</b>: Function not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:fc1f8e84-7b57-8354-6fe8-f621211fe933"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2StatisticDataUsage_Object  -->
                                <v:var name="Csi2StatisticDataUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Statistic Data Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Statistic Data Usage</h1><p>
                                               This parameter set the usage of statistic data and the associated features.
                                               This means : automatic DC offset adjustment, toggle bit reporting.
                                               If set to False, all the associated code will be removed from the driver.
                                               </P>
                                               <P>
                                               <b>True</b>: Function available.</P>
                                               <P>
                                               <b>False</b>: Function not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:9bc97002-6423-c950-d702-e8afa41f6e74"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2HeaderDataUsage_Object  -->
                                <v:var name="Csi2HeaderDataUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Header Data Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Header Data Usage</h1><p>
                                               This parameter set the usage of header data for all received data.<br>
                                               This means : each chirp for any Virtual Channel used, have to receive the ADC header data at the end of the chirp data.
                                               The chirp buffer length must be defined accordingly.
                                               </P>
                                               <P>
                                               <b>True</b>: Function available.</P>
                                               <P>
                                               <b>False</b>: Function not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:b5db45dd-32c5-f175-3802-f63dac70b280"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="EDITABLE" type="XPath"
                                        expr="text:concat(text:grep(node:value('/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative'),
                                                    'saf85[A-Za-z_0-9]*'), 'x') != 'x'" />
                                </v:var>

                                <!--  @implements   Csi2FooterDataUsage_Object  -->
                                <v:var name="Csi2FooterDataUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Footer Data Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Footer Data Usage</h1><p>
                                               This parameter set the usage of footer data for all received data.<br>
                                               This means : each chirp for any Virtual Channel used, have to receive the ADC header data at the end of the chirp data.
                                               The chirp buffer length must be defined accordingly.
                                               </P>
                                               <P>
                                               <b>True</b>: Function available.</P>
                                               <P>
                                               <b>False</b>: Function not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:234f44f6-7a91-917c-9e41-8eef48bafaa0"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="EDITABLE" type="XPath"
                                        expr="text:concat(text:grep(node:value('/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative'),
                                                    'saf85[A-Za-z_0-9]*'), 'x') != 'x'" />
                                </v:var>

                                <!--  @implements   Csi2DcAutoCompensation_Object  -->
                                <v:var name="Csi2DcAutoCompensation" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Auto DC Offset Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Auto DC Offset Usage</h1><p>
                                               This parameter set the usage of DC auto offset compensation usage.
                                               This parameter can be set only if the Statistic Data Usage is set to True.
                                               If this is set to False, the code for Auto DC Offset compensation will
                                               be removed from the driver, but the other features of Statistic Data Usage
                                               will be available.
                                               </P>
                                               <P>
                                               <b>True</b>: Feature available.</P>
                                               <P>
                                               <b>False</b>: Feature not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:40b9dc6b-1f90-436d-fe5f-01c6a655366a"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2StatisticDataUsage))"/>
                                </v:var>

                                <!--  @implements   Csi2AuxiliaryDataUsage_Object  -->
                                <v:var name="Csi2AuxiliaryDataUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Auxiliary Data Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Auxiliary Data Usage</h1><p>
                                               This parameter set the usage of auxiliary data reception.
                                               Set this parameter to False if not sure auxiliary data will be received.
                                               </P>
                                               <P>
                                               <b>True</b>: Auxiliary data used.</P>
                                               <P>
                                               <b>False</b>: Auxiliary data not used.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:6809ecfb-5e2e-af99-968b-95f8c129397b"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2MetaDataUsage_Object  -->
                                <v:var name="Csi2MetaDataUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver MetaData Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver MetaData Usage</h1><p>
                                               This parameter set the usage of metadata reception.
                                               Set this parameter to False if not sure metadata will be received.
                                               </P>
                                               <P>
                                               <b>True</b>: MetaData data used.</P>
                                               <P>
                                               <b>False</b>: MetaData data not used.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:e121c4e8-4910-076f-2826-6f9460d8028d"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2SingleCallbackUsage_Object  -->
                                <v:var name="Csi2SingleCallbackUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Single Callback Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Single Callback Usage</h1><p>
                                               This parameter set the usage of the callbacks.
                                               </P>
                                               <P>
                                               <b>True</b>: A single callback is used for all three Csi2 interrupts.</P>
                                               <P>
                                               <b>False</b>: Three different callbacks to be used :
                                               the "first two" for error reporting, the "third" for events reporting.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:f2950491-fbba-5137-0666-64471d38d624"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2RxStartStopUsage_Object  -->
                                <v:var name="Csi2RxStartStopUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Rx Start/Stop Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Rx Start/Stop Usage</h1><p>
                                               This parameter set the usage of the Csi2_RxStop and Csi2_RxStart functions.
                                               </P>
                                               <P>
                                               <b>True</b>: The functions to be available to be used.</P>
                                               <P>
                                               <b>False</b>: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:26f6c573-f9f0-38ce-0dc5-545766812407"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2PowerOnOffUsage_Object  -->
                                <v:var name="Csi2PowerOnOffUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Power On/Off Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Power On/Off Usage</h1><p>
                                               This parameter set the usage of the Csi2_PowerOn and Csi2_PowerOff functions.
                                               </P>
                                               <P>
                                               <b>True</b>: The functions to be available to be used.</P>
                                               <P>
                                               <b>False</b>: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:1166fb1e-51d9-676e-9e94-64d2208fd9a4"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2InterfaceFunctionsUsage_Object  -->
                                <v:var name="Csi2InterfaceFunctionsUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Interface Functions Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Interface Functions Usage</h1><p>
                                               This parameter set the usage of the Csi2_GetInterfaceStatus and Csi2_GetLaneStatus functions.
                                               </P>
                                               <P>
                                               <b>True</b>: The functions to be available to be used.</P>
                                               <P>
                                               <b>False</b>: The functions will not be used and
                                                for this reason to be removed from the code files.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:ae4e95f2-26bd-b60a-d66b-04458ce72f6a"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2FramesCounterUsage_Object  -->
                                <v:var name="Csi2FramesCounterUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver Frames Counter Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver Frames Counter Usage</h1><p>
                                               This parameter set the usage of the frames counter.
                                               </P>
                                               <P>
                                               <b>True</b>: Frames counter to be used, The function Csi2_FetFramesCounter will be available.</P>
                                               <P>
                                               <b>False</b>: The frames counter not be used and
                                                The function Csi2_FetFramesCounter will be available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:242da811-0d0a-8a54-6f90-8ca7443d222f"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Csi2GPIOUsage_Object  -->
                                <v:var name="Csi2GPIOUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver GPIO Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver GPIO Usage</h1><p>
                                               This parameter set the usage of the GPIO feature of the Csi2 hardware.
                                               The setup of the GPIO outputs must be done separately.
                                               </P>
                                               <P>
                                               <b>True</b>: GPIO to be used.</P>
                                               <P>
                                               <b>False</b>: GPIO not used, the appropriate code will be removed from the build.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:0d0fd596-aecc-e127-ea6b-0798192647a8"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2SDMAUsage_Object  -->
                                <v:var name="Csi2SDMAUsage" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver SDMA Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver SDMA Usage</h1><p>
                                               This parameter set the usage of the SDMA feature of the Csi2 hardware.
                                               The setup of the SDMA outputs must be done separately.
                                               </P>
                                               <P>
                                               <b>True</b>: SDMA to be used.</P>
                                               <P>
                                               <b>False</b>: SDMA not used, the appropriate code will be removed from the build.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:e6f60327-4cd9-5883-7c8c-1cec074f4c9b"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2PhyUsageSaf85_Object  -->
                                <v:var name="Csi2PhyUsageSaf85" type="BOOLEAN">
                                    <a:a name="LABEL" value="Csi2 Driver PHY Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Csi2 Driver PHY Usage</h1><p>
                                               This parameter set the usage of the CSI2 PHY interface, only for SAF85XX.<br>
                                               For the other platforms the PHY level is used by default.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:87e24e44-c035-a309-1eaa-303eaa646e7f"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="EDITABLE" type="XPath"  expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x')" />
                                </v:var>

                                <!--  @implements   Csi2Rfe20Usage_Object  -->
                                <v:var name="Csi2Rfe20Usage" type="BOOLEAN">
                                    <a:a name="LABEL" value="RFE 2.0 Abstract Usage"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>RFE 2.0 Abstraction Usage</h1><p>
                                               This parameter specify if for S32R41 platform the RFE 2.0 Abstract is used.<br>
                                               If this is used, the CSI2 interface needs a very specific setup, to align the needs of RFE Abstract 2.0 for Front-End (TEF82XX, etc.) BIST :<br>
                                               <b>- Virtual Channel 3 reserved for BIST data reception<br>
                                               - the correct setup for data to be received<br>
                                               - usage of a very specific physical address for data to be received, aligned to the one specified in the RFE Abstract 2.0 Tresos plugin</b><br>
                                               As it will be detected after files generation, this feature is connected to and needs the files generated from RFE Abstract 2.0 plugin.
                                               All necesssary Virtual Channel 3 definitions will be added to the Csi2_PBCfg.c file, but using the same <b>RFE_RFBIST_BUFFERS_ADDRESS</b> address.
                                               As each Front-End needs the own BIST buffer and the BIST buffer memory allocation is contiguous, at file generation time the buffers will be aligned to
                                               modulo <b>RFE_NUM_USED_FRONT_ENDS</b> basis, the BIST buffer start for the n-th CSI2 setup starting at <br>
                                               <b>RFE_RFBIST_BUFFERS_ADDRESS + (1024 * (n % RFE_NUM_USED_FRONT_ENDS))</b><br>
                                               If the CSI2 units setup is registered in the normal order, the resulted configuration will be perfect. If not, it will be necessary to adjust manually the
                                               BIST buffer start in the resulted Csi2_PBCfg.c file.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:87e24e44-c035-a309-1eaa-303eaa646e7f"/>
                                    <a:da name="DEFAULT" value="false"/>
                                    <a:da name="EDITABLE" type="XPath"  expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 'saf8[A-Za-z_0-9]*'), 'x') = 'x')" />

                                </v:var>

                                <!-- implement Csi2OsIfTimerUsage_object, for unit setup parameters -->
                                <v:var name="Csi2OsIfTimerUsage" type="ENUMERATION">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            OsIf timer used by the driver for necessary time counting. This must be aligned to the general timer for the application<br>
                                            Possible usage:<br>
                                            <b>OSIF_COUNTER_DUMMY</b>  = no counters used from OS level<br>
                                            <b>OSIF_COUNTER_SYSTEM</b> = the system counter used<br>
                                            <b>OSIF_COUNTER_CUSTOM</b> = the application must implement teh custom timer
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="OsIf timer/counter type"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:cf43106f-564d-4147-a5b7-087e3aac2566"/>
                                    <a:da name="DEFAULT" value="OSIF_COUNTER_SYSTEM"/>
                                    <a:da name="RANGE">
                                        <a:v>OSIF_COUNTER_DUMMY</a:v>
                                        <a:v>OSIF_COUNTER_SYSTEM</a:v>
                                        <a:v>OSIF_COUNTER_CUSTOM</a:v>
                                    </a:da>
                                </v:var>
                            </v:ctr>

                            <!--  @implements   Csi2PinsSetup_Object  -->
                            <v:ctr name="Csi2PinsSetup" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <h1>Csi2PinsSetup</h1><p>
                                        Necessary parameters to setup the CSI2 PHY interface to receive external data.
                                        </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:171108bf-891a-5cb8-81c0-2210171c0b29"/>
                                <a:a name="LABEL" value="Pins Setup for CSI2 Driver"/>
                                <a:da name="EDITABLE" value="false" />

                                <!--  @implements   Csi2PinsSwapClock_Object  -->
                                <v:var name="Csi2PinsSwapClock" type="BOOLEAN">
                                    <a:a name="LABEL" value="Swap Clock Pins"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Swap Clock Pins</h1><p>
                                            Specify the clock polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.</p><p>
                                            <b>True</b>: Swap the clock pins polarity<br>
                                            <b>False</b>: Use the default pins polarity, get after the reset/power-on
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92"/>
                                    <a:da name="EDITABLE" type="XPath"  expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x') and (node:value('../../Csi2General/Csi2PhyUsageSaf85') = 'true')"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2PinsSwapLane0_Object  -->
                                <v:var name="Csi2PinsSwapLane0" type="BOOLEAN">
                                    <a:a name="LABEL" value="Swap Lane_0 Pins"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Swap Lane 0 Pins</h1><p>
                                            Specify the lane_0 polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.</p><p>
                                            <b>True</b>: Swap the lane_0 pins polarity<br>
                                            <b>False</b>: Use the default pins polarity, get after the reset/power-on
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92"/>
                                    <a:da name="EDITABLE" type="XPath"  expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x') and (node:value('../../Csi2General/Csi2PhyUsageSaf85') = 'true')"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Csi2PinsSwapLane1_Object  -->
                                <v:var name="Csi2PinsSwapLane1" type="BOOLEAN">
                                    <a:a name="LABEL" value="Swap Lane_1 Pins"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Swap Lane 1 Pins</h1><p>
                                            Specify the lane_1 polarity pins to be used when receiving radar data using CSI2 Subsystem - PHY Usage selected.</p><p>
                                            <b>True</b>: Swap the lane_0 pins polarity<br>
                                            <b>False</b>: Use the default pins polarity, get after the reset/power-on
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:61a89973-2a2d-a03c-cef5-362706da7e92"/>
                                    <a:da name="EDITABLE" type="XPath"  expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x') and (node:value('../../Csi2General/Csi2PhyUsageSaf85') = 'true')"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>
                            </v:ctr>



                            <!--  @implements   Csi2Callbacks_Object  -->
                            <v:ctr name="Csi2Callbacks" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <h1>Csi2Callbacks</h1><p>
                                        The necessary definitions for CSI2 interrupt handlers callbacks.<br>
                                        The callback(s) are necessary for error reporting and events reporting if necessary/required.
                                        </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:6255bd46-646a-8792-e6ae-c8742804a977"/>
                                <a:a name="LABEL" value="Specific Callback(s) definitions"/>
                                <a:da name="EDITABLE" value="false" />

                                <!-- implementation of Csi2SingleCallbackName_object -->
                                <v:var name="Csi2SingleCallbackName" type="STRING">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            The name of the single callback, if single callback selected.<br>
                                            All errors and/or events reported by CSI2 driver will use this single callback,
                                            setting the appropriate information on the passed variable.
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="The Name of the Single Callback used"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:96455f3e-0576-078a-8083-ab68666c339d"/>
                                    <a:da name="DEFAULT" value="Csi2_SingleIsrCallback"/>
                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2General/Csi2SingleCallbackUsage) = 'true'" />
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                            false="The name must be an accespted C symbol and must not start with _." />
                                </v:var>

                                <!-- implementation of Csi2PhyErrorCallbackName_object -->
                                <v:var name="Csi2PhyErrorCallbackName" type="STRING">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            The name of the callback for reporting PHY errors.<br>
                                            This callback receive only the PHY errors reported by the CSI2 driver.
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="The Name of the PHY Errors Callback"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:6601b3e5-42a2-3cd5-089b-8f4bca48c21c"/>
                                    <a:da name="DEFAULT" value="Csi2_PhyIsrCallbackUnit"/>
                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2General/Csi2SingleCallbackUsage) = 'false'" />
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                            false="The name must be an accespted C symbol and must not start with _." />
                                </v:var>

                                <!-- implementation of Csi2PcktErrorCallbackName_object -->
                                <v:var name="Csi2PcktErrorCallbackName" type="STRING">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            The name of the callback for reporting Packet errors.<br>
                                            This callback receive only the Packet errors reported by the CSI2 driver.
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="The Name of the Packet Errors Callback"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:266a4cdc-b028-aeef-e2f8-81a50ab92849"/>
                                    <a:da name="DEFAULT" value="Csi2_PcktIsrCallbackUnit"/>
                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2General/Csi2SingleCallbackUsage) = 'false'" />
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                            false="The name must be an accespted C symbol and must not start with _." />
                                </v:var>

                                <!-- implementation of Csi2EvtErrorCallbackName_object -->
                                <v:var name="Csi2EvtErrorCallbackName" type="STRING">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            The name of the callback for reporting requested Events.<br>
                                            This callback receive only the requested Events reported by the CSI2 driver when triggered.
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="The Name of the Events Callback"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:439ef874-a8a4-c8db-3509-df6ce9f1d98e"/>
                                    <a:da name="DEFAULT" value="Csi2_EvtIsrCallbackUnit"/>
                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2General/Csi2SingleCallbackUsage) = 'false'" />
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                            false="The name must be an accespted C symbol and must not start with _." />
                                </v:var>
                            </v:ctr>

                            <!--  CSI2 SETUP PARAMS LIST  >>>>>>>>> -->
                            <v:lst name="Csi2SetupParamsList" type="MAP">
                                <a:da name="MIN" value="1" />
                                <a:a name="LABEL" value="List of All Defined CSI2 Configurations"/>
                                <v:ctr name="Csi2SetupParamsList" type="IDENTIFIABLE">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:<html>
                                            This container contains a list of the necessary setup structures for the Csi2 driver.
                                            The necessary parameters have two levels :<br>
                                            <b>Unit level</b> : the specific paameters for the Csi2 unit level, mainly the interface.<br>
                                            <b>Virtual Channel level</b> : the specific paameters for the Csi2 Virtual Channel level.
                                            For each setup parameter at least one and maximum four Virtual channels must be defined<br>
                                        </html>]]></a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="CSI2 Configuration Parameters"/>
                                    <a:da name="EDITABLE" value="false" />
                                    <a:a name="UUID" value="ECUC:c968b229-6bf7-2145-3b77-1cc843e363a5" />

                                    <!-- implement Csi2RxFrequency_object, for unit setup parameters -->
                                    <v:var name="Csi2RxFrequency" type="INTEGER">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                The input clock frequency of the MIPI-CSI2 unit for the current setup.
                                                The value is specified in MHz/Mbps.
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Rx Clock Frequency"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="UUID" value="ECUC:5e0f9088-5ba0-8a47-0eb3-eef1c9a49189"/>
                                        <a:da name="DEFAULT" value="240"/>
                                        <a:da name="INVALID" type="Range">
                                            <a:tst expr="&gt;=0"/>
                                            <a:tst expr="&lt;=2500"/>
                                        </a:da>
                                    </v:var>

                                    <!-- implement Csi2NumLanesRx_object, for unit setup parameters -->
                                    <v:var name="Csi2NumLanesRx" type="ENUMERATION">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                Number of lanes to be used for the connection. 1...4 lanes available.
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Number of Lanes Used"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="UUID" value="ECUC:a7bce3e3-7a58-cd9c-c5bf-44d5b6917d86"/>
                                        <a:da name="DEFAULT" value="Four__lanes"/>
                                        <!-- a:da name="INVALID" type="XPath"
                                        expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x')
                                                and ((node:value(.) = 'Three_lanes') or (node:value(.) = 'Four__lanes'))" / -->
                                        <a:da name="INVALID" type="XPath"
                                        expr="(text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r41[A-Za-z_0-9]*'), 'x') = 'x')
                                        and ((node:value(.) = 'Three_lanes') or (node:value(.) = 'Four__lanes'))"
                                        true="SAF85XX has only two lanes available"/>
                                        <a:da name="RANGE">
                                            <a:v>One___lane</a:v>
                                            <a:v>Two___lanes</a:v>
                                            <a:v>Three_lanes</a:v>
                                            <a:v>Four__lanes</a:v>
                                        </a:da>
                                    </v:var>

                                    <!-- control for Csi2 Laned mapping -->
                                    <v:ctr name="Csi2LanesMapping" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="Lanes Mapping"/>
                                        <a:a name="UUID" value="ECUC:680d6ba5-fd3e-6019-41f9-e1742cf7d20d"/>
                                        <a:da name="EDITABLE" value="false" />

                                        <!-- implement Csi2Lane1Mapping_object, for unit setup parameters -->
                                        <v:var name="Csi2Lane1Mapping" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                    <html>
                                                    Input lane to be mapped as lane 1
                                                    </html>
                                                    ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Lane 1 mapped to Connector Lane"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:d73fb955-906c-dff9-28c1-23d8494a3c7a"/>
                                            <a:da name="DEFAULT" value="1"/>
                                            <a:da name="EDITABLE" type="XPath" expr='((node:value(../../Csi2NumLanesRx) = "Two___lanes") or
                                                                (node:value(../../Csi2NumLanesRx) = "Three_lanes") or (node:value(../../Csi2NumLanesRx) = "Four__lanes"))'/>
                                            <a:da name="INVALID" type="XPath"
                                                expr='((node:value(../../Csi2NumLanesRx) = "One___lane") and (node:value(.) != "1")) or
                                                    ((node:value(../../Csi2NumLanesRx) = "Two___lanes") and (node:value(.) > "2")) or
                                                    ((node:value(../../Csi2NumLanesRx) = "Three_lanes") and (node:value(.) > "3"))'
                                                true="Incorrect mapping for lane 1."/>
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=4"/>
                                            </a:da>
                                        </v:var>

                                        <!-- implement Csi2Lane2Mapping_object, for unit setup parameters -->
                                        <v:var name="Csi2Lane2Mapping" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                    <html>
                                                    Input lane to be mapped as lane 2.
                                                    </html>
                                                    ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Lane 2 mapped to Connector Lane"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:67d09720-65c5-5eca-bf62-6dd57c64c365"/>
                                            <a:da name="DEFAULT" value="2"/>
                                            <a:da name="EDITABLE" type="XPath" expr='((node:value(../../Csi2NumLanesRx) = "Two___lanes") or
                                                                (node:value(../../Csi2NumLanesRx) = "Three_lanes") or (node:value(../../Csi2NumLanesRx) = "Four__lanes"))' />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=4"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath"
                                                expr='((node:value(../../Csi2NumLanesRx) = "Two___lanes") and (node:value(.) > "2")) or
                                                    ((node:value(../../Csi2NumLanesRx) = "Three_lanes") and (node:value(.) > "3")) or
                                                    (node:value(../Csi2Lane1Mapping) = node:value(.))'
                                                true="Incorrect mapping for lane 2."/>
                                        </v:var>

                                        <!-- implement Csi2Lane3Mapping_object, for unit setup parameters -->
                                        <v:var name="Csi2Lane3Mapping" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                    <html>
                                                    Input lane to be mapped as lane 3.
                                                    </html>
                                                    ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Lane 3 mapped to Connector Lane"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:67f60a33-ff5d-5af2-6cb6-afa4db378941"/>
                                            <a:da name="DEFAULT" value="3"/>
                                            <a:da name="EDITABLE" type="XPath" expr='((node:value(../../Csi2NumLanesRx) = "Three_lanes")
                                                    or (node:value(../../Csi2NumLanesRx) = "Four__lanes"))'  />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=4"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath"
                                                expr='((node:value(../../Csi2NumLanesRx) = "Three_lanes") and (node:value(.) > "3")) or
                                                        (node:value(../Csi2Lane1Mapping) = node:value(.)) or
                                                        (node:value(../Csi2Lane2Mapping) = node:value(.))'
                                                true="Incorrect mapping for lane 3."/>
                                        </v:var>

                                        <!-- implement Csi2Lane4Mapping_object, for unit setup parameters -->
                                        <v:var name="Csi2Lane4Mapping" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                    <html>
                                                    Input lane to be mapped as lane 4.
                                                    </html>
                                                    ]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="LABEL" value="Lane 4 mapped to Connector Lane"/>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="UUID" value="ECUC:3768ebaa-d51b-cfab-17cb-fc5c83a14e86"/>
                                            <a:da name="DEFAULT" value="4"/>
                                            <a:da name="EDITABLE" type="XPath" expr='(node:value(../../Csi2NumLanesRx) = "Four__lanes")' />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&gt;=1"/>
                                                <a:tst expr="&lt;=4"/>
                                            </a:da>
                                            <a:da name="INVALID" type="XPath"
                                                expr='(node:value(../Csi2Lane1Mapping) = node:value(.)) or
                                                    (node:value(../Csi2Lane2Mapping) = node:value(.)) or
                                                    (node:value(../Csi2Lane3Mapping) = node:value(.))'
                                                true="Incorrect mapping for lane 4."/>
                                        </v:var>
                                    </v:ctr>

                                    <!-- control for Csi2UnitInitOptions_Object -->
                                    <v:var name="Csi2UnitInitOptions" type="ENUMERATION">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                The possible initialization options for the CSI2 unit:<br><br>
                                                <b>CSI2_DPHY_INIT_SIMPLE</b> : simple calibration, with hardware reset but STOP state possible not achieved on the lanes<br>
                                                <b>CSI2_DPHY_INIT_SHORT_CALIB</b> : the shortest calibration, using the previous PHY values and STOP state not tested/achieved<br>
                                                <b>CSI2_DPHY_INIT_W_STOP_STATE</b> : hardware reset used and STOP state not tested/achieved<br>
                                                <b>CSI2_DPHY_INIT_SHORT_AND_STOP</b> : previous PHY values used and STOP state achieved<br><br>
                                                Using previous PHY values reduce the initialization time to around 100-200 us.<br>
                                                The time linit to wait for the STOP state on the lanes is set to 1.2 ms.
                                                If the stop state is not achieved in this time period, the initialization will fail.
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="DPHY Init Options"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="UUID" value="ECUC:a391a50e-3684-f3f9-ab30-c740ab79cab4"/>
                                        <a:da name="DEFAULT" value="CSI2_DPHY_INIT_SIMPLE"/>
                                        <a:da name="RANGE">
                                            <a:v>CSI2_DPHY_INIT_SIMPLE</a:v>
                                            <a:v>CSI2_DPHY_INIT_SHORT_CALIB</a:v>
                                            <a:v>CSI2_DPHY_INIT_W_STOP_STATE</a:v>
                                            <a:v>CSI2_DPHY_INIT_SHORT_AND_STOP</a:v>
                                        </a:da>
                                    </v:var>

                                    <!-- control for Csi2StatisticsImplOptions_Object -->
                                    <v:var name="Csi2StatisticsImplOptions" type="ENUMERATION">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:
                                                <html>
                                                The possible automatic DC compensation computation.
                                                As the statistic data is reported after each chirp,
                                                this parameter defines how often the data is processed,
                                                as the data processing is done inside the events interrupt handler.<br><br>
                                                <b>CSI2_AUTODC_NO</b> : auto DC compensation not done, no computation to be done<br>
                                                <b>CSI2_AUTODC_EVERY_LINE</b> : auto DC compensation using all statistics received
                                                <b>CSI2_AUTODC_AT_FE</b> : auto DC compensation done at the end of the frame (only once)
                                                    using the statistics from all lines/chirps in the receiving buffer<br>
                                                <b>CSI2_AUTODC_LAST_LINE</b> : auto DC compensation done at the end of the frame (only once)
                                                    using the statistics only from the last received line/chirp
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="LABEL" value="Statistics Usage Implementation"/>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="UUID" value="ECUC:36d9b6b5-c7c7-ec67-cab3-8c7463ec4f13"/>
                                        <a:da name="DEFAULT" value="CSI2_AUTODC_NO"/>
                                        <a:da name="EDITABLE" type="XPath"
                                                expr="../../../Csi2General/Csi2DcAutoCompensation = 'true' and ../../../Csi2General/Csi2StatisticDataUsage = 'true'"  />
                                        <a:da name="RANGE">
                                            <a:v>CSI2_AUTODC_NO</a:v>
                                            <a:v>CSI2_AUTODC_EVERY_LINE</a:v>
                                            <a:v>CSI2_AUTODC_AT_FE</a:v>
                                            <a:v>CSI2_AUTODC_LAST_LINE</a:v>
                                        </a:da>
                                    </v:var>

                                    <!--  CSI2 VIRTUAL CHANNEL SETUP PARAMS LIST -->
                                    <!-- implementation of Csi2VcParamList_object -->
                                    <v:lst name="Csi2VcParamsList" type="MAP">
                                        <a:da name="MIN" value="1" />
                                        <a:da name="MAX" value="4" />
                                        <a:a name="LABEL" value="List of Used Virtual Channels"/>

                                        <!-- implementation of Csi2VcParams_object -->
                                        <v:ctr name="Csi2VcParamsList" type="IDENTIFIABLE">
                                            <a:a name="LABEL" value="Virtual Channel Setup"/>
                                            <a:a name="UUID" value="ECUC:da9e36cd-19c5-1cc5-ea83-e36ca5e9676b"/>
                                            <a:da name="EDITABLE" value="false" />

                                            <!-- implementation of Csi2VcUsed_object -->
                                            <v:var name="Csi2VcUsed" type="INTEGER">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        The Virtual Channel number for this set of parameters
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Virtual Channel Used"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:a1ac1047-87a5-3cd9-fdd6-4599e0b81137"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&gt;=0"/>
                                                    <a:tst expr="&lt;=3"/>
                                                </a:da>
                                                <a:da name="INVALID" type="XPath"
                                                    expr="(count(../../*[Csi2VcUsed = 0]) > 1) or (count(../../*[Csi2VcUsed = 1]) > 1) or (count(../../*[Csi2VcUsed = 2]) > 1) or (count(../../*[Csi2VcUsed = 3]) > 1)"
                                                        true="Multiple definitions for the same Virtual Channel."/>
                                                <a:da name="INVALID" type="XPath"
                                                    expr="(node:value(.) = 3) and (text:concat(text:grep(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 'saf8[A-Za-z_0-9]*'), 'x') = 'x') and (../../../../../Csi2General/Csi2Rfe20Usage) = 'true'"
                                                        true="Virtual Channel 3 is reserved for RFE Abstract 2.0 BIST."/>
                                            </v:var>

                                            <!-- implementation of Csi2VcStreamType_object -->
                                            <v:var name="Csi2VcStreamType" type="ENUMERATION">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        Input stream type.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Data Stream Type"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:053c8b09-d403-68b8-2ba6-cc7d40a672b0"/>
                                                <a:da name="DEFAULT" value="CSI2_DATA_TYPE_RAW12"/>
                                                <a:da name="RANGE">
                                                    <a:v>CSI2_DATA_TYPE_EMBD</a:v>
                                                    <a:v>CSI2_DATA_TYPE_YUV422_8</a:v>
                                                    <a:v>CSI2_DATA_TYPE_YUV422_10</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RGB565</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RGB888</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RAW8</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RAW10</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RAW12</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RAW14</a:v>
                                                    <a:v>CSI2_DATA_TYPE_RAW16</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR0</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR1</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR2</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR3</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR4</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR5</a:v>
                                                    <a:v>CSI2_DATA_TYPE_16_FROM_8</a:v>
                                                    <a:v>CSI2_DATA_TYPE_USR7</a:v>
                                                </a:da>
                                            </v:var>

                                            <!-- implementation of Csi2VcChannels_object -->
                                            <v:var name="Csi2VcChannels" type="INTEGER">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        The number of analog channels used for this flow. Usually this is the number of antennas,
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Number of channels/antennas"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:5408d318-a56e-f1d5-60c9-6e496574acb3"/>
                                                <a:da name="DEFAULT" value="4"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&gt;=1"/>
                                                    <a:tst expr="&lt;=4"/>
                                                </a:da>
                                            </v:var>

                                            <!-- implementation of Csi2VcNumSamples_object -->
                                            <v:var name="Csi2VcNumSamples" type="INTEGER">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        The number of samples per channel/antenna to be received in a chirp.
                                                        If Auxiliary Data is used, this number must be the effective value
                                                        to be received into the data buffer line, without the Auxiliary Data.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Samples Num to Receive in a Chirp"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:8674067d-c5d2-c6cb-ff68-944cf45ce1d9"/>
                                                <a:da name="DEFAULT" value="256"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&gt;=1"/>
                                                    <a:tst expr="&lt;=32500"/>
                                                </a:da>
                                            </v:var>

                                            <!-- implementation of Csi2VcNumChirps_object -->
                                            <v:var name="Csi2VcNumChirps" type="INTEGER">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        The number of chirps to be received in a frame.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Chirps Num to Receive in a Frame"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:d0aa0103-86eb-b1b7-da8a-ca4976100612"/>
                                                <a:da name="DEFAULT" value="512"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&gt;=1"/>
                                                    <a:tst expr="&lt;=2000"/>
                                                </a:da>
                                            </v:var>
                                            <!-- implements Csi2BufResetType_object -->
                                            <v:var name="Csi2BufResetType" type="ENUMERATION">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        Select the buffer reset metthod at the end of the frame.<br>
                                                        <b>CSI2_BUF_RESET_NO</b> = the buffer pointer is not reset, the first data line of the next frame will be put after the last line of the previous frame,
                                                        <b>CSI2_BUF_RESET_FS</b> = always the first line/chirp of the frame will be put in the first line of the buffer
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Buffer Data Output Template"/>
                                                <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                <a:a name="SCOPE" value="LOCAL"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                <a:a name="UUID" value="ECUC:d56ad882-a18f-b916-da28-62336c37e345"/>
                                                <a:da name="DEFAULT" value="CSI2_BUF_RESET_FS"/>
                                                <a:da name="RANGE">
                                                    <a:v>CSI2_BUF_RESET_NO</a:v>
                                                    <a:v>CSI2_BUF_RESET_FS</a:v>
                                                </a:da>
                                                <a:da name="EDITABLE" type="XPath"
                                                    expr="text:concat(text:grep(node:value('/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative'),
                                                                'saf85[A-Za-z_0-9]*'), 'x') != 'x'" />
                                            </v:var>


                                            <!-- implementation of Csi2VcOutputMode_object -->
                                            <v:ctr name="Csi2VcOutputMode" type="IDENTIFIABLE">
                                                <a:a name="LABEL" value="Buffer Data Output Mode"/>
                                                <a:a name="UUID" value="ECUC:612eb584-a08f-123f-1f14-0e3c4b521dfa"/>
                                                <a:da name="EDITABLE" value="false" />

                                                <!-- implements Csi2BufDataOutput_object -->
                                                <v:var name="Csi2BufDataOutput" type="ENUMERATION">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Select the output data template.<br>
                                                            <b>CSI2_VC_BUF_OUT_ILEAVED</b> = data is put in the buffer as received<br>
                                                            <b>CSI2_VC_BUF_OUT_TILE8</b>   = for each channel eight samples are put together, the buffer will receive data as :
                                                                chA_0, chA_1,..., chA_7, chB_0, chB_1,..., chB_7,..., chA_8, chA_9,.., chA_15, chB_8, chB_9,..., chB_15, ...
                                                            <b>CSI2_VC_BUF_OUT_TILE16</b>   = for each channel sixteen samples are put together, the buffer will receive data as :
                                                                chA_0, chA_1,..., chA_15, chB_0, chB_1,..., chB_15,..., chA_16, chA_17,.., chA_31, chB_16, chB_17,..., chB_31, ...
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Buffer Data Output Template"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:706fe1c1-84a7-c684-b8a2-6a6393bd09f0"/>
                                                    <a:da name="DEFAULT" value="CSI2_VC_BUF_OUT_TILE8"/>
                                                    <a:da name="RANGE">
                                                        <a:v>CSI2_VC_BUF_OUT_ILEAVED</a:v>
                                                        <a:v>CSI2_VC_BUF_OUT_TILE8</a:v>
                                                        <a:v>CSI2_VC_BUF_OUT_TILE16</a:v>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcOutputComplex_object -->
                                                <v:var name="Csi2VcOutputComplex" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The type of the data to receive, real/complex.
                                                            If complex data to be received, the specified number of channes will be multipled by 2.
                                                            Ex.: if 4 channels specified and complex data to receive, in the data flow will be considered 8 different channels.
                                                            <br><b>False</b> : Real data will be received
                                                            <br><b>True </b> : Complex data will be received
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Complex Data to Receive"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:1d523394-22a2-ba2a-d694-2534a5d095bd"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>

                                                <!-- implementation of Csi2VcOutputFlip_object -->
                                                <v:var name="Csi2VcOutputFlip" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Specify if the sign of the received data will be flipped or not.
                                                            This can be applied to the data types for which the length of the
                                                            received data is less than the lenght of the data put in the memory buffer.
                                                            <br><b>False</b> : The data received will have only sign extension
                                                            <br><b>True </b> : The sign of the received data will be flipped
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Flip Received Data Sign"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:cd8c69be-2740-ea7c-ad16-2029ca181968"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>

                                                <!-- implementation of Csi2VcOutputSwap8_object -->
                                                <v:var name="Csi2VcOutputSwap8" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Swap the bytes for RAW8 data received. It applies only for RAW8 data type.
                                                            <br><b>False</b> : The data received will be put in buffer as received
                                                            <br><b>True </b> : The data received will have the bytes swapped
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Swap Bytes for RAW8 Data Type"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:95d5fb45-db02-ddaf-02df-db33216e46c4"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2VcStreamType) = 'CSI2_DATA_TYPE_RAW8'" />
                                                </v:var>

                                                <!-- implementation of Csi2VcOutputSwap16_object -->
                                                <v:var name="Csi2VcOutputSwap16" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Swap the bytes for RAW16 data received. It applies only for RAW16 data type.
                                                            <br><b>False</b> : The data received will be put in buffer as received
                                                            <br><b>True </b> : The data received will have the bytes swapped
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Swap Bytes for RAW16 Data Type"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:94abb08f-d144-066c-d387-66b700a24061"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../Csi2VcStreamType) = 'CSI2_DATA_TYPE_RAW16'" />
                                                </v:var>

                                                <!-- implementation of Csi2VcOutputWriteAll_object -->
                                                <v:var name="Csi2VcOutputWriteAll" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Write all received data into the buffer, even it was received before FrameStart.
                                                            <br><b>False</b> : The data received will not be written
                                                            <br><b>True </b> : The data received will be written
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Write All Received Data"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:990da8fc-7138-d49a-cc61-27ae927b8b24"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>
                                            </v:ctr>

                                            <!-- implementation of Csi2VcDataBuffer_object -->
                                            <v:ctr name="Csi2VcDataBuffer" type="IDENTIFIABLE">
                                                <a:a name="LABEL" value="Memory Buffer Parameters"/>
                                                <a:a name="UUID" value="ECUC:608da392-5615-d70e-50b3-4dcbc8578f69"/>
                                                <a:da name="EDITABLE" value="false" />

                                                <!-- implementation of Csi2VcBufNumLines_object -->
                                                <v:var name="Csi2VcBufNumLines" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The number of the lines available in the memory buffer.<br>
                                                            The total memory reserved for CSI2 data must be :<br>
                                                            <b>NUM_LINES * (NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA)</b><br>
                                                            For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits.
                                                            <br>The received data will be put into the memory using the memory buffer lines as a cicular buffer of lines.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Number of Lines in the Memory Buffer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:7d74a49b-d3a2-6446-8b77-5cad03e59026"/>
                                                    <a:da name="DEFAULT" value="2"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=2000"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcBufLineLen_object -->
                                                <v:var name="Csi2VcBufLineLen" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The length of a memory buffer line.<br>
                                                            The lenth of a buffer line must be at least the length of the data to be put in memory for a chirp. It could be bigger. The necessary amount of memory for a buffer line is :
                                                            <br><b>(NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA</b><br>
                                                            For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Length of a Memory Buffer Line"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:8988753a-ad4b-30ee-23e9-8cca5a4b0db3"/>
                                                    <a:da name="DEFAULT" value="2048"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=65000"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcBufMemPointer_object -->
                                                <v:var name="Csi2VcBufMemPointer" type="STRING">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The name of the pointer which is initialized with the start memory address of the buffer data.<br>
                                                            As C code, if the specified name is 'pBufferData', it must be initialized like : <br><br>
                                                            uint8_t *pBufData;<br>
                                                            pBufData = {start_memory_address}<br>
                                                            The {start_memory_address} must be a valid physically address.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Symbolic Name of the Buffer Pointer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:82a2938a-19f2-be16-d1b2-d850d551cb4f"/>
                                                    <a:da name="DEFAULT" value=""/>
                                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^[A-Za-z][A-Za-z_0-9]*')"
                                                            false="The name must be an accespted C symbol and must not start with _." />
                                                </v:var>
                                            </v:ctr>

                                            <!-- implementation of Csi2VcDcOffsets_object -->
                                            <v:ctr name="Csi2VcDcOffsets" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                  <a:v><![CDATA[EN: <html>
                                                      Common container fro all possible DC offsets.
                                                  </html>]]></a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:7b4ca864-05c0-0747-54bc-910dd61518b4"/>
                                                <a:da name="LABEL" value="DC Offsets for All Channels" />
                                                <a:da name="EDITABLE" value="false" />

                                                <!-- implementation of Csi2VcDcOffsetsReal_object -->
                                                <v:ctr name="Csi2VcDcOffsetsReal" type="IDENTIFIABLE">
                                                    <a:a name="DESC">
                                                      <a:v><![CDATA[EN: <html>
                                                          Common container fro all possible DC offsets.
                                                      </html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="UUID" value="ECUC:592f50d8-a498-6a25-816a-0794558b324a"/>
                                                    <a:da name="LABEL" value="DC Offsets for Real Channels" />
                                                    <a:da name="EDITABLE" value="false" />

                                                    <!-- implementation for Csi2VcDcOffsetReal0_object -->
                                                    <v:var name="Csi2VcDcOffsetReal0" type="INTEGER">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                DC offset for Real Channel A. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Real Channel A"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:95e45429-649e-6005-1ad3-3fef3b53db00"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                    </v:var>

                                                    <!-- implementation for Csi2VcDcOffsetReal1_object -->
                                                    <v:var name="Csi2VcDcOffsetReal1" type="INTEGER">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                DC offset for Real Channel B. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Real Channel B"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:0e1d8dd0-7f1a-4215-448e-1e62d3e31473"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../../../Csi2VcChannels)) &gt;= 2" />
                                                    </v:var>

                                                    <!-- implementation for Csi2VcDcOffsetReal2_object -->
                                                    <v:var name="Csi2VcDcOffsetReal2" type="INTEGER">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                DC offset for Real Channel C. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Real Channel C"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:0662fd74-ac40-d508-b75c-8234e3831bc5"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../../../Csi2VcChannels)) &gt;= 3" />
                                                    </v:var>

                                                    <!-- implementation for Csi2VcDcOffsetReal3_object -->
                                                    <v:var name="Csi2VcDcOffsetReal3" type="INTEGER">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                DC offset for Real Channel D. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Real Channel D"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:5a743b5c-d1ca-2bf1-b229-bc407e0533b5"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../../../Csi2VcChannels)) &gt;= 4" />
                                                    </v:var>
                                                </v:ctr>


                                                <!-- implementation of Csi2VcDcOffsetsComplex_object -->
                                                <v:ctr name="Csi2VcDcOffsetsComplex" type="IDENTIFIABLE">
                                                    <a:a name="DESC">
                                                      <a:v><![CDATA[EN: <html>
                                                          Common container fro all possible DC offsets.
                                                      </html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="UUID" value="ECUC:1740c832-2e36-64aa-7ef4-c9cd2df260e6"/>
                                                    <a:da name="LABEL" value="DC Offsets for Complex Channels" />
                                                    <a:da name="EDITABLE" value="false" />

                                                    <!-- implementation for Csi2VcDcOffsetComplex0_object -->
                                                    <v:var name="Csi2VcDcOffsetComplex0" type="INTEGER">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                DC offset for Complex Channel A. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Complex Channel A"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:33a691e7-1f35-d58f-0d09-4c7b4630c7ce"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../Csi2VcOutputMode/Csi2VcOutputComplex) = 'true'" />
                                                    </v:var>

                                                    <!-- implementation for Csi2VcDcOffsetComplex1_object -->
                                                    <v:var name="Csi2VcDcOffsetComplex1" type="INTEGER">
