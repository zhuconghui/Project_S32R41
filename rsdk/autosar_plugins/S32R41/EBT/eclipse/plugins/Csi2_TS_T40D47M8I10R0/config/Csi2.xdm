                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../../Csi2General/Csi2SDMAUsage) = 'true'" />
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2Sdma1PackAndFrameSelection_object -->
                                                    <v:var name="Csi2Sdma1PackAndFrameSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the SDMA_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="SDMA_1 Frame and Packet Events"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:a3a90b59-fde7-9192-1ead-da077d88dc01"/>
                                                        <a:da name="DEFAULT" value="Frame_Start"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Frame_Start</a:v>
