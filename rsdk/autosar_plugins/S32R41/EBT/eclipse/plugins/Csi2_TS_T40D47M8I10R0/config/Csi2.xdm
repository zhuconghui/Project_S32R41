                                                        <a:a name="UUID" value="ECUC:7daa7de6-81d7-8285-44f8-c42847aaec9a"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="((node:value(../../../Csi2VcChannels)) &gt;= 4) and (node:value(../../../Csi2VcOutputMode/Csi2VcOutputComplex) = 'true')" />
                                                    </v:var>
