                                            </v:ctr>

                                            <!-- implements Csi2VcEventsManagement_object -->
                                            <v:ctr name="Csi2VcEventsManagement" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                  <a:v><![CDATA[EN: <html>
                                                      Container for Virtual Channel events management.
                                                  </html>]]></a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:55f02e5d-6e2d-ffa9-4424-67235c49d266"/>
                                                <a:da name="EDITABLE" value="false" />
                                                <a:da name="LABEL" value="Virtual Channel Events Management" />

                                                <!-- implements Csi2VcBufLinesTrigger_object -->
                                                <v:var name="Csi2VcBufLinesTrigger" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Define the number of lines received which generate a LineReceived signal to SPT.
                                                            If CSI2_EVT_LINE_END is selected, this is the number of lines received to generate a callback signaling this eveny.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Number of Lines to Generate a Trigger"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:264d8413-fb6f-3305-13e1-2f5c444288c4"/>
                                                    <a:da name="DEFAULT" value="1"/>
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=1024"/>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath" expr="node:value(.) &gt;= (node:value(../../Csi2VcNumChirps) + 1)"
                                                                true="The value must be less equal the number of chirps" />
                                                </v:var>

                                                <!-- implements Csi2VcEventsSelection_object -->
                                                <v:ctr name="Csi2VcEventsSelection" type="IDENTIFIABLE">
                                                    <a:a name="DESC">
                                                      <a:v><![CDATA[EN: <html>
                                                          Container for selection of the reported events for Virtual Channel activities.
                                                      </html>]]></a:v>
                                                    </a:a>
                                                    <a:a name="UUID" value="ECUC:8d71da7d-9f8b-5bae-a0d1-948c8d072fd6"/>
                                                    <a:da name="EDITABLE" value="false" />
                                                    <a:da name="LABEL" value="Virtual Channel Events Selection" />

                                                    <!-- implements Csi2VcFrameStartEvt_object -->
                                                    <v:var name="Csi2VcFrameStartEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, when Frame Start packet is received,
                                                                it will be reported to application, using the callback.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Frame Start Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:c7d8109f-f3b4-86cc-d838-26749c0aca7d"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2VcFrameEndEvt_object -->
                                                    <v:var name="Csi2VcFrameEndEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, when Frame End packet is received,
                                                                it will be reported to application, using the callback.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Frame End Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:06863ebf-0c60-8a53-358c-5efcdf150bfa"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2VcLineDoneEvt_object -->
                                                    <v:var name="Csi2VcLineDoneEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, a LineDone event will be reported,
                                                                it will be reported to application, using the callback.
                                                                The event will be reported only after the number of lines specified in
                                                                "Number of Lines to Generate a Trigger".
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Line Done/Received Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:c1fe9c65-7989-d10e-0d24-390667b537a2"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2VcShortPackedEvt_object -->
                                                    <v:var name="Csi2VcShortPackedEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, a Short Packet Received event will be reported,
                                                                if a short packet other then FrameStart and FrameEnd will be received.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Short Packet Received Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:7f5ed3cb-1e99-598b-2e54-4d3c2f8d4ac7"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2VcBitNotToggledEvt_object -->
                                                    <v:var name="Csi2VcBitNotToggledEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, a Bit Not Toggled event will be reported,
                                                                if a smaple bit seems not to toggle for a chirp.
                                                                This event is available only if Statistics is enabled.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Bit Not Toggled Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:01b67546-08a9-85a1-de41-f8ef8e69f71a"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../../Csi2General/Csi2StatisticDataUsage)" />
                                                    </v:var>

                                                    <!-- implements Csi2VcStartNotZeroEvt_object -->
                                                    <v:var name="Csi2VcStartNotZeroEvt" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                If selected, a Next Start Not Zero event will be reported,
                                                                if a chirp error occur and the circular buffer reception is perturbed.
                                                                This means for the next frame the first chirp data will not be put in the first buffer line.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="Start Not Zero Event"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:e9aef328-9559-0b95-777e-671397a8e644"/>
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>
                                                </v:ctr>
                                            </v:ctr>    <!-- Csi2VcEventsManagement -->

                                            <!-- implement Csi2VcGpioSetup_Object -->
                                            <v:ctr name="Csi2VcGpioSetup" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        General setup for the GPIO triggers. The GPIO outputs are not initialized by the CSI2 driver.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:1f64f83d-7e78-5144-d68d-3bfbf6402a32"/>
                                                <a:a name="LABEL" value="GPIO Trigger Setup"/>
                                                <a:a name="EDITABLE" value="false" />

                                                <!-- implements Csi2Gpio1Setup_Object -->
                                                <v:ctr name="Csi2Gpio1Setup" type="IDENTIFIABLE">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Setup for the GPIO 1 output. The GPIO output is not initialized by the CSI2 driver.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="UUID" value="ECUC:4ac03eb3-7ded-91e7-68d4-a201ab3455f1"/>
                                                    <a:a name="LABEL" value="GPIO 1 Pad Output Trigger Setup"/>
                                                    <a:a name="EDITABLE" value="false"/>

                                                    <!-- implements Csi2Gpio1EnaPackAndFrame_object -->
                                                    <v:var name="Csi2Gpio1EnaPackAndFrame" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Enable the output trigger for the GPIO_1 if a Frame Start/End
                                                                packet is received or Chirp Start/End is received."
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO 1 Enable Frame and Packet Events"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:ba962af0-4c59-7b89-ca01-7106a49d20ae"/>
                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true'" />
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2Gpio1PackAndFrameSelection_object -->
                                                    <v:var name="Csi2Gpio1PackAndFrameSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the GPIO_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO_1 Frame and Packet Events"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:1ceb5add-765a-835f-6b6e-f38d19f31fe6"/>
                                                        <a:da name="DEFAULT" value="Frame_Start"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Frame_Start</a:v>
                                                            <a:v>Frame_End</a:v>
                                                            <a:v>Packet_Start</a:v>
                                                            <a:v>Packet_End</a:v>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2Gpio1EnaPackAndFrame) = 'true') and (node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true')" />
                                                    </v:var>

                                                    <!-- implements Csi2Gpio1EnaPackType_object -->
                                                    <v:var name="Csi2Gpio1EnaPackType" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Enable the output trigger for the GPIO_1 if a specific
                                                                packet is received."
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO 1 Enable Specific Packet Events"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:76088975-6039-a37f-f599-ae7a8e9a5d14"/>
                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true'" />
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2Gpio1PackTypeSelection_object -->
                                                    <v:var name="Csi2Gpio1PackTypeSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the GPIO_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO_1 Specific Packet Events Selection"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:ae815767-1607-05ce-cede-9a8a782f3755"/>
                                                        <a:da name="DEFAULT" value="Embedded_Data"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Embedded_Data</a:v>
                                                            <a:v>User_Defined_Data</a:v>
                                                            <a:v>RAW_Data</a:v>
                                                            <a:v>RGB_Data</a:v>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2Gpio1EnaPackType) = 'true') and (node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true')" />
                                                    </v:var>

                                                     <!-- implements Csi2Gpio1EnaError_object -->
                                                    <v:var name="Csi2Gpio1EnaError" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Enable the output trigger for the GPIO_1 if an error is detected."
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO 1 Enable Error Packet Events"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:9fdc9764-3e05-b2fe-2c87-4ea110a21943"/>
                                                        <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true'" />
                                                        <a:da name="DEFAULT" value="false"/>
                                                    </v:var>

                                                    <!-- implements Csi2Gpio1ErrorSelection_object -->
                                                    <v:var name="Csi2Gpio1ErrorSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the GPIO_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="GPIO_1 Error Events Selection"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:c24c4432-0dff-173a-7cd6-4ad4863a762e"/>
                                                        <a:da name="DEFAULT" value="Line_Count"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Line_Count</a:v>
                                                            <a:v>Line_Length</a:v>
                                                            <a:v>CRC_or_ECC2bits</a:v>
                                                            <a:v>No_Synchronization_on_DPHY</a:v>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2Gpio1EnaError) = 'true') and (node:value(../../../../../../../Csi2General/Csi2GPIOUsage) = 'true')" />
                                                    </v:var>

                                                </v:ctr>    <!-- Csi2Gpio1Setup -->
                                            </v:ctr>    <!-- Csi2VcGpioSetup -->


                                             <!-- implement Csi2VcSdmaSetup_Object -->
                                            <v:ctr name="Csi2VcSdmaSetup" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
