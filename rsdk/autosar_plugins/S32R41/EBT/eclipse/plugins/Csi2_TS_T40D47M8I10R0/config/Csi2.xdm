                                                    <v:var name="Csi2Sdma1ErrorSelection" type="ENUMERATION">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Select the trigger source for the SDMA_1,
                                                                only one of the four possible events can be selected.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="SDMA_1 Error Events Selection"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:940e0e3d-f90f-5890-a1f4-f9c50e54ba7d"/>
                                                        <a:da name="DEFAULT" value="Line_Count"/>
                                                        <a:da name="RANGE">
                                                            <a:v>Line_Count</a:v>
                                                            <a:v>Line_Length</a:v>
                                                            <a:v>CRC_or_ECC2bits</a:v>
                                                            <a:v>No_Synchronization_on_DPHY</a:v>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2Sdma1EnaError) = 'true') and (node:value(../../../../../../../Csi2General/Csi2SDMAUsage) = 'true')" />
                                                    </v:var>

                                                </v:ctr>    <!-- Csi2Sdma1Setup -->
                                            </v:ctr>    <!-- Csi2VcSdmaSetup -->

                                            <!-- implementation of Csi2VcMetadataSetup_object -->
                                            <v:ctr name="Csi2VcMetadataSetup" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        General setup for Metadata usage.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="UUID" value="ECUC:83751097-bb6a-b299-35c0-31057304b354"/>
                                                <a:a name="LABEL" value="Csi2 VC Metadata Setup"/>
                                                <a:da name="EDITABLE" value="false" />

                                                <!-- implementation of Csi2VcMetadataUsage_object -->
                                                <v:var name="Csi2VcMetadataUsage" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Metadata usage for this Virtual Channel setup.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Metadata is Used"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:96af87b9-603b-d157-e545-df2e1eda1907"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true'" />
                                                    <a:da name="DEFAULT" value="false"/>
                                                </v:var>

                                                <!-- implementation of Csi2VcMetadataStreamType_object -->
                                                <v:var name="Csi2VcMetadataStreamType" type="ENUMERATION">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Metadata input stream type.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Data Stream Type"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:0d9d9d8f-8a7f-fe1e-f324-478b404d8fed"/>
                                                    <a:da name="DEFAULT" value="CSI2_DATA_TYPE_EMBD"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="RANGE">
                                                        <a:v>CSI2_DATA_TYPE_EMBD</a:v>
                                                        <a:v>CSI2_DATA_TYPE_YUV422_8</a:v>
                                                        <a:v>CSI2_DATA_TYPE_YUV422_10</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RGB565</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RGB888</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RAW8</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RAW10</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RAW12</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RAW14</a:v>
                                                        <a:v>CSI2_DATA_TYPE_RAW16</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR0</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR1</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR2</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR3</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR4</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR5</a:v>
                                                        <a:v>CSI2_DATA_TYPE_16_FROM_8</a:v>
                                                        <a:v>CSI2_DATA_TYPE_USR7</a:v>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcMetadataInputNumLines_object -->
                                                <v:var name="Csi2VcMetadataInputNumLines" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The number of Metadata lines to be received in a frame.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Metadata Num Lines to Receive in a Frame"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:761de424-cd29-b9c3-15c5-bdb3e7c4abe5"/>
                                                    <a:da name="DEFAULT" value="1"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=20"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcMetadataInputLineLen_object -->
                                                <v:var name="Csi2VcMetadataInputLineLen" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The length of a Metadata line to be received.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Metadata Line Length to Receive"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:ab0a703a-70d4-070f-135c-62244a934c6e"/>
                                                    <a:da name="DEFAULT" value="64"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=64"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2MetadataBufNumLines_object -->
                                                <v:var name="Csi2VcMetadataBufNumLines" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The number of the lines available in the memory buffer for Metadata.<br>
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Number of Metadata Lines in the Memory Buffer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:0a2eb0d3-3fa5-479b-4ec0-d9734de05db9"/>
                                                    <a:da name="DEFAULT" value="1"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=10"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcMetadataBufLineLen_object -->
                                                <v:var name="Csi2VcMetadataBufLineLen" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The length of a memory buffer line.<br>
                                                            As for Metadata the received data is put into the memory as received,
                                                            this value must be at least the length of the received Metadata line.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Length of a Metadata Buffer Line"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:a3532658-cb9c-a8f5-971f-9356a7a9c847"/>
                                                    <a:da name="DEFAULT" value="64"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=256"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcMetadataBufMemPointer_object -->
                                                <v:var name="Csi2VcMetadataBufMemPointer" type="STRING">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The name of the pointer which is initialized with the start memory address of the Metadata buffer data.<br>
                                                            As C code, if the specified name is 'pBufferData', it must be initialized like : <br><br>
                                                            uint8_t *pBufData;<br>
                                                            pBufData = {start_memory_address}<br>
                                                            The {start_memory_address} must be a valid physically address.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Symbolic Name of the Buffer Pointer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:1db49147-4df5-5948-bf5c-58ed0b4927b2"/>
                                                    <a:da name="DEFAULT" value=""/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcMetadataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="XPath" expr="((text:concat(text:grep( . , '^[A-Za-z][A-Za-z_0-9]*'), 'xx') = 'xx')
                                                                            and (node:value(../Csi2VcMetadataUsage)='true')
                                                                            and (node:value(../../../../../../Csi2General/Csi2MetaDataUsage)='true')) = false()"
                                                            false="The name must be an accespted C symbol and must not start with _." />
                                                </v:var>
                                            </v:ctr>    <!-- Csi2VcMetadataSetup -->

                                            <!-- implementation of Csi2VcAuxiliaryDataSetup_object -->
                                            <v:ctr name="Csi2VcAuxiliaryDataSetup" type="IDENTIFIABLE">
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                        <html>
                                                        General setup for Auxiliary Data usage.
                                                        </html>
                                                        ]]>
                                                    </a:v>
                                                </a:a>
                                                <a:a name="LABEL" value="Csi2 VC Auxiliary Data Setup"/>
                                                <a:a name="UUID" value="ECUC:6917cb63-e195-a78d-850c-67433dde3768"/>

                                                <!-- implementation of Csi2VcMetadataUsage_object -->
                                                <v:var name="Csi2VcAuxiliaryDataUsage" type="BOOLEAN">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Auxiliary Data usage for this Virtual Channel setup.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Auxiliary Data is Used"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:45182f88-bdbf-3436-099a-28facb122b39"/>
                                                    <a:da name="DEFAULT" value="false"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="XPath" expr="((.) = 'false') or (((.) = 'true') and 
                                                    ((node:value(../../Csi2VcStreamType) = 'CSI2_DATA_TYPE_RAW12') or (node:value(../../Csi2VcStreamType) = 'CSI2_DATA_TYPE_RAW16')))"
                                                            false="Only RAW12 and RAW16 data type are permitted." />
                                                </v:var>

                                                <!-- implementation of Csi2VcAuxiliaryDataStreamType_object -->
                                                <v:var name="Csi2VcAuxiliaryDataStreamType" type="ENUMERATION">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            Auxiliary Data input stream split/drop type. Please check the
                                                            Reference Manual to understand which is the correct usage you need.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Data Stream Drop Schema"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:3f58f7c2-b31d-958d-1010-326cdafefba5"/>
                                                    <a:da name="DEFAULT" value="CSI2_DATA_TYPE_AUX_0_DR_3OF4"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcAuxiliaryDataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage) = 'true')" />
                                                    <a:da name="RANGE">
                                                        <a:v>CSI2_DATA_TYPE_AUX_0_NO_DROP</a:v>
                                                        <a:v>CSI2_DATA_TYPE_AUX_0_DR_1OF2</a:v>
                                                        <a:v>CSI2_DATA_TYPE_AUX_0_DR_3OF4</a:v>
                                                        <a:v>CSI2_DATA_TYPE_AUX_1_NO_DROP</a:v>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2AuxiliaryDataBufNumLines_object -->
                                                <v:var name="Csi2AuxiliaryDataBufNumLines" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The number of the lines available in the memory buffer for Auxiliary Data.
                                                            It can differ from the number of lines for the radar data<br>
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="Number of Auxiliary Data Lines in the Memory Buffer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:51037f14-861b-8e6c-77ea-3d8d1cd09ff9"/>
                                                    <a:da name="DEFAULT" value="1"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcAuxiliaryDataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=1000"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcAuxiliaryDataBufLineLen_object -->
                                                <v:var name="Csi2VcAuxiliaryDataBufLineLen" type="INTEGER">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The length of a memory buffer line.<br>
                                                            For Auxiliary Data, the effective necessary buffer data length
                                                            must be the same as for teh radar data, applying the drop data schema.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Length of a Auxiliary Data Buffer Line"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:e97ca06d-fa2b-2864-844d-a16ad83f70eb"/>
                                                    <a:da name="DEFAULT" value="64"/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcAuxiliaryDataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&gt;=1"/>
                                                        <a:tst expr="&lt;=32000"/>
                                                    </a:da>
                                                </v:var>

                                                <!-- implementation of Csi2VcAuxDataBufMemPointer_object -->
                                                <v:var name="Csi2VcAuxDataBufMemPointer" type="STRING">
                                                    <a:a name="DESC">
                                                        <a:v><![CDATA[EN:
                                                            <html>
                                                            The name of the pointer which is initialized with the start memory address of the Auxiliary Data buffer.<br>
                                                            As C code, if the specified name is 'pBufferData', it must be initialized like : <br><br>
                                                            uint8_t *pBufData;<br>
                                                            pBufData = {start_memory_address}<br>
                                                            The {start_memory_address} must be a valid physically address.
                                                            </html>
                                                            ]]>
                                                        </a:v>
                                                    </a:a>
                                                    <a:a name="LABEL" value="The Symbolic Name of the Buffer Pointer"/>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                    <a:a name="SCOPE" value="LOCAL"/>
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                    <a:a name="UUID" value="ECUC:12af02d4-0406-c267-84c7-f28a66eaefb6"/>
                                                    <a:da name="DEFAULT" value=""/>
                                                    <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2VcAuxiliaryDataUsage) = 'true') and (node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage) = 'true')" />
                                                    <a:da name="INVALID" type="XPath" expr="((text:concat(text:grep( . , '^[A-Za-z][A-Za-z_0-9]*'), 'xx') = 'xx')
                                                                            and (node:value(../Csi2VcAuxiliaryDataUsage)='true')
                                                                            and (node:value(../../../../../../Csi2General/Csi2AuxiliaryDataUsage)='true')) = false()"
                                                            false="The name must be an accespted C symbol and must not start with _." />
                                                </v:var>
                                            </v:ctr>    <!-- Csi2VcAuxiliaryDataSetup -->
                                        </v:ctr>        <!-- Csi2VcParams object -->
                                    </v:lst>
                                </v:ctr>
                            </v:lst>
                            <!--  <<<<<<<<<  CSI2 SETUP PARAMS LIST -->

                            <!--  @implements Csi2CommonPublishedInformation_Object  -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                  <a:v><![CDATA[EN: <html>
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                  </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:4132aa47-dfab-b63c-0a95-37f82da2ff0f"/>
                            </v:ctr>
                            <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Csi2"/>
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Csi2_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="UUID" value="ECUC:b1f1e138-6483-2112-639e-aeb3bd1e7837"/>
                            <a:a name="DEF"
                                 value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                            </d:lst>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Csi2_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                                value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER" >
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                                value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
