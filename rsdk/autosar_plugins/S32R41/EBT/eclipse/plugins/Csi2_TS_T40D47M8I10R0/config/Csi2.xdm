                                                        <a:da name="EDITABLE" type="XPath" expr="(node:value(../Csi2Sdma1EnaPackType) = 'true') and (node:value(../../../../../../../Csi2General/Csi2SDMAUsage) = 'true')" />
                                                    </v:var>

                                                     <!-- implements Csi2Sdma1EnaError_object -->
