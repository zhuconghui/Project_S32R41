                                                    <a:a name="EDITABLE" value="false" />

                                                    <!-- implements Csi2Sdma1EnaPackAndFrame_object -->
                                                    <v:var name="Csi2Sdma1EnaPackAndFrame" type="BOOLEAN">
                                                        <a:a name="DESC">
                                                            <a:v><![CDATA[EN:
                                                                <html>
                                                                Enable the output trigger for the SDMA_1 if a Frame Start/End
                                                                packet is received or Chirp Start/End is received."
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
