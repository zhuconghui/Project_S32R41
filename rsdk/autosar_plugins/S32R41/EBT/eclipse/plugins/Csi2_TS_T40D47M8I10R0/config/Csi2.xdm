                                                                <html>
                                                                DC offset for Complex Channel B. The 32767 value is only
                                                                for Auto DC Adjustment and signal that the channel DC offset is adjusted after each frame.
                                                                Any other value is a fix value to be applied as DC adjustment.
                                                                </html>
                                                                ]]>
                                                            </a:v>
                                                        </a:a>
                                                        <a:a name="LABEL" value="DC Offset for Complex Channel B"/>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:83f053c3-def9-80c4-d329-d9c863e016c8"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="((node:value(../../../Csi2VcChannels)) &gt;= 2) and (node:value(../../../Csi2VcOutputMode/Csi2VcOutputComplex) = 'true')" />
                                                    </v:var>

                                                    <!-- implementation for Csi2VcDcOffsetComplex2_object -->
                                                    <v:var name="Csi2VcDcOffsetComplex2" type="INTEGER">
