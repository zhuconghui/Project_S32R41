                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="UUID" value="ECUC:6cb01a24-d42d-1320-5a38-56f261df7eb2"/>
                                                        <a:da name="DEFAULT" value="0"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=-32760"/>
                                                            <a:tst expr="&lt;=32767"/>
                                                        </a:da>
                                                        <a:da name="EDITABLE" type="XPath" expr="((node:value(../../../Csi2VcChannels)) &gt;= 3) and (node:value(../../../Csi2VcOutputMode/Csi2VcOutputComplex) = 'true')" />
                                                    </v:var>

