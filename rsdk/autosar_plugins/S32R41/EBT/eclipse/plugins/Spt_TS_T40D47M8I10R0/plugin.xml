<plugin>
  <extension point="dreisoft.tresos.launcher2.plugin.module"
             id="Spt_TS_T40D47M8I10R0_ModuleId"
             name="Spt_TS_T40D47M8I10R0 Module">

    <module id="Spt_TS_T40D47M8I10R0"
            label="Spt"
            mandatory="false"
            allowMultiple="false"
            description="Spt BSW module"
            copyright="Copyright  NXP Semiconductors"
            swVersionMajor="0"
            swVersionMinor="8"
            swVersionPatch="10"
            swVersionSuffix="D2411"
            specVersionMajor=""
            specVersionMinor=""
            specVersionPatch=""
            specVersionSuffix=""
            relVersionPrefix="AUTOSAR"
            relVersionMajor="4"
            relVersionMinor="7"
            relVersionPatch="0"
            relVersionSuffix="0000"
            categoryType="Spt"
            categoryLayer="MCAL"
            categoryCategory="ECU Firmware"
            categoryComponent="ECUC">
      <ecuType target="ARM64" derivate="S32R41X"/>
      <ecuType target="CORTEXM" derivate="S32R41XM7"/>

    </module>
    </extension>
   
  <extension point="dreisoft.tresos.launcher2.plugin.configuration"
             id="Spt_TS_T40D47M8I10R0_ConfigId"
             name="Spt_TS_T40D47M8I10R0 Configuration">
    <configuration moduleId="Spt_TS_T40D47M8I10R0">
      <schema>
        <manager class="dreisoft.tresos.autosar2.resourcehandling.AutosarSchemaManager"/>
          <!-- register the main xdm configuration schema for Spt -->
          <resource value="config/Spt.xdm" type="xdm"/>

      </schema>

      <data>
        <manager class="dreisoft.tresos.autosar2.resourcehandling.AutosarConfigManager"/>
        <schemaNode path="ASPath:/TS_T40D47M8I10R0/Spt"/>
      </data>

      <editor id="Spt_TS_T40D47M8I10R0_EditorId"
              label="Default"
              tooltip="Spt BSW module">
        <class class="dreisoft.tresos.launcher2.editor.GenericConfigEditor">
          <parameter name="schema" value="ASPath:/TS_T40D47M8I10R0/Spt"/>
          <parameter name="title" value="Spt"/>
          <parameter name="noTabs" value="false"/>
          <parameter name="noLinks" value="true"/>
          <parameter name="groupLinks" value="false"/>
          <parameter name="groupContainers" value="false"/>
          <parameter name="groupTables" value="true"/>
          <parameter name="optionalGeneralTab" value="true"/>
        </class>
      </editor>
    </configuration>
  </extension>

 <extension point="dreisoft.tresos.launcher2.plugin.generator"
             id="EPCGenerator"
             name="EPC Generator">
  <generator moduleId="Spt_TS_T40D47M8I10R0"
               id="Spt_TS_T40D47M8I10R0"
               class="dreisoft.tresos.autosar2.generator.EPCFileGenerator">
   
  <parameter name="variantAware" value="true"/>
  <parameter name="cfgFilePath" value="output"/>
  <parameter name="generateAllModules" value="false"/>
  <parameter name="generateIntoOneFile" value="false"/>
  <parameter name="contentType" value="asc:4.7.0"/>
  </generator>
 </extension>
  
 <extension point="dreisoft.tresos.generator.api.plugin.generator" id="Spt_TS_T40D47M8I10R0_NGGeneratorId">
          <generator moduleId="Spt_TS_T40D47M8I10R0"
                     class="dreisoft.tresos.generator.ng.api.NGGenerator"
                     id="Spt_TS_T40D47M8I10R0_UniqueNGGeneratorId"
                     modes="generate,generate_PC,generate_PB,verify"
                     step="post"> <!-- run after code-generation -->
              <parameter name="buildfile" value="ant_generator.xml"/>
           <parameter name="variantAware" value="true"/>
          </generator>
  </extension>
      <extension point="dreisoft.tresos.launcher2.plugin.generator"
              id="Spt_TS_T40D47M8I10R0_GeneratorId"
              name="Spt_TS_T40D47M8I10R0 Generator">
    <generator moduleId="Spt_TS_T40D47M8I10R0"
               class="dreisoft.tresos.launcher2.generator.TemplateBasedCodeGenerator">
  
    <parameter name="variantAware" value="true"/>
    <!-- swcd modes and template path parameters -->
    <parameter name="mode_type" mode="generate_swcd" value="generate"></parameter>
    <parameter name="mode_type" mode="verify_swcd" value="verify"></parameter>
    <parameter name="templates" mode="generate_swcd,verify_swcd" value="generate_swcd"></parameter>   

      <!-- common template path parameters -->
      <parameter name="templates" mode="generate,verify" value="generate,generate_PC,generate_PB"/>
      <!-- custom generators -->
      <parameter name="templates" mode="generate_PC" value="generate_PC"/>
      <parameter name="templates" mode="generate_PB" value="generate_PB"/>
      <!-- custom template paths -->
      <parameter name="mode_type" mode="generate_PC" value="generate"/>
      <parameter name="mode_type" mode="generate_PB" value="generate"/>
    </generator>
  </extension>
  
  <extension point="org.eclipse.help.toc">
    <toc file="anchors.xml" primary="true"/>
    <toc file="$nl$/Spt/toc.xml" primary="false"/>
    <!-- toc file="$nl$/ReleaseNotes/toc.xml" primary="false"/ !-->
  </extension>
</plugin>
