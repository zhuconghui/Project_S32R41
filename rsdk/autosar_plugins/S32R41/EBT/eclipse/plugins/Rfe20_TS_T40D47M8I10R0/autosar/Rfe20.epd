<?xml version='1.0'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="ECUC:de209b69-853b-2a17-1cdf-eb343e0e1061">
      <SHORT-NAME>TS_T40D47M8I10R0</SHORT-NAME>
      <ELEMENTS>
        <ECUC-DEFINITION-COLLECTION UUID="ECUC:51d3aba9-23ad-a59a-1fde-b819689399af">
          <SHORT-NAME>Csi2_EcuParameterDefinition</SHORT-NAME>
          <MODULE-REFS>
            <MODULE-REF DEST="ECUC-MODULE-DEF">/TS_T40D47M9I0R0/Csi2</MODULE-REF>
          </MODULE-REFS>
        </ECUC-DEFINITION-COLLECTION>
        <ECUC-MODULE-DEF UUID="ECUC:7f3490ca-cdca-3a92-63da-154a3ec8d7cf">
          <SHORT-NAME>Rfe20</SHORT-NAME>
          <DESC>
            <L-2 L="EN">
                                    &lt;html&gt;
                                    &lt;h1&gt;Rfe20&lt;/h1&gt;&lt;p&gt;
                                    Configuration of the Radar Front End Abstract 2.0 module
                                    &lt;/p&gt;&lt;/html&gt;</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>4.6.0</REVISION-LABEL>
                <ISSUED-BY>AUTOSAR</ISSUED-BY>
                <DATE>2014-10-31</DATE>
              </DOC-REVISION>
            </DOC-REVISIONS>
          </ADMIN-DATA>
          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
          <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
          <REFINED-MODULE-DEF-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Csi2</REFINED-MODULE-DEF-REF>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:923b5a1b-a910-5cb0-debf-d98790ead5e8">
              <SHORT-NAME>Rfe20_General</SHORT-NAME>
              <DESC>
                <L-2 L="EN">
                                        &lt;html&gt;
                                        &lt;h1&gt;Radar Front End Abstract 2.0&lt;/h1&gt;&lt;p&gt;
                                        All general parameters of the Radar Front End Abstract 2.0 driver configuration are collected here.
                                        &lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:01dd997e-8256-d46b-7e73-f7b13028e63d">
                  <SHORT-NAME>Rfe20DevErrorDetect</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            &lt;h1&gt;Radar Front End Abstract 2.0 Development Error Detect&lt;/h1&gt;&lt;p&gt;
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            &lt;b&gt;True&lt;/b&gt;: Development error detection enabled
                                            &lt;b&gt;False&lt;/b&gt;: Development error detection disabled
                                            &lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f53ddd40-6ae6-2edf-89a2-2aab3612b7c3">
                  <SHORT-NAME>Rfe20StopAfterErrorReport</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - Stop Execution After Error Report&lt;/h1&gt;&lt;p&gt;
                                               When this parameter is enabled, the Radar Front End Abstract 2.0 driver will stop execution after Det error report.
                                               The execution will stop in an local infinite loop.
                                          &lt;/p&gt;
                                          &lt;p&gt;If this parameter is not ediatable, that means Radar Front End Abstract 2.0 driver can&apos;t stop.&lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ba56856c-30a0-6e26-987d-da22cae8e675">
                  <SHORT-NAME>Rfe20SingleThreadUsed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - Thread Usage Definition&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the number of threads the driver is used. It is recommended to use a single thread.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Single thread used.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Multiple threads used.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e4ea12c6-22c3-ba28-df95-de47c94e9259">
                  <SHORT-NAME>Rfe20VersionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - Driver Version Info Available&lt;/h1&gt;&lt;p&gt;
                                               This parameter set the Availability of CDD_Rfe_GetVersionInfo function to the application.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;True&lt;/b&gt;: Function available.&lt;/P&gt;
                                               &lt;P&gt;
                                               &lt;b&gt;False&lt;/b&gt;: Function not available.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:7e10204f-99b0-d44e-6e21-e9d8eef61424">
                  <SHORT-NAME>Rfe20_RfeMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                            &lt;html&gt;
                                            The current working mode for the RFE-Fw side.&lt;br&gt;
                                            Possible usage:&lt;br&gt;
                                            &lt;b&gt;STANDALONE&lt;/b&gt;  = Independent Front-End used; for the moment only one Front-End allowed to be managed&lt;br&gt;
                                            &lt;b&gt;CASCADED&lt;/b&gt; = Cascaded Front-Ends setup, the limit is the number of the MIPI-CSI2 interfaces available ofr the used platform&lt;br&gt;
                                            &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE></DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>STANDALONE</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF>
                      <SHORT-NAME>CASCADED</SHORT-NAME>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1ae6fdc9-4005-63ca-3ace-1c986e58bd56">
                  <SHORT-NAME>Rfe20FeNumber</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - Number of connected Front-Ends&lt;/h1&gt;&lt;p&gt;
                                               This parameter define the number of connected Front-Ends.&lt;/P&gt;
                                               &lt;P&gt;It can be set only for CASCADED mode.
                                          &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>2</DEFAULT-VALUE>
                  <MAX>4</MAX>
                  <MIN>1</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:a777ed23-a9e7-bcce-c0bf-a540b6423ca2">
                  <SHORT-NAME>Rfe20FeStateAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - the Shared address between API and Firmware : the location of Front-End Status &lt;/h1&gt;&lt;p&gt;
                                               This parameter define the exact memory address where the Front-End status is saved by the Firmware, to be accessible to the API.&lt;/P&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE></DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:a22b7bcd-03ec-6319-331e-2894a38dcf79">
                  <SHORT-NAME>Rfe20FePointerAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - the Shared address between API and Firmware : the location of transfer memory pointer&lt;/h1&gt;&lt;p&gt;
                                               This parameter define the exact memory address where the Firmware will receive the memory buffer address to use for data transfer.&lt;/P&gt;
                                               &lt;p&gt; At interface initialization, this location will be put by API interface with the Shared Memory Buffer address.&lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE></DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:b547ef56-4fdb-3fd2-d834-4f955bc81343">
                  <SHORT-NAME>Rfe20DataTransferBuffer</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - the Data Transfer Buffer&lt;/h1&gt;&lt;p&gt;
                                               This parameter define the exact memory address where starts the data transfer buffer between API and Firmware.&lt;/P&gt;
                                               &lt;p&gt; At interface initialization, this address will be put by API interface in the Data Buffer Pointer Location.&lt;/p&gt;
                                               &lt;p&gt; The memory space reserved for data transfer must be at least 544 bytes. It must not be used by any application for other purposes.&lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE></DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
                <ECUC-STRING-PARAM-DEF UUID="ECUC:ee1a7fd9-f9d9-2b32-6c77-2b8669194028">
                  <SHORT-NAME>Rfe20BistBuffer</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">
                                          &lt;html&gt;
                                          &lt;h1&gt;Radar Front End Abstract 2.0 - the BIST Buffer&lt;/h1&gt;&lt;p&gt;
                                               This parameter define the exact memory address where starts the BIST buffer, used by the Firmware to receive the BIST data from the Front-End(s).&lt;/P&gt;
                                               &lt;p&gt; This value must be used by the application running on M7_0 core to initialize the CSI2 interface.&lt;/p&gt;
                                               &lt;p&gt; The memory space reserved for BIST data transfer must be &lt;br&gt;&lt;b&gt;128[samples] * 4[channels] * 2[bytes/sample] * N[front-end(s) used]&lt;/b&gt; .&lt;/p&gt;
                                               &lt;p&gt; The CSI2 setup must be done like this, for TEF82XX front-end BIST data : &lt;br&gt;
                                               &lt;dl&gt;&lt;b&gt;
                                                   &lt;dt&gt;&amp;#9755; Virtual Channel 3              &lt;/dt&gt;
                                                   &lt;dt&gt;&amp;#9755; RAW12 data type                &lt;/dt&gt;
                                                   &lt;dt&gt;&amp;#9755; single data line               &lt;/dt&gt;
                                                   &lt;dt&gt;&amp;#9755; 128 samples for line length    &lt;/dt&gt;
                                                   &lt;dt&gt;&amp;#9755; 4 (four) real channels         &lt;/dt&gt;
                                                   &lt;dt&gt;&amp;#9755; for buffer data pointers :     &lt;/dt&gt;&lt;/b&gt;
                                                    &lt;i&gt;&lt;dd&gt;- this memory address for the first front-end   &lt;/dd&gt;
                                                       &lt;dd&gt;- this memory address + (1024[bytes] * n[follower front-end position, 1...]) for each follower&lt;/i&gt;&lt;/dd&gt;&lt;/dl&gt;
                                                    &lt;/p&gt;
                                          &lt;/html&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>NXP</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      <DEFAULT-VALUE></DEFAULT-VALUE>
                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                </ECUC-STRING-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4132aa47-dfab-b63c-0a95-37f82da2ff0f">
              <SHORT-NAME>CommonPublishedInformation</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                  &lt;/html&gt;</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
