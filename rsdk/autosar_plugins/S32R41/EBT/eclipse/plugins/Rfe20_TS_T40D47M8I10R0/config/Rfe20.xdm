<?xml version='1.0'?>
<datamodel version="3.0"
        xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
        xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
        xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
        xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

<!--
*   @file    Rfe20.xdm
*   @version 0.8.10
*
*   @brief   AUTOSAR Rfe20 - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and Rfe20 plugin.
-->
<!--
====================================================================================================
*   Project              : RTD AUTOSAR 4.7
*   Platform             : CORTEXM
*   Peripheral           : Swt
*   Dependencies         : none
*
*   Autosar Version      : 4.7.0
*   Autosar Revision     : ASR_REL_4_7_REV_0000
*   Autosar Conf.Variant :
*   SW Version           : 0.8.10
*   Build Version        : S32R41_RTD_0_8_4_D2309
*   (c) Copyright 2023 NXP Semiconductors
*   All Rights Reserved.
====================================================================================================
====================================================================================================
====================================================================================================
-->
    <d:ctr type="AUTOSAR" factory="autosar"
                            xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
                            xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
                            xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="TS_T40D47M8I10R0" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:de209b69-853b-2a17-1cdf-eb343e0e1061"/>
                <d:lst type="ELEMENTS">
                    <d:chc name="Rfe20" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="LABEL" value="Rfe20 Driver Code Parameters" />
                            <a:a name="RELEASE" value="asc:4.7"/>
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                            <ad:DATE>2014-10-31</ad:DATE>
                                        </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                    <html>
                                    <h1>Rfe20</h1><p>
                                    Configuration of the Radar Front End Abstract 2.0 module
                                    </p></html>
                                    ]]>
                                </a:v>
                            </a:a>
                            <a:a name="LOWER-MULTIPLICITY" value="1"/>
                            <a:a name="UPPER-MULTIPLICITY" value="*"/>
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                            <a:a name="UUID" value="ECUC:7f3490ca-cdca-3a92-63da-154a3ec8d7cf"/>

                            <!--  @implements   Rfe20General_Object  -->
                            <v:ctr name="Rfe20_General" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                        <html>
                                        <h1>Radar Front End Abstract 2.0</h1><p>
                                        All general parameters of the Radar Front End Abstract 2.0 driver configuration are collected here.
                                        </p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:923b5a1b-a910-5cb0-debf-d98790ead5e8"/>
                                <a:a name="LABEL" value="General Parameters for Radar Front End Abstract 2.0 Driver"/>
                                <a:da name="EDITABLE" value="false" />

                                <!--  @implements   Rfe20DevErrorDetect_Object  -->
                                <v:var name="Rfe20DevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Detection of Development Errors"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                            <html>
                                            <h1>Radar Front End Abstract 2.0 Development Error Detect</h1><p>
                                            Compile switch to enable / disable development error detection for this
                                            module. This reffer mainly to the input parameters check.
                                            <b>True</b>: Development error detection enabled
                                            <b>False</b>: Development error detection disabled
                                            </p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:01dd997e-8256-d46b-7e73-f7b13028e63d"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Rfe20StopAfterErrorReport_Object  -->
                                <v:var name="Rfe20StopAfterErrorReport" type="BOOLEAN">
                                    <a:a name="LABEL" value="Stop Execution After Error Report"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - Stop Execution After Error Report</h1><p>
                                               When this parameter is enabled, the Radar Front End Abstract 2.0 driver will stop execution after Det error report.
                                               The execution will stop in an local infinite loop.
                                          </p>
                                          <p>If this parameter is not ediatable, that means Radar Front End Abstract 2.0 driver can't stop.</p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:f53ddd40-6ae6-2edf-89a2-2aab3612b7c3"/>
                                    <a:a name="READONLY" value="false"/>
                                    <a:da name="DEFAULT" value="false"/>
                                </v:var>

                                <!--  @implements   Rfe20SingleThreadUsed_Object  -->
                                <v:var name="Rfe20SingleThreadUsed" type="BOOLEAN">
                                    <a:a name="LABEL" value="Radar Front End Abstract 2.0 Driver Single Thread Used"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - Thread Usage Definition</h1><p>
                                               This parameter set the number of threads the driver is used. It is recommended to use a single thread.</P>
                                               <P>
                                               <b>True</b>: Single thread used.</P>
                                               <P>
                                               <b>False</b>: Multiple threads used.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:ba56856c-30a0-6e26-987d-da22cae8e675"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!--  @implements   Rfe20VersionInfo_Object  -->
                                <v:var name="Rfe20VersionInfo" type="BOOLEAN">
                                    <a:a name="LABEL" value="Radar Front End Abstract 2.0 Driver Version Info Available"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - Driver Version Info Available</h1><p>
                                               This parameter set the Availability of CDD_Rfe_GetVersionInfo function to the application.</P>
                                               <P>
                                               <b>True</b>: Function available.</P>
                                               <P>
                                               <b>False</b>: Function not available.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:e4ea12c6-22c3-ba28-df95-de47c94e9259"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <!-- implement Rfe20_RfeMode_object, for unit setup parameters -->
                                <v:var name="Rfe20_RfeMode" type="ENUMERATION">
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                            The current working mode for the RFE-Fw side.<br>
                                            Possible usage:<br>
                                            <b>STANDALONE</b>  = Independent Front-End used; for the moment only one Front-End allowed to be managed<br>
                                            <b>CASCADED</b> = Cascaded Front-Ends setup, the limit is the number of the MIPI-CSI2 interfaces available ofr the used platform<br>
                                            </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="RFE-Fw working mode"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="UUID" value="ECUC:7e10204f-99b0-d44e-6e21-e9d8eef61424"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="INVALID" type="XPath" expr="starts-with(node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Resource/ELEMENTS/Resource/ResourceGeneral/ResourceSubderivative), 's32r4')"
                                                false="Only S32R41 platfom allowed" />
                                    <a:da name="RANGE">
                                        <a:v>STANDALONE</a:v>
                                        <a:v>CASCADED</a:v>
                                    </a:da>
                                </v:var>

                                <!--  @implements   Rfe20FeNumber_Object  -->
                                <v:var name="Rfe20FeNumber" type="INTEGER">
                                    <a:a name="LABEL" value="Number of Connected Front-Ends"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - Number of connected Front-Ends</h1><p>
                                               This parameter define the number of connected Front-Ends.</P>
                                               <P>It can be set only for CASCADED mode.
                                          </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:1ae6fdc9-4005-63ca-3ace-1c986e58bd56"/>
                                    <a:da name="DEFAULT" value="2"/>
                                    <a:da name="EDITABLE" type="XPath" expr="node:value(../Rfe20_RfeMode) = 'CASCADED'" />
                                    <a:da name="INVALID" type="XPath" expr="node:value(.) = 2" false="For S32R41 only 2 Front-Ends can be connected in CASCADED mode" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=1"/>
                                        <a:tst expr="&lt;=4"/>
                                    </a:da>

                                </v:var>

                                <!--  @implements   Rfe20FeStateAddress_Object  -->
                                <v:var name="Rfe20FeStateAddress" type="STRING">
                                    <a:a name="LABEL" value="Fw Status - Shared Memory Address"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - the Shared address between API and Firmware : the location of Front-End Status </h1><p>
                                               This parameter define the exact memory address where the Front-End status is saved by the Firmware, to be accessible to the API.</P>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a777ed23-a9e7-bcce-c0bf-a540b6423ca2"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^0[xX][a-fA-F0-9][a-fA-F0-9]*')" 
                                                        false="A valid hexadecimal value to be used, starting with 0x" />
                                </v:var>

                                <!--  @implements   Rfe20FePointerAddress_Object  -->
                                <v:var name="Rfe20FePointerAddress" type="STRING">
                                    <a:a name="LABEL" value="Data Buffer Pointer Location - Shared Memory Address"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - the Shared address between API and Firmware : the location of transfer memory pointer</h1><p>
                                               This parameter define the exact memory address where the Firmware will receive the memory buffer address to use for data transfer.</P>
                                               <p> At interface initialization, this location will be put by API interface with the Shared Memory Buffer address.</p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a22b7bcd-03ec-6319-331e-2894a38dcf79"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^0[xX][a-fA-F0-9][a-fA-F0-9]*')" 
                                                        false="A valid hexadecimal value to be used, starting with 0x" />
                                </v:var>

                                <!--  @implements   Rfe20DataTransferBuffer_Object  -->
                                <v:var name="Rfe20DataTransferBuffer" type="STRING">
                                    <a:a name="LABEL" value="Data Transfer Buffer Address"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - the Data Transfer Buffer</h1><p>
                                               This parameter define the exact memory address where starts the data transfer buffer between API and Firmware.</P>
                                               <p> At interface initialization, this address will be put by API interface in the Data Buffer Pointer Location.</p>
                                               <p> The memory space reserved for data transfer must be at least 544 bytes. It must not be used by any application for other purposes.</p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:b547ef56-4fdb-3fd2-d834-4f955bc81343"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^0[xX][a-fA-F0-9][a-fA-F0-9]*')" 
                                                        false="A valid hexadecimal value to be used, starting with 0x" />
                                </v:var>

                                <!--  @implements   Rfe20BistBuffer_Object  -->
                                <v:var name="Rfe20BistBuffer" type="STRING">
                                    <a:a name="LABEL" value="BIST Buffer Address"/>
                                    <a:a name="DESC">
                                    <a:v>
                                      <![CDATA[EN:
                                          <html>
                                          <h1>Radar Front End Abstract 2.0 - the BIST Buffer</h1><p>
                                               This parameter define the exact memory address where starts the BIST buffer, used by the Firmware to receive the BIST data from the Front-End(s).</P>
                                               <p> This value must be used by the application running on M7_0 core to initialize the CSI2 interface.</p>
                                               <p> The memory space reserved for BIST data transfer must be <br><b>128[samples] * 4[channels] * 2[bytes/sample] * N[front-end(s) used]</b> .</p>
                                               <p> The CSI2 setup must be done like this, for TEF82XX front-end BIST data : <br>
                                               <dl><b>
                                                   <dt>&#9755; Virtual Channel 3              </dt>
                                                   <dt>&#9755; RAW12 data type                </dt>
                                                   <dt>&#9755; single data line               </dt>
                                                   <dt>&#9755; 128 samples for line length    </dt>
                                                   <dt>&#9755; 4 (four) real channels         </dt>
                                                   <dt>&#9755; for buffer data pointers :     </dt></b>
                                                    <i><dd>- this memory address for the first front-end   </dd>
                                                       <dd>- this memory address + (1024[bytes] * n[follower front-end position, 1...]) for each follower</i></dd></dl>
                                                    </p>
                                          </html>
                                      ]]>
                                    </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:ee1a7fd9-f9d9-2b32-6c77-2b8669194028"/>
                                    <a:da name="DEFAULT" value=""/>
                                    <a:da name="INVALID" type="XPath" expr="text:grep( . , '^0[xX][a-fA-F0-9][a-fA-F0-9]*')" 
                                                        false="A valid hexadecimal value to be used, starting with 0x" />
                                </v:var>
                            
                            </v:ctr>


                            <!--  @implements Csi2CommonPublishedInformation_Object  -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                  <a:v><![CDATA[EN: <html>
                                      Common container, aggregated by all modules. It contains published information about vendor and versions.
                                  </html>]]></a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:4132aa47-dfab-b63c-0a95-37f82da2ff0f"/>
                            </v:ctr>
                            <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Csi2"/>
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Csi2_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="UUID" value="ECUC:51d3aba9-23ad-a59a-1fde-b819689399af"/>
                            <a:a name="DEF"
                                 value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                            </d:lst>
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Csi2_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                                value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
                            <d:var name="MODULE_ID" type="INTEGER" >
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="PRE_CONFIGURED_CONF" value="none">
                                <a:a name="READONLY" value="true"/>
                                <a:a name="IMPORTER_INFO" value="@DEF"/>
                            </d:ref>
                            <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                                value="ASPath:/TS_T40D47M9I0R0/Csi2"/>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>
