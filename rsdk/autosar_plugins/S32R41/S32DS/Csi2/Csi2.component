            <struct id="Csi2VCParamsType" label="Defined Virtual Channel Usage">
                <description><![CDATA[<html>The Virtual Channel setup parameters</html>]]>
                </description>
                <quick_selections>
                    <quick_selection id="Csi2VCParamsTypeDefault" label="Default Values" available="true">
                        <set id="Csi2VCParamsName">SetupParam_x_Params_VC_y</set>
                        <set id="Csi2VcStreamType">CSI2_DATA_TYPE_RAW16</set>
                        <set id="Csi2VcChannels">4</set>
                        <set id="Csi2VcNumSamples">256</set>
                        <set id="Csi2VcNumChirps">512</set>
                        <set id="Csi2BufResetType">CSI2_BUF_RESET_NO</set>
                        <set id="Csi2VcOutputMode">CSI2_VC_BUF_OUT_ILEAVED</set>
                        <set id="Csi2VcOutputComplex">false</set>
                        <set id="Csi2VcOutputFlip">false</set>

                    </quick_selection>
                </quick_selections>

                <string id="Csi2VCParamsName" label="Variable Identifier">
                    <description>The name of the variable to be used in the generated .c file.</description>
                    <validation>
                        <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue())) &amp;&amp; $this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, $this.getValue(), `SetupParam_`)"
                        level="error" description="Name must be a valid C identifier and must start with 'VC_' !"/>
                        <constraint cond_expr="countOccurrences(($parent.getParent()), x -&gt; (x.getSetting(`Csi2VCParamsName`).getValue() == $this.value())) == 1" level="error" description="Duplicated value&#44; Csi2VCParamsName must be unique across all Virtual Channels."/>
                    </validation>
                </string>

