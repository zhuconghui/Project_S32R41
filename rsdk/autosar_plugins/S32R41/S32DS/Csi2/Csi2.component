                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </integer>

                <!-- object Csi2VcStreamType  -->
                <dynamic_enum id="Csi2VcStreamType" label="Received Data Type" items="toArray(`CSI2_DATA_TYPE_EMBD`,
                                                                                              `CSI2_DATA_TYPE_YUV422_8`,
                                                                                              `CSI2_DATA_TYPE_YUV422_10`,
                                                                                              `CSI2_DATA_TYPE_RGB565`,
                                                                                              `CSI2_DATA_TYPE_RGB888`,
                                                                                              `CSI2_DATA_TYPE_RAW8`,
                                                                                              `CSI2_DATA_TYPE_RAW10`,
                                                                                              `CSI2_DATA_TYPE_RAW12`,
                                                                                              `CSI2_DATA_TYPE_RAW14`,
                                                                                              `CSI2_DATA_TYPE_RAW16`,
                                                                                              `CSI2_DATA_TYPE_USR0`,
                                                                                              `CSI2_DATA_TYPE_USR1`,
                                                                                              `CSI2_DATA_TYPE_USR2`,
                                                                                              `CSI2_DATA_TYPE_USR3`,
                                                                                              `CSI2_DATA_TYPE_USR4`,
