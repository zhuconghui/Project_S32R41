                <integer id="Csi2VcNumber" label="The Virtual Channel used" type="uint32_t" min_expr="0"  max_expr="3">
                    <description><![CDATA[<html>The Virtual Channel number used to receive data for this set of parameters</html>]]>
                    </description>
                    <validation>
                        <constraint cond_expr="countOccurrences(($parent.getParent()), x -&gt; (x.getSetting(`Csi2VcNumber`).getValue() == $this.value())) == 1" level="error" description="Duplicated value&#44; Csi2VcNumber must be unique across all Virtual Channels."/>
                    </validation>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                        <option id="postBuildVariantValue" expr="false"/>
