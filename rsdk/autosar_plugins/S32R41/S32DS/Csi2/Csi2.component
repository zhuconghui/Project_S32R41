                <!-- Virtual Channel buffer definitions -->
                <struct id="Csi2VcDataBuffer" label="Memory Buffer Parameters">
                    <description>
                        <![CDATA[<html>Necessary parameters for the memory buffer used to receive CSI2 data. </html> ]]>
                    </description>

                    <!-- object Csi2VcBufNumLines  -->
                    <integer id="Csi2VcBufNumLines" label="Number of Lines in the Memory Buffer" type="uint32_t" min_expr="1"  max_expr="2048">
                        <description><![CDATA[<html>The number of the lines available in the memory buffer.
                                    The total memory reserved for CSI2 data must be :
                                    <b>NUM_LINES * (NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA)</b>
                                    For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits.
                                    The received data will be put into the memory using the memory buffer lines as a cicular buffer of lines. </html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="2"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </integer>

                    <!-- object Csi2VcBufLineLen  -->
                    <integer id="Csi2VcBufLineLen" label="The Length of a Memory Buffer Line" type="uint32_t" min_expr="1"  max_expr="65535">
                        <description><![CDATA[<html>The length of a memory buffer line.
                            The lenth of a buffer line must be at least the length of the data to be put in memory for a chirp. It could be bigger. The necessary amount of memory for a buffer line is :
                            <b>(NUM_CHRPS * (NUM_SAMPLES * NUM_CHANNELS) * BUF_SAMPLE_LEN + STATISTICS_DATA</b>
                            For some data the input data length is different than the buffer data len. Ex. : for RAW12, the input is 12 bits, but the output is 16 bits. </html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="4096"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </integer>

                    <!-- object Csi2VcBufMemPointer  -->
                    <string id="Csi2VcBufMemPointer" label="The Symbolic Name of the Buffer Pointer" available="true">
                        <description><![CDATA[<html>The name of the pointer which is initialized with the start memory address of the buffer data.
                                    As C code, if the specified name is 'pBufData', it must be initialized like :
                                    uint8_t *pBufData;<br>
                                    pBufData = {start_memory_address}
                                    The {start_memory_address} must be a valid physically address. </html> ]]></description>
                        <validation>
                            <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue()))" level="error" description="Name must be a valid C identifier!"/>
                        </validation>
                        <options_expr>
                            <option id="type" expr="`STRING`"/>
                            <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="SYNC_VALUE"/>
                            <option id="postBuildVariantValue" expr="true"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`bufPtrVc`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </string>

                </struct>  <!-- Virtual Channel buffer definitions : Csi2VcDataBuffer -->

