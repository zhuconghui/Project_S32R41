                <integer id="Csi2VcNumSamples" label="Used Number of samples" type="uint32_t" min_expr="1"  max_expr="8192">
                    <description><![CDATA[<html>The number of samples per channel/antenna to be received in a chirp.
                                                        If Auxiliary Data is used, this number must be the effective value to be received into the data buffer line, without the Auxiliary Data.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="true"/>
                        <option id="defaultValue" expr="256"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </integer>

                <!-- object Csi2VcNumChirps  -->
                <integer id="Csi2VcNumChirps" label="Used Number of chirps" type="uint32_t" min_expr="1"  max_expr="2000">
                    <description><![CDATA[<html>The number of chirps to be received in a frame.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="true"/>
                        <option id="defaultValue" expr="512"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </integer>

                <!-- object Csi2BufResetType  -->
                <dynamic_enum id="Csi2BufResetType" label="Buffer Pointer Reset Type" items="toArray(`CSI2_BUF_RESET_NO`,
                                                                                              `CSI2_BUF_RESET_FS`)" >
                    <description><![CDATA[<html>Select the buffer reset metthod at the end of the frame.
                            <b>CSI2_BUF_RESET_NO</b> = the buffer pointer is not reset, the first data line of the next frame will be put after the last line of the previous frame,
                            <b>CSI2_BUF_RESET_FS</b> = always the first line/chirp of the frame will be put in the first line of the buffer</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`CSI2_BUF_RESET_NO`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <!-- object Csi2VcOutputMode  -->
                <dynamic_enum id="Csi2VcOutputMode" label="Buffer Data Output Template" items="toArray(`CSI2_VC_BUF_OUT_ILEAVED`,
                                                                                              `CSI2_VC_BUF_OUT_TILE8`,
                                                                                              `CSI2_VC_BUF_OUT_TILE16`)" >
                    <description><![CDATA[<html>Select the output data template.
                            <b>CSI2_VC_BUF_OUT_ILEAVED</b> = data is put in the buffer as received
                            <b>CSI2_VC_BUF_OUT_TILE8</b>   = for each channel eight samples are put together, the buffer will receive data as :
                                chA_0, chA_1,..., chA_7, chB_0, chB_1,..., chB_7,..., chA_8, chA_9,.., chA_15, chB_8, chB_9,..., chB_15, ...
                            <b>CSI2_VC_BUF_OUT_TILE16</b>   = for each channel sixteen samples are put together, the buffer will receive data as :
                                chA_0, chA_1,..., chA_15, chB_0, chB_1,..., chB_15,..., chA_16, chA_17,.., chA_31, chB_16, chB_17,..., chB_31, ...</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`CSI2_VC_BUF_OUT_ILEAVED`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <!-- object Csi2VcOutputComplex  -->
                <bool id="Csi2VcOutputComplex" label="Complex ADC Data output" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>The type of the data to receive, real/complex.
                                    If complex data to be received, the specified number of channes will be multipled by 2.
                                    Ex.: if 4 channels specified and complex data to receive, in the data flow will be considered 8 different channels.
                                    <b>FALSE</b> : Real data will be received
                                    <b>TRUE </b> : Complex data will be received </html> ]]>
                    </description>
                    <options_expr>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2VcOutputFlip  -->
                <bool id="Csi2VcOutputFlip" label="Flip Received Data Sign" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Specify if the sign of the received data will be flipped or not.
                                    This can be applied to the data types for which the length of the received data is less than the lenght of the data put in the memory buffer.
                                    <b>FALSE</b> : The data received will have only sign extension
                                    <b>TRUE </b> : The sign of the received data will be flipped </html> ]]>
                    </description>
                    <options_expr>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

