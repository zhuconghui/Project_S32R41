<?xml version="1.0" encoding= "UTF-8" ?>
<component:config_component id="Csi2" label="Csi2" global_only="false" xsi:schemaLocation="http://swtools.freescale.net/XSD/component/1.0 http://swtools.freescale.net/XSD/component/1.0/component-8.0.xsd" xmlns:component="http://swtools.freescale.net/XSD/component/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" category="driver" max_instances="1" >

<sw_comp_ref name="platform.driver.csi2" version="0.8.10"/>

    <description>Csi2 Driver Configuration</description>
    <mode id="ip" label="CSI2 Module" available="true">
        <description>Csi2 Driver Module Name, not used</description>
        <config_set_refs>
            <config_set_ref>Csi2</config_set_ref>
        </config_set_refs>
    </mode>


    <config_set id="Csi2" label="CSI2" public="true" options="ShowContentAs=Tabs;UI_LABEL_HIDDEN;UI_BORDER_HIDDEN">
        <description>Configuration of the Csi2 module.</description>
        <quick_selections>
            <quick_selection id="Csi2Default" label="Default Values" available="true">
                <set id="Name">Csi2</set>
                <set id="Csi2GeneralConfiguration.Csi2DevErrorDetect">false</set>
                <set id="Csi2GeneralConfiguration.Csi2StopAfterErrorReport">true</set>
                <set id="Csi2GeneralConfiguration.Csi2SingleThreadUsed">true</set>
                <set id="Csi2GeneralConfiguration.Csi2VersionInfo">false</set>
                <set id="Csi2GeneralConfiguration.Csi2StatisticDataUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2HeaderDataUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2FooterDataUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2DcAutoCompensation">false</set>
                <set id="Csi2GeneralConfiguration.Csi2AuxiliaryDataUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2MetaDataUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2SingleCallbackUsage">true</set>
                <set id="Csi2GeneralConfiguration.Csi2RxStartStopUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PowerOnOffUsage">true</set>
                <set id="Csi2GeneralConfiguration.Csi2InterfaceFunctionsUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2FramesCounterUsage">true</set>
                <set id="Csi2GeneralConfiguration.Csi2GPIOUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2SDMAUsage">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PhyUsageSaf85">false</set>
                <set id="Csi2GeneralConfiguration.Csi2Rfe20Usage">true</set>
                <set id="Csi2GeneralConfiguration.Csi2OsIfTimerUsage">OSIF_COUNTER_DUMMY</set>
                <set id="Csi2GeneralConfiguration.Csi2PinsSwapClock">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PinsSwapLane0">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PinsSwapLane1">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PinsSwapLane2">false</set>
                <set id="Csi2GeneralConfiguration.Csi2PinsSwapLane3">false</set>
                <set id="Csi2GeneralConfiguration.Csi2CallbackSetup.Csi2SingleCallbackName">Csi2_SingleIsrCallback</set>
                <set id="Csi2GeneralConfiguration.Csi2CallbackSetup.Csi2PhyErrorCallbackName">Csi2_PhyIsrCallbackUnit</set>
                <set id="Csi2GeneralConfiguration.Csi2CallbackSetup.Csi2PcktErrorCallbackName">Csi2_PcktIsrCallbackUnit</set>
                <set id="Csi2GeneralConfiguration.Csi2CallbackSetup.Csi2EvtErrorCallbackName">Csi2_EvtIsrCallbackUnit</set>

             </quick_selection>
            <default>Default</default>
        </quick_selections>

        <settings>
            <variable value="`../Csi2/csi2_codegenerator.js`" id="codegen_file"></variable>
            <variable value="`Csi2_CodeGenerator`" id="codegen_class"></variable>
            <variable value="`true`" id="generate_templates"></variable>
            <variable value="toArray(`CSI2`)" id="used_peripherals" />
            <variable value="$this.getMode()" id="mode"/>
            <variable value="$this" id="rootNode"/>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2GetPlatform`, getPartNumber())" id="PlatformName"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, getPartNumber(), `S32R41`)" id="Is_S32R41"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, getPartNumber(), `SAF8`)" id="Is_STRX"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, getPartNumber(), `SAF85`)" id="Is_OneChip"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, getPartNumber(), `SAF86`)" id="Is_Remote"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, getPartNumber(), `SAF86`)" id="Use_Single_Callback"></variable>
            <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `GetNumLanes`, $configSet.Csi2SpecificConfiguration.Csi2DriverMainContainer)" id="NumRxLanes"></variable>
            <variable value="get(get(system::getParent($this, 1),15),8).getValue()" id="Is_AutoDCSelected"></variable>
            <variable value="false" id="DebugMode"></variable>

            <struct id="Csi2GeneralConfiguration" label="Compile Parameters">
                <description>
                    This container contains the global configuration parameters of the RadarSDK CSI2 driver.
                </description>
                <quick_selections>
                    <quick_selection id="Csi2GeneralConfigDefault" label="Default Values" available="true">
                        <set id="Csi2DevErrorDetect">false</set>
                        <set id="Csi2StopAfterErrorReport">true</set>
                        <set id="Csi2SingleThreadUsed">true</set>
                        <set id="Csi2VersionInfo">false</set>
                        <set id="Csi2StatisticDataUsage">false</set>
                        <set id="Csi2HeaderDataUsage">false</set>
                        <set id="Csi2FooterDataUsage">false</set>
                        <set id="Csi2DcAutoCompensation">false</set>
                        <set id="Csi2AuxiliaryDataUsage">false</set>
                        <set id="Csi2MetaDataUsage">false</set>
                        <set id="Csi2SingleCallbackUsage">true</set>
                        <set id="Csi2RxStartStopUsage">false</set>
                        <set id="Csi2PowerOnOffUsage">true</set>
                        <set id="Csi2InterfaceFunctionsUsage">false</set>
                        <set id="Csi2FramesCounterUsage">true</set>
                        <set id="Csi2GPIOUsage">false</set>
                        <set id="Csi2SDMAUsage">false</set>
                        <set id="Csi2PhyUsageSaf85">false</set>
                        <set id="Csi2Rfe20Usage">true</set>
                        <set id="Csi2OsIfTimerUsage">OSIF_COUNTER_DUMMY</set>
                        <set id="Csi2PinsSwapClock">false</set>
                        <set id="Csi2PinsSwapLane0">false</set>
                        <set id="Csi2PinsSwapLane1">false</set>
                        <set id="Csi2PinsSwapLane2">false</set>
                        <set id="Csi2PinsSwapLane3">false</set>
                        <set id="Csi2CallbackSetup.Csi2SingleCallbackName">Csi2_SingleIsrCallback</set>
                        <set id="Csi2CallbackSetup.Csi2PhyErrorCallbackName">Csi2_PhyIsrCallbackUnit</set>
                        <set id="Csi2CallbackSetup.Csi2PcktErrorCallbackName">Csi2_PcktIsrCallbackUnit</set>
                        <set id="Csi2CallbackSetup.Csi2EvtErrorCallbackName">Csi2_EvtIsrCallbackUnit</set>

                    </quick_selection>
                    <default>Default</default>
                </quick_selections>

                <info id="DebugInfo" label="Debug Info" available="($configSet.DebugMode.getValue())"
                    value="$configSet.NumRxLanes.getValue()" >
                    <description>User defined debug data to be shown.--</description>
                    <options_expr>
                        <option id="type" expr="`STRING`"/>
                        <option id="UUID" expr="`ECUC:dafa241d-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`PORT_PIN_HIGH_Z`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </info>


                <!-- object Csi2DevErrorDetect  -->
                <bool id="Csi2DevErrorDetect" label="Detect Development Errors" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to enable or disable the errors at development time
                        <b>TRUE</b> = the development errors will be checked and reported
                        <b>FALSE</b> = the development errors will not be checked, usually this means the parameters will not be checked for correctness </html> ]]>
                    </description>
                    <options_expr>
                        <!-- option id="type" expr="`BOOL`"/ -->
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2StopAfterErrorReport  -->
                <bool id="Csi2StopAfterErrorReport" label="Stop After Error Report" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to define the code execution after an error was reported
                        <b>TRUE</b> = the execution will stop after error was reported, in an endless loop
                        <b>FALSE</b> = the execution will continue after error reporting</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`true`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2SingleThreadUsed  -->
                <bool id="Csi2SingleThreadUsed" label="A Single Thread is Used" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to specify if the application is using a single or multiple threads to manage Csi2 driver.
                        <b>TRUE</b> = single thread used, so no necessary to use exclusive area functions
                        <b>FALSE</b> = multiple threads used, so is necessary to use exclusive area functions</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`true`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2VersionInfo  -->
                <bool id="Csi2VersionInfo" label="Provide Version Info" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to specify if the Version Info will be available to application.
                        <b>TRUE</b> = Version Info provided, the function Csi2_GetVersionInfo is available
                        <b>FALSE</b> = Version Info not provided</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2StatisticDataUsage  -->
                <bool id="Csi2StatisticDataUsage" label="Use the Statistical Data" available="true" >
                    <description>
                        <![CDATA[<html>Parameter to specify if the Statistical data provided by the interface will be provided.
                        To receive this data, the chirp line buffer must be upgraded with 80 supplimentary bytes, to receive the statistical data after each chirp. This will affect all used Virtual Channels and Data Type used.
                        The statistical data content consist, for each analog channel :
                        - sum of all samples in the chirp
                        - min, max ADC channel value in the chirp
                        - bit toggle
                        To activate the 'Automatic channel DC compensation' feature, this parametr must be set to TRUE.
                        <b>TRUE</b> = Statistica Data added at the end of the chirp
                        <b>FALSE</b> = Statistical Data not provided</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2HeaderDataUsage  -->
                <bool id="Csi2HeaderDataUsage" label="Header Data Usage" available="($configSet.Is_OneChip.getValue())">
                    <description>
                        <![CDATA[<html>Parameter to specify if the Header statistical data will be provided. The data is added at the end of each chirp.
                        For this another 16 bytes of data must be provided at the end of the chirp data. This parameter/buffer usage is not related to Statistical data.
                        The requests for Header/Footer data are independent, both are using the same 16 bytes space.
                        This feature is available only for SAF85XX, Please read the RM for the provided data usage.
                        <b>TRUE</b> = Header Data added at the end of the chirp
                        <b>FALSE</b> = Header Data not provided</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2FooterDataUsage  -->
                <bool id="Csi2FooterDataUsage" label="Footer Data Usage" available="($configSet.Is_OneChip.getValue())">
                    <description>
                        <![CDATA[<html>Parameter to specify if the Footer statistical data will be provided. The data is added at the end of each chirp.
                        For this another 16 bytes of data must be provided at the end of the chirp data. This parameter/buffer usage is not related to Statistical data.
                        The requests for Header/Footer data are independent, both are using the same 16 bytes space.
                        This feature is available only for SAF85XX, Please read the RM for the provided data usage.
                        <b>TRUE</b> = Footer Data added at the end of the chirp
                        <b>FALSE</b> = Footer Data not provided</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2DcAutoCompensation  -->
                <bool id="Csi2DcAutoCompensation" label="Automatic DC Compensation Usage" available="get(system::getParent($this,1),5).getValue()">
                    <description>
                        <![CDATA[<html>Parameter to specify if the driver will implement the automatic DC compensation.
                        This parameter is available only if the 'Statistical data' is enabled. The real usage will be defined later for each Virtual Channel used.
                        <b>TRUE</b> = Auto DC compensation to be used
                        <b>FALSE</b> = Auto DC compensation not to be used</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2AuxiliaryDataUsage  -->
                <bool id="Csi2AuxiliaryDataUsage" label="Auxiliary Data Usage" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to specify if the Auxiliary Data feature will be used for data reception.
                        Please read the RadarSDK User Manual and Reference Manual to understand how the ADC data flow is split for radar data and auxiliary data.
                        <b>TRUE</b> = Auxiliary Data to be used
                        <b>FALSE</b> = Auxiliary Data not to be used</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2MetaDataUsage  -->
                <bool id="Csi2MetaDataUsage" label="Metadata Data Usage" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to specify if the Metadata Data feature will be used for data reception.
                        Please read the RadarSDK User Manual to understand how the Metadata can be received and handled.
                        <b>TRUE</b> = Metadata Data to be used
                        <b>FALSE</b> = Metadata Data not to be used</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2SingleCallbackUsage  -->
                <bool id="Csi2SingleCallbackUsage" label="Single Callback Usage" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to set the usage of the callbacks.
                        <b>TRUE</b>: A single callback is used for all three Csi2 interrupts.
                        <b>FALSE</b>: Three different callbacks to be used :
                        the "first two" for error reporting, the "third" for events reporting.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2RxStartStopUsage  -->
                <bool id="Csi2RxStartStopUsage" label="Rx Start/Stop Functions Usage" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to set the usage of the Csi2_RxStop and Csi2_RxStart functions.
                        <b>TRUE</b>: The functions to be available to be used.</P>
                        <b>FALSE</b>: The functions will not be used and for this reason will be removed from the code files at compile time.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`false`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <!-- object Csi2PowerOnOffUsage  -->
                <bool id="Csi2PowerOnOffUsage" label="Power On/Off Functions Usage" available="system::hasExclusiveOwnership(`CSI2`, $group)">
                    <description>
                        <![CDATA[<html>Parameter to set the usage of the Csi2_PowerOn and Csi2_PowerOff functions.
                        <b>TRUE</b>: The functions to be available to be used.</P>
                        <b>FALSE</b>: The functions will not be used and for this reason will be removed from the code files at compile time.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`BOOLEAN`"/>
                        <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c8285559c370`"/>
                        <option id="postBuildVariantValue" expr="false"/>
