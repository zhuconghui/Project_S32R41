                <integer id="Csi2VcChannels" label="Used Number of ADC channels" type="uint32_t" min_expr="1"  max_expr="4">
                    <description><![CDATA[<html>The number of analog channels used for this flow. Usually this is the number of antennas.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
