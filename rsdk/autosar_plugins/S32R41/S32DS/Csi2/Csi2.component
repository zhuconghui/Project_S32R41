            <!-- type structure for CSI2 unit setup -->
            <struct id="Csi2DriverParamsType">
                <variable value="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2GetSetupParamsName`, system::getParent($this,1).getID())" id="ParamsName"></variable>
                <quick_selections>
                    <quick_selection id="Csi2DriverParamsTypeDefault" label="Default Values" available="true">
                        <set id="Csi2DriverParamsName">Csi2SetupParamsList_</set>
                        <set id="Csi2RxFrequency">"$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2MinFreq`, getPartNumber()).toInt()"</set>
                        <set id="Csi2NumLanesRx">Two___lanes</set>
                        <set id="Csi2UnitInitOptions">CSI2_DPHY_INIT_SHORT_CALIB</set>
                    </quick_selection>
                </quick_selections>

                <string id="Csi2DriverParamsName" label="Variable Identifier">
                    <description>The name of the variable to be used in the generated .c file.</description>
                    <validation>
                        <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue())) &amp;&amp; $this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2IsPlatformMatch`, $this.getValue(), `Csi2SetupParamsList_`)"
                        level="error" description="Name must be a valid C identifier and must start with 'Csi2SetupParamsList_' !"/>
                        <constraint cond_expr="countOccurrences(($parent.getParent()), x -&gt; (x.getSetting(`Csi2DriverParamsName`).getValue() == $this.value())) == 1" level="error" description="Duplicated value&#44; Csi2DriverParamsName must be unique across all CSI2 units parameters."/>
                    </validation>
                </string>

                <!-- object Csi2RxFrequency  -->
                <integer id="Csi2RxFrequency" label="Clock Frequency [MHz]" type="uint32_t" min_expr="$this.execScriptFunction(`../Csi2/csi2_utils.js`, `Csi2MinFreq`, getPartNumber()).toInt()"
                            max_expr="2500">
                    <description><![CDATA[<html>The input clock frequency of the MIPI-CSI2 unit for the current setup.
                        The value is specified in MHz/Mbps.
                        For SAFxx chips, for internal path, 0 (zero) value must be used.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="true"/>
                        <option id="defaultValue" expr="`2`"/>
                        <option id="min" expr="1"/>
                        <option id="max" expr="181"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="($configSet.Is_OneChip.getValue() &amp;&amp;
                        ((get(get(system::getParent($this,4),15),18).getValue() &amp;&amp; ($this.getValue() != 0)) ||
                        ((get(get(system::getParent($this,4),15),18).getValue() == `false`) &amp;&amp; ($this.getValue() == 0)))) ||
                        ($configSet.Is_S32R41.getValue() &amp;&amp; ($this.getValue() != 0))"
                        level="error" description="Only two lanes can be used by the SAF85 chips"/>
                    </validation>
                </integer>

                <!-- object Csi2NumLanesRx  -->
                <dynamic_enum id="Csi2NumLanesRx" label="The used number for Rx lanes" items="toArray(`One___lane`,`Two___lanes`,`Three_lanes`,`Four__lanes`)"
                        available="$configSet.Is_S32R41.getValue() || ($configSet.Is_OneChip.getValue() &amp;&amp; $configSet.Csi2GeneralConfiguration.Csi2PhyUsageSaf85.getValue())">
                    <description><![CDATA[<html> The number of lanes used to receive data. This parameter is used only for CSI2-PHY setup.
                        Possible usage:
                        <b>One___lane</b>  = only one lane
                        <b>Two___lanes</b> = two lanes
                        <b>Three_lanes</b> = three lanes
                        <b>Four__lanes</b> = four lanes</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`Two___lanes`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="($configSet.Is_OneChip.getValue() &amp;&amp; (($this.getValue() == `One___lane`) || ($this.getValue() == `Two___lanes`))) ||
                        $configSet.Is_S32R41.getValue()" level="error" description="Only two lanes can be used by the SAF85 chips"/>
                    </validation>
                </dynamic_enum>

                <!-- lanes mapping -->
                <struct id="Csi2LanesMapping" label="The real mapping of the input lanes" available="$configSet.Is_S32R41.getValue() || ($configSet.Is_OneChip.getValue() &amp;&amp; $configSet.Csi2GeneralConfiguration.Csi2PhyUsageSaf85.getValue())">
                    <quick_selections>
                        <quick_selection id="Csi2LanesMappingDefault" label="Default Values" available="true">
                            <set id="Csi2Lane1Mapping">1</set>
                            <set id="Csi2Lane2Mapping">2</set>
                            <set id="Csi2Lane3Mapping">3</set>
                            <set id="Csi2Lane4Mapping">4</set>
                        </quick_selection>
                    </quick_selections>
                    <validation>
                        <constraint cond_expr="true" level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                    </validation>

                    <!-- object Csi2Lane1Mapping  -->
                    <integer id="Csi2Lane1Mapping" label="Real Lane_1 Mapping" type="uint32_t" min_expr="1"  max_expr="4">
                        <description><![CDATA[<html>The Tx output lane connected to Rx lane 1</html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="1"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                        <validation>
                            <constraint cond_expr="$this.getValue() &lt;= size($this.execScriptFunction(`../Csi2/csi2_utils.js`, `GetNumLanes`, get(system::getParent($this,2), 3).getValue()))" level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                        </validation>
                    </integer>

                    <!-- object Csi2Lane2Mapping  -->
                    <integer id="Csi2Lane2Mapping" label="Real Lane_2 Mapping" type="uint32_t" min_expr="1"  max_expr="4"
                            available="(get(system::getParent($this,2), 3).getValue() == `Four__lanes`) || (get(system::getParent($this,2), 3).getValue() == `Three_lanes`)
                                || (get(system::getParent($this,2), 3).getValue() == `Two___lanes`)">
                        <description><![CDATA[<html>The Tx output lane connected to Rx lane 2</html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="2"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                        <validation>
                            <constraint cond_expr="$this.getValue() &lt;= size($this.execScriptFunction(`../Csi2/csi2_utils.js`, `GetNumLanes`, get(system::getParent($this,2), 3).getValue()))" level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                            <constraint cond_expr="( ($this.isAvailable()) &amp;&amp;
                                (get(system::getParent($this,1),0).getValue() == $this.getValue() )) != `true`"
                            level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                        </validation>
                    </integer>

                    <!-- object Csi2Lane3Mapping  -->
                    <integer id="Csi2Lane3Mapping" label="Real Lane_3 Mapping" type="uint32_t" min_expr="1"  max_expr="4"
                            available="(get(system::getParent($this,2), 3).getValue() == `Four__lanes`) || (get(system::getParent($this,2), 3).getValue() == `Three_lanes`)">
                        <description><![CDATA[<html>The Tx output lane connected to Rx lane 3</html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="3"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                        <validation>
                            <constraint cond_expr="$this.getValue() &lt;= size($this.execScriptFunction(`../Csi2/csi2_utils.js`, `GetNumLanes`, get(system::getParent($this,2), 3).getValue()))" level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                            <constraint cond_expr="( ($this.isAvailable()) &amp;&amp;
                                ((get(system::getParent($this,1),0).getValue() == $this.getValue()) ||
                                 (get(system::getParent($this,1),1).getValue() == $this.getValue()) )) != `true`"
                            level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                        </validation>
                    </integer>

                    <!-- object Csi2Lane4Mapping  -->
                    <integer id="Csi2Lane4Mapping" label="Real Lane_4 Mapping" type="uint32_t" min_expr="1"  max_expr="4"
                            available="get(system::getParent($this,2), 3).getValue() == `Four__lanes`">
                        <description><![CDATA[<html>The Tx output lane connected to Rx lane 4</html>]]>
                        </description>
                        <options_expr>
                            <option id="type" expr="`INTEGER`"/>
                            <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6f11`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`AUTOSAR_ECUC`"/>
                            <option id="symbolicNameValue" expr="true"/>
                            <option id="defaultValue" expr="3"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                        <validation>
                            <constraint cond_expr="$this.getValue() &lt;= size($this.execScriptFunction(`../Csi2/csi2_utils.js`, `GetNumLanes`, get(system::getParent($this,2), 3).getValue()))" level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                            <constraint cond_expr="( ($this.isAvailable()) &amp;&amp;
                                ((get(system::getParent($this,1),0).getValue() == $this.getValue()) ||
                                 (get(system::getParent($this,1),1).getValue() == $this.getValue()) ||
                                 (get(system::getParent($this,1),2).getValue() == $this.getValue()) )) != `true`"
                            level="error" description="There are some duplicated lanes or conflicts in the Csi2LanesMapping"/>
                        </validation>
                    </integer>

                </struct>

                <!-- object Csi2UnitInitOptions  -->
                <dynamic_enum id="Csi2UnitInitOptions" label="DPHY Init Options" items="toArray(`CSI2_DPHY_INIT_SIMPLE`,
                                                                                                `CSI2_DPHY_INIT_SHORT_CALIB`,
                                                                                                `CSI2_DPHY_INIT_W_STOP_STATE`,
                                                                                                `CSI2_DPHY_INIT_SHORT_AND_STOP`)"
                        available="$configSet.Is_S32R41.getValue() || ($configSet.Is_OneChip.getValue() &amp;&amp; $configSet.Csi2GeneralConfiguration.Csi2PhyUsageSaf85.getValue())">
                    <description><![CDATA[<html>The possible initialization options for the CSI2 unit:
                                                <b>CSI2_DPHY_INIT_SIMPLE</b> : simple calibration, with hardware reset but STOP state possible not achieved on the lanes
                                                <b>CSI2_DPHY_INIT_SHORT_CALIB</b> : the shortest calibration, using the previous PHY values and STOP state not tested/achieved
                                                <b>CSI2_DPHY_INIT_W_STOP_STATE</b> : hardware reset used and STOP state not tested/achieved
                                                <b>CSI2_DPHY_INIT_SHORT_AND_STOP</b> : previous PHY values used and STOP state achieved
                                                Using previous PHY values reduce the initialization time to around 100-200 us.
                                                The time linit to wait for the STOP state on the lanes is set to 1.2 ms.
                                                If the stop state is not achieved in this time period, the initialization will fail.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`CSI2_DPHY_INIT_SHORT_CALIB`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <!-- object Csi2StatisticsImplOptions  -->
                <dynamic_enum id="Csi2StatisticsImplOptions" label="Statistics Usage Implementation" items="toArray(`CSI2_AUTODC_NO`,
                                                                                                `CSI2_AUTODC_EVERY_LINE`,
                                                                                                `CSI2_AUTODC_AT_FE`,
                                                                                                `CSI2_AUTODC_LAST_LINE`)"
                                available="$configSet.Is_AutoDCSelected.getValue()">
                    <description><![CDATA[<html>The possible automatic DC compensation computation.
                                                As the statistic data is reported after each chirp, this parameter defines how often the data is processed, as the data processing is done inside the events interrupt handler.
                                                <b>CSI2_AUTODC_NO</b> : auto DC compensation not done, no computation to be done
                                                <b>CSI2_AUTODC_EVERY_LINE</b> : auto DC compensation using all statistics received
                                                <b>CSI2_AUTODC_AT_FE</b> : auto DC compensation done at the end of the frame (only once) using the statistics from all lines/chirps in the receiving buffer
                                                <b>CSI2_AUTODC_LAST_LINE</b> : auto DC compensation done at the end of the frame (only once) using the statistics only from the last received line/chirp</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0464317`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`CSI2_AUTODC_NO`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <!-- the array of the Virtual Channels to be defined -->
                <array id="Csi2DriverVCContainer" type="Csi2VCParamsType" label="All CSI2 VC Params" options="ShowContentAs=MasterDetail;UI_BORDER_HIDDEN" min_expr="1" max_expr="4"
                            key_selector_expr="x -> x.getID()">
                    <description>Container collecting the CSI2 Virtual Channel setup defined parameters.</description>
                    <validation>
                        <constraint cond_expr="$this.findDuplicates(item -&gt; item.getSetting(`Name`).value()).length() == 0" level="error" description="There are some duplicated 'Name' in the Defined CSI2 Configurations Container"/>
                    </validation>
                    <item_defaults>
                        <set_default id="Csi2VCParamsName" value_expr="x -&gt; `SetupParam_` + system::getParent($this,1).getID() + `_Params_VC_` + x.getID()"/>
                        <set_default id="Csi2VcNumber" value_expr="x -&gt; x.getID()"/>
                        <set_default id="Csi2VcStreamType" value_expr="x -&gt; (`CSI2_DATA_TYPE_RAW16`)"/>
                        <set_default id="Csi2VcDataBuffer.Csi2VcBufMemPointer" value_expr="x -&gt; `bufData_` + system::getParent($this,1).getID() + `_` + x.getID() + `_VcPtr`"/>
                        <set_default id="Csi2VcMetadataSetup.Csi2VcMetadataBufMemPointer" value_expr="x -&gt; `bufData_` + system::getParent($this,1).getID() + `_` + x.getID() + `_MetaPtr`"/>
                        <set_default id="Csi2VcAuxiliaryDataSetup.Csi2VcAuxDataBufMemPointer" value_expr="x -&gt; `bufData_` + system::getParent($this,1).getID() + `_` + x.getID() + `_AuxPtr`"/>

                    </item_defaults>
                    <options_expr>
                        <option id="type" expr="`CONTAINER`"/>
                        <option id="UUID" expr="`ECUC:66380587-564d-45f3-bada-0475671e8218`"/>
                        <option id="lowerMultiplicity" expr="1"/>
                        <option id="upperMultiplicityInfinite" expr="1"/>
                        <option id="postBuildVariantMultiplicity" expr="false"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </array>

            </struct>  <!-- type structure for CSI2 unit setup : struct id="Csi2DriverParamsType" -->

