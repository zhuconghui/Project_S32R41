                        <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue())) &amp;&amp; $this.execScriptFunction(`../Cte/cte_utils.js`, `CteIsPlatformMatch`, $this.getValue(), `timeTable_`)"
                        level="error" description="Name must be a valid C identifier and must start with 'timeTable_' !"/>
                        <constraint cond_expr="countOccurrences(($parent.getParent()), x -> (x.getSetting(`CteTimeTableConfigName`).getValue() == $this.value())) == 1" level="error" description="Duplicated value&#44; `Time Table Name` must be unique across all CTE configurations."/>
                    </validation>
                </string>

