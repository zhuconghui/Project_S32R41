                        <set_default id="CteActionsConfigName" value_expr="x -> `table_` + system::getParent($this,1).getLabel() + `_Action_` + x.getID()"/>
                        <set_default id="CteActionExecTime" value_expr="x -> $this.execScriptFunction(`../Cte/cte_utils.js`, `CteIncrementByOne`, x.getID()) + `0000`"/>
                    </item_defaults>
                    <options_expr>
                        <option id="type" expr="`CONTAINER`"/>
                        <option id="UUID" expr="`ECUC:66380587-564d-45f3-bada-0475671e1231`"/>
                        <option id="lowerMultiplicity" expr="1"/>
