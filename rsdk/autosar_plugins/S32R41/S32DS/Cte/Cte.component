                                                 ($this.findDuplicates(item -&gt; item.getSetting(`CteOutputSignalClockType`).value()).length() == 0) ||
                                                 ($this.findDuplicates(item -&gt; item.getSetting(`CteOutputSignalHIZType`).value()).length() == 0) )" level="error" description="Duplicated Values! An identical Action is already defined in this Event List."/>
                    </validation>
