                        (( $this.getValue() == `CTE_OUTPUT_SPT_RFS` &amp;&amp; get(get(system::getParent($this,8),1),18).getValue() != `SPTRFS_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_SPT_RFS` ) &amp;&amp;
                        (( $this.getValue() == `CTE_OUTPUT_FLEX_0` &amp;&amp; get(get(system::getParent($this,8),1),19).getValue() != `FLEX0_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_FLEX_0` ) &amp;&amp;
                        (( $this.getValue() == `CTE_OUTPUT_FLEX_1` &amp;&amp; get(get(system::getParent($this,8),1),20).getValue() != `FLEX1_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_FLEX_1` )

