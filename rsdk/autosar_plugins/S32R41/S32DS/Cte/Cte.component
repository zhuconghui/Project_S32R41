                        (( $this.getValue() == `CTE_OUTPUT_CTEP_0` &amp;&amp; get(get(system::getParent($this,8),1),1).getValue() != `CTEP0_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_CTEP_0` ) &amp;&amp;
