                        (( $this.getValue() == `CTE_OUTPUT_CTEP_6` &amp;&amp; get(get(system::getParent($this,8),1),13).getValue() != `CTEP6_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_CTEP_6` ) &amp;&amp;
                        (( $this.getValue() == `CTE_OUTPUT_CTEP_7` &amp;&amp; get(get(system::getParent($this,8),1),15).getValue() != `CTEP7_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_CTEP_7` ) &amp;&amp;
