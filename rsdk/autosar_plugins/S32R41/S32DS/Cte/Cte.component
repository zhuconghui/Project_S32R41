<?xml version="1.0" encoding= "UTF-8" ?>
<component:config_component id="Cte" label="Cte" global_only="false" xsi:schemaLocation="http://swtools.freescale.net/XSD/component/1.0 http://swtools.freescale.net/XSD/component/1.0/component-8.0.xsd" xmlns:component="http://swtools.freescale.net/XSD/component/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" category="driver" max_instances="1" >

<sw_comp_ref name="platform.driver.cte" version="0.8.10"/>

    <description>Cte Driver Configuration</description>
    <mode id="ip" label="CTE Module" available="true">
        <description>Cte Driver Module Name, not used</description>
        <config_set_refs>
            <config_set_ref>Cte</config_set_ref>
        </config_set_refs>
    </mode>


    <config_set id="Cte" label="CTE" public="true" options="ShowContentAs=Tabs;UI_LABEL_HIDDEN;UI_BORDER_HIDDEN">
        <description>Configuration of the Cte module.</description>
        <quick_selections>
            <quick_selection id="CteDefault" label="Default Values" available="true">
                <set id="Name">Cte</set>
                <set id="CteDriverCodeParameters.CteGeneralConfiguration.CteDevErrorDetect">false</set>
                <set id="CteDriverCodeParameters.CteGeneralConfiguration.CteCallbackName">Cte_IsrCallback</set>
             </quick_selection>
            <default>Default</default>
        </quick_selections>

        <settings>
            <!-- *** DO NOT DELETE *** -->
            <!-- Required for file generation. -->
            <variable value="`../Cte/cte_codegenerator.js`" id="codegen_file"></variable>
            <variable value="`Cte_CodeGenerator`" id="codegen_class"></variable>
            <variable value="`true`" id="generate_templates"></variable>
            <variable value="toArray(`CTE`)" id="used_peripherals" />
            <!-- *** DO NOT DELETE *** -->
            <variable value="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteGetPlatform`, getPartNumber())" id="PlatformName"></variable>
            <variable value="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteIsPlatformMatch`, getPartNumber(), `S32R41`)" id="Is_R41"></variable>

            <struct id="CteDriverCodeParameters" label="CTE Code Parameters">
                <description>
                    This container configures the variants aspects of the CTE driver.
                </description>

                <bool id="CtePostBuildVariantUsed" label="Post Build Variant Used" available="false">
                    <description>
                        <![CDATA[<html>Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points. </html> ]]>
                    </description>
                    <options_expr>
                        <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd1234`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`true`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </bool>

                <dynamic_enum id="CteConfigVariant" label="Config Variant" items="toArray(`VariantPostBuild`,
                                                                                          `VariantPreCompile`)" available="false">
                    <description><![CDATA[<html> Selects the variant option. </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0461239`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <struct id="CteGeneralConfiguration" label="CTE Parameters">
                    <description>
                        This container contains the global configuration parameters of the RadarSDK CTE driver.
                    </description>

                    <bool id="CteDevErrorDetect" label="Detect Development Errors" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>
                            <![CDATA[<html>Enables development error detection for this module.
                            This reffers mainly to the input parameters check.
                            <b>TRUE</b> = Development error detection enabled
                            <b>FALSE</b> = Development error detection disabled </html> ]]>
                        </description>
                        <options_expr>
                            <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd9999`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`true`"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </bool>

                    <bool id="CteErrorHalt" label="Stop Execution after Error Detection" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>
                            <![CDATA[<html>Stops execution after the error report.
                            Intended only for debugging.
                            <b>TRUE</b> = Development error detection enabled.
                            <b>FALSE</b> = Development error detection disabled. </html> ]]>
                        </description>
                        <options_expr>
                            <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd9998`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`true`"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </bool>

                    <bool id="CteSingleThread" label="Use Single Thread" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>
                            <![CDATA[<html>Specifies if the driver should be single or multi threaded.
                            In single threaded mode, exclusive areas are not needed.
                            <b>TRUE</b> = Single threaded.
                            <b>FALSE</b> = Multi threaded. </html> ]]>
                        </description>
                        <options_expr>
                            <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd9997`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`true`"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </bool>

                    <bool id="CteVersionInfo" label="Driver Version info" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>
                            <![CDATA[<html>Exposes the VersionInfo function.
                            <b>TRUE</b> = VersionInfo available
                            <b>FALSE</b> = VersionInfo not available </html> ]]>
                        </description>
                        <options_expr>
                            <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd9996`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`true`"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </bool>

                    <bool id="CteStartStop" label="Expose Start/Stop" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>
                            <![CDATA[<html>Exposes the Start/Stop functions.
                            These functions can be used only in Master mode, when the CTE signals are not used.
                            if the CTE execution is managed only by the CTE interface, these two functions are not necessary.
                            <b>TRUE</b> = Start/Stop available.
                            <b>FALSE</b> = Start/Stop not available. </html> ]]>
                        </description>
                        <options_expr>
                            <option id="UUID" expr="`ECUC:e03507f1-4e98-4e85-a93e-5555b9dd9995`"/>
                            <option id="postBuildVariantValue" expr="false"/>
                            <option id="SYNC_VALUE"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`true`"/>
                            <option id="scope" expr="`LOCAL`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </bool>

                    <string id="CteCallbackName" label="Callback Name" available="system::hasExclusiveOwnership(`CTE`, $group)">
                        <description>This is the name of the driver callback.
                        It is used for events reporting. The call is done from the CTE events interrupt handler.
                        To avoid any issues, this callback must be implemented.
                        </description>
                        <validation>
                            <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue()))" level="error" description="Name must be a valid C identifier!"/>
                        </validation>
                        <options_expr>
                            <option id="type" expr="`STRING`"/>
                            <option id="UUID" expr="`ECUC:2beea917-2bcd-497c-a2ed-c82855599994`"/>
                            <option id="origin" expr="`NXP`"/>
                            <option id="SYNC_VALUE"/>
                            <option id="postBuildVariantValue" expr="true"/>
                            <option id="symbolicNameValue" expr="false"/>
                            <option id="defaultValue" expr="`Cte_IsrCallback`"/>
                            <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                            <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                        </options_expr>
                    </string>

                </struct>
            </struct>

            <struct id="CteOutputConfigurationList" label="Output Configuration">
                <description>
                    <![CDATA[<html>
                                            This container contains a list of the necessary setup structures for the Cte driver.
                                            The lists are necessary, to define the working mode for the CTE controlled outputs.
                                            Is necessary to define at least one output list. It is possible to define more output lists,
                                            if many time tables are used, in different contexts. For each working mode it is necessary to define
                                            how the outputs are used.
                                            At least one output must be used for a correct Output Configuration.
                                        </html>]]>
                </description>

                <array id="CteDriverMainContainer" type="CteDriverParamsType" label="Output Configuration List" options="ShowContentAs=MasterDetail;UI_BORDER_HIDDEN" min_expr="1"
                            key_selector_expr="x -> x.getID()">
                    <description><![CDATA[<html>
                                            List containing all the configurations.
                                        </html>]]>
                    </description>
                    <item_defaults>
                        <set_default id="CteOutputConfigName" value_expr="x -> `outputDefTable_` + x.getID()"/>
                    </item_defaults>
                    <options_expr>
                        <option id="type" expr="`CONTAINER`"/>
                        <option id="UUID" expr="`ECUC:66380587-564d-45f3-bada-0475671e1231`"/>
                        <option id="lowerMultiplicity" expr="1"/>
                        <option id="upperMultiplicityInfinite" expr="1"/>
                        <option id="postBuildVariantMultiplicity" expr="false"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </array>

            </struct>

            <struct id="CteFinalConfig" label="CTE Configuration List">
                <description>
                    <![CDATA[<html>
                                This container contains a list of the necessary parameters for CTE setup :<br>
                                - working mode<br>
                                - necessary hardware parameters<br>
                                - pairing between the defined Output Configurations and defined Timing Tables<br>
                                - etc.
                            </html>]]>
                </description>

                <array id="CteDriverFinalConfigContainer" type="CteFinalConfigParamsType" label="Config List" options="ShowContentAs=MasterDetail;UI_BORDER_HIDDEN" min_expr="1"
                            key_selector_expr="x -> x.getID()">
                    <description>List of configurations.</description>
                    <item_defaults>
                        <set_default id="CteConfigName" value_expr="x -> `cteSetupParam_` + x.getID()"/>
                        <set_default id="CteConfigClockFreq" value_expr="40000000"/>
                    </item_defaults>
                    <options_expr>
                        <option id="type" expr="`CONTAINER`"/>
                        <option id="UUID" expr="`ECUC:66380587-564d-45f3-bada-0475671e1231`"/>
                        <option id="lowerMultiplicity" expr="1"/>
                        <option id="upperMultiplicityInfinite" expr="1"/>
                        <option id="postBuildVariantMultiplicity" expr="false"/>
                        <option id="multiplicityConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </array>

            </struct>


        </settings>

        <user_types>

            <struct id="CteFinalConfigParamsType">
                <integer id="test" label="Support Variable" type="uint32_t" value="$this.execScriptFunction(`../Cte/cte_utils.js`, `getIndex`, get(system::getParent($this,1),4).getValue()).toInt()" available="false">
                    <description><![CDATA[<html> Support variable for TimeTablePtr0 [Hz] </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44752d6845`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </integer>

                <string id="CteConfigName" label="Config Name">
                    <description>The name of the configuration structure to be used in the generated .c file.</description>
                    <validation>
                        <constraint cond_expr="(($this.getValue() != ``) &amp;&amp; isCIdentifier($this.getValue())) &amp;&amp; $this.execScriptFunction(`../Cte/cte_utils.js`, `CteIsPlatformMatch`, $this.getValue(), `cteSetupParam_`)"
                        level="error" description="Name must be a valid C identifier and must start with 'cteSetupParam_' !"/>
                        <constraint cond_expr="countOccurrences(($parent.getParent()), x -> (x.getSetting(`CteConfigName`).getValue() == $this.value())) == 1" level="error" description="Duplicated value&#44; Config Name must be unique across all CTE configurations."/>
                    </validation>
                </string>

                <integer id="CteConfigClockFreq" label="CTE input clock [Hz]" type="uint32_t" >
                    <description><![CDATA[<html> The value for the CTE_clock/CTE_CLK [Hz] </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6845`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="true"/>
                        <option id="defaultValue" expr="`40000000`"/>
                        <option id="min" expr="40000000"/>
                        <option id="max" expr="1000000000"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="($this.getValue() != ``) &amp;&amp; ($this.getValue() &gt;= 40000000) &amp;&amp; ($this.getValue() &lt;= 1000000000)"
                        level="error" description="Value must be between 40000000 and 1000000000."/>
                    </validation>
                </integer>

                <integer id="CteRepeatCount" label="Tables Repeat Counter" type="uint32_t" >
                    <description><![CDATA[<html>The number of times the table execution will be repeated until
                                                    going to HALT state. 0 (zero) means "forever". If two alternative
                                                    tables used, each table execution will decrease the counter.</html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`INTEGER`"/>
                        <option id="UUID" expr="`ECUC:89dc979d-14a5-4550-b3a3-ee44747d6845`"/>
                        <option id="postBuildVariantValue" expr="false"/>
                        <option id="SYNC_VALUE"/>
                        <option id="origin" expr="`AUTOSAR_ECUC`"/>
                        <option id="symbolicNameValue" expr="true"/>
                        <option id="defaultValue" expr="`40000000`"/>
                        <option id="min" expr="40000000"/>
                        <option id="max" expr="1000000000"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="($this.getValue() != ``) &amp;&amp; ($this.getValue() &gt;= 0) &amp;&amp; ($this.getValue() &lt;= 65535)"
                        level="error" description="Value must be between 0 and 65535."/>
                    </validation>
                </integer>

                <dynamic_enum id="CteSignalDefPtr0" label="Output Selection 0" items="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteGetSignalDefs`, get(get(system::getParent($this,4),7),0).getSize(), false)">
                    <description><![CDATA[<html>
                                    Select which Output Configuration to be used in this configuration.
                                    </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-1234-493f-8e05-3716f0466543`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <dynamic_enum id="CteTimeTablePtr0" label="Time Table Selection 0" items="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteGetTimeTables`, get(get(get(get(get(system::getParent($this,4),7),0),$this.execScriptFunction(`../Cte/cte_utils.js`, `getIndex`, get(system::getParent($this,1),4).getValue()).toInt()),1),21).getFirst().getLabel().toInt(), get(get(get(get(get(system::getParent($this,4),7),0),$this.execScriptFunction(`../Cte/cte_utils.js`, `getIndex`, get(system::getParent($this,1),4).getValue()).toInt()),1),21).getSize())">
                    <description><![CDATA[<html>
                                    Select which Time Table to be used in this configuration.
                                    </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-1234-493f-8e05-3716f0466543`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <dynamic_enum id="CteSignalDefPtr1" label="Output Selection 1" items="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteGetSignalDefs`, get(get(system::getParent($this,4),7),0).getSize(), true)">
                    <description><![CDATA[<html>
                                    Select which Output Configuration to be used in this configuration.
                                    </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-1234-493f-8e05-3716f0466543`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="get(system::getParent($this,1),4).getValue() != $this.getValue()"
                        level="error" description="Value already used! Select a different one."/>
                    </validation>
                </dynamic_enum>

                <dynamic_enum id="CteTimeTablePtr1" label="Time Table Selection 1" items="$this.execScriptFunction(`../Cte/cte_utils.js`, `CteGetTimeTables`, get(get(get(get(get(system::getParent($this,4),7),0),$this.execScriptFunction(`../Cte/cte_utils.js`, `getIndex`, get(system::getParent($this,1),6).getValue()).toInt()),1),21).getFirst().getLabel().toInt(), get(get(get(get(get(system::getParent($this,4),7),0),$this.execScriptFunction(`../Cte/cte_utils.js`, `getIndex`, get(system::getParent($this,1),6).getValue()).toInt()),1),21).getSize())" available="get(system::getParent($this,1),6).getValue()!=`NULL_PTR`">
                    <description><![CDATA[<html>
                                    Select which Time Table to be used in this configuration.
                                    </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-1234-493f-8e05-3716f0466543`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <dynamic_enum id="CteWorkingSetup" label="CTE Working Mode Setup" items="toArray(`CTE_MASTER`,
                                                                                                 `CTE_SLAVE_EXTERNAL`,
                                                                                                 `CTE_SLAVE_CSI2`)">
                    <description><![CDATA[<html>
                                    The usage for the CTE module :<br>
                                    - <b>MASTER</b>         - the CTE is started by the software<br>
                                    - <b>SLAVE_EXTERNAL</b> - the CTE is started by the external RFS/RCS signals<br>
                                    - <b>SLAVE_CSI2</b>     - the CTE is started by the CSI2 reception<br>
                                    </html>]]>
                    </description>
                    <options_expr>
                        <option id="type" expr="`ENUMERATION`"/>
                        <option id="UUID" expr="`ECUC:daca2411-31e0-493f-8e05-3716f0466543`"/>
                        <option id="postBuildVariantValue" expr="true"/>
                        <option id="origin" expr="`NXP`"/>
                        <option id="symbolicNameValue" expr="false"/>
                        <option id="defaultValue" expr="`VariantPostBuild`"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`POST-BUILD=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                </dynamic_enum>

                <dynamic_enum id="CteWorkingSlaveCsi2Unit" label="CSI2 unit to be used for start signals" items="toArray(`CTE_CSI2_UNIT_0`,
                                                                                                                         `CTE_CSI2_UNIT_1`)" available="get(system::getParent($this,1),8).getValue()==`CTE_SLAVE_CSI2`" >
                    <description><![CDATA[<html>
                                    The CSI2 unit which provide the CTE start signals.
                                    </html>]]>
                    </description>
                    <options_expr>
