                        <option id="min" expr="1"/>
                        <option id="max" expr="181"/>
                        <option id="scope" expr="`LOCAL`"/>
                        <option id="valueConfigClass" expr="`PRE-COMPILE=VARIANT-POST-BUILD;PRE-COMPILE=VARIANT-PRE-COMPILE`"/>
                    </options_expr>
                    <validation>
                        <constraint cond_expr="($this.getValue() != ``) &amp;&amp; ($this.getValue() &gt;= 1) &amp;&amp; ($this.getValue() &lt;= 4000000000)"
                        level="error" description="Value must be between 1 and 4000000000."/>
                    </validation>
                </integer>

                <array id="CteDriverEventsContainer" type="CteEventsTableType" label="Event List" options="ShowContentAs=MasterDetail;UI_BORDER_HIDDEN" min_expr="1" max_expr="64"
