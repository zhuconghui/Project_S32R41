                        (( $this.getValue() == `CTE_OUTPUT_CTEP_4` &amp;&amp; get(get(system::getParent($this,8),1),9).getValue() != `CTEP4_NOT_USED`) || $this.getValue() != `CTE_OUTPUT_CTEP_4` ) &amp;&amp;
