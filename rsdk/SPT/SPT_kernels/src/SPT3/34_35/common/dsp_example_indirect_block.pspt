/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 #include "spt_assembler_defines.h"
 .include "oram.inc"                   /* include ORAM header file */
 .include "tram.inc"                   /* include TRAM header file */
 .include "wr.inc"                     /* include WR header file */
 .include "spt_kernel_internals.inc"   /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/

 //DSP cmd 1 format: indirect parameter passing, CRC enabled
 #define DSP_CMD1_FORMAT (0x3)

 //use WR_1 to pass the paramList,  WR_2 for funcID and WR_3 for CRC
 .set DSP_CMD1_BITS_31_0,  	RSDK_DSP_CMD_BITS_31_0(0x01, 0x02, 0x03)
 .set DSP_CMD1_BITS_63_32, 	RSDK_DSP_CMD_BITS_63_32(0)
 .set DSP_CMD1_BITS_95_64, 	RSDK_DSP_CMD_BITS_95_64(0)
 .set DSP_CMD1_BITS_120_96, RSDK_DSP_CMD_BITS_120_96(DSP_CMD1_FORMAT, 0)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDspExampleIndirectBlocking();
* @brief
* @details        Sends a blocking "DSP" command which triggers execution of a preselected function on the BBE32 DSP.
* 				  All command parameters are passed from the application at runtime, through Work Registers.
*                 This routine will exit only after the DSP function has replied by pushing a response to the SPT Response Queue.
*
* @note
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptDspExampleIndirectBlocking
 .global RsdkSptDspExampleIndirectBlocking_size

RsdkSptDspExampleIndirectBlocking:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

    //function ID and 32-bit parameter (or pointer to parameter list) can be set at runtime
    //from the user app, using the SPT Driver to write them to the WRs. Here we assume that the
    //parameter is contained in WR_1, the function ID in WR_2 and the CRC in WR_3
    /*=========================================================================
     * DSP instruction works only with immediate value. Here it is used to point to
     * the WRs which contain the DSP params
     *=========================================================================*/
    dsp .block, DSP_CMD1_BITS_120_96, DSP_CMD1_BITS_95_64, DSP_CMD1_BITS_63_32, DSP_CMD1_BITS_31_0

    /*=========================================================================
     * STOP cmd
     *=========================================================================*/
    stop

 .set RsdkSptDspExampleIndirectBlocking_size, .-RsdkSptDspExampleIndirectBlocking
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
