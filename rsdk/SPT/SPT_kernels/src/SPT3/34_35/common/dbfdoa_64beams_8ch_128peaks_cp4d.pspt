/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set PEAK_NUM,                 64 /* 128/2, unrolling on OPRAM banks */
 .set CHANNEL_NUM,               8
 .set SCALAR_PROD_TAPS,          8
 .set BEAM_NUM,                 64
 .set BYTES_BEAM_MAG_SAMPLE,     4 /* 32 bits in SRAM, 24 used(log2 16 bit + tagging) */
 .set BYTES_CP4D_DATA,           8 /* 8 bytes, per CP4D data */
 .set PEAK_SRAM_SLICES,         ((PEAK_NUM * CHANNEL_NUM) >> 2) /* two SRAM slice contains compressed data for 1 Peak
                                                                   1st slice for CH#0..CH#3; 2nd slice for CH#4..CH#7 */

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDbfDoa64Beams8Ch128PeaksCp4d();
* @brief          Function for Digital BeamForming - DBF for 64 Steering Vector,
*                 8 channels and 128 peaks and Direction of Arrival, CP4D PDMA decompression.
* @details        Compute Magnitudes(log2 format) for Beamscans (for each peak).
*                 Compute Global Max, calculate thresold and compute the local maxima, per Beamscan.
*                 Results stored in SRAM (log2 format + tagging for local peaks)
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Peak list, CP4D compressed),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_CH1_CH2_CH3-P0
*                 CH4_CH5_CH6_CH7-P0
*                 CH0_CH1_CH2_CH3-P1
*                 CH4_CH5_CH6_CH7-P1
*                 |
*                 |
*                 |
*                 CH0_CH1_CH2_CH3-P127
*                 CH4_CH5_CH6_CH7-P127
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(128 beamscans of 64 beams),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 32 bit real. First 16 bit reserved for tagging, next 16bit for log2 magnitudes
*                 63:48           47:32           31:16           15:0
*                 P0-TAG-Beam0    P0-MAG-Beam0    P0-TAG-Beam1    P0-MAG-Beam1
*                 P0-TAG-Beam2    P0-MAG-Beam2    P0-TAG-Beam3    P0-MAG-Beam3
*                 |               |               |               |
*                 P0-TAG-Beam62   P0-MAG-Beam62   P0-TAG-Beam63   P0-MAG-Beam63 -> Beamscan 0
*                 ----------------------------------------------------------------------------
*                 P1-TAG-Beam0    P1-MAG-Beam0    P1-TAG-Beam1    P1-MAG-Beam1
*                 P1-TAG-Beam2    P1-MAG-Beam2    P1-TAG-Beam3    P1-MAG-Beam3
*                 |               |               |               |
*                 P1-TAG-Beam62   P1-MAG-Beam62   P1-TAG-Beam63   P1-MAG-Beam63 -> Beamscan 1
*                 ----------------------------------------------------------------------------
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 ----------------------------------------------------------------------------
*                 P127-TAG-Beam0  P127-MAG-Beam0  P127-TAG-Beam1  P127-MAG-Beam1
*                 P127-TAG-Beam2  P127-MAG-Beam2  P127-TAG-Beam3  P127-MAG-Beam3
*                 |               |               |               |
*                 P127-TAG-Beam62 P127-MAG-Beam62 P127-TAG-Beam63 P127-MAG-Beam63 -> Beamscan 127
*                 ----------------------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): Threshold Factor, used for Threshold calculation (14bit log2 format). \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Steering vector coeficients are placed in TRAM at TR_0_448_0 by the Init function. \n
*                 The kernel rely on the assumption that TR_0_447_0 can be used as temp location.
*
* @note           All buffers MUST be 8 bytes aligned. \n
*                 The input buffer CANNOT be reused for the output buffers.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptDbfDoa64Beams8Ch128PeaksCp4d
 .global RsdkSptDbfDoa64Beams8Ch128PeaksCp4d_size

RsdkSptDbfDoa64Beams8Ch128PeaksCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * Work Register 11, 12
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put first 64 peak samples of the 8 channels
     *        24bit(IM): SRAM offset to peak samples
     * WR_12: 24bit(RE): OPRAM address where to put last 64 peak samples of the 8 channels
     *        24bit(IM): SRAM offset to the next 64 peak samples
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_1_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_3_0_0 | ((PEAK_NUM * 2 * BYTES_CP4D_DATA) << 24)), WR_12

    /*=========================================================================
     * Work Register 19 & 20
     *=========================================================================
     * WR_19: 24bit(RE): OPRAM address where to get beams magnitude for the first 64 peaks
     *        24bit(IM): SRAM beam magnitude result buffer address offset for the first 64 peaks
     * WR_20: 24bit(RE): OPRAM address where to get beams magnitude for the last 64 peaks
     *        24bit(IM): SRAM beam magnitude result buffer address offset for the last 64 peaks
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_1_0_0), WR_19
    add .noshift .mod24 WR_2, #(OR_3_0_0 | ((PEAK_NUM * BEAM_NUM * BYTES_BEAM_MAG_SAMPLE) << 24)), WR_20

    /*=========================================================================
     * Work Register 13, 14 used together with 15
     *=========================================================================
     * WR_13: OPRAM address to take the global max(GM) for each of the first 64peaks. WR_45 place to store the current global max.
     * WR_14: OPRAM address to take the global max(GM) for each of the last 64peaks.  WR_45 place to store the current global max.
     * WR_15: increment value from where to take the next GM.
     *=========================================================================*/
    set #(WR_45 | (OR_4_0_0 << 24)), WR_13
    set #(WR_45 | (OR_4_0_0 << 24)), WR_14
    set #(0x1 << 24), WR_15

    /*=========================================================================
     * Work Register 16, 17 used together with 18
     *=========================================================================
     * WR_16: OPRAM address from and where to put the local max results. Used for the first 64 peaks.
     * WR_17: OPRAM address from and where to put the local max results. Used for the last 64 peaks.
     * WR_18: increment value from and where to put to take next beams.
     *=========================================================================*/
    set #(OR_0_0_0 | (OR_1_0_0 << 24)), WR_16
    set #(OR_2_0_0 | (OR_3_0_0 << 24)), WR_17
    set #(0x20 | (0x20 << 24)), WR_18

    /*=========================================================================
     * set WR_43. Keep "0" value as reference for cmp instruction
     *=========================================================================*/
    set #(0x0), WR_43

/*=========================================================================
 * START DIGITAL BEAMFORMING SECTION + Direction of Arrival Algo
 *=========================================================================*/
    /*=========================================================================
     * PDMA: transfer first/last 64 compressed peak samples for all 8 channels from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, PEAK_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .CP4D .sysram2opram .async .notrace, PEAK_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * START OF PROCESSING FOR THE FIRST 64 PEAKS
     *=========================================================================*/
    /*=========================================================================
     * REPEAT 64 (beam number) times the SCP for the first 64 Peaks, bank OR_1_0_0 -> OR_0_0_0
     * SCP: scalar product with 8 taps, steering vector in TRAM, taken from TR_0_448_0...
     * S = (P_A*SV_A + P_B*SV_B + P_C*SV_C + P_D*SV_D + P_E*SV_E + P_F*SV_F + P_G*SV_G + P_H*SV_H)/8,
     * done for 8ch x PEAK_NUM(64).
     *=========================================================================*/
    repeat BEAM_NUM, 0x0, PEAK_NUM, MEM_SLICES, 0x0
    scp .cmplx .coef_cmplx .nosft SCALAR_PROD_TAPS, CHANNEL_NUM*PEAK_NUM, OR_1_0_0, OR_0_0_0, 0x1, 0x1, TR_0_448_0

    /*=========================================================================
     * COPY 8x8 transpose. Done for 64 peaks*64beams
     *=========================================================================*/
    copy.trans PEAK_NUM*BEAM_NUM, OR_0_0_0, OR_1_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * REPEAT 8 times the COPY command (interleave), bank OR_1_0_0 -> OR_0_0_0
     * COPY: rearrange the data, all the beams grouped for each Peak(Beamscan/SCP calculated)
     * src_inc 8 (skip other 7*8 Peaks), dst_inc 1, done for 8 peaks*64beams, each time
     *=========================================================================*/
    repeat 8, MEM_SLICES, MEM_SLICES*BEAM_NUM, 0x0, 0x0
    copy.simple 8*BEAM_NUM, OR_1_0_0, OR_0_0_0, 0x8, 0x1

    /*=========================================================================
     * COPY 8x8 transpose. Done for 64 peaks*64beams
     *=========================================================================*/
    copy.trans PEAK_NUM*BEAM_NUM, OR_0_0_0, OR_1_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * REPEAT 8 times the COPY command (interleave), bank OR_1_0_0 -> OR_0_0_0
     * COPY: rearrange the data, eack peak to have all the 64 beams consecutive
     * src_inc 8(skip other 7*8 Peaks), dst_inc 1, done for 8 peaks*64beams, each time
     *=========================================================================*/
    repeat 8, MEM_SLICES, MEM_SLICES*BEAM_NUM, 0x0, 0x0
    copy.simple 8*BEAM_NUM, OR_1_0_0, OR_0_0_0, 0x8, 0x1

    /*=========================================================================
     * VMT: Operation Sequence 1(Mag2 and log2), output packing. Done for 64 peaks*64beams.
     *=========================================================================*/
    vmt.sq1 .cmplx .in_48 .op_on, PEAK_NUM*BEAM_NUM, OR_0_0_0, OR_1_0_0, 0x1, 0x1

    /*=========================================================================
     * REPEAT #PEAKS + Global MAXS on a beamscan, input packing
     *=========================================================================*/
    repeat PEAK_NUM, BEAM_NUM>>1, 0x1, 0x0, 0x0
    maxs.gm .no_maxsn .log2 .no_preproc .in_48packed, BEAM_NUM, OR_1_0_0, OR_4_0_0, 0x1, 0x1

    /*=========================================================================
     * Repeat 128/2 = 64 (peak number - beamscan) the local max algorithm
     *=========================================================================*/
    loop #(PEAK_NUM)

       /*=========================================================================
         * GET: take the GM for first peak and place it in WR_45
         *=========================================================================*/
        get.ind WR_13

        /*=========================================================================
         * ADD: increment OPRAM address to read the next 64 beams(beamscan)
         *=========================================================================*/
        add .noshift .mod24 WR_13, WR_15, WR_13

        /*=========================================================================
         * SUB: substract thresholdFactor from the global max
         *=========================================================================*/
        sub .noshift .mod24 WR_45, WR_3, WR_44

        /*=========================================================================
         * CMP: compare the (GLB_MAX - thresholdFactor) > 0
         *=========================================================================*/
        cmp WR_44, WR_43, WR_42

        /*=========================================================================
         * SEL: check wr 42, SRC1(WR_45), SRC2(WR_45), SRC3(WR_44), Dest(WR_45)
         * If (GLB_MAX - thresholdFactor) > 0 then Threshold = (GLB_MAX - thresholdFactor)
         * If (GLB_MAX - thresholdFactor) <= 0 then Threshold = GLB_MAX
         *=========================================================================*/
        sel .re 42 WR_45, WR_45, WR_44, WR_45

        /*=========================================================================
         * MAXS with output tagging: local maxima on a beamscan, IN/OUT packing, threshold in WR_45
         *=========================================================================*/
        maxs.lmth.ind .no_maxsn .log2 .no_preproc .in_48packed .tag .no_tag_in .no_cyc_ext .gt_thld, BEAM_NUM, WR_16, 0x1, 0x1, WR_45

        /*=========================================================================
         * ADD: increment OPRAM address to read/write the data/local max for the next 64 beams(beamscan)
         *=========================================================================*/
        add .noshift .mod24 WR_16, WR_18, WR_16

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

    /*=========================================================================
     * COPY: R2I and I2R. Inverse the real with imaginary column.
     * Needed for PDMA with 24complex to transfer consecutive beam data
     *=========================================================================*/
    copy.partial_r2i .keep_orig, PEAK_NUM*BEAM_NUM>>1, OR_0_0_0, OR_1_0_0, 0x1, 0x1
    copy.partial_i2r .keep_orig, PEAK_NUM*BEAM_NUM>>1, OR_0_0_0, OR_1_0_0, 0x1, 0x1

    /*=========================================================================
     * PDMA: copy mag2+log2 data + peak info(tagging)
     * 64 beams for the first 64 peaks, grouped 2 real columns in one(Re/Im) OPRAM slice
     *=========================================================================*/
    pdma.ind .signext .24cmplx .opram2sysram .async .notrace, PEAK_NUM*BEAM_NUM>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_19, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * END OF PROCESSING FOR THE FIRST 64 PEAKS
     *=========================================================================*/

    /*=========================================================================
     * START OF PROCESSING FOR THE LAST 64 PEAKS
     *=========================================================================*/
    /*=========================================================================
     * REPEAT 64 (beam number) times the SCP for the last 64 Peaks, bank OR_3_0_0 -> OR_2_0_0
     * SCP: scalar product with 8 taps, steering vector in TRAM, taken from TR_0_448_0...
     * S = (P_A*SV_A + P_B*SV_B + P_C*SV_C + P_D*SV_D + P_E*SV_E + P_F*SV_F + P_G*SV_G + P_H*SV_H)/8,
     * done for 8ch x PEAK_NUM(64).
     *=========================================================================*/
    repeat BEAM_NUM, 0x0, PEAK_NUM, MEM_SLICES, 0x0
    scp .cmplx .coef_cmplx .nosft SCALAR_PROD_TAPS, CHANNEL_NUM*PEAK_NUM, OR_3_0_0, OR_2_0_0, 0x1, 0x1, TR_0_448_0

    /*=========================================================================
     * COPY 8x8 transpose. Done for 64 peaks*64beams
     *=========================================================================*/
    copy.trans PEAK_NUM*BEAM_NUM, OR_2_0_0, OR_3_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * REPEAT 8 times the COPY command (interleave), bank OR_3_0_0 -> OR_2_0_0
     * COPY: rearrange the data, all the beams grouped for each Peak(Beamscan/SCP calculated)
     * src_inc 8 (skip other 7*8 Peaks), dst_inc 1, done for 8 peaks*64beams, each time
     *=========================================================================*/
    repeat 8, MEM_SLICES, MEM_SLICES*BEAM_NUM, 0x0, 0x0
    copy.simple 8*BEAM_NUM, OR_3_0_0, OR_2_0_0, 0x8, 0x1

    /*=========================================================================
     * COPY 8x8 transpose. Done for 64 peaks*64beams
     *=========================================================================*/
    copy.trans PEAK_NUM*BEAM_NUM, OR_2_0_0, OR_3_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * REPEAT 8 times the COPY command (interleave), bank OR_3_0_0 -> OR_2_0_0
     * COPY: rearrange the data, eack peak to have all the 64 beams consecutive
     * src_inc 8(skip other 7*8 Peaks), dst_inc 1, done for 8 peaks*64beams, each time
     *=========================================================================*/
    repeat 8, MEM_SLICES, MEM_SLICES*BEAM_NUM, 0x0, 0x0
    copy.simple 8*BEAM_NUM, OR_3_0_0, OR_2_0_0, 0x8, 0x1

    /*=========================================================================
     * VMT: Operation Sequence 1(Mag2 and log2), output packing. Done for 64 peaks*64beams.
     *=========================================================================*/
    vmt.sq1 .cmplx .in_48 .op_on, PEAK_NUM*BEAM_NUM, OR_2_0_0, OR_3_0_0, 0x1, 0x1

    /*=========================================================================
     * REPEAT #PEAKS + Global MAXS on a beamscan, input packing
     *=========================================================================*/
    repeat PEAK_NUM, BEAM_NUM>>1, 0x1, 0x0, 0x0
    maxs.gm .no_maxsn .log2 .no_preproc .in_48packed, BEAM_NUM, OR_3_0_0, OR_4_0_0, 0x1, 0x1

    /*=========================================================================
     * Repeat 128/2 = 64 (peak number - beamscan) the local max algorithm
     *=========================================================================*/
    loop #(PEAK_NUM)

       /*=========================================================================
         * GET: take the GM for first peak and place it in WR_45
         *=========================================================================*/
        get.ind WR_14

        /*=========================================================================
         * ADD: increment OPRAM address to read the next 64 beams(beamscan)
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_15, WR_14

        /*=========================================================================
         * SUB: substract thresholdFactor from the global max
         *=========================================================================*/
        sub .noshift .mod24 WR_45, WR_3, WR_44

        /*=========================================================================
         * CMP: compare the (GLB_MAX - thresholdFactor) > 0
         *=========================================================================*/
        cmp WR_44, WR_43, WR_42

        /*=========================================================================
         * SEL: check wr 42, SRC1(WR_45), SRC2(WR_45), SRC3(WR_44), Dest(WR_45)
         * If (GLB_MAX - thresholdFactor) > 0 then Threshold = (GLB_MAX - thresholdFactor)
         * If (GLB_MAX - thresholdFactor) <= 0 then Threshold = GLB_MAX
         *=========================================================================*/
        sel .re 42 WR_45, WR_45, WR_44, WR_45

        /*=========================================================================
         * MAXS with output tagging: local maxima on a beamscan, IN/OUT packing, threshold in WR_45
         *=========================================================================*/
        maxs.lmth.ind .no_maxsn .log2 .no_preproc .in_48packed .tag .no_tag_in .no_cyc_ext .gt_thld, BEAM_NUM, WR_17, 0x1, 0x1, WR_45

        /*=========================================================================
         * ADD: increment OPRAM address to read/write the data/local max for the next 64 beams(beamscan)
         *=========================================================================*/
        add .noshift .mod24 WR_17, WR_18, WR_17

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

    /*=========================================================================
     * COPY: R2I and I2R. Inverse the real with imaginary column.
     * Needed for PDMA with 24complex to transfer consecutive beam data
     *=========================================================================*/
    copy.partial_r2i .keep_orig, PEAK_NUM*BEAM_NUM>>1, OR_2_0_0, OR_3_0_0, 0x1, 0x1
    copy.partial_i2r .keep_orig, PEAK_NUM*BEAM_NUM>>1, OR_2_0_0, OR_3_0_0, 0x1, 0x1

    /*=========================================================================
     * PDMA: copy mag2+log2 data + peak info(tagging)
     * 64 beams for the last 64 peaks, grouped 2 real columns in one(Re/Im) OPRAM slice
     *=========================================================================*/
    pdma.ind .signext .24cmplx .opram2sysram .async .notrace, PEAK_NUM*BEAM_NUM>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_20, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * END OF PROCESSING FOR THE LAST 64 PEAKS
     *=========================================================================*/

/*=========================================================================
 * STOP: end of DBF+DOA program
 *=========================================================================*/
 stop

 .set RsdkSptDbfDoa64Beams8Ch128PeaksCp4d_size, .-RsdkSptDbfDoa64Beams8Ch128PeaksCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
