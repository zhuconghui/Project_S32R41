/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,        256
 .set CHIRPS_PER_TX_SLOT,       256
 .set TDMIMO_TX_SLOTS,            2
 .set BYTES_CP4D_DATA,            8
 .set CHANNELS_PER_SLOT,          8 /* total phy channels no */
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set SRAM_SLICES,              ((TDMIMO_TX_SLOTS * CHANNELS_PER_SLOT * CHIRPS_PER_TX_SLOT) >> 2)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
 /*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*==================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d();
* @brief          Function for Doppler FFT256, 8 physical channels/TX slot, 2TX TD-MIMO
* @details        Compute Doppler FFT storing compressed results(CP4D) in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Range FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp0
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp255
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp255
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp255
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp255           ---> RangeBin #0
*                 ---------------------------------------------------------------
*                 |
*                 |
*                 |
*                 ---------------------------------------------------------------
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp0
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp0
*                 |
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp255
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp255
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp255
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp255   ---> RangeBin #127
*                 ---------------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(Doppler FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR"
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp0
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp255
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp255
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp255
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp255           ---> RangeBin #0
*                 ---------------------------------------------------------------
*                 |
*                 |
*                 |
*                 ---------------------------------------------------------------
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp0
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp0
*                 |
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp255
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp255
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp255
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp255   ---> RangeBin #127
*                 ---------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): Pre-Scaling Factor, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0. \n
*                       Value given from the application level, based on global max provided by the range kernel. \n
*                       Shall be computed on the CORE as: pre_scaling value = floor(log2(0x7FFFFF / 1Q23 max_glb)).
*
* @param[in]      WR_4: 24bit(RE): Scaling Factor on output data, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_0_0 by the Init function. \n
*                 Window coeficients are placed in TRAM at TR_0_64_0 by the Init function. \n
*                 Derotation phase coeficients are places in TRAM at TR_0_100_0 by the Init function.
*
* @note           The kernel implementation guarantees no saturation, for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 The current implementation is ONLY to be used in combination with 256 Range FFT 2TX TD-MIMO. \n
*                 The input buffer CAN be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*==================================================================================================*/
/** @cond */
 .global RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d
 .global RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d_size

RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put ODD range bins for all channels
     *        24bit(IM): SRAM offset to ODD range bins (doppler input)
     * WR_12: 24bit(RE): OPRAM address where to put EVEN range bins for all channels
     *        24bit(IM): SRAM offset to EVEN range bins (doppler input)
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins/doppler
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_2_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24)), WR_12
    set #((2 * TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24), WR_13

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_14: 24bit(RE): OPRAM address where to get doppler results(ODD range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     * WR_15: 24bit(RE): OPRAM address where to get doppler results(EVEN range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_0_0_0), WR_14
    add .noshift .mod24 WR_2, #(OR_2_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24)), WR_15

/*=========================================================================
 * START DOPPLER FFT256 SECTION
 *=========================================================================*/
    /*=========================================================================
     * set WR_46, for custom left shift. By default, no shift.
     *=========================================================================*/
    set #0x0, WR_46
    sub .noshift .mod24 WR_4, WR_46, WR_46

    /*=========================================================================
     * LOOP: loop #count is number of range bins/2 (2 range bins processed within one iteration)
     *=========================================================================*/
    loop #(RANGE_BINS >> 1)

        /*=========================================================================
         * PDMA: transfer ODD/EVEN range bin data of all 16 virtual channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * ODD range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * VMT: pre shift(WR_3).
         * Separate first 8 channels (TX slot #0) from last 8 channels (TX slot #1)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_0_0,   OR_1_0_0, 0x2, 0x1
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_1_0, OR_1_256_0, 0x2, 0x1

        /*=========================================================================
         * COPY 8x8 transpose for first/last 8 channels
         *=========================================================================*/
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT,   OR_1_0_0,   OR_0_0_0, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_1_256_0, OR_0_256_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT256, TX slot #0
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_0_0, Window in TR_0_64_0
         =========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_1_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, OR_1_0_0, OR_0_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_1_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, OR_1_0_0, OR_0_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT256, TX slot #1, WITH compensation
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_0_0, Window in TR_0_64_0
         =========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, OR_0_256_0, OR_1_256_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, OR_1_256_0, OR_0_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, OR_0_256_0, OR_1_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, OR_1_256_0, OR_0_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times compensation(WIN) for TX slot #1
         *=========================================================================
         *=========================================================================
         * WIN: multiply with Derotation Phase Vector, Vector in TR_0_100_0
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_0_256_0, OR_1_256_0, 0x8, 0x8, TR_0_100_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times: move data back for TX slot #1
         *=========================================================================
         *=========================================================================
         * COPY: move the result back, ready to be transposed for output PDMA
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        copy.simple CHIRPS_PER_TX_SLOT, OR_1_256_0, OR_0_256_0, 0x8, 0x8

        /*=========================================================================
         * COPY 8x8 transpose for first/last 8 channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_0_0_0                                          ,   OR_1_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_0_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_1_0_0                                          , 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_0_256_0                                          , OR_1_256_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_0_256_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_1_256_0                                          , 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift.
         * Merge first 8 channels (TX slot #0) with last 8 channels (TX slot #1)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT,   OR_1_0_0, OR_0_0_0, 0x1, 0x2
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_1_256_0, OR_0_1_0, 0x1, 0x2

        /*=========================================================================
         * PDMA: transfer doppler results(ODD range bins) of all 16 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * EVEN range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * VMT: pre shift(WR_3).
         * Separate first 8 channels (TX slot #0) from last 8 channels (TX slot #1)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_2_0_0,   OR_3_0_0, 0x2, 0x1
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_2_1_0, OR_3_256_0, 0x2, 0x1

        /*=========================================================================
         * COPY 8x8 transpose for first/last 8 channels
         *=========================================================================*/
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT,   OR_3_0_0,   OR_2_0_0, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_3_256_0, OR_2_256_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT256, TX slot #0
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_0_0, Window in TR_0_64_0
         =========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, OR_2_0_0, OR_3_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, OR_3_0_0, OR_2_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, OR_2_0_0, OR_3_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, OR_3_0_0, OR_2_0_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT256, TX slot #1, WITH compensation
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_0_0, Window in TR_0_64_0
         =========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, OR_2_256_0, OR_3_256_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, OR_3_256_0, OR_2_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, OR_2_256_0, OR_3_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, OR_3_256_0, OR_2_256_0, 0x8, 0x8, TR_0_0_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times compensation(WIN) for TX slot #1
         *=========================================================================
         *=========================================================================
         * WIN: multiply with Derotation Phase Vector, Vector in TR_0_100_0
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_2_256_0, OR_3_256_0, 0x8, 0x8, TR_0_100_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_PER_SLOT) times: move data back for TX slot #1
         *=========================================================================
         *=========================================================================
         * COPY: move the result back, ready to be transposed for output PDMA
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        copy.simple CHIRPS_PER_TX_SLOT, OR_3_256_0, OR_2_256_0, 0x8, 0x8

        /*=========================================================================
         * COPY 8x8 transpose for first/last 8 channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_2_0_0                                          ,   OR_3_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_2_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1,   OR_3_0_0                                          , 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_256_0                                          , OR_3_256_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_256_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_3_256_0                                          , 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift.
         * Merge first 8 channels (TX slot #0) with last 8 channels (TX slot #1)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT,   OR_3_0_0, OR_2_0_0, 0x1, 0x2
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_3_256_0, OR_2_1_0, 0x1, 0x2

        /*=========================================================================
         * PDMA: transfer doppler results(ODD range bins) of all 16 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_13, WR_14
        add .noshift .mod24 WR_15, WR_13, WR_15

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of FFT256 doppler program
 *=========================================================================*/
 stop

 .set RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d_size, .-RsdkSptDoppler256smp256crp8ch2TxTdMimoCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
