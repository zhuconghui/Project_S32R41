/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,        256
 .set CHIRPS_PER_TX_SLOT,       128
 .set TDMIMO_TX_SLOTS,            6
 .set TDMIMO_COMP_SLOTS,        (TDMIMO_TX_SLOTS - 1) /* number of slots that need compensation */
 .set BYTES_CP4D_DATA,            8
 .set CHANNELS_PER_SLOT,          8 /* total phy channels no */
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set SRAM_SLICES,              ((TDMIMO_TX_SLOTS * CHANNELS_PER_SLOT * CHIRPS_PER_TX_SLOT) >> 2)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
 /*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*==================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d();
* @brief          Function for Doppler FFT256, 8 physical channels/TX slot, 6TX TD-MIMO
* @details        Compute Doppler FFT storing compressed results(CP4D) in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Range FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp0
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp127
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp127
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp127           ---> RangeBin #0
*                 --------------------------------------------------------------
*                 |
*                 |
*                 |
*                 --------------------------------------------------------------
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp0
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp0
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp0
*                 |
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp127
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp127
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp127  ---> RangeBin #127
*                 --------------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(Doppler FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR"
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp0
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp127
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp127
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp127           ---> RangeBin #0
*                 --------------------------------------------------------------
*                 |
*                 |
*                 |
*                 --------------------------------------------------------------
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp0
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp0
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp0
*                 |
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp127
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp127
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp127  ---> RangeBin #127
*                 --------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): Pre-Scaling Factor, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0. \n
*                       Value given from the application level, based on global max provided by the range kernel. \n
*                       Shall be computed on the CORE as: pre_scaling value = floor(log2(0x7FFFFF / 1Q23 max_glb)).
*
* @param[in]      WR_4: 24bit(RE): Scaling Factor on output data, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_32_0 by the Init function. \n
*                 Window coeficients are placed in TRAM at TR_0_80_0 by the Init function. \n
*                 Derotation phase coeficients are places in TRAM at TR_0_112_0 by the Init function.
*
* @note           The kernel implementation guarantees no saturation, for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 The current implementation is ONLY to be used in combination with 256 Range FFT 6TX TD-MIMO. \n
*                 The input buffer CAN be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*==================================================================================================*/
/** @cond */
 .global RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d
 .global RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d_size

RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put ODD range bins for all channels
     *        24bit(IM): SRAM offset to ODD range bins (doppler input)
     * WR_12: 24bit(RE): OPRAM address where to put EVEN range bins for all channels
     *        24bit(IM): SRAM offset to EVEN range bins (doppler input)
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins/doppler
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_4_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24)), WR_12
    set #((2 * TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24), WR_13 /* (2*BYTES_CP4D_DATA) = bytes occupied by 8 channels data */

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_14: 24bit(RE): OPRAM address where to get doppler results(ODD range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     * WR_15: 24bit(RE): OPRAM address where to get doppler results(EVEN range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_2_0_0), WR_14
    add .noshift .mod24 WR_2, #(OR_6_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * (2*BYTES_CP4D_DATA)) << 24)), WR_15

/*=========================================================================
 * START DOPPLER FFT128 SECTION
 *=========================================================================*/
    /*=========================================================================
     * set WR_46, for custom left shift. By default, no shift.
     *=========================================================================*/
    set #0x0, WR_46
    sub .noshift .mod24 WR_4, WR_46, WR_46

    /*=========================================================================
     * Prepare registers for indirect addressing
     *=========================================================================
     * WR_16: increment value for the next TD-MIMO slot
     *=========================================================================*/
    set #(CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT | (CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT << 24)), WR_16

    /*=========================================================================
     * LOOP#0: loop #count is number of range bins/2 (2 range bins processed within one iteration)
     *=========================================================================*/
    loop #(RANGE_BINS >> 1)

        /*=========================================================================
         * PDMA: transfer ODD/EVEN range bin data of all 16 virtual channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * ODD range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * VMT: pre shift(WR_3). Separate the channels from each TX slot
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, MEM_SLICES, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_2_0_0, 0x6, 0x1

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_2_0_0, OR_0_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Prepare registers for indirect addressing
         *=========================================================================*/
        /*=========================================================================
         * WR_17: OPRAM address from and where to put rdx results
         * WR_18: OPRAM address from and where to put rdx results
         *=========================================================================*/
        set #((OR_2_0_0) | (OR_0_0_0 << 24)), WR_17
        set #((OR_0_0_0) | (OR_2_0_0 << 24)), WR_18

        /*=========================================================================
         * LOOP#1: Repeat 6(TDMIMO_TX_SLOTS) times(every TD-MIMO slot)
         *=========================================================================*/
        loop #(TDMIMO_TX_SLOTS)

            /*=========================================================================
             * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT128
             *=========================================================================
             *=========================================================================
             * RDX Round 0(+win)...3, Twiddle in TR_0_32_0, Window in TR_0_80_0
             =========================================================================*/
            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x8, 0x8, TR_0_80_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x8, 0x8, TR_0_32_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x8, 0x8, TR_0_32_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx2.ind .cmplx .nosplit .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x8, 0x8, TR_0_32_0

            /*=========================================================================
             * ADD: update OPRAM address for the next TD-MIMO slot
             *=========================================================================*/
            add .noshift .mod24 WR_17, WR_16, WR_17
            add .noshift .mod24 WR_18, WR_16, WR_18

        /*=========================================================================
         * NEXT: end of the loop#1
         *=========================================================================*/
        next

        /*=========================================================================
         * COPY: Copy the first slot as it is (it does not require compensation)
         *=========================================================================*/
        copy.simple CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_2_0_0, 0x1, 0x1

        /*=========================================================================
         * REPEAT: CHANNELS_PER_SLOT times, compensation
         * WIN: multiply with Derotation Phase Vector, CH#<8*n..8*n+7>
         * After ending with one TD-MIMO slot, continues with the next one in the same WIN cmd
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, TDMIMO_COMP_SLOTS*CHIRPS_PER_TX_SLOT, OR_0_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_2_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x8, 0x8, TR_0_112_0, .mod0, 0x1

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * COPY 8x8 transpose for all virtual channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_0_0, OR_0_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8

        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_0_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * VMT: custom shift(WR_46). Default, no shift. Merge all virtual channels
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, MEM_SLICES, 0x0, 0x0
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_2_0_0, 0x1, 0x6

        /*=========================================================================
         * PDMA: transfer doppler results(ODD range bins) of all 48 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * EVEN range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * VMT: pre shift(WR_3). Separate the channels from each TX slot
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, MEM_SLICES, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_4_0_0, OR_6_0_0, 0x6, 0x1

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_6_0_0, OR_4_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Prepare registers for indirect addressing
         *=========================================================================*/
        /*=========================================================================
         * WR_17: OPRAM address from and where to put rdx results
         * WR_18: OPRAM address from and where to put rdx results
         * WR_20: save the initial TD-MIMO slot increment offset
         *=========================================================================*/
        set #((OR_6_0_0) | (OR_4_0_0 << 24)), WR_17
        set #((OR_4_0_0) | (OR_6_0_0 << 24)), WR_18

        /*=========================================================================
         * LOOP#1: Repeat 6(TDMIMO_TX_SLOTS) times(every TD-MIMO slot)
         *=========================================================================*/
        loop #(TDMIMO_TX_SLOTS)

            /*=========================================================================
             * Repeat 8(CHANNELS_PER_SLOT) times Doppler FFT128
             *=========================================================================
             *=========================================================================
             * RDX Round 0(+win)...3, Twiddle in TR_0_32_0, Window in TR_0_80_0
             =========================================================================*/
            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x8, 0x8, TR_0_80_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x8, 0x8, TR_0_32_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx4.ind .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x8, 0x8, TR_0_32_0, .mod0, 0x1

            repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
            rdx2.ind .cmplx .nosplit .qext .noovs .round3 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x8, 0x8, TR_0_32_0

            /*=========================================================================
             * ADD: update OPRAM address for the next TD-MIMO slot
             *=========================================================================*/
            add .noshift .mod24 WR_17, WR_16, WR_17
            add .noshift .mod24 WR_18, WR_16, WR_18

        /*=========================================================================
         * NEXT: end of the loop#1
         *=========================================================================*/
        next

        /*=========================================================================
         * COPY: Copy the first slot as it is (it does not require compensation)
         *=========================================================================*/
        copy.simple CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_4_0_0, OR_6_0_0, 0x1, 0x1

        /*=========================================================================
         * REPEAT: CHANNELS_PER_SLOT times, compensation
         * WIN: multiply with Derotation Phase Vector, CH#<8*n..8*n+7>
         * After ending with one TD-MIMO slot, continues with the next one in the same WIN cmd
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, TDMIMO_COMP_SLOTS*CHIRPS_PER_TX_SLOT, OR_4_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_6_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x8, 0x8, TR_0_112_0, .mod0, 0x1

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * COPY 8x8 transpose for all virtual channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_6_0_0, OR_4_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1, 0x8, 0x8

        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, 0x0, 0x0
        copy.trans CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_6_0_0 + CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_4_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * REPEAT: TDMIMO_TX_SLOTS times
         * VMT: custom shift(WR_46). Default, no shift. Merge all virtual channels
         *=========================================================================*/
        repeat TDMIMO_TX_SLOTS, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, MEM_SLICES, 0x0, 0x0
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_4_0_0, OR_6_0_0, 0x1, 0x6

        /*=========================================================================
         * PDMA: transfer doppler results(EVEN range bins) of all 48 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_13, WR_14
        add .noshift .mod24 WR_15, WR_13, WR_15

    /*=========================================================================
     * NEXT: end of the loop#0
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of FFT128 doppler program
 *=========================================================================*/
 stop

 .set RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d_size, .-RsdkSptDoppler256smp128crp8ch6TxTdMimoCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
