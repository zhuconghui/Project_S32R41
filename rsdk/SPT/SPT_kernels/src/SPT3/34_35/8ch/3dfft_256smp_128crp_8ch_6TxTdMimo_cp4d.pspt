/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,         256
 .set CHIRPS_PER_TX_SLOT,        128
 .set TDMIMO_TX_SLOTS,             6
 .set NR_FFT_POINTS,             128 /* at least 2*TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT */
 .set BYTES_CP4D_DATA,             8
 .set CHANNELS_PER_SLOT,           8 /* total phy channels no */
 .set LOG2_FORMAT_BYTE,            2
 .set HIST_BINS,                  64
 .set BYTES_HIST_BINS,             2
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set SRAM_SLICES,              ((TDMIMO_TX_SLOTS * CHANNELS_PER_SLOT * CHIRPS_PER_TX_SLOT) >> 3)

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d();
* @brief          Function for 3D FFT, 256 chirps, 128 sample/chirp,
*                 8 physical channels/TX slot, 6TX TD-MIMO
* @details        Compute 3D FFT, storing results in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Doppler FFT CP4D compressed results),
*                       relative to SRAM start address, @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp0
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp0
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX0_Crp127
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX1_Crp127
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX5_Crp127
*                 CH4_0-CH5_0-CH6_0-CH7_0-TX5_Crp127           ---> RangeBin #0
*                 --------------------------------------------------------------
*                 |
*                 |
*                 |
*                 --------------------------------------------------------------
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp0
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp0
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp0
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp0
*                 |
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX0_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX0_Crp127
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX1_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX1_Crp127
*                 |
*                 CH0_127-CH1_127-CH2_127-CH3_127-TX5_Crp127
*                 CH4_127-CH5_127-CH6_127-CH7_127-TX5_Crp127   ---> RangeBin #127
*                 ---------------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the RDM OUTPUT buffer(3D FFT matrix),
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16 bit real Log2 Mag2 format
*                 63:48           47:32           31:16           15:0
*                 R0_D0_MAG       R0_D1_MAG       R0_D2_MAG       R0_D3_MAG
*                 |               |               |               |
*                 R0_D124_MAG     R0_D125_MAG     R0_D126_MAG     R0_D127_MAG
*                 R1_D0_MAG       R1_D1_MAG       R1_D2_MAG       R1_D3_MAG
*                 |               |               |               |
*                 R1_D124_MAG     R1_D125_MAG     R1_D126_MAG     R1_D127_MAG
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 R127_D0_MAG     R127_D1_MAG     R127_D2_MAG     R127_D3_MAG
*                 |               |               |               |
*                 R127_D124_MAG   R127_D125_MAG   R127_D126_MAG   R127_D127_MAG
* @endverbatim
*
* @param[out]     WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the Histogram OUTPUT buffer,
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16 bit values histogram counters
*            0x0  bin1  bin0
*            0x4  bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 0
*                 --------------------------
*                 bin1  bin0
*                 bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 1
*                 ---------------------------
*                 |     |
*                 |     |
*                 |     |
*                 --------------------------
*                 bin1  bin0
*                 bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 127
*                 --------------------------
* @endverbatim
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_32_0 by the Init function.
*
* @note           The current implementation is ONLY to be used in combination with 256 Range FFT and 128 Doppler FFT, 6TX TD-MIMO. \n
*                 The input buffer MUST NOT be reused for the histogram or RDM output. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d
 .global RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d_size

RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put first half of each range bin for all channels
     *        24bit(IM): SRAM offset to first half of each range bin (doppler output)
     * WR_12: 24bit(RE): OPRAM address where to put second half of each range bin for all channels
     *        24bit(IM): SRAM offset to first second of each range bin (doppler output)
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins/doppler
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_2_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_6_0_0 | ((TDMIMO_TX_SLOTS * (CHIRPS_PER_TX_SLOT >> 1) * (2*BYTES_CP4D_DATA)) << 24)), WR_12
    set #((2 * TDMIMO_TX_SLOTS * (CHIRPS_PER_TX_SLOT >> 1) * (2*BYTES_CP4D_DATA)) << 24), WR_13

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_14: 24bit(RE): OPRAM address where to get the data after vmt Mag2+Log2, (First half of each range bin)
     *        24bit(IM): SRAM RDM result buffer address offset
     * WR_15: 24bit(RE): OPRAM address where to get the data after vmt Mag2+Log2, (Second half of each range bin)
     *        24bit(IM): SRAM RDM result buffer address offset
     * WR_16: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_2_0_0), WR_14
    add .noshift .mod24 WR_2, #(OR_6_0_0 | (((CHIRPS_PER_TX_SLOT >> 1) * LOG2_FORMAT_BYTE) << 24)), WR_15
    set #((2 * (CHIRPS_PER_TX_SLOT >> 1) * LOG2_FORMAT_BYTE) << 24), WR_16

    /*=========================================================================
     * OUTPUT - Histogram
     *=========================================================================
     * WR_17: 24bit(RE): OPRAM address where to get the histogram counters, for each range bin
     *        24bit(IM): SRAM histogram buffer address offset
     * WR_18: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     *=========================================================================*/
    add .noshift .mod24 WR_3, #(OR_0_0_0), WR_17
    set #((HIST_BINS * BYTES_HIST_BINS) << 24), WR_18

/*=========================================================================
 * 3DFFT SECTION
 *=========================================================================*/
    /*=========================================================================
     * LOOP: loop #count is number of range bins. Process one range bin per iteration
     *=========================================================================*/
    loop #(RANGE_BINS)

        /*=========================================================================
         * COPY with clear. Reset OPRAM banks to zero to prepare for zero padding.
         * PDMA: transfer first and second half of individual range bin data for all 48 virtual channels from SRAM to OPRAM
         * Prepare for oversampled FFT, copy 48 virtual channels and skip 80 zeros.
         *=========================================================================*/
        copy.clear OPRAM_BANK_SIZE, OR_2_0_0, 0x1, 0xFFFF
        copy.clear OPRAM_BANK_SIZE, OR_3_0_0, 0x1, 0xFFFF
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0xA, 0x6, 0x0, 0x1

        copy.clear OPRAM_BANK_SIZE, OR_6_0_0, 0x1, 0xFFFF
        copy.clear OPRAM_BANK_SIZE, OR_7_0_0, 0x1, 0xFFFF
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0xA, 0x6, 0x0, 0x1

        /*=========================================================================
         * First half of individual range bin proccesing part
         *=========================================================================*/

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times FFT on 48 ch samples + 80 zeros
         *=========================================================================
         *=========================================================================
         * RDX Round 0...3, Twiddle in TR_0_32_0
         =========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round0 .nosft, NR_FFT_POINTS, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, NR_FFT_POINTS, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, NR_FFT_POINTS, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, NR_FFT_POINTS, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_32_0

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times VMT
         *=========================================================================
         *=========================================================================
         * VMT: Operation Sequence 1, Mag2 and log2. log2(S^2). Output packed.
         *=========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        vmt.sq1 .cmplx .in_48 .op_on, NR_FFT_POINTS, OR_2_0_0, OR_0_0_0, 0x1, 0x1

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times MAXS
         *=========================================================================
         *=========================================================================
         * MAX: absolute maxima on DOA axis, input packed.
         *=========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, 0x1, 0x0, 0x0
        maxs.gm .no_maxsn .log2 .no_preproc .in_48packed, NR_FFT_POINTS, OR_0_0_0, OR_2_0_0, 0x1, 0x1

        /*=========================================================================
         * PDMA: copy first half of the RDM data to SRAM
         *=========================================================================*/
        pdma.ind .zeropad .16real .opram2sysram .async .notrace, CHIRPS_PER_TX_SLOT>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * Second half of individual range bin proccesing part
         *=========================================================================*/

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times FFT on 48 ch samples + 80 zeros
         *=========================================================================
         *=========================================================================
         * RDX Round 0...3, Twiddle in TR_0_32_0
         =========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round0 .nosft, NR_FFT_POINTS, OR_6_0_0, OR_4_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, NR_FFT_POINTS, OR_4_0_0, OR_6_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, NR_FFT_POINTS, OR_6_0_0, OR_4_0_0, 0x1, 0x1, TR_0_32_0, .mod0, 0x1

        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, NR_FFT_POINTS, OR_4_0_0, OR_6_0_0, 0x1, 0x1, TR_0_32_0

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times VMT
         *=========================================================================
         *=========================================================================
         * VMT: Operation Sequence 1, Mag2 and log2. log2(S^2). Output packed.
         *=========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, NR_FFT_POINTS, 0x0, 0x0
        vmt.sq1 .cmplx .in_48 .op_on, NR_FFT_POINTS, OR_6_0_0, OR_4_0_0, 0x1, 0x1

        /*=========================================================================
         * Repeat 64(CHIRPS_PER_TX_SLOT>>1) times MAXS
         *=========================================================================
         *=========================================================================
         * MAX: absolute maxima on DOA axis, input packed.
         *=========================================================================*/
        repeat CHIRPS_PER_TX_SLOT>>1, NR_FFT_POINTS, 0x1, 0x0, 0x0
        maxs.gm .no_maxsn .log2 .no_preproc .in_48packed, NR_FFT_POINTS, OR_4_0_0, OR_6_0_0, 0x1, 0x1

        /*=========================================================================
         * SYNC: make sure to finish transfering the first half of RDM to SRAM
         *=========================================================================*/
        sync

        /*=========================================================================
         * COPY: move maxs results from second half of each individual range bin next to the results
         * obtained from the first half of the respective range bin.
         *=========================================================================*/
        copy.simple CHIRPS_PER_TX_SLOT>>1, OR_6_0_0, OR_2_0_0 + CHIRPS_PER_TX_SLOT>>1, 0x1, 0x1

        /*=========================================================================
         * PDMA: copy second half of the RDM data to SRAM
         *=========================================================================*/
        pdma.ind .zeropad .16real .opram2sysram .async .notrace, CHIRPS_PER_TX_SLOT>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * HIST: Histogram per range bin. The output will be used for threshold calculation
         * on the CPU. Input in log2 format. Threshold bin: 0
         *=========================================================================*/
        hist .log2 .no_preproc .read_store .64bins .no_preload .no_pack_real .24bits, CHIRPS_PER_TX_SLOT, OR_2_0_0, OR_0_0_0, 0x1, 0x1, 0x0

        /*=========================================================================
         * PDMA: move the Histogram counters in SRAM, for each range bin
         *=========================================================================*/
        pdma.ind .zeropad .16cmplx .opram2sysram .async .notrace, HIST_BINS>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_17, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next first/second half of range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next first/second half of range bin (RDM)
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_16, WR_14
        add .noshift .mod24 WR_15, WR_16, WR_15

        /*=========================================================================
         * ADD: increment output SRAM offset to next range bin histogram
         *=========================================================================*/
        add .noshift .mod24 WR_17, WR_18, WR_17

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of 3DFFT program
 *=========================================================================*/
 stop

 .set RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d_size, .-RsdkSpt3Dfft256smp128crp8ch6TxTdMimoCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
