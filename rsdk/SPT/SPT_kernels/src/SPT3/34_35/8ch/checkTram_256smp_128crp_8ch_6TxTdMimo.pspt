/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set   PACKED_DATA_LENGTH0, (FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT128_WIN_NO>>1 + FFT128_WIN_NO>>1)
 .set   PACKED_DATA_LENGTH1, (PACKED_DATA_LENGTH0 + 5*DEROT_VECT128_NO)
 .set UNPACKED_DATA_LENGTH1, (2*PACKED_DATA_LENGTH1)

 .set   PACKED_DATA_LENGTH2, (FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO)
 .set UNPACKED_DATA_LENGTH2, (2*PACKED_DATA_LENGTH2)

 .set UNPACKED_DATA_LENGTH3, (FFT256_WIN_NO + FFT128_WIN_NO + FFT128_WIN_NO)
 .set UNPACKED_DATA_LENGTH4, (2*5*DEROT_VECT128_NO)

 .set TRAM_LAYOUT_LENGTH,    (FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO + FFT256_WIN_NO + FFT128_WIN_NO + FFT128_WIN_NO + 5*DEROT_VECT128_NO)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptCheckTram256smp128crp8ch6TxTdMimo();
* @brief          Function for checking sanity of persistent TRAM content. 256 samples, 128 chirps, 8 physical channels/TX slot, 6TX TD-Mimo.
* @details        Compare persistent TRAM content with the SRAM/flash reference.
*                 The kernell will reload the twiddles, window, derotation coefficients into SPT memory and compare them
*                 with the data already stored in TRAM at the initialization time.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT256 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
* @endverbatim
*
* * @param[in]      WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT128 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Range FFT 256),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win64   win128   win192
*                 win16  win80   win144   win208
*                 |      |       |        |
*                 |      |       |        |
*                 win15  win79   win143   win207
*                 win31  win95   win159   win223
*                 win32  win96   win160   win224
*                 win48  win112  win176   win240
*                 |      |       |        |
*                 |      |       |        |
*                 win47  win111  win175   win239
*                 win63  win127  win191   win255
* @endverbatim
*
* @param[in]      WR_4: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Doppler FFT128),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win32   win64    win96
*                 win8   win40   win72    win104
*                 |      |       |        |
*                 |      |       |        |
*                 win7   win39   win71    win103
*                 win15  win47   win79    win111
*                 win16  win48   win80    win112
*                 win24  win56   win88    win120
*                 |      |       |        |
*                 |      |       |        |
*                 win23  win55   win87    win119
*                 win31  win63   win95    win127
* @endverbatim
*
* @param[in]      WR_5: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for DBF FFT128),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win32   win64    win96
*                 win8   win40   win72    win104
*                 |      |       |        |
*                 |      |       |        |
*                 win7   win39   win71    win103
*                 win15  win47   win79    win111
*                 win16  win48   win80    win112
*                 win24  win56   win88    win120
*                 |      |       |        |
*                 |      |       |        |
*                 win23  win55   win87    win119
*                 win31  win63   win95    win127
* @endverbatim
*
* @param[in]      WR_6: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Derotation Phased Vector),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48             47:32           31:16           15:0
*                 DeRotPh0_Im-TX1   DeRotPh0_Re-TX1   DeRotPh1_Im-TX1   DeRotPh1_Re-TX1
*                 DeRotPh2_Im-TX1   DeRotPh2_Re-TX1   DeRotPh3_Im-TX1   DeRotPh3_Re-TX1
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 DeRotPh124_Im-TX1 DeRotPh124_Re-TX1 DeRotPh125_Im-TX1 DeRotPh125_Re-TX1
*                 DeRotPh126_Im-TX1 DeRotPh126_Re-TX1 DeRotPh127_Im-TX1 DeRotPh127_Re-TX1
*                 DeRotPh0_Im-TX2   DeRotPh0_Re-TX2   DeRotPh1_Im-TX2   DeRotPh1_Re-TX2
*                 DeRotPh2_Im-TX2   DeRotPh2_Re-TX2   DeRotPh3_Im-TX2   DeRotPh3_Re-TX2
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 DeRotPh124_Im-TX2 DeRotPh124_Re-TX2 DeRotPh125_Im-TX2 DeRotPh125_Re-TX2
*                 DeRotPh126_Im-TX2 DeRotPh126_Re-TX2 DeRotPh127_Im-TX2 DeRotPh127_Re-TX2
*                 DeRotPh0_Im-TX3   DeRotPh0_Re-TX3   DeRotPh1_Im-TX3   DeRotPh1_Re-TX3
*                 DeRotPh2_Im-TX3   DeRotPh2_Re-TX3   DeRotPh3_Im-TX3   DeRotPh3_Re-TX3
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 DeRotPh124_Im-TX3 DeRotPh124_Re-TX3 DeRotPh125_Im-TX3 DeRotPh125_Re-TX3
*                 DeRotPh126_Im-TX3 DeRotPh126_Re-TX3 DeRotPh127_Im-TX3 DeRotPh127_Re-TX3
*                 DeRotPh0_Im-TX4   DeRotPh0_Re-TX4   DeRotPh1_Im-TX4   DeRotPh1_Re-TX4
*                 DeRotPh2_Im-TX4   DeRotPh2_Re-TX4   DeRotPh3_Im-TX4   DeRotPh3_Re-TX4
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 DeRotPh124_Im-TX4 DeRotPh124_Re-TX4 DeRotPh125_Im-TX4 DeRotPh125_Re-TX4
*                 DeRotPh126_Im-TX4 DeRotPh126_Re-TX4 DeRotPh127_Im-TX4 DeRotPh127_Re-TX4
*                 DeRotPh0_Im-TX5   DeRotPh0_Re-TX5   DeRotPh1_Im-TX5   DeRotPh1_Re-TX5
*                 DeRotPh2_Im-TX5   DeRotPh2_Re-TX5   DeRotPh3_Im-TX5   DeRotPh3_Re-TX5
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 |                 |                 |                 |
*                 DeRotPh124_Im-TX5 DeRotPh124_Re-TX5 DeRotPh125_Im-TX5 DeRotPh125_Re-TX5
*                 DeRotPh126_Im-TX5 DeRotPh126_Re-TX5 DeRotPh127_Im-TX5 DeRotPh127_Re-TX5
* @endverbatim
*
* @return         WR_0: will indicate if persistent TRAM content is corrupted or not.
* @retval         0, if persistent TRAM content is not corrupted. \n
*                 >0, if persistent TRAM content is corrupted.
*
* @note           All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptCheckTram256smp128crp8ch6TxTdMimo
 .global RsdkSptCheckTram256smp128crp8ch6TxTdMimo_size

RsdkSptCheckTram256smp128crp8ch6TxTdMimo:

    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put FFT256 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_12: 24bit(RE): OPRAM address where to put FFT128 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_13: 24bit(RE): OPRAM address where to put range FFT256 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_14: 24bit(RE): OPRAM address where to put doppler FFT128 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_15: 24bit(RE): OPRAM address where to put DBF FFT128 window coef
     *        24bit(IM): SRAM twiddle coef address offset
     * WR_16: 24bit(RE): OPRAM address where to put DeRotPh vector
     *        24bit(IM): SRAM derotation phased vector address offset
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0                                                                                                           ), WR_11
    add .noshift .mod24 WR_2, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO                                                                                  ), WR_12
    add .noshift .mod24 WR_3, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO                                                         ), WR_13
    add .noshift .mod24 WR_4, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1                                      ), WR_14
    add .noshift .mod24 WR_5, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT128_WIN_NO>>1                   ), WR_15
    add .noshift .mod24 WR_6, #(OR_2_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT128_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT128_WIN_NO>>1 + FFT128_WIN_NO>>1), WR_16

/*=========================================================================
 * START COMPARE
 *=========================================================================*/
    /*=========================================================================
     * PDMA: Copy 256 FFT twiddles from SRAM to OPRAM
     *       Copy 128 FFT twiddles from SRAM to OPRAM
     *       Copy 256 FFT range window coefficients from SRAM to OPRAM
     *       Copy 128 FFT doppler window coefficients from SRAM to OPRAM
     *       Copy 128 FFT dbf window coefficients from SRAM to OPRAM
     *       Copy DeRotPh vector from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT256_TWIDDLE_SRAM_SLICES,   RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT128_TWIDDLE_SRAM_SLICES,   RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT256_WIN_SRAM_SLICES,       RSDK_SPT_OTHER_BASE_ADDR, WR_13, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT128_WIN_SRAM_SLICES,       RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT128_WIN_SRAM_SLICES,       RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, 5*DEROT_VECT128_SRAM_SLICES,  RSDK_SPT_OTHER_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: Invert DeRotPh vector. Copy half of data.
     *=========================================================================*/
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 0*DEROT_VECT128_NO                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + 0*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 0*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0 + 0*DEROT_VECT128_NO                      , 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 1*DEROT_VECT128_NO                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + 1*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 1*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0 + 1*DEROT_VECT128_NO                      , 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 2*DEROT_VECT128_NO                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + 2*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 2*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0 + 2*DEROT_VECT128_NO                      , 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 3*DEROT_VECT128_NO                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + 3*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 3*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0 + 3*DEROT_VECT128_NO                      , 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 4*DEROT_VECT128_NO                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + 4*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT128_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + 4*DEROT_VECT128_NO + DEROT_VECT128_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0 + 4*DEROT_VECT128_NO                      , 0x1, 0x1

    /*=========================================================================
     * COPY: unpack a complex number into real numbers (in real part only of the OPRAM).
     *=========================================================================*/
    copy.unpack .keep_orig, PACKED_DATA_LENGTH1, OR_0_0_0, OR_2_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY R2I: move the real part into imag part. Prepare for conjugate.
     *=========================================================================*/
    copy.partial_r2i .keep_orig, UNPACKED_DATA_LENGTH1, OR_2_0_0, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * VMT: Conjugate a imag number == negate all the data.
     *=========================================================================*/
    vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .conj_sq2s1 .no_sq2s3, UNPACKED_DATA_LENGTH1, OR_0_0_0, OR_2_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY: reconstruct the original memory layout, as present in TRAM.
     *=========================================================================*/
    copy.imag_pack               UNPACKED_DATA_LENGTH2, OR_2_0_0                                                , OR_0_0_0                      , 0x1, 0x1
    copy.partial_i2r .keep_orig, UNPACKED_DATA_LENGTH3, OR_2_0_0 + UNPACKED_DATA_LENGTH2                        , OR_0_0_0 + PACKED_DATA_LENGTH2, 0x1, 0x1
    copy.clear                   UNPACKED_DATA_LENGTH3,                                                           OR_0_0_0 + PACKED_DATA_LENGTH2, 0x1, 0xAAAA
    copy.imag_pack               UNPACKED_DATA_LENGTH4, OR_2_0_0 + UNPACKED_DATA_LENGTH2 + UNPACKED_DATA_LENGTH3, OR_0_0_0 + PACKED_DATA_LENGTH2 + UNPACKED_DATA_LENGTH3, 0x1, 0x1

    /*=========================================================================
     * VMT: Vector add. Add TRAM persistent content to the negated OPRAM content.
     *=========================================================================*/
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 TR_0_0_0 .no_sq2s3, TRAM_LAYOUT_LENGTH, OR_0_0_0, OR_2_0_0, 0x1, 0x1

    /*=========================================================================
     * Global MAXS on the entire data(Real ABS preprocessing), PACKED input(x2).
     *=========================================================================*/
    set #0x0, OR_0_0_0
    maxs.gm .no_maxsn .real .abs_proc .in_48packed, 2*TRAM_LAYOUT_LENGTH, OR_2_0_0, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * GET: get overall max value from OPRAM in WR_0.
     *=========================================================================*/
    get OR_0_0_0, WR_0

    /*=========================================================================
     * Workaround for errata ERR010997: the CPU is only allowed to read WR0 before the STOP instruction
     * and this can only be done using an EVT/WAIT handshake with the SPT kernel right before STOP.
     * Use 'lsb' event line for this.
     *=========================================================================*/
    evt.cpu 0

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0

    /*=========================================================================
     * STOP cmd
     *=========================================================================*/
    stop

 .set RsdkSptCheckTram256smp128crp8ch6TxTdMimo_size, .-RsdkSptCheckTram256smp128crp8ch6TxTdMimo
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
