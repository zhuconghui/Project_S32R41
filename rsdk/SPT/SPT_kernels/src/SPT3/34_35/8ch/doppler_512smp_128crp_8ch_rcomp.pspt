/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,        512
 .set CHIRPS_PER_FRAME,         128
 .set BYTES_COMPLEX_FFT_SAMPLE,   4
 .set CHANNELS_NO,                8 /* total phy channels no */
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set DATA_SRAM_SLICES,         ((CHANNELS_NO * CHIRPS_PER_FRAME) >> 1)
 .set CF_SRAM_SLICES,           ((CHANNELS_NO * CHIRPS_PER_FRAME) >> 3) /* 4 CF per SRAM slice */

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDoppler512smp128crp8chRcomp();
* @brief          Function for Doppler FFT 128, 8 channels(CH#0..CH#7).
* @details        Compute Doppler FFT, plus compensation for Range Adaptive scaling, storing the results in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Range FFT results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48               47:32               31:16               15:0
*                 CH0_0-Im-Crp0       CH0_0-Re-Crp0       CH1_0-Im-Crp0       CH1_0-Re-Crp0
*                 CH2_0-Im-Crp0       CH2_0-Re-Crp0       CH3_0_Im-Crp0       CH3_0-Re-Crp0
*                 CH4_0-Im-Crp0       CH4_0-Re-Crp0       CH5_0-Im-Crp0       CH5_0-Re-Crp0
*                 CH6_0-Im-Crp0       CH6_0-Re-Crp0       CH7_0-Im-Crp0       CH7_0-Re-Crp0
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 CH0_0-Im-Crp127     CH0_0-Re-Crp127     CH1_0-Im-Crp127     CH1_0-Re-Crp127
*                 CH2_0-Im-Crp127     CH2_0-Re-Crp127     CH3_0_Im-Crp127     CH3_0-Re-Crp127
*                 CH4_0-Im-Crp127     CH4_0-Re-Crp127     CH5_0-Im-Crp127     CH5_0-Re-Crp127
*                 CH6_0-Im-Crp127     CH6_0-Re-Crp127     CH7_0-Im-Crp127     CH7_0-Re-Crp127    ---> RangeBin #0
*                 -------------------------------------------------------------------------------------------------
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 -------------------------------------------------------------------------------------------------
*                 CH0_255-Im-Crp0     CH0_255-Re-Crp0     CH1_255-Im-Crp0     CH1_255-Re-Crp0
*                 CH2_255-Im-Crp0     CH2_255-Re-Crp0     CH3_255_Im-Crp0     CH3_255-Re-Crp0
*                 CH4_255-Im-Crp0     CH4_255-Re-Crp0     CH5_255-Im-Crp0     CH5_255-Re-Crp0
*                 CH6_255-Im-Crp0     CH6_255-Re-Crp0     CH7_255-Im-Crp0     CH7_255-Re-Crp0
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 CH0_255-Im-Crp127   CH0_255-Re-Crp127   CH1_255-Im-Crp127   CH1_255-Re-Crp127
*                 CH2_255-Im-Crp127   CH2_255-Re-Crp127   CH3_255_Im-Crp127   CH3_255-Re-Crp127
*                 CH4_255-Im-Crp127   CH4_255-Re-Crp127   CH5_255-Im-Crp127   CH5_255-Re-Crp127
*                 CH6_255-Im-Crp127   CH6_255-Re-Crp127   CH7_255-Im-Crp127   CH7_255-Re-Crp127  ---> RangeBin #255
*                 -------------------------------------------------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(Doppler FFT results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48               47:32               31:16               15:0
*                 CH0_0-Im-Crp0       CH0_0-Re-Crp0       CH1_0-Im-Crp0       CH1_0-Re-Crp0
*                 CH2_0-Im-Crp0       CH2_0-Re-Crp0       CH3_0_Im-Crp0       CH3_0-Re-Crp0
*                 CH4_0-Im-Crp0       CH4_0-Re-Crp0       CH5_0-Im-Crp0       CH5_0-Re-Crp0
*                 CH6_0-Im-Crp0       CH6_0-Re-Crp0       CH7_0-Im-Crp0       CH7_0-Re-Crp0
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 CH0_0-Im-Crp127     CH0_0-Re-Crp127     CH1_0-Im-Crp127     CH1_0-Re-Crp127
*                 CH2_0-Im-Crp127     CH2_0-Re-Crp127     CH3_0_Im-Crp127     CH3_0-Re-Crp127
*                 CH4_0-Im-Crp127     CH4_0-Re-Crp127     CH5_0-Im-Crp127     CH5_0-Re-Crp127
*                 CH6_0-Im-Crp127     CH6_0-Re-Crp127     CH7_0-Im-Crp127     CH7_0-Re-Crp127    ---> RangeBin #0
*                 -------------------------------------------------------------------------------------------------
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 -------------------------------------------------------------------------------------------------
*                 CH0_255-Im-Crp0     CH0_255-Re-Crp0     CH1_255-Im-Crp0     CH1_255-Re-Crp0
*                 CH2_255-Im-Crp0     CH2_255-Re-Crp0     CH3_255_Im-Crp0     CH3_255-Re-Crp0
*                 CH4_255-Im-Crp0     CH4_255-Re-Crp0     CH5_255-Im-Crp0     CH5_255-Re-Crp0
*                 CH6_255-Im-Crp0     CH6_255-Re-Crp0     CH7_255-Im-Crp0     CH7_255-Re-Crp0
*                 |                   |                   |                   |
*                 |                   |                   |                   |
*                 CH0_255-Im-Crp127   CH0_255-Re-Crp127   CH1_255-Im-Crp127   CH1_255-Re-Crp127
*                 CH2_255-Im-Crp127   CH2_255-Re-Crp127   CH3_255_Im-Crp127   CH3_255-Re-Crp127
*                 CH4_255-Im-Crp127   CH4_255-Re-Crp127   CH5_255-Im-Crp127   CH5_255-Re-Crp127
*                 CH6_255-Im-Crp127   CH6_255-Re-Crp127   CH7_255-Im-Crp127   CH7_255-Re-Crp127  ---> RangeBin #255
*                 -------------------------------------------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Compensation factors list),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       These compensation factors are multiplication factors, not to be used directly from Range CF which are shift factors.
*                       Shall be computed on the CORE based on the Range CF: doppler_cf[i] = 0x7FFF >> range_cf[i].
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16bit real
*                 63:48           47:32           31:16           15:0
*                 CF0_CH0CH1      CF1_CH0CH1      CF2_CH0CH1      CF3_CH0CH1
*                 |               |               |               |
*                 CF124_CH0CH1    CF125_CH0CH1    CF126_CH0CH1    CF127_CH0CH1
*                 CF0_CH2CH3      CF1_CH2CH3      CF2_CH2CH3      CF3_CH2CH3
*                 |               |               |               |
*                 CF124_CH2CH3    CF125_CH2CH3    CF126_CH2CH3    CF127_CH2CH3
*                 CF0_CH4CH5      CF1_CH4CH5      CF2_CH4CH5      CF3_CH4CH5
*                 |               |               |               |
*                 CF124_CH4CH5    CF125_CH4CH5    CF126_CH4CH5    CF127_CH4CH5
*                 CF0_CH6CH7      CF1_CH6CH7      CF2_CH6CH7      CF3_CH6CH7
*                 |               |               |               |
*                 CF124_CH6CH7    CF125_CH6CH7    CF126_CH6CH7    CF127_CH6CH7
* @endverbatim
*
* @param[in]      WR_4: 24bit(RE): Scaling Factor, e.g. 1 for scale left with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_64_0 by the Init function. \n
*                 Window coeficients are placed in TRAM at TR_0_144_0 by the Init function. \n
*                 The kernel rely on the assumption that TRAM can be used as temp buffer from TR_0_162_0 to TR_0_226_0.
*
* @note           The kernel implementation guarantees no saturation, for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 The current implementation is ONLY to be used in combination with 512 Range FFT. \n
*                 The input buffer CAN be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptDoppler512smp128crp8chRcomp
 .global RsdkSptDoppler512smp128crp8chRcomp_size

RsdkSptDoppler512smp128crp8chRcomp:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put ODD range bins for all channels
     *        24bit(IM): SRAM offset to ODD range bins (doppler input)
     * WR_12: 24bit(RE): OPRAM address where to put EVEN range bins for all channels
     *        24bit(IM): SRAM offset to EVEN range bins (doppler input)
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins/doppler
     * WR_14: 24bit(RE): OPRAM address where to put compensation factor list
     *        24bit(IM): SRAM offset to compensation factor list buffer
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_2_0_0 | ((CHANNELS_NO * CHIRPS_PER_FRAME * BYTES_COMPLEX_FFT_SAMPLE) << 24)), WR_12
    set #((2 * CHANNELS_NO * CHIRPS_PER_FRAME * BYTES_COMPLEX_FFT_SAMPLE) << 24), WR_13
    add .noshift .mod24 WR_3, #(OR_4_0_0), WR_14

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_15: 24bit(RE): OPRAM address where to get doppler results(ODD range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     * WR_16: 24bit(RE): OPRAM address where to get doppler results(EVEN range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_0_0_0), WR_15
    add .noshift .mod24 WR_2, #(OR_2_0_0 | ((CHANNELS_NO * CHIRPS_PER_FRAME * BYTES_COMPLEX_FFT_SAMPLE) << 24)), WR_16

/*=========================================================================
 * START DOPPLER FFT128 SECTION
 *=========================================================================*/
    /*=========================================================================
     * set WR_46, for custom left shift. By default, right shift 8
     *=========================================================================*/
    set #0x8, WR_46
    sub .noshift .mod24 WR_4, WR_46, WR_46

    /*=========================================================================
     * PDMA: transfer compensation factor list buffer into OPRAM
     *=========================================================================*/
    pdma.ind .signext .16real .sysram2opram .sync .notrace, CF_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: move the compensation factors into TRAM
     *=========================================================================*/
    copy.simple CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_4_0_0, TR_0_162_0, 0x1, 0x1

    /*=========================================================================
     * LOOP#0: loop #count is number of range bins/2 (2 range bins processed within one iteration)
     *=========================================================================*/
    loop #(RANGE_BINS >> 1)

        /*=========================================================================
         * PDMA: transfer ODD/EVEN range bin data of all 8 channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .16cmplx .sysram2opram  .sync .notrace, DATA_SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
        pdma.ind .signext .16cmplx .sysram2opram .async .notrace, DATA_SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * ODD range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         *=========================================================================*/
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME, OR_0_0_0, OR_1_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Repeat 4(CHANNELS_NO>>1) times compensation for CH#<2*n>
         *=========================================================================
         *=========================================================================
         * WIN(+prescaling): multiply with compensation factors vector. Vector in TR_0_162_0 (real)
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        repeat CHANNELS_NO>>1, 2*MEM_SLICES, 2*MEM_SLICES, CHIRPS_PER_FRAME, 0x0
        win .cmplx .real_win_real_tram .shift8, CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x8, 0x8, TR_0_162_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 4(CHANNELS_NO>>1) times compensation for CH#<2*n+1>
         *=========================================================================
         *=========================================================================
         * WIN(+prescaling): multiply with compensation factors vector. Vector in TR_0_162_0 (real)
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        repeat CHANNELS_NO>>1, 2*MEM_SLICES, 2*MEM_SLICES, CHIRPS_PER_FRAME, 0x0
        win .cmplx .real_win_real_tram .shift8, CHIRPS_PER_FRAME, OR_1_1_0, OR_0_1_0, 0x8, 0x8, TR_0_162_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_NO) times Doppler FFT128
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_64_0, Window in TR_0_144_0
         =========================================================================*/
        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_FRAME, OR_0_0_0, OR_1_0_0, 0x8, 0x8, TR_0_144_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_FRAME, OR_0_0_0, OR_1_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x8, 0x8, TR_0_64_0

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_0_0_0, OR_1_0_0 + CHANNELS_NO*CHIRPS_PER_FRAME>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_0_0_0 + CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_1_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * VMT: custom shift(WR_46). Default shift left by 8(to compensate the pre-scalling)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_NO*CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x1, 0x1

        /*=========================================================================
         * PDMA: transfer doppler results(ODD range bins) of all 8 channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .16cmplx .opram2sysram .async .notrace, CHANNELS_NO*CHIRPS_PER_FRAME, RSDK_SPT_CUBE_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * EVEN range bins proccesing part
         *=========================================================================*/

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         *=========================================================================*/
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME, OR_2_0_0, OR_3_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * Repeat 4(CHANNELS_NO>>1) times compensation for CH#<2*n>
         *=========================================================================
         *=========================================================================
         * WIN(+prescaling): multiply with compensation factors vector. Vector in TR_0_162_0 (real)
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        repeat CHANNELS_NO>>1, 2*MEM_SLICES, 2*MEM_SLICES, CHIRPS_PER_FRAME, 0x0
        win .cmplx .real_win_real_tram .shift8, CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x8, 0x8, TR_0_162_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 4(CHANNELS_NO>>1) times compensation for CH#<2*n+1>
         *=========================================================================
         *=========================================================================
         * WIN(+prescaling): multiply with compensation factors vector. Vector in TR_0_162_0 (real)
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        repeat CHANNELS_NO>>1, 2*MEM_SLICES, 2*MEM_SLICES, CHIRPS_PER_FRAME, 0x0
        win .cmplx .real_win_real_tram .shift8, CHIRPS_PER_FRAME, OR_3_1_0, OR_2_1_0, 0x8, 0x8, TR_0_162_0, .mod0, 0x1

        /*=========================================================================
         * Repeat 8(CHANNELS_NO) times Doppler FFT128
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win)...3, Twiddle in TR_0_64_0, Window in TR_0_144_0
         =========================================================================*/
        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_FRAME, OR_2_0_0, OR_3_0_0, 0x8, 0x8, TR_0_144_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_FRAME, OR_2_0_0, OR_3_0_0, 0x8, 0x8, TR_0_64_0, .mod0, 0x1

        repeat CHANNELS_NO, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x8, 0x8, TR_0_64_0

        /*=========================================================================
         * COPY 8x8 transpose for all channels
         * Invert the spectrum, DC in the middle. Copy half of data.
         *=========================================================================*/
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_2_0_0, OR_3_0_0 + CHANNELS_NO*CHIRPS_PER_FRAME>>1, 0x1, 0x1, 0x8, 0x8
        copy.trans CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_2_0_0 + CHANNELS_NO*CHIRPS_PER_FRAME>>1, OR_3_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * VMT: custom shift(WR_46). Default shift left by 8(to compensate the pre-scalling)
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_NO*CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x1, 0x1

        /*=========================================================================
         * PDMA: transfer doppler results(EVEN range bins) of all 8 channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .16cmplx .opram2sysram .async .notrace, CHANNELS_NO*CHIRPS_PER_FRAME, RSDK_SPT_CUBE_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_15, WR_13, WR_15
        add .noshift .mod24 WR_16, WR_13, WR_16

    /*=========================================================================
     * NEXT: end of the loop#0
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of FFT128 doppler program
 *=========================================================================*/
 stop

 .set RsdkSptDoppler512smp128crp8chRcomp_size, .-RsdkSptDoppler512smp128crp8chRcomp
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
