/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,        1024
 .set CHIRPS_PER_TX_SLOT,        64
 .set TDMIMO_TX_SLOTS,            4
 .set TDMIMO_COMP_SLOTS,        (TDMIMO_TX_SLOTS - 1) /* number of slots that need compensation */
 .set BYTES_CP4D_DATA,            8
 .set CHANNELS_PER_SLOT,          4 /* total phy channels no */
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set SRAM_SLICES,              ((TDMIMO_TX_SLOTS * CHANNELS_PER_SLOT * CHIRPS_PER_TX_SLOT) >> 2)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
 /*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*==================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d();
* @brief          Function for Doppler FFT 1024, 4 physical channels/TX slot, 4TX TD-MIMO
* @details        Compute Doppler FFT storing compressed results(CP4D) in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Range FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
* 				  CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX2_Crp0
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX3_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp63
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp63
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX2_Crp63
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX3_Crp63            ---> RangeBin #0
*                 ---------------------------------------------------------------
*                 |
*                 |
*                 |
*                 ---------------------------------------------------------------
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX0_Crp0
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX1_Crp0
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX2_Crp0
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX3_Crp0
*                 |
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX0_Crp63
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX1_Crp63
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX2_Crp63
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX3_Crp63    ---> RangeBin #511
*                 ---------------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(Doppler FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR"
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
* 				  CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp0
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp0
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX2_Crp0
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX3_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX0_Crp63
*                 CH0_0-CH1_0-CH2_0-CH3_0-TX1_Crp63
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX2_Crp63
*				  CH0_0-CH1_0-CH2_0-CH3_0-TX3_Crp63            ---> RangeBin #0
*                 ---------------------------------------------------------------
*                 |
*                 |
*                 |
*                 ---------------------------------------------------------------
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX0_Crp0
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX1_Crp0
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX2_Crp0
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX3_Crp0
*                 |
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX0_Crp63
*                 CH0_511-CH1_511-CH2_511-CH3_511-TX1_Crp63
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX2_Crp63
*				  CH0_511-CH1_511-CH2_511-CH3_511-TX3_Crp63    ---> RangeBin #511
*                 ---------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): Pre-Scaling Factor, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0. \n
*                       Value given from the application level, based on global max provided by the range kernel. \n
*                       Shall be computed on the CORE as: pre_scaling value = floor(log2(0x7FFFFF / 1Q23 max_glb)).
*
* @param[in]      WR_4: 24bit(RE): Scaling Factor on output data, e.g. 1 for left shift with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_128_0 by the Init function. \n
*                 Window coeficients are placed in TRAM at TR_0_264_0 by the Init function. \n
*                 Derotation phase coeficients are places in TRAM at TR_0_276_0 by the Init function.
*
* @note           The current implementation is ONLY to be used in combination with 1024 Range FFT 4TX TD-MIMO CP4D. \n
*                 The input buffer CAN be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*==================================================================================================*/
/** @cond */
 .global RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d
 .global RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d_size

RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put ODD range bins for all channels
     *        24bit(IM): SRAM offset to ODD range bins (doppler input)
     * WR_12: 24bit(RE): OPRAM address where to put EVEN range bins for all channels
     *        24bit(IM): SRAM offset to EVEN range bins (doppler input)
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins/doppler
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_3_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * BYTES_CP4D_DATA) << 24)), WR_12
    set #((2*(TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * BYTES_CP4D_DATA)) << 24), WR_13

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_14: 24bit(RE): OPRAM address where to get doppler results(ODD range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     * WR_15: 24bit(RE): OPRAM address where to get doppler results(EVEN range bins) for all channels
     *        24bit(IM): SRAM doppler result buffer address offset
     *=========================================================================*/
     add .noshift .mod24 WR_2, #(OR_0_0_0), WR_14
     add .noshift .mod24 WR_2, #(OR_3_0_0 | ((TDMIMO_TX_SLOTS * CHIRPS_PER_TX_SLOT * BYTES_CP4D_DATA) << 24)), WR_15

/*=========================================================================
 * START DOPPLER FFT SECTION
 *=========================================================================*/
    /*=========================================================================
     * set WR_46, for custom left shift. By default, no shift.
     *=========================================================================*/
    set #0x0, WR_46
    sub .noshift .mod24 WR_4, WR_46, WR_46

    /*=========================================================================
     * LOOP: loop #count is number of range bins/2 (2 range bins processed within one iteration)
     *=========================================================================*/
    loop #(RANGE_BINS >> 1)

        /*=========================================================================
         * PDMA: transfer compressed range FFT samples of all 16 virtual channels from SRAM to OPRAM, ODD/EVEN samples
         *=========================================================================*/
        pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ODD range bins proccesing part // first chirp
         *=========================================================================
        /*=========================================================================
         * VMT: pre shift(WR_3).
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_0_0_0, OR_1_0_0, 0x1, 0x1

        /*=========================================================================
         * COPY 8x8 transpose all virtual channels
         * output: 128 columns of alternating data(4 columns for TX0-CH0/CH1/CH2/CH4, 4 columns for TX1, 4 columns of TX2 and 4 columns for TX3)
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_1_0_0, OR_0_0_0,  0x2, 0x1, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_1_1_0, OR_0_8_0,  0x2, 0x1, 0x10, 0x10

        /*=========================================================================
         * Prepare registers for indirect addressing
         *=========================================================================*/
        /*=========================================================================
         * WR_17: OPRAM address from and where to put rdx results
         * WR_18: OPRAM address from and where to put rdx results
         *=========================================================================*/
        set #((OR_1_0_0) | (OR_0_0_0 << 24)), WR_17
        set #((OR_0_0_0) | (OR_1_0_0 << 24)), WR_18

        /*=========================================================================
         * Repeat 16 times Doppler FFT64
         * FFT64 for TXi, all phy channels skipping 16 columns
         * RDX4 Round 0(+win)...2, src & dest inc 16, Twiddle in TR_0_128_0, Window in TR_0_264_0
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x10, 0x10, TR_0_264_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x10, 0x10, TR_0_128_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x10, 0x10, TR_0_128_0, .mod0, 0x1

         /*=========================================================================
         * COPY: Copy the first slot as it is (it does not require compensation)
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        copy.simple CHIRPS_PER_TX_SLOT, OR_1_0_0, OR_0_0_0, 0x10, 0x10

         /*=========================================================================
         * REPEAT: CHANNELS_PER_SLOT times, compensation, same vector applies for all phy channels of one TX
         * WIN: multiply with Derotation Phase Vector
         * After ending with one TD-MIMO slot, continues with the next one in the same WIN cmd
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_1_4_0,  OR_0_4_0, 0x10, 0x10, TR_0_276_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_1_8_0,  OR_0_8_0, 0x10, 0x10, TR_0_284_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_1_12_0, OR_0_12_0, 0x10, 0x10, TR_0_292_0, .mod0, 0x1

        /*=========================================================================
         * COPY 8x8 transpose all 16 virtual channels.
         * Invert the spectrum, DC in the middle. Copy half of data.
         * interleave TX0&TX1 with TX2&TX3 at destination
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_0_0_0, OR_1_0_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x2, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_0_0_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_1_0_0, 0x1, 0x2, 0x10, 0x10

        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_0_8_0, OR_1_1_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x2, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_0_8_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_1_1_0, 0x1, 0x2, 0x10, 0x10

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift. Merge all virtual channels
         * at this point we have already interleaved data for TX0&TX1, TX2&TX3
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_1_0_0,  OR_0_0_0, 0x1, 0x1

        /*=========================================================================
         * PDMA: transfer doppler results(EVEN range bins) of all 16 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1


        /*=========================================================================
         * EVEN range bins proccesing part
         *=========================================================================
        /*=========================================================================
         * Prepare registers for indirect addressing
         *=========================================================================*/
        /*=========================================================================
         * WR_17: OPRAM address from and where to put rdx results
         * WR_18: OPRAM address from and where to put rdx results
         *=========================================================================*/
        set #((OR_2_0_0) | (OR_3_0_0 << 24)), WR_17
        set #((OR_3_0_0) | (OR_2_0_0 << 24)), WR_18

        /*=========================================================================
         * VMT: pre shift(WR_3).
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_3 .no_sq2s3, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_3_0_0, OR_2_0_0, 0x1, 0x1

        /*=========================================================================
         * COPY 8x8 transpose all virtual channels
         * output: 128 columns of alternating data(4 columns for TX0-CH0/CH1/CH2/CH4, 4 columns for TX1, 4 columns of TX2 and 4 columns for TX3)
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_0_0, OR_3_0_0,  0x2, 0x1, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_1_0, OR_3_8_0,  0x2, 0x1, 0x10, 0x10

         /*=========================================================================
         * Repeat 16 times Doppler FFT64
         * FFT64 for TXi, all channels skipping 16 columns
         * RDX4 Round 0(+win)...2, src & dest inc 16, Twiddle in TR_0_128_0, Window in TR_0_264_0
         *=========================================================================*/

        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x10, 0x10, TR_0_264_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .no_win .qext .noovs .round1 .nosft, CHIRPS_PER_TX_SLOT, WR_18, 0x10, 0x10, TR_0_128_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT*TDMIMO_TX_SLOTS, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        rdx4.ind .cmplx .no_win .qext .noovs .round2 .nosft, CHIRPS_PER_TX_SLOT, WR_17, 0x10, 0x10, TR_0_128_0, .mod0, 0x1

       /*=========================================================================
         * COPY: Copy the first slot as it is (it does not require compensation)
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        copy.simple CHIRPS_PER_TX_SLOT, OR_2_0_0, OR_3_0_0, 0x10, 0x10

         /*=========================================================================
         * REPEAT: CHANNELS_PER_SLOT times, compensation, same vector applies for all phy channels of one TX
         * WIN: multiply with Derotation Phase Vector
         * After ending with one TD-MIMO slot, continues with the next one in the same WIN cmd
         *=========================================================================*/
        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_2_4_0,  OR_3_4_0, 0x10, 0x10, TR_0_276_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_2_8_0,  OR_3_8_0, 0x10, 0x10, TR_0_284_0, .mod0, 0x1

        repeat CHANNELS_PER_SLOT, MEM_SLICES, MEM_SLICES, 0x0, 0x0
        win .cmplx .cmplx_win .nosft, CHIRPS_PER_TX_SLOT, OR_2_12_0, OR_3_12_0, 0x10, 0x10, TR_0_292_0, .mod0, 0x1

        /*=========================================================================
         * COPY 8x8 transpose all 16 virtual channels.
         * Invert the spectrum, DC in the middle. Copy half of data.
         * interleave TX0&TX1 with TX2&TX3 at destination
         *=========================================================================*/
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_3_0_0, OR_2_0_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x2, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_3_0_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_0_0, 0x1, 0x2, 0x10, 0x10

        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_3_8_0, OR_2_1_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, 0x1, 0x2, 0x10, 0x10
        copy.trans TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>2, OR_3_8_0 + TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT>>1, OR_2_1_0, 0x1, 0x2, 0x10, 0x10

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift. Merge all virtual channels
         * at this point we have already interleaved data for TX0&TX1, TX2&TX3
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, OR_2_0_0,  OR_3_0_0, 0x1, 0x1

        /*=========================================================================
         * PDMA: transfer doppler results(EVEN range bins) of all 16 virtual channels from OPRAM to SRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, TDMIMO_TX_SLOTS*CHANNELS_PER_SLOT*CHIRPS_PER_TX_SLOT, RSDK_SPT_CUBE_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next compressed ODD/EVEN range bins
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next compressed ODD/EVEN range bins
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_13, WR_14
        add .noshift .mod24 WR_15, WR_13, WR_15

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of FFT 64 doppler program
 *=========================================================================*/
 stop

 .set RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d_size, .-RsdkSptDoppler1024smp64crp4ch4TxTdMimoCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
