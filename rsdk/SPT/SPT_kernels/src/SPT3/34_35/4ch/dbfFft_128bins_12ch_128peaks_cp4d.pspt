/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"              /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set BYTES_CP4D_DATA,        8
 .set CHANNELS_8NO,           8
 .set CHANNELS_12NO,         12
 .set PEAK_NO,              128
 .set PEAKS_PER_ITER,        64 /* peaks to be proccesed at a time */
 .set BYTES_AZIMUT_SAMPLE,    4
 .set AZIMUTH_BINS_NO,      128
 .set MAX_VECT_LENGHT,        0 /* alias to 8192 max vect size */
 .set SRAM_SLICES,          ((PEAKS_PER_ITER * CHANNELS_12NO) >> 2) /* three SRAM slice contains compressed data for 1 Peak */

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptDbfFFT128Bins12Ch128PeaksCp4d();
* @brief          Function for Digital BeamForming - DBF for 128 bins, 12 channels and 128 peaks.
* @details        Compute FFT 128 (16 bit complex format) for each peak.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Compressed Peak list),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0     -> P0
*                 CH4_0-CH5_0-CH6_0-CH7_0     -> P0
*                 CH8_0-CH9_0-CH10_0-CH11_0   -> P0
*                 |
*                 |
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0     -> P127
*                 CH4_0-CH5_0-CH6_0-CH7_0     -> P127
*                 CH8_0-CH9_0-CH10_0-CH11_0   -> P127
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(128 Azimut bins for 128 peaks),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16 bit real Log2 Mag2 format
*                 63:48           47:32           31:16           15:0
*                 AzBin0-Im       AzBin0-Re       AzBin1-Im       AzBin1-Re
*                 AzBin2-Im       AzBin2-Re       AzBin3-Im       AzBin3-Re
*                 |               |               |               |
*                 AzBin124-Im     AzBin124-Re     AzBin125-Im     AzBin125-Re
*                 AzBin126-Im     AzBin126-Re     AzBin127-Im     AzBin127-Re  ---> P0
*                 ---------------------------------------------------------------------
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 ---------------------------------------------------------------------
*                 AzBin0-Im       AzBin0-Re       AzBin1-Im       AzBin1-Re
*                 AzBin2-Im       AzBin2-Re       AzBin3-Im       AzBin3-Re
*                 |               |               |               |
*                 AzBin124-Im     AzBin124-Re     AzBin125-Im     AzBin125-Re
*                 AzBin126-Im     AzBin126-Re     AzBin127-Im     AzBin127-Re  ---> P127
*                 ----------------------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT128 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For twiddle generation algorithm, see S32R41_RM 68.9.5.3 / SAF85xx_RM 68.9.5.3.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
*                 tw16_Im  tw16_Re  tw16_Im  tw16_Re
* @endverbatim
*
* @param[in]      WR_4: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for DBF FFT128),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For reorder algorithm, see S32R41_RM 68.9.9.7 / SAF85xx_RM 68.9.9.7.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win32   win64    win96
*                 win8   win40   win72    win104
*                 |      |       |        |
*                 |      |       |        |
*                 win7   win39   win71    win103
*                 win15  win47   win79    win111
*                 win16  win48   win80    win112
*                 win24  win56   win88    win120
*                 |      |       |        |
*                 |      |       |        |
*                 win23  win55   win87    win119
*                 win31  win63   win95    win127
* @endverbatim
*
* @param[in]      WR_5: 24bit(RE): Scaling Factor, e.g. 1 for scale left with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            The kernel rely on the assumption that TRAM can be used as temp buffer from TR_0_320_0 to TR_0_351_7.
*
* @note           The kernel implementation guarantees no saturation, for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 The input buffer CANNOT be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptDbfFFT128Bins12Ch128PeaksCp4d
 .global RsdkSptDbfFFT128Bins12Ch128PeaksCp4d_size

RsdkSptDbfFFT128Bins12Ch128PeaksCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address to put first chunk of PEAKS_PER_ITER peak samples of 12 channels
     *        24bit(IM): SRAM offset to first chunk of peak samples
     * WR_12: 24bit(RE): OPRAM address to put second chunk of PEAKS_PER_ITER peak samples of 12 channels
     *        24bit(IM): SRAM offset to second chunk of peak samples
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_4_0_0 | ((PEAKS_PER_ITER * ((CHANNELS_12NO >> 2)*BYTES_CP4D_DATA)) << 24)), WR_12

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_13: 24bit(RE): OPRAM address to get azimut bins for first chunk of PEAKS_PER_ITER peaks
     *        24bit(IM): SRAM azimut bins address offset for first chunk of PEAKS_PER_ITER peaks
     * WR_14: 24bit(RE): OPRAM address to get azimut bins for second chunk of PEAKS_PER_ITER peaks
     *        24bit(IM): SRAM azimut bins address offset for second chunk of PEAKS_PER_ITER peaks
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_0_0_0), WR_13
    add .noshift .mod24 WR_2, #(OR_4_0_0 | (PEAKS_PER_ITER * AZIMUTH_BINS_NO * BYTES_AZIMUT_SAMPLE) << 24), WR_14

    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_15: 24bit(RE): OPRAM address where to put DBF FFT128 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_16: 24bit(RE): OPRAM address where to put DBF FFT128 window coeficients
     *        24bit(IM): SRAM window coeficients address offset
     *=========================================================================*/
     add .noshift .mod24 WR_3,  #(OR_2_0_0), WR_15
     add .noshift .mod24 WR_4, #(OR_2_16_0), WR_16

/*=========================================================================
 * START FFT128 BEAMFORMING
 *=========================================================================*/
    /*=========================================================================
     * set WR_46, for custom left shift. By default, left shift 5(compensation with 3 zeropad 12 -> 128)
     *=========================================================================*/
    set #0x5, WR_46
    sub .noshift .mod24 WR_5, WR_46, WR_46

    /*=========================================================================
     * PDMA: Copy 128FFT DBF twiddles from SRAM to OPRAM
     *       Copy 128FFT DBF window coeficients from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .zeropad .16cmplx .sysram2opram .sync .notrace, FFT128_TWIDDLE_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1
    pdma.ind .zeropad .16real  .sysram2opram .sync .notrace, FFT128_WIN_SRAM_SLICES,     RSDK_SPT_OTHER_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * PDMA: transfer first/second chunk of PEAKS_PER_ITER compressed peak samples for all 12 channels from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: Copy 128FFT DBF twiddles into TRAM
     *       Copy 128FFT DBF window coeficients into TRAM
     *=========================================================================*/
    copy.simple FFT128_TRAM_TWIDDLE_NO,  OR_2_0_0, TR_0_320_0, 0x1, 0x1
    copy.simple FFT128_WIN_NO,          OR_2_16_0, TR_0_336_0, 0x1, 0x1

    /*=========================================================================
     * first range bins proccesing part
     *=========================================================================
     *=========================================================================
     * COPY clear: Reset OPRAM bank 2 and 3 to zero. Prepare zero padding 12 -> 128.
     *=========================================================================*/
    copy.clear MAX_VECT_LENGHT, OR_2_0_0, 0x1, 0xFFFF

    /*=========================================================================
     * COPY simple/shift/clear: move 12 channels for the same peak, on 128 values in OPRAM
     * 12 ch samples + 116 zeros -> 128 samples for Azimut/Beamforming FFT128
     *=========================================================================*/
    copy.shift  CHANNELS_12NO*PEAKS_PER_ITER,   OR_0_0_0, OR_1_0_4                 , 0x1,  0x1
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_0_0_0, OR_2_0_0                 , 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_0_1_0, OR_2_1_0                 , 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_1_2_0, OR_2_0_0 + AZIMUTH_BINS_NO, 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_1_3_0, OR_2_1_0 + AZIMUTH_BINS_NO, 0x3, 0x20
    copy.clear  CHANNELS_8NO*PEAKS_PER_ITER,    OR_2_1_0                           ,0x10, 0xFF00

    /*=========================================================================
     * Repeat PEAKS_PER_ITER times Azimut FFT128 for Peak #(n)
     *=========================================================================
     *=========================================================================
     * RDX Round 0(+win)...3, Twiddle in TR_0_320_0, Window in TR_0_336_0
     =========================================================================*/
    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, AZIMUTH_BINS_NO, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_336_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, AZIMUTH_BINS_NO, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_320_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, AZIMUTH_BINS_NO, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_320_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, AZIMUTH_BINS_NO, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_320_0

    /*=========================================================================
     * Repeat PEAKS_PER_ITER times VMT
     *=========================================================================
     *=========================================================================
     * VMT: custom shift(WR_46). Default shift left by 5(save on 16bit on SRAM).
     * Invert the spectrum. Copy half of data.
     *=========================================================================*/
    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, AZIMUTH_BINS_NO>>1, OR_2_0_0, OR_0_0_0 + AZIMUTH_BINS_NO>>1, 0x1, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, AZIMUTH_BINS_NO>>1, OR_2_0_0 + AZIMUTH_BINS_NO>>1, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * PDMA: transfer azimut FFT results for first chunks of PEAKS_PER_ITER peaks from OPRAM to SRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .opram2sysram .async .notrace, AZIMUTH_BINS_NO*PEAKS_PER_ITER, RSDK_SPT_OTHER_BASE_ADDR, WR_13, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * second range bins proccesing part
     *=========================================================================
     *=========================================================================
     * COPY clear: Reset OPRAM bank 6 and 7 to zero. Prepare zero padding 12 -> 128.
     *=========================================================================*/
    copy.clear MAX_VECT_LENGHT, OR_6_0_0, 0x1, 0xFFFF

    /*=========================================================================
     * COPY simple/shift/clear: move 12 channels for the same peak, on 128 values in OPRAM
     * 12 ch samples + 116 zeros -> 128 samples for Azimut/Beamforming FFT128
     *=========================================================================*/
    copy.shift  CHANNELS_12NO*PEAKS_PER_ITER,   OR_4_0_0, OR_5_0_4                 , 0x1,  0x1
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_4_0_0, OR_6_0_0                 , 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_4_1_0, OR_6_1_0                 , 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_5_2_0, OR_6_0_0 + AZIMUTH_BINS_NO, 0x3, 0x20
    copy.simple CHANNELS_8NO*PEAKS_PER_ITER>>1, OR_5_3_0, OR_6_1_0 + AZIMUTH_BINS_NO, 0x3, 0x20
    copy.clear  CHANNELS_8NO*PEAKS_PER_ITER,    OR_6_1_0                           ,0x10, 0xFF00

    /*=========================================================================
     * Repeat PEAKS_PER_ITER times Azimut FFT128 for Peak #(n)
     *=========================================================================
     *=========================================================================
     * RDX Round 0(+win)...3, Twiddle in TR_0_320_0, Window in TR_0_336_0
     =========================================================================*/
    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .nosft, AZIMUTH_BINS_NO, OR_6_0_0, OR_4_0_0, 0x1, 0x1, TR_0_336_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, AZIMUTH_BINS_NO, OR_4_0_0, OR_6_0_0, 0x1, 0x1, TR_0_320_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, AZIMUTH_BINS_NO, OR_6_0_0, OR_4_0_0, 0x1, 0x1, TR_0_320_0, .mod0, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    rdx2 .cmplx .nosplit .qext .noovs .round3 .nosft, AZIMUTH_BINS_NO, OR_4_0_0, OR_6_0_0, 0x1, 0x1, TR_0_320_0

    /*=========================================================================
     * Repeat PEAKS_PER_ITER times VMT
     *=========================================================================
     *=========================================================================
     * VMT: custom shift(WR_46). Default shift left by 5(save on 16bit on SRAM).
     * Invert the spectrum. Copy half of data.
     *=========================================================================*/
    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, AZIMUTH_BINS_NO>>1, OR_6_0_0, OR_4_0_0 + AZIMUTH_BINS_NO>>1, 0x1, 0x1

    repeat PEAKS_PER_ITER, AZIMUTH_BINS_NO, AZIMUTH_BINS_NO, 0x0, 0x0
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, AZIMUTH_BINS_NO>>1, OR_6_0_0 + AZIMUTH_BINS_NO>>1, OR_4_0_0, 0x1, 0x1

    /*=========================================================================
     * PDMA: transfer azimut FFT results for second chunks of PEAKS_PER_ITER peaks from OPRAM to SRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .opram2sysram .async .notrace, AZIMUTH_BINS_NO*PEAKS_PER_ITER, RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1

/*=========================================================================
 * STOP: end of FFT128 BEAMFORMING kernel
 *=========================================================================*/
 stop

 .set RsdkSptDbfFFT128Bins12Ch128PeaksCp4d_size, .-RsdkSptDbfFFT128Bins12Ch128PeaksCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
