/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,        1024
 .set CHIRPS_PER_FRAME,          128
 .set BYTES_CP4D_DATA,             8
 .set LOG2_FORMAT_BYTE,            2
 .set SCALAR_PROD_TAPS,            4
 .set HIST_BINS,                  64
 .set BYTES_HIST_BINS,             2
 .set CHANNELS_NO,                 4 /* total phy channels no */
 .set RANGE_BINS,               (SAMPLES_PER_CHIRP >> 1)
 .set SRAM_SLICES,              ((CHANNELS_NO * CHIRPS_PER_FRAME) >> 2)

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptNcc1024smp128crp4chCp4d();
* @brief          Function for Non coherent combining, 128 chirps, 1024 sample/chirp, 4 channels(CH#0..CH#3)
* @details        Compute Non Coherent Combining, storing results in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Doppler FFT compressed results),
*                       relative to SRAM start address, @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-Crp127           ---> RangeBin #0
*                 -----------------------------------------------------------
*                 |
*                 |
*                 |
*                 -----------------------------------------------------------
*                 CH0_511-CH1_511-CH2_511-CH3_511-Crp0
*                 |
*                 CH0_511-CH1_511-CH2_511-CH3_511-Crp127   ---> RangeBin #511
*                 -----------------------------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the RDM OUTPUT buffer(NCC matrix),
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16 bit real Log2 Mag2 format
*                 63:48           47:32           31:16           15:0
*                 R0_D0_MAG       R0_D1_MAG       R0_D2_MAG       R0_D3_MAG
*                 |               |               |               |
*                 R0_D124_MAG     R0_D125_MAG     R0_D126_MAG     R0_D127_MAG
*                 R1_D0_MAG       R1_D1_MAG       R1_D2_MAG       R1_D3_MAG
*                 |               |               |               |
*                 R1_D124_MAG     R1_D125_MAG     R1_D126_MAG     R1_D127_MAG
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 R511_D0_MAG     R511_D1_MAG     R511_D2_MAG     R511_D3_MAG
*                 |               |               |               |
*                 R511_D124_MAG   R511_D125_MAG   R511_D126_MAG   R511_D127_MAG
* @endverbatim
*
* @param[out]     WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the Histogram OUTPUT buffer,
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16 bit values histogram counters
*            0x0  bin1  bin0
*            0x4  bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 0
*                 --------------------------
*                 bin1  bin0
*                 bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 1
*                 ---------------------------
*                 |     |
*                 |     |
*                 |     |
*                 --------------------------
*                 bin1  bin0
*                 bin3  bin2
*                 |     |
*                 bin61 bin60
*                 bin63 bin62 -> Range Bin 511
*                 --------------------------
* @endverbatim
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            The kernel rely on the assumption that TRAM can be used as temp buffer from TR_0_290_0 to TR_0_448_0.
*
* @note           The current implementation is ONLY to be used in combination with 1024 Range FFT and 128 Doppler FFT. \n
*                 The input buffer MUST NOT be reused for the histogram or RDM output. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptNcc1024smp128crp4chCp4d
 .global RsdkSptNcc1024smp128crp4chCp4d_size

RsdkSptNcc1024smp128crp4chCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put ODD range bins for all channels
     *        24bit(IM): SRAM offset to ODD range bins
     * WR_12: 24bit(RE): OPRAM address where to put EVEN range bins for all channels
     *        24bit(IM): SRAM offset to EVEN range bins
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset to next range bins
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_2_0_0 | ((CHIRPS_PER_FRAME * BYTES_CP4D_DATA) << 24)), WR_12
    set #((2 * CHIRPS_PER_FRAME * BYTES_CP4D_DATA) << 24), WR_13

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_14: 24bit(RE): OPRAM address where to get the data after vmt Mag2+Log2, (ODD range bins)
     *        24bit(IM): SRAM RDM result buffer address offset
     * WR_15: 24bit(RE): OPRAM address where to get the data after vmt Mag2+Log2, (EVEN range bins)
     *        24bit(IM): SRAM RDM result buffer address offset
     * WR_16: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_1_0_0), WR_14
    add .noshift .mod24 WR_2, #(OR_3_0_0 | ((CHIRPS_PER_FRAME * LOG2_FORMAT_BYTE) << 24)), WR_15
    set #((2 * CHIRPS_PER_FRAME * LOG2_FORMAT_BYTE) << 24), WR_16

    /*=========================================================================
     * OUTPUT - Histogram
     *=========================================================================
     * WR_17: 24bit(RE): OPRAM address where to get the histogram counters, (ODD range bins)
     *        24bit(IM): SRAM histogram buffer address offset
     * WR_18: 24bit(RE): OPRAM address where to get the histogram counters, (EVEN range bins)
     *        24bit(IM): SRAM histogram buffer address offset
     * WR_19: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     *=========================================================================*/
    add .noshift .mod24 WR_3, #(OR_0_0_0), WR_17
    add .noshift .mod24 WR_3, #(OR_2_0_0 | ((HIST_BINS * BYTES_HIST_BINS) << 24)), WR_18
    set #((2 * HIST_BINS * BYTES_HIST_BINS) << 24), WR_19

/*=========================================================================
 * NON COHERENT COMBINING SECTION
 *=========================================================================*/
    /*=========================================================================
     * set TRAM column 290, slice 0..3 with "1" coef for 4 tap SCP
     *=========================================================================*/
    set #(0x7FFF), TR_0_290_0
    set #(0x7FFF), TR_0_290_1
    set #(0x7FFF), TR_0_290_2
    set #(0x7FFF), TR_0_290_3

    /*=========================================================================
     * LOOP: loop #count is number of range bins/2 (2 range bins processed within one iteration)
     *=========================================================================*/
    loop #(RANGE_BINS >> 1)

        /*=========================================================================
         * PDMA: transfer ODD/EVEN range bin data of all channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .CP4D .sysram2opram  .sync .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
        pdma.ind .signext .CP4D .sysram2opram .async .notrace, SRAM_SLICES, RSDK_SPT_CUBE_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ODD range bins proccesing part
         *=========================================================================
        /*=========================================================================
         * VMT: Operation Sequence 2, Stage 1, Vector Magnitude(sqrt(Re^2(x)+Im^2(x))/2)
         *=========================================================================*/
        vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .mag_sq2s1 .no_sq2s3, CHANNELS_NO*CHIRPS_PER_FRAME, OR_0_0_0, OR_1_0_0, 0x1, 0x1

        /*=========================================================================
         * SCP: scalar product with 4 taps, coeficients = 1, taken form TRAM.
         * Combine all 4 channels into a single RDM. S = (Mag(CH#0) + ... + Mag(CH#3))/4.
         *=========================================================================*/
        scp .real .coef_re .nosft SCALAR_PROD_TAPS, CHANNELS_NO*CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x1, 0x1, TR_0_290_0

        /*=========================================================================
         * VMT: Operation Sequence 1, Mag2 and log2. log2(S^2). Output packed.
         *=========================================================================*/
        vmt.sq1 .real .in_24real .op_on, CHIRPS_PER_FRAME, OR_0_0_0, OR_1_0_0, 0x1, 0x1

        /*=========================================================================
         * HIST: Histogram per range bin. The output will be used for threshold calculation
         * on the CPU. Input packed in log2 format. Threshold bin: 0
         *=========================================================================*/
        hist .log2 .no_preproc .read_store .64bins .no_preload .pack .24bits, CHIRPS_PER_FRAME, OR_1_0_0, OR_0_0_0, 0x1, 0x1, 0x0

        /*=========================================================================
         * PDMA: move the Histogram counters in SRAM, for each range bin
         *=========================================================================*/
        pdma.ind .zeropad .16cmplx .opram2sysram .async .notrace, HIST_BINS>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_17, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * PDMA: swap copy(packed data) the RDM data to SRAM, grouped 2 real columns in one OPRAM slice
         *=========================================================================*/
        pdma.ind .zeropad .16swap .opram2sysram .async .notrace, CHIRPS_PER_FRAME>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * EVEN range bins proccesing part
         *=========================================================================
        /*=========================================================================
         * VMT: Operation Sequence 2, Stage 1, Vector Magnitude(sqrt(Re^2(x)+Im^2(x))/2)
         *=========================================================================*/
        vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .mag_sq2s1 .no_sq2s3, CHANNELS_NO*CHIRPS_PER_FRAME, OR_2_0_0, OR_3_0_0, 0x1, 0x1

        /*=========================================================================
         * SCP: scalar product with 4 taps, coeficients = 1, taken form TRAM.
         * Combine all 4 channels into a single RDM. S = (Mag(CH#0) + ... + Mag(CH#3))/4.
         *=========================================================================*/
        scp .real .coef_re .nosft SCALAR_PROD_TAPS, CHANNELS_NO*CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x1, 0x1, TR_0_290_0

        /*=========================================================================
         * VMT: Operation Sequence 1, Mag2 and log2. log2(S^2). Output packed.
         *=========================================================================*/
        vmt.sq1 .real .in_24real .op_on, CHIRPS_PER_FRAME, OR_2_0_0, OR_3_0_0, 0x1, 0x1

        /*=========================================================================
         * HIST: Histogram per range bin. The output will be used for threshold calculation
         * on the CPU. Input packed in log2 format. Threshold bin: 0
         *=========================================================================*/
        hist .log2 .no_preproc .read_store .64bins .no_preload .pack .24bits, CHIRPS_PER_FRAME, OR_3_0_0, OR_2_0_0, 0x1, 0x1, 0x0

        /*=========================================================================
         * PDMA: move the Histogram counters in SRAM, for each range bin
         *=========================================================================*/
        pdma.ind .zeropad .16cmplx .opram2sysram .async .notrace, HIST_BINS>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_18, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * PDMA: swap copy(packed data) the RDM data to SRAM, grouped 2 real columns in one OPRAM slice
         *=========================================================================*/
        pdma.ind .zeropad .16swap .opram2sysram .async .notrace, CHIRPS_PER_FRAME>>1, RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment input SRAM offset to next ODD/EVEN range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11
        add .noshift .mod24 WR_12, WR_13, WR_12

        /*=========================================================================
         * ADD: increment output SRAM offset to next ODD/EVEN range bin (RDM)
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_16, WR_14
        add .noshift .mod24 WR_15, WR_16, WR_15

        /*=========================================================================
         * ADD: increment output SRAM offset to next ODD/EVEN range bin histogram
         *=========================================================================*/
        add .noshift .mod24 WR_17, WR_19, WR_17
        add .noshift .mod24 WR_18, WR_19, WR_18

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of Non Coherent Combining kernel
 *=========================================================================*/
 stop

 .set RsdkSptNcc1024smp128crp4chCp4d_size, .-RsdkSptNcc1024smp128crp4chCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
