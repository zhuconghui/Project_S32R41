/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set   PACKED_DATA_LENGTH0, (FFT2048_WIN_NO>>1 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT16_TRAM_TWIDDLE_NO) // we use win2048 instead of twiddles, as we have little space
 .set   PACKED_DATA_LENGTH1, (PACKED_DATA_LENGTH0 + DBF64_4CH_NO)
 .set UNPACKED_DATA_LENGTH1, (2*PACKED_DATA_LENGTH1)

 .set   PACKED_DATA_LENGTH2, (FFT2048_TRAM_TWIDDLE_NO) //unpacking this data fills one OPRAM bank
 .set UNPACKED_DATA_LENGTH2, (2*PACKED_DATA_LENGTH2)

 .set UNPACKED_DATA_LENGTH3, (FFT2048_WIN_NO)

 .set   PACKED_DATA_LENGTH3, (FFT256_TRAM_TWIDDLE_NO)
 .set UNPACKED_DATA_LENGTH4, (2*PACKED_DATA_LENGTH3)

 .set UNPACKED_DATA_LENGTH5, (FFT256_WIN_NO)
 .set UNPACKED_DATA_LENGTH6, (2*FFT16_TRAM_TWIDDLE_NO + 2*DBF64_4CH_NO)
 .set UNPACKED_DATA_LENGTH7, (UNPACKED_DATA_LENGTH3 + UNPACKED_DATA_LENGTH4 + UNPACKED_DATA_LENGTH5)
 .set   PACKED_DATA_LENGTH4, (PACKED_DATA_LENGTH2 + PACKED_DATA_LENGTH3 + UNPACKED_DATA_LENGTH5)


 .set TRAM_LAYOUT_LENGTH1,   (FFT2048_TRAM_TWIDDLE_NO + FFT256_TRAM_TWIDDLE_NO+ FFT256_WIN_NO + FFT16_TRAM_TWIDDLE_NO)
 .set TRAM_LAYOUT_LENGTH2,   (DBF64_4CH_NO)
 .set TRAM_LAYOUT_LENGTH3,   (TRAM_LAYOUT_LENGTH1 + TRAM_LAYOUT_LENGTH2)
 .set TRAM_LAYOUT_LENGTH4,   (FFT2048_WIN_NO)


/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptCheckTram2048smp256crp4ch();
* @brief          Function for checking sanity of persistent TRAM content. 2048 samples, 256 chirps and 4 physical channels.
* @details        Compare persistent TRAM content with the SRAM/flash reference.
*                 The kernell will reload the twiddles, window, steering vector coefficients into SPT memory and compare them
*                 with the data already stored in TRAM at the initialization time.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT2048 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For twiddle generation algorithm, see S32R41_RM 68.9.5.3 / SAF85xx_RM 68.9.5.3.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw256_Im  tw256_Re  tw256_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw256_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw256_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw256_Im  tw256_Re
* @endverbatim
*
* @param[in]      WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT256 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For twiddle generation algorithm, see S32R41_RM 68.9.5.3 / SAF85xx_RM 68.9.5.3.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Range FFT2048),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For reorder algorithm, see S32R41_RM 68.9.9.7 / SAF85xx_RM 68.9.9.7.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win512  win1024  win1536
*                 win128 win640  win1152  win1664
*                 |      |       |        |
*                 |      |       |        |
*                 win127 win639  win1151  win1663
*                 win255 win767  win1279  win1791
*                 win256 win768  win1280  win1792
*                 win384 win896  win1408  win1920
*                 |      |       |        |
*                 |      |       |        |
*                 win383 win895  win1407  win1919
*                 win511 win1023 win1535  win2047
* @endverbatim
*
* @param[in]      WR_4: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Doppler FFT 256),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For reorder algorithm, S32R41_RM 68.9.9.7 / SAF85xx_RM 68.9.9.7.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win64   win128   win192
*                 win16  win80   win144   win208
*                 |      |       |        |
*                 |      |       |        |
*                 win15  win79   win143   win207
*                 win31  win95   win159   win223
*                 win32  win96   win160   win224
*                 win48  win112  win176   win240
*                 |      |       |        |
*                 |      |       |        |
*                 win47  win111  win175   win239
*                 win63  win127  win191   win255
* @endverbatim
*
* @param[in]      WR_5: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT16 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For twiddle generation algorithm, see S32R41_RM 68.9.5.3 / SAF85xx_RM 68.9.5.3.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Im   tw1_Im   tw1_Im
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
* @endverbatim
*
* @param[in]      WR_6: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Beamforming Steering Vector),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For steering coeficients generation algorithm, see
*                       <a href="../Apps/rSDK_Auxiliary_vector_generation.docx">rSDK_Auxiliary_vector_generation.docx</a>.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32 bit complex(16b_Im + 16b_Re)
*                 63:48         47:32           31:16           15:0
*                 SV0_Im-CH0    SV0_Re-CH0      SV0_Im-CH1      SV0_Re-CH1
*                 SV0_Im-CH2    SV0_Re-CH2      SV0_Im-CH3      SV0_Re-CH3
*                 SV1_Im-CH0    SV1_Re-CH0      SV1_Im-CH1      SV1_Re-CH1
*                 SV1_Im-CH2    SV1_Re-CH2      SV1_Im-CH3      SV1_Re-CH3
*                 |             |               |               |
*                 |             |               |               |
*                 |             |               |               |
*                 SV63_Im-CH0   SV63_Re-CH0     SV63_Im-CH1     SV63_Re-CH1
*                 SV63_Im-CH2   SV63_Re-CH2     SV63_Im-CH3     SV63_Re-CH3
* @endverbatim
*
*
* @return         WR_0: will indicate if persistent TRAM content is corrupted or not.
* @retval         0, if persistent TRAM content is not corrupted. \n
*                 >0, if persistent TRAM content is corrupted.
*
* @note           All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptCheckTram2048smp256crp4ch
 .global RsdkSptCheckTram2048smp256crp4ch_size

RsdkSptCheckTram2048smp256crp4ch:

    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_13: 24bit(RE): OPRAM address where to put range FFT2048 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_12: 24bit(RE): OPRAM address where to put FFT256 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_11: 24bit(RE): OPRAM address where to put FFT2048 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_14: 24bit(RE): OPRAM address where to put doppler FFT256 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_15: 24bit(RE): OPRAM address where to put FFT16 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_16: 24bit(RE): OPRAM address where to put DBF steering vectors
     *        24bit(IM): SRAM steering vector address offset
     *=========================================================================*/
    add .noshift .mod24 WR_3, #(OR_0_0_0                                                                                        ), WR_13
    add .noshift .mod24 WR_2, #(OR_0_0_0 + FFT2048_WIN_NO>>1                                                                    ), WR_12
    add .noshift .mod24 WR_1, #(OR_1_0_0                                                                                        ), WR_11
    add .noshift .mod24 WR_4, #(OR_0_0_0 + FFT2048_WIN_NO>>1 + FFT256_TRAM_TWIDDLE_NO                                           ), WR_14
    add .noshift .mod24 WR_5, #(OR_0_0_0 + FFT2048_WIN_NO>>1 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1                        ), WR_15
    add .noshift .mod24 WR_6, #(OR_2_0_0 + FFT2048_WIN_NO>>1 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT16_TRAM_TWIDDLE_NO), WR_16

/*=========================================================================
 * START COMPARE
 *=========================================================================*/
    /*=========================================================================
     * PDMA: Copy 2048 FFT twiddles from SRAM to OPRAM
     *       Copy 256 FFT twiddles from SRAM to OPRAM
     *       Copy 2048 FFT range window coefficients from SRAM to OPRAM
     *       Copy 256 FFT doppler window coefficients from SRAM to OPRAM
     *       Copy 16 FFT twiddles from SRAM to OPRAM
     *       Copy DBF steering vector from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT2048_TWIDDLE_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT256_TWIDDLE_SRAM_SLICES,  RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT2048_WIN_SRAM_SLICES,     RSDK_SPT_OTHER_BASE_ADDR, WR_13, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT256_WIN_SRAM_SLICES,      RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT16_TWIDDLE_SRAM_SLICES,   RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, DBF64_4CH_SRAM_SLICES,       RSDK_SPT_OTHER_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: move 4 channel SV for each beam, on 8 values in OPRAM, 4 ch SV + 4 zeros
     *=========================================================================*/
    copy.simple   DBF64_4CH_NO, OR_2_0_0 + PACKED_DATA_LENGTH0, OR_0_0_0 + PACKED_DATA_LENGTH0, 0x1, 0x2
    copy.shift    DBF64_4CH_NO, OR_2_0_0 + PACKED_DATA_LENGTH0, OR_3_0_4                      , 0x1, 0x1
    copy.simple   DBF64_4CH_NO, OR_3_1_0                      , OR_0_1_0 + PACKED_DATA_LENGTH0, 0x1, 0x2
    copy.clear  2*DBF64_4CH_NO,                                 OR_0_0_0 + PACKED_DATA_LENGTH0, 0x1, 0xFF00

    /*=========================================================================
     * COPY: unpack a complex number into real numbers (in real part only of the OPRAM).
     *=========================================================================*/
    copy.unpack .keep_orig, PACKED_DATA_LENGTH1, OR_0_0_0, OR_2_0_0, 0x1, 0x1
    copy.unpack .keep_orig, PACKED_DATA_LENGTH2, OR_1_0_0, OR_3_0_0, 0x1, 0x1 //unpack twiddles2048 in a dedicated bank
    /*=========================================================================
     * COPY R2I: move the real part into imag part. Prepare for conjugate.
     *=========================================================================*/
    copy.partial_r2i .keep_orig, UNPACKED_DATA_LENGTH1, OR_2_0_0, OR_0_0_0, 0x1, 0x1
    copy.partial_r2i .keep_orig, UNPACKED_DATA_LENGTH2, OR_3_0_0, OR_1_0_0, 0x1, 0x1

    /*=========================================================================
     * VMT: Conjugate a imag number == negate all the data.
     *=========================================================================*/
    vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .conj_sq2s1 .no_sq2s3, UNPACKED_DATA_LENGTH1, OR_0_0_0, OR_2_0_0, 0x1, 0x1
    vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .conj_sq2s1 .no_sq2s3, UNPACKED_DATA_LENGTH2, OR_1_0_0, OR_3_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY: reconstruct the original memory layout, as present in TRAM.
     *=========================================================================*/
    copy.imag_pack               UNPACKED_DATA_LENGTH2, OR_3_0_0                                                , OR_0_0_0                      , 0x1, 0x1         //twiddles2048

    copy.partial_i2r .keep_orig, UNPACKED_DATA_LENGTH3, OR_2_0_0                                                , OR_1_0_0                      , 0x1, 0x1         //window2048 to required location
    copy.clear                   UNPACKED_DATA_LENGTH3,                                                           OR_1_0_0                      , 0x1, 0xAAAA

    copy.imag_pack               UNPACKED_DATA_LENGTH4, OR_2_0_0 + UNPACKED_DATA_LENGTH3                        , OR_0_0_0 + PACKED_DATA_LENGTH2, 0x1, 0x1         //twiddles256

    copy.partial_i2r .keep_orig, UNPACKED_DATA_LENGTH5, OR_2_0_0 + UNPACKED_DATA_LENGTH3 + UNPACKED_DATA_LENGTH4, OR_0_0_0 + PACKED_DATA_LENGTH2 + PACKED_DATA_LENGTH3, 0x1, 0x1  //window256
    copy.clear                   UNPACKED_DATA_LENGTH5,                                                           OR_0_0_0 + PACKED_DATA_LENGTH2 + PACKED_DATA_LENGTH3, 0x1, 0xAAAA

    copy.imag_pack               UNPACKED_DATA_LENGTH6, OR_2_0_0 + UNPACKED_DATA_LENGTH7                        , OR_0_0_0 + PACKED_DATA_LENGTH4, 0x1, 0x1

    /*=========================================================================
     * VMT: Vector add. Add TRAM persistent content to the negated OPRAM content.
     *=========================================================================*/
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1   TR_0_0_0 .no_sq2s3, TRAM_LAYOUT_LENGTH1, OR_0_0_0                      , OR_2_0_0                      , 0x1, 0x1
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 TR_0_448_0 .no_sq2s3, TRAM_LAYOUT_LENGTH2, OR_0_0_0 + TRAM_LAYOUT_LENGTH1, OR_2_0_0 + TRAM_LAYOUT_LENGTH1, 0x1, 0x1
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1   TR_1_0_0 .no_sq2s3, TRAM_LAYOUT_LENGTH4, OR_1_0_0                      , OR_3_0_0                      , 0x1, 0x1
    /*=========================================================================
     * Global MAXS on the entire data(Real ABS preprocessing), PACKED input(x2).
     *=========================================================================*/
    set #0x0, OR_0_0_0
    set #0x0, OR_0_1_0
    maxs.gm .no_maxsn .real .abs_proc .in_48packed, 2*TRAM_LAYOUT_LENGTH3, OR_2_0_0, OR_0_0_0, 0x1, 0x1
    maxs.gm .no_maxsn .real .abs_proc .in_48packed, 2*TRAM_LAYOUT_LENGTH4, OR_3_0_0, OR_0_1_0, 0x1, 0x1

    /*=========================================================================
     * GET: get overall max value from OPRAM in WR_0.
     *=========================================================================*/
    get OR_0_0_0, WR_40
    get OR_0_1_0, WR_41
    add .noshift .mod24 WR_40, WR_41, WR_0

    /*=========================================================================
     * Workaround for errata ERR010997: the CPU is only allowed to read WR0 before the STOP instruction
     * and this can only be done using an EVT/WAIT handshake with the SPT kernel right before STOP.
     * Use 'lsb' event line for this.
     *=========================================================================*/
    evt.cpu 0

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0

    /*=========================================================================
     * STOP cmd
     *=========================================================================*/
    stop

 .set RsdkSptCheckTram2048smp256crp4ch_size, .-RsdkSptCheckTram2048smp256crp4ch
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
