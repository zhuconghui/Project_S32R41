/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,       2048
 .set SDADC_ACTIVE_CHANNELS,      4 /* phy channels per MIPI-CSI2 link */
 .set CHANNELS_NO,                4 /* total phy channels no */
 .set BYTES_PER_SDADC_SAMPLE,     2
 .set OUTPUT_SAMPLES_PER_CH,    (SAMPLES_PER_CHIRP >> 1)
 .set SDADC_SRAM_SLICES,        (SAMPLES_PER_CHIRP * SDADC_ACTIVE_CHANNELS * BYTES_PER_SDADC_SAMPLE) >> 3

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptRfBist2048smp1crp4ch();
* @brief          Function for RF Build-in Self Test 2048 samples, 1 chirp, 4 channels(CH_0..CH_3). Offline version only.
* @details        Compute FFT on ADC samples, amplitude and max amplitude on each RX channel, storing results in SRAM.
*
* @param[in]            WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT2048 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR". \n
*                       For twiddle generation algorithm, see S32R41_RM 68.9.5.3 / SAF85xx_RM 68.9.5.3.
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48     47:32     31:16     15:0
*                 tw1_Im    tw1_Re    tw1_Im    tw1_Re
*                 tw1_Im    tw1_Re    tw1_Im    tw1_Re
*                 tw1_Im    tw1_Re    tw1_Im    tw1_Re
*                 tw1_Im    tw1_Re    tw1_Im    tw1_Re
*                 tw2_Im    tw2_Re    tw2_Im    tw2_Re
*                 tw2_Im    tw2_Re    tw2_Im    tw2_Re
*                 tw2_Im    tw2_Re    tw2_Im    tw2_Re
*                 tw2_Im    tw2_Re    tw2_Im    tw2_Re
*                 |         |         |         |
*                 |         |         |         |
*                 |         |         |         |
*                 tw256_Im  tw256_Re  tw265_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw265_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw265_Im  tw256_Re
*                 tw256_Im  tw256_Re  tw265_Im  tw256_Re
* @endverbatim
*
* @param[in]      WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(sample ADC),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real ADC sample
*                 63:48     47:32     31:16     15:0
*                 CH0_0     CH0_1     CH0_2     CH0_3
*                 CH0_4     CH0_5     CH0_6     CH0_7
*                 CH1_0     CH1_1     CH1_2     CH1_3
*                 CH1_4     CH1_5     CH1_6     CH1_7
*                 CH2_0     CH2_1     CH2_2     CH2_3
*                 CH2_4     CH2_5     CH2_6     CH2_7
*                 CH3_0     CH3_1     CH3_2     CH3_3
*                 CH3_4     CH3_5     CH3_6     CH3_7
*                 |         |         |         |
*                 CH0_2040  CH0_2041  CH0_2042  CH0_2043
*                 CH0_2044  CH0_2045  CH0_2046  CH0_2047
*                 CH1_2040  CH1_2041  CH1_2042  CH1_2043
*                 CH1_2044  CH1_2045  CH1_2046  CH1_2047
*                 CH2_2040  CH2_2041  CH2_2042  CH2_2043
*                 CH2_2044  CH2_2045  CH2_2046  CH2_2047
*                 CH3_2040  CH3_2041  CH3_2042  CH3_2043
*                 CH3_2044  CH3_2045  CH3_2046  CH3_2047
* @endverbatim
*
* @param[out]     WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(FFT results),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48         47:32         31:16         15:0
*                 CH0_0_Im      CH0_0_Re      CH1_0_Im      CH1_0_Re
*                 CH2_0_Im      CH2_0_Re      CH3_0_Im      CH3_0_Re
*                 CH0_1_Im      CH0_1_Re      CH1_1_Im      CH1_1_Re
*                 CH2_1_Im      CH2_1_Re      CH3_1_Im      CH3_1_Re
*                 |             |             |             |
*                 |             |             |             |
*                 |             |             |             |
*                 CH0_1022_Im   CH0_1022_Re   CH1_1022_Im   CH1_1022_Re
*                 CH2_1022_Im   CH2_1022_Re   CH3_1022_Im   CH3_1022_Re
*                 CH0_1023_Im   CH0_1023_Re   CH1_1023_Im   CH1_1023_Re
*                 CH2_1023_Im   CH2_1023_Re   CH3_1023_Im   CH3_1023_Re
* @endverbatim
*
* @param[out]     WR_4: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(Mag2+Log2 results),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 16bit real
*                 63:48         47:32         31:16         15:0
*                 CH0_0_Mag     CH1_0_Mag     CH2_0_Mag     CH3_0_Mag
*                 CH0_1_Mag     CH1_1_Mag     CH2_1_Mag     CH3_1_Mag
*                 |             |             |             |
*                 |             |             |             |
*                 |             |             |             |
*                 CH0_1022_Mag  CH1_1022_Mag  CH2_1022_Mag  CH3_1022_Mag
*                 CH0_1023_Mag  CH1_1023_Mag  CH2_1023_Mag  CH3_1023_Mag
* @endverbatim
*
* @param[in]      WR_5: 24bit(RE): Scaling Factor, e.g. 1 for scale left with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: Global maxima(amplitude) for channel CH#0.
* @retval         Will indicate the Mag2+Log2 value of the global maxima for the channel CH#0.
*
* @pre            MIPI_EVENT_LINE is RFE HW connection dependent. Can be configured from spt_kernel_internals.inc.
*
* @note           The kernel implementation guarantees no saturation for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptRfBist2048smp1crp4ch
 .global RsdkSptRfBist2048smp1crp4ch_size

RsdkSptRfBist2048smp1crp4ch:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put FFT2048 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_12: 24bit(RE): OPRAM address where to put SDADC samples of all channels
     *        24bit(IM): SRAM sample buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_2, #(OR_0_0_0), WR_12

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_13: 24bit(RE): OPRAM address of FFT results for all channels
     *        24bit(IM): SRAM FFT result array offset
     * WR_14: 24bit(RE): OPRAM address of Mag2+Log2 results for all channels
     *        24bit(IM): SRAM result array offset
     *=========================================================================*/
    add .noshift .mod24 WR_3, #(OR_0_0_0), WR_13
    add .noshift .mod24 WR_4, #(OR_2_0_0), WR_14

/*=========================================================================
 * START RF Bist SECTION
 *=========================================================================*/

    /*=========================================================================
     * COPY clear. Reset used OPRAM banks to zero. Required to ensure non parity errors.
     *=========================================================================*/
    copy.clear OPRAM_BANK_SIZE, OR_0_0_0, 0x1, 0xFFFF
    copy.clear OPRAM_BANK_SIZE, OR_1_0_0, 0x1, 0xFFFF
    copy.clear OPRAM_BANK_SIZE, OR_2_0_0, 0x1, 0xFFFF
    copy.clear OPRAM_BANK_SIZE, OR_3_0_0, 0x1, 0xFFFF

    /*=========================================================================
     * COPY clear. Reset the TRAM to zero. Required to ensure non parity errors.
     *=========================================================================*/
    copy.clear TRAM_BANK_SIZE, TR_0_0_0, 0x1, 0xFFFF

    /*=========================================================================
     * PDMA: Copy 2048 FFT twiddles from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT2048_TWIDDLE_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: Copy FFT2048 twiddles into TRAM
     *=========================================================================*/
    copy.simple FFT2048_TRAM_TWIDDLE_NO, OR_0_0_0, TR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * PDMA: transfer SDADC samples of all active channels (CH#0..CH#3) from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16real .sysram2opram .sync .notrace, SDADC_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY simple: CH#0 samples(interleaved with other channels), src_inc 4, dst_inc 1
     * COPY simple: CH#2 samples(interleaved with other channels), src_inc 4, dst_inc 1
     * COPY R2I: CH#1 samples, for combined real FFT(CH#0 & CH#1), src_inc 4, dst_inc 1
     * COPY R2I: CH#3 samples, for combined real FFT(CH#2 & CH#3), src_inc 4, dst_inc 1
     *=========================================================================*/
    copy.simple SAMPLES_PER_CHIRP, OR_0_0_0, OR_2_0_0, 0x4, 0x1
    copy.simple SAMPLES_PER_CHIRP, OR_0_2_0, OR_3_0_0, 0x4, 0x1
    copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_0_1_0, OR_2_0_0, 0x4, 0x1
    copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_0_3_0, OR_3_0_0, 0x4, 0x1

    /*=========================================================================
     * FFT2048 for CH#0 & CH#1
     * RDX Round 0...6(split round), src & dest inc 1, Twiddle in TR_0_0_0.
     * Prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
     *=========================================================================*/
    rdx4 .cmplx .no_win .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round1  .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round2  .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round3  .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round4  .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx2 .cmplx .nosplit .qext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_2_0_0, 0x1, 0x1, TR_0_0_0
    rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0

    /*=========================================================================
     * VMT: custom left shift(WR_5).
     * Move CH#0 (leave space for CH#1, CH#2, CH#3), src_inc 1, dst_inc 4
     * Move CH#1 (leave space for CH#0, CH#2, CH#3), src_inc 1, dst_inc 4
     *=========================================================================*/
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_5 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_0_0_0                        , OR_2_0_0, 0x1, 0x4
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_5 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_0_0_0 + OUTPUT_SAMPLES_PER_CH, OR_2_1_0, 0x1, 0x4

    /*=========================================================================
     * FFT2048 for CH#2 & CH#3
     * RDX Round 0...6(split round), src & dest inc 1, Twiddle in TR_0_0_0.
     * Prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
     *=========================================================================*/
    rdx4 .cmplx .no_win .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_3_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round1  .nosft, SAMPLES_PER_CHIRP, OR_1_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round2  .nosft, SAMPLES_PER_CHIRP, OR_3_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round3  .nosft, SAMPLES_PER_CHIRP, OR_1_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx4 .cmplx .no_win .qext .noovs .round4  .nosft, SAMPLES_PER_CHIRP, OR_3_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
    rdx2 .cmplx .nosplit .qext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_1_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0
    rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_3_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0

    /*=========================================================================
     * VMT: custom left shift(WR_5).
     * Move CH#2 (leave space for CH#0, CH#1, CH#3), src_inc 1, dst_inc 4
     * Move CH#3 (leave space for CH#0, CH#1, CH#2), src_inc 1, dst_inc 4
     *=========================================================================*/
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_5 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_1_0_0                        , OR_2_2_0, 0x1, 0x4
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_5 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_1_0_0 + OUTPUT_SAMPLES_PER_CH, OR_2_3_0, 0x1, 0x4

    /*=========================================================================
     * VMT: WR_46, right shift with 8(to compensate the initial pre-scalling)
     *=========================================================================*/
    set #0x0, WR_46
    sub .noshift .mod24 WR_46, #0x8, WR_46
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_2_0_0, OR_3_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY 8x4 FWD transpose for all channels
     *=========================================================================*/
    copy.trans_fwd_8x4 CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_3_0_0, OR_0_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * PDMA: transfer FFT results of all channels from OPRAM to SRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .opram2sysram .async .notrace, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, RSDK_SPT_OTHER_BASE_ADDR, WR_13, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * VMT: Operation Sequence 1, Mag2 and log2. No output packing.
     *=========================================================================*/
    vmt.sq1 .cmplx .in_48 .op_off, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_2_0_0, OR_3_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY 8x4 FWD transpose for all channels
     *=========================================================================*/
    copy.trans_fwd_8x4 CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_3_0_0, OR_2_0_0, 0x1, 0x1, 0x8, 0x8

    /*=========================================================================
     * PDMA: transfer (mag2+log2) results of all channels from OPRAM to SRAM
     *=========================================================================*/
    pdma.ind .signext .16real .opram2sysram .async .notrace, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * Global MAXS on channel CH0
     *=========================================================================*/
    set #0x0, OR_0_0_0
    maxs.gm .no_maxsn .log2 .no_preproc .in_24real, OUTPUT_SAMPLES_PER_CH, OR_3_0_0, OR_0_0_0, 0x4, 0x1

    /*=========================================================================
     * GET: get overall max value from OPRAM in WR_0.
     *=========================================================================*/
    get OR_0_0_0, WR_0

    /*=========================================================================
     * Workaround for errata ERR010997: the CPU is only allowed to read WR0 before the STOP instruction
     * and this can only be done using an EVT/WAIT handshake with the SPT kernel right before STOP.
     * Use 'lsb' event line for this.
     *=========================================================================*/
    evt.cpu 0

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0

/*=========================================================================
 * STOP: end of RF Bist program
 *=========================================================================*/
 stop

 .set RsdkSptRfBist2048smp1crp4ch_size, .-RsdkSptRfBist2048smp1crp4ch
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
