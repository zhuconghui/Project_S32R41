/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,           2048
 .set CHIRPS_PER_FRAME,            256
 .set BYTES_REAL_RDM_SAMPLE,       2
 .set BYTES_BITFIELD_WORD32_DATA,  4
 .set RANGE_BINS,                  (SAMPLES_PER_CHIRP >> 1)
 .set THRL_SRAM_SLICES,            (RANGE_BINS >> 2)
 .set RANGE_BIN_BITFIELD_DATA,     (CHIRPS_PER_FRAME >> 5)
 .set THRESHOLD_ADDR,              (OR_4_0_0)

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptPeakSearch2048smp256crp1D();
* @brief          Function for Peak Search 1D, 256 chirps (doppler bins), 2048 sample/chirp (1024 range bins).
* @details        Compute Peaks, storing results in SRAM as packed bitfields, to be used togheter with
*                 Radar Data Cube by more advanced algorithms.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Range-Doppler Matrix),
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16 bit real Log2 Mag2 format
*                 63:48           47:32           31:16           15:0
*                 R0_D0_MAG       R0_D1_MAG       R0_D2_MAG       R0_D3_MAG
*                 |               |               |               |
*                 R0_D252_MAG     R0_D253_MAG     R0_D254_MAG     R0_D255_MAG
*                 R1_D0_MAG       R1_D1_MAG       R1_D2_MAG       R1_D3_MAG
*                 |               |               |               |
*                 R1_D252_MAG     R1_D253_MAG     R1_D254_MAG     R1_D255_MAG
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 R1023_D0_MAG    R1023_D1_MAG    R1023_D2_MAG    R1023_D3_MAG
*                 |               |               |               |
*                 R1023_D252_MAG  R1023_D253_MAG  R1023_D254_MAG  R1023_D255_MAG
* @endverbatim
*
* @param[in]      WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the Threshold buffer, log2 format,
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 Threshold Memory layout:
*                 SRAM, 16bit log2 format
*                 63:48            47:32            31:16            15:0
*                 Thr_RangeBin0    Thr_RangeBin1    Thr_RangeBin2    Thr_RangeBin3
*                 Thr_RangeBin4    Thr_RangeBin5    Thr_RangeBin6    Thr_RangeBin7
*                 |                |                |                |
*                 |                |                |                |
*                 |                |                |                |
*                 Thr_RangeBin1020 Thr_RangeBin1021 Thr_RangeBin1022 Thr_RangeBin1023
* @endverbatim
*
* @param[out]     WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer(bitfiels with peaks postions),
*                       relative to SRAM start address, @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 Big Endian representation, internal to SPT. PDMA to SRAM swaps endian considering data is 16 bit words.
*                 SRAM, bitfield, P<n> = bit 1(peak), bit 0(non peak)
*            0x0  P31P30......P17P16  P15P14........P1P0
*            0x4  P63P62......P49P48  P47P46......P33P32
*            0x8  P95P94......P81P80  P79P78......P65P64
*            0xC  P127P126..P113P112  P111P110....P97P96
*           0x10  P159P158..P145P144  P143P142..P129P128
*           0x14  P191P190..P177P176  P175P174..P161P160
*           0x18  P223P222..P209P208  P207P206..P193P192
*           0x1C  P255P254..P241P240  P239P238..P225P224 -> RangeBin 0
*                 -------------------------------------------------
*                 P31P30......P17P16  P15P14........P1P0
*                 P63P62......P49P48  P47P46......P33P32
*                 P95P94......P81P80  P79P78......P65P64
*                 P127P126..P113P112  P111P110....P97P96
*                 P159P158..P145P144  P143P142..P129P128
*                 P191P190..P177P176  P175P174..P161P160
*                 P223P222..P209P208  P207P206..P193P192
*                 P255P254..P241P240  P239P238..P225P224 -> RangeBin 1
*                 -------------------------------------------------
*                 |                   |
*                 |                   |
*                 |                   |
*                 -------------------------------------------------
*                 P31P30......P17P16  P15P14........P1P0
*                 P63P62......P49P48  P47P46......P33P32
*                 P95P94......P81P80  P79P78......P65P64
*                 P127P126..P113P112  P111P110....P97P96
*                 P159P158..P145P144  P143P142..P129P128
*                 P191P190..P177P176  P175P174..P161P160
*                 P223P222..P209P208  P207P206..P193P192
*                 P255P254..P241P240  P239P238..P225P224 -> RangeBin 1023
*                 -------------------------------------------------
* @endverbatim
*
* @return         WR_0: No value returned.
* @retval         No value returned.
*
* @pre            N/A.
*
* @note           The current implementation is ONLY to be used in combination with 2048 Range FFT and 256 Doppler FFT. \n
*                 The input buffer MUST NOT be reused for peaks output. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptPeakSearch2048smp256crp1D
 .global RsdkSptPeakSearch2048smp256crp1D_size

RsdkSptPeakSearch2048smp256crp1D:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put range-doppler matrix
     *        24bit(IM): SRAM INPUT range-doppler matrix buffer address
     * WR_13: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     * WR_22: 24bit(RE): OPRAM address where to put threshold for each range bin
     *        24bit(IM): SRAM Threshold buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_2_0_0), WR_11
    set #(((CHIRPS_PER_FRAME) * BYTES_REAL_RDM_SAMPLE) << 24), WR_13
    add .noshift .mod24 WR_2, #(THRESHOLD_ADDR), WR_22

    /*=========================================================================
     * OUTPUT - PEAKS
     *=========================================================================
     * WR_16: 24bit(RE): OPRAM address where to get peak list(bitfield format) data after max on range bin
     *        24bit(IM): SRAM OUTPUT buffer(bitfield format) address offset
     * WR_17: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): SRAM offset for the results of the next range bin
     *=========================================================================*/
    add .noshift .mod24 WR_3, #(OR_1_0_0), WR_16
    set #((RANGE_BIN_BITFIELD_DATA * BYTES_BITFIELD_WORD32_DATA) << 24), WR_17

/*=========================================================================
 * PEAK SEARCH SECTION
 *=========================================================================*/
    /*=========================================================================
     * PDMA: transfer threshold buffer into Twiddle RAM
     *=========================================================================*/
    pdma.ind .signext .16real .sysram2opram .sync .notrace, THRL_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_22, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * WR_24: 24bit(RE): WR to store the threshold value for each range bin
     *        24bit(IM): start address of the OPRAM from where to take the thresholds
     * WR_25: 24bit(RE): no inc for WR, same WR for all thresholds
     *        24bit(IM): inc the OPRAM address
     *=========================================================================*/
    set #(WR_23 | (THRESHOLD_ADDR << 24)), WR_24
    set #(0x1 << 24), WR_25

    /*=========================================================================
     * GET: take the threshold for first range bin and place it in WR_23
     *=========================================================================*/
    get.ind WR_24

    /*=========================================================================
     * LOOP: loop #count is number of range bins
     *=========================================================================*/
    loop #(RANGE_BINS)

        /*=======================================================================
         * PDMA: copy the range doppler matrix data to opram, CHIRPS_PER_FRAME/4 SRAM slices
         *=========================================================================*/
        pdma.ind .signext .16real .sysram2opram .sync .notrace, CHIRPS_PER_FRAME>>2, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * MAXS with output bitfield: local maxima on range bin, no IN/OUT packing
         * no cyclic extention search, TRAM address for threshold: WR_23
         * 256 chirps, 32 peaks per opram slice --> 8 slices filled (1 opram column)
         *=========================================================================*/
        maxs.lmth .no_maxsn .log2 .no_preproc .in_24real .16bits .no_tag_in .no_cyc_ext .gt_thld, CHIRPS_PER_FRAME, OR_2_0_0, OR_1_0_0, 0x1, 0x1, WR_23

        /*=========================================================================
         * PDMA: copy the range bin bitfield data to the output memory (SRAM)
         *=========================================================================*/
        pdma.ind .zeropad .16cmplx .opram2sysram .async .notrace, RANGE_BIN_BITFIELD_DATA, RSDK_SPT_OTHER_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * ADD: increment SRAM offset to next range bin
         *=========================================================================*/
        add .noshift .mod24 WR_11, WR_13, WR_11

        /*=========================================================================
         * ADD: increment output SRAM offset to write next tagged range bin of the RDM
         *=========================================================================*/
        add .noshift .mod24 WR_16, WR_17, WR_16

        /*=========================================================================
         * ADD: increment TRAM addres to take next range bin threshold
         *=========================================================================*/
        add .noshift .mod24 WR_24, WR_25, WR_24

        /*=========================================================================
         * GET: take the next threshold place it in WR_23
         *=========================================================================*/
        get.ind WR_24

    /*=========================================================================
     * NEXT: end of the loop
     *=========================================================================*/
    next

/*=========================================================================
 * STOP: end of Peak Search program
 *=========================================================================*/
 stop

 .set RsdkSptPeakSearch2048smp256crp1D_size, .-RsdkSptPeakSearch2048smp256crp1D
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
