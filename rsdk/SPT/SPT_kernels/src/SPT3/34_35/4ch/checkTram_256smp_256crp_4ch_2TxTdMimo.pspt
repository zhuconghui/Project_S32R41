/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set   PACKED_DATA_LENGTH0, (FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT256_WIN_NO>>1 + FFT16_TRAM_TWIDDLE_NO)
 .set   PACKED_DATA_LENGTH1, (PACKED_DATA_LENGTH0 + DEROT_VECT256_NO)
 .set   PACKED_DATA_LENGTH2, (PACKED_DATA_LENGTH1 + DBF64_8CH_NO)
 .set UNPACKED_DATA_LENGTH2, (2*PACKED_DATA_LENGTH2)

 .set   PACKED_DATA_LENGTH3, (FFT256_TRAM_TWIDDLE_NO)
 .set UNPACKED_DATA_LENGTH3, (2*PACKED_DATA_LENGTH3)

 .set UNPACKED_DATA_LENGTH4, (FFT256_WIN_NO + FFT256_WIN_NO)
 .set UNPACKED_DATA_LENGTH5, (2*FFT16_TRAM_TWIDDLE_NO + 2*DEROT_VECT256_NO + 2*DBF64_8CH_NO)

 .set TRAM_LAYOUT_LENGTH1,   (FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO + FFT256_WIN_NO + FFT16_TRAM_TWIDDLE_NO + DEROT_VECT256_NO)
 .set TRAM_LAYOUT_LENGTH2,   (DBF64_8CH_NO)
 .set TRAM_LAYOUT_LENGTH3,   (TRAM_LAYOUT_LENGTH1 + TRAM_LAYOUT_LENGTH2)

/*==================================================================================================
 *                                      GLOBAL REFERENCES
 *==================================================================================================*/

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptCheckTram256smp256crp4ch2TxTdMimo();
* @brief          Function for checking sanity of persistent TRAM content. 256 samples, 256 chirps, 4 physical channels/TX slot, 2TX TD-Mimo.
* @details        Compare persistent TRAM content with the SRAM/flash reference.
*                 The kernell will reload the twiddles, window, derotation and steering vector coefficients into SPT memory and compare them
*                 with the data already stored in TRAM at the initialization time.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT256 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 |        |        |        |
*                 |        |        |        |
*                 |        |        |        |
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
*                 tw32_Im  tw32_Re  tw32_Im  tw32_Re
* @endverbatim
*
* @param[in]      WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Range FFT 256),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win64   win128   win192
*                 win16  win80   win144   win208
*                 |      |       |        |
*                 |      |       |        |
*                 win15  win79   win143   win207
*                 win31  win95   win159   win223
*                 win32  win96   win160   win224
*                 win48  win112  win176   win240
*                 |      |       |        |
*                 |      |       |        |
*                 win47  win111  win175   win239
*                 win63  win127  win191   win255
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Reordered Window coef for Doppler FFT 256),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real Window Coef
*                 63:48  47:32   31:16    15:0
*                 win0   win64   win128   win192
*                 win16  win80   win144   win208
*                 |      |       |        |
*                 |      |       |        |
*                 win15  win79   win143   win207
*                 win31  win95   win159   win223
*                 win32  win96   win160   win224
*                 win48  win112  win176   win240
*                 |      |       |        |
*                 |      |       |        |
*                 win47  win111  win175   win239
*                 win63  win127  win191   win255
* @endverbatim
*
* @param[in]      WR_4: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(FFT16 Twiddle Factors),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48    47:32    31:16    15:0
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Re   tw1_Im   tw1_Re
*                 tw1_Im   tw1_Im   tw1_Im   tw1_Im
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
*                 tw2_Im   tw2_Re   tw2_Im   tw2_Re
* @endverbatim
*
* @param[in]      WR_5: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Derotation Phased Vector),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32bit complex(16b_Im + 16b_Re)
*                 63:48           47:32           31:16           15:0
*                 DeRotPh0_Im     DeRotPh0_Re     DeRotPh1_Im     DeRotPh1_Re
*                 DeRotPh2_Im     DeRotPh2_Re     DeRotPh3_Im     DeRotPh3_Re
*                 |               |               |               |
*                 |               |               |               |
*                 |               |               |               |
*                 DeRotPh252_Im   DeRotPh252_Re   DeRotPh253_Im   DeRotPh253_Re
*                 DeRotPh254_Im   DeRotPh254_Re   DeRotPh255_Im   DeRotPh255_Re
* @endverbatim
*
* @param[in]      WR_6: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the INPUT buffer(Beamforming Steering Vector),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 32 bit complex(16b_Im + 16b_Re)
*                 63:48         47:32           31:16           15:0
*                 SV0_Im-CH0    SV0_Re-CH0      SV0_Im-CH1      SV0_Re-CH1
*                 SV0_Im-CH2    SV0_Re-CH2      SV0_Im-CH3      SV0_Re-CH3
*                 SV0_Im-CH4    SV0_Re-CH4      SV0_Im-CH5      SV0_Re-CH5
*                 SV0_Im-CH6    SV0_Re-CH6      SV0_Im-CH7      SV0_Re-CH7
*                 SV1_Im-CH0    SV1_Re-CH0      SV1_Im-CH1      SV1_Re-CH1
*                 SV1_Im-CH2    SV1_Re-CH2      SV1_Im-CH3      SV1_Re-CH3
*                 SV1_Im-CH4    SV1_Re-CH4      SV1_Im-CH5      SV1_Re-CH5
*                 SV1_Im-CH6    SV1_Re-CH6      SV1_Im-CH7      SV1_Re-CH7
*                 |             |               |               |
*                 |             |               |               |
*                 |             |               |               |
*                 SV63_Im-CH0   SV63_Re-CH0     SV63_Im-CH1     SV63_Re-CH1
*                 SV63_Im-CH2   SV63_Re-CH2     SV63_Im-CH3     SV63_Re-CH3
*                 SV63_Im-CH4   SV63_Re-CH4     SV63_Im-CH5     SV63_Re-CH5
*                 SV63_Im-CH6   SV63_Re-CH6     SV63_Im-CH7     SV63_Re-CH7
* @endverbatim
*
* @return         WR_0: will indicate if persistent TRAM content is corrupted or not.
* @retval         0, if persistent TRAM content is not corrupted. \n
*                 >0, if persistent TRAM content is corrupted.
*
* @note           All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptCheckTram256smp256crp4ch2TxTdMimo
 .global RsdkSptCheckTram256smp256crp4ch2TxTdMimo_size

RsdkSptCheckTram256smp256crp4ch2TxTdMimo:

    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put FFT256 twiddle factors
     *        24bit(IM): SRAM twiddle factors address offset
     * WR_12: 24bit(RE): OPRAM address where to put range FFT256 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_13: 24bit(RE): OPRAM address where to put doppler FFT256 window coef
     *        24bit(IM): SRAM window coef address offset
     * WR_14: 24bit(RE): OPRAM address where to put FFT16 twiddle factors
     *        24bit(IM): SRAM twiddle coef address offset
     * WR_15: 24bit(RE): OPRAM address where to put DeRotPh vector
     *        24bit(IM): SRAM derotation phased vector address offset
     * WR_16: 24bit(RE): OPRAM address where to put DBF steering vectors
     *        24bit(IM): SRAM steering vector address offset
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0                                                                                                          ), WR_11
    add .noshift .mod24 WR_2, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO                                                                                 ), WR_12
    add .noshift .mod24 WR_3, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1                                                              ), WR_13
    add .noshift .mod24 WR_4, #(OR_0_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT256_WIN_NO>>1                                           ), WR_14
    add .noshift .mod24 WR_5, #(OR_2_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT256_WIN_NO>>1 + FFT16_TRAM_TWIDDLE_NO                   ), WR_15
    add .noshift .mod24 WR_6, #(OR_2_0_0 + FFT256_TRAM_TWIDDLE_NO + FFT256_WIN_NO>>1 + FFT256_WIN_NO>>1 + FFT16_TRAM_TWIDDLE_NO + DEROT_VECT256_NO), WR_16

/*=========================================================================
 * START COMPARE
 *=========================================================================*/
    /*=========================================================================
     * PDMA: Copy 256 FFT twiddles from SRAM to OPRAM
     *       Copy 256 FFT range window coefficients from SRAM to OPRAM
     *       Copy 256 FFT doppler window coefficients from SRAM to OPRAM
     *       Copy 16 FFT twiddles from SRAM to OPRAM
     *       Copy DeRotPh vector from SRAM to OPRAM.
     *       Copy DBF steering vector from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT256_TWIDDLE_SRAM_SLICES, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT256_WIN_SRAM_SLICES,     RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16swap  .sysram2opram .sync .notrace, FFT256_WIN_SRAM_SLICES,     RSDK_SPT_OTHER_BASE_ADDR, WR_13, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, FFT16_TWIDDLE_SRAM_SLICES,  RSDK_SPT_OTHER_BASE_ADDR, WR_14, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, DEROT_VECT256_SRAM_SLICES,  RSDK_SPT_OTHER_BASE_ADDR, WR_15, 0x0, 0x1, 0x0, 0x1
    pdma.ind .signext .16cmplx .sysram2opram .sync .notrace, DBF64_8CH_SRAM_SLICES,      RSDK_SPT_OTHER_BASE_ADDR, WR_16, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * COPY: Invert DeRotPh vector. Copy half of data.
     *=========================================================================*/
    copy.simple DEROT_VECT256_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0                      , OR_0_0_0 + PACKED_DATA_LENGTH0 + DEROT_VECT256_NO>>1, 0x1, 0x1
    copy.simple DEROT_VECT256_NO>>1, OR_2_0_0 + PACKED_DATA_LENGTH0 + DEROT_VECT256_NO>>1, OR_0_0_0 + PACKED_DATA_LENGTH0                      , 0x1, 0x1

    /*=========================================================================
     * VMT: Half magnitude the steering vector coef.
     *=========================================================================*/
    set #(0x3F), WR_46 /* set WR_46, for right shift value 1. 111111b (-1) */
    vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, DBF64_8CH_NO, OR_2_0_0 + PACKED_DATA_LENGTH1, OR_0_0_0 + PACKED_DATA_LENGTH1, 0x1, 0x1

    /*=========================================================================
     * COPY: unpack a complex number into real numbers (in real part only of the OPRAM).
     *=========================================================================*/
    copy.unpack .keep_orig, PACKED_DATA_LENGTH2, OR_0_0_0, OR_2_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY R2I: move the real part into imag part. Prepare for conjugate.
     *=========================================================================*/
    copy.partial_r2i .keep_orig, UNPACKED_DATA_LENGTH2, OR_2_0_0, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * VMT: Conjugate a imag number == negate all the data.
     *=========================================================================*/
    vmt.no_sq2s2 .cmplx .rst_sum .in_48 .op_off .conj_sq2s1 .no_sq2s3, UNPACKED_DATA_LENGTH2, OR_0_0_0, OR_2_0_0, 0x1, 0x1

    /*=========================================================================
     * COPY: reconstruct the original memory layout, as present in TRAM.
     *=========================================================================*/
    copy.imag_pack               UNPACKED_DATA_LENGTH3, OR_2_0_0                                                , OR_0_0_0                      , 0x1, 0x1
    copy.partial_i2r .keep_orig, UNPACKED_DATA_LENGTH4, OR_2_0_0 + UNPACKED_DATA_LENGTH3                        , OR_0_0_0 + PACKED_DATA_LENGTH3, 0x1, 0x1
    copy.clear                   UNPACKED_DATA_LENGTH4,                                                           OR_0_0_0 + PACKED_DATA_LENGTH3, 0x1, 0xAAAA
    copy.imag_pack               UNPACKED_DATA_LENGTH5, OR_2_0_0 + UNPACKED_DATA_LENGTH3 + UNPACKED_DATA_LENGTH4, OR_0_0_0 + PACKED_DATA_LENGTH3 + UNPACKED_DATA_LENGTH4, 0x1, 0x1

    /*=========================================================================
     * VMT: Vector add. Add TRAM persistent content to the negated OPRAM content.
     *=========================================================================*/
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1   TR_0_0_0 .no_sq2s3, TRAM_LAYOUT_LENGTH1, OR_0_0_0                      , OR_2_0_0                      , 0x1, 0x1
    vmt.vec_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 TR_0_448_0 .no_sq2s3, TRAM_LAYOUT_LENGTH2, OR_0_0_0 + TRAM_LAYOUT_LENGTH1, OR_2_0_0 + TRAM_LAYOUT_LENGTH1, 0x1, 0x1

    /*=========================================================================
     * Global MAXS on the entire data(Real ABS preprocessing), PACKED input(x2).
     *=========================================================================*/
    set #0x0, OR_0_0_0
    maxs.gm .no_maxsn .real .abs_proc .in_48packed, 2*TRAM_LAYOUT_LENGTH3, OR_2_0_0, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * GET: get overall max value from OPRAM in WR_0.
     *=========================================================================*/
    get OR_0_0_0, WR_0

    /*=========================================================================
     * Workaround for errata ERR010997: the CPU is only allowed to read WR0 before the STOP instruction
     * and this can only be done using an EVT/WAIT handshake with the SPT kernel right before STOP.
     * Use 'lsb' event line for this.
     *=========================================================================*/
    evt.cpu 0

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0

    /*=========================================================================
     * STOP cmd
     *=========================================================================*/
    stop

 .set RsdkSptCheckTram256smp256crp4ch2TxTdMimo_size, .-RsdkSptCheckTram256smp256crp4ch2TxTdMimo
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
