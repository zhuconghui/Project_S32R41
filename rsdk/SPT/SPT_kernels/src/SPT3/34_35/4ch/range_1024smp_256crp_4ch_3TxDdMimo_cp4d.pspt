/** @cond */
/*==================================================================================================
 *                                        INCLUDE FILES
 *==================================================================================================*/
 .include "oram.inc"                    /* include ORAM header file */
 .include "tram.inc"                    /* include TRAM header file */
 .include "wr.inc"                      /* include WR header file */
 .include "spt_kernel_internals.inc"    /* include local defines */

/*==================================================================================================
 *                                          SECTION
 *==================================================================================================*/
 .section .RsdkSpt3 , "ax"   /* memory section where to store SPT code */

/*==================================================================================================
 *                                      LOCAL CONSTANTS
 *==================================================================================================*/
 .set SAMPLES_PER_CHIRP,       1024
 .set CHIRPS_PER_FRAME,         256
 .set SDADC_ACTIVE_CHANNELS,      4 /* phy channels per MIPI-CSI2 link */
 .set CHANNELS_NO,                4 /* total phy channels no */
 .set BYTES_PER_SDADC_SAMPLE,     2
 .set BYTES_CP4D_DATA,            8
 .set OUTPUT_SAMPLES_PER_CH,    (SAMPLES_PER_CHIRP >> 1)

/** @endcond */
/*==================================================================================================
 *                                      GLOBAL FUNCTIONS
 *==================================================================================================*/
/*================================================================================================*/
/**
* @addtogroup spt_kernels_api_func
* @{
*
* @fn             void *RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d();
* @brief          Function for Range FFT 1024, 4 channels(CH#0..CH#3), DD-Mimo use case.
* @details        Compute Range FFT storing compressed(CP4D) results in SRAM.
*
* @param[in]      WR_1: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the first INPUT buffer (sample ADC, CH#0..CH#3),
*                       relative to SRAM start address @ref RSDK_SPT_OTHER_BASE_ADDR "RSDK_SPT_OTHER_BASE_ADDR".
* @verbatim
*                 INPUT Memory layout:
*                 SRAM, 16bit Real ADC sample
*                 63:48     47:32     31:16     15:0
*                 CH0_0     CH0_1     CH0_2     CH0_3
*                 CH0_4     CH0_5     CH0_6     CH0_7
*                 CH1_0     CH1_1     CH1_2     CH1_3
*                 CH1_4     CH1_5     CH1_6     CH1_7
*                 CH2_0     CH2_1     CH2_2     CH2_3
*                 CH2_4     CH2_5     CH2_6     CH2_7
*                 CH3_0     CH3_1     CH3_2     CH3_3
*                 CH3_4     CH3_5     CH3_6     CH3_7
*                 |         |         |         |
*                 |         |         |         |
*                 |         |         |         |
*                 CH0_1016  CH0_1017  CH0_1018  CH0_1019
*                 CH0_1020  CH0_1021  CH0_1022  CH0_1023
*                 CH1_1016  CH1_1017  CH1_1018  CH1_1019
*                 CH1_1020  CH1_1021  CH1_1022  CH1_1023
*                 CH2_1016  CH2_1017  CH2_1018  CH2_1019
*                 CH2_1020  CH2_1021  CH2_1022  CH2_1023
*                 CH3_1016  CH3_1017  CH3_1018  CH3_1019
*                 CH3_1020  CH3_1021  CH3_1022  CH3_1023
*                 ---------------------------------------
*                 <RESERVED FOR CSI2 STATS: ADDR LINE 1>
*                 <RESERVED FOR CSI2 STATS: ADDR LINE 2>
*                 |
*                 <RESERVED FOR CSI2 STATS: ADDR LINE 10>
*                 ---------------------------------------
* @endverbatim
*
* @param[out]     WR_2: 24bit(RE): 0 \n
*                       24bit(IM): Offset(restricted to 24bit value!) of the OUTPUT buffer (Range FFT compressed results),
*                       relative to SRAM start address @ref RSDK_SPT_CUBE_BASE_ADDR "RSDK_SPT_CUBE_BASE_ADDR".
* @verbatim
*                 OUTPUT Memory layout:
*                 SRAM, 64bit compressed data
*                 63:0
*                 CH0_0-CH1_0-CH2_0-CH3_0_Crp0
*                 |
*                 CH0_0-CH1_0-CH2_0-CH3_0-Crp255          ---> RangeBin #0
*                 ----------------------------------------------------------
*                 |
*                 |
*                 |
*                 ----------------------------------------------------------
*                 CH0_511-CH1_511-CH2_511-CH3_511-Crp0
*                 |
*                 CH0_511-CH1_511-CH2_511-CH3_511-Crp255  ---> RangeBin #511
*                 ----------------------------------------------------------
* @endverbatim
*
* @param[in]      WR_3: 24bit(RE): Scaling Factor, e.g. 1 for scale left with 1. \n
*                       24bit(IM): 0.
*
* @return         WR_0: Return Global Max over the range output.
* @retval         Return Global Max amoung the absolute values of the real or imaginary part of the range output. \n
*                 Return value = max(max(abs(Re(k))), max(abs(Im(k)))), 24 bit format(1Q23).
*
* @pre            Twiddle coeficients are placed in TRAM at TR_0_0_0 by the Init function. \n
*                 Window coeficients are placed in TRAM at TR_0_160_0 by the Init function. \n
*                 MIPI_EVENT_LINE is RFE HW connection dependent. Can be configured from spt_kernel_internals.inc.
*
* @note           The kernel implementation guarantees no saturation, for 0 output scaling factor.
*                 If other scaling is used, it's the user responsibility to prevent saturation. \n
*                 This kernel implementation assumes that each ADC buffer is followed by BYTES_CSI2_STATS [80B] reserved for MIPI-CSI2 statistics. \n
*                 The current implementation is ONLY to be used in combination with 256 CP4D Doppler FFT. \n
*                 The input buffer CANNOT be reused for the output buffer. \n
*                 All buffers MUST be 8 bytes aligned.
*
* @}*/
/*================================================================================================*/
/** @cond */
 .global RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d
 .global RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d_size

RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d:
    /*=========================================================================
     * Kernel watermarking instruction without side-effects. WR_0 can be ovewritten
     * with the output parameter, according to the SPT calling convention
     *=========================================================================*/
    set #RSDK_SPT_KERNEL_WATERMARK, WR_0

/*=========================================================================
 * API parameter passing
 *=========================================================================*/
    /*=========================================================================
     * INPUT
     *=========================================================================
     * WR_11: 24bit(RE): OPRAM address where to put SDADC samples of all channels, EVEN chirp
     *        24bit(IM): SRAM sample buffer address offset
     * WR_12: 24bit(RE): OPRAM address where to put SDADC samples of all channels, ODD chirp
     *        24bit(IM): SRAM sample buffer address offset
     *=========================================================================*/
    add .noshift .mod24 WR_1, #(OR_0_0_0), WR_11
    add .noshift .mod24 WR_1, #(OR_2_0_0 | (SAMPLES_PER_CHIRP * SDADC_ACTIVE_CHANNELS * BYTES_PER_SDADC_SAMPLE + BYTES_CSI2_STATS) << 24), WR_12

    /*=========================================================================
     * OUTPUT
     *=========================================================================
     * WR_13: 24bit(RE): OPRAM address of FFT CP4D results for all channels, EVEN chirp
     *        24bit(IM): SRAM FFT result array offset
     * WR_14: 24bit(RE): OPRAM address of FFT CP4D results for all channels, ODD chirp
     *        24bit(IM): SRAM FFT result array offset
     * WR_15: 24bit(RE): no adder for OPRAM address
     *        24bit(IM): adder per loop #for FFT result array address pointer
     *=========================================================================*/
    add .noshift .mod24 WR_2, #(OR_1_0_0), WR_13
    add .noshift .mod24 WR_2, #(OR_3_0_0 | (BYTES_CP4D_DATA << 24)), WR_14
    set #(2*BYTES_CP4D_DATA << 24), WR_15

/*=========================================================================
 * START RANGE FFT1024 SECTION
 *=========================================================================*/

 .if ENABLE_SW_EVT_WAIT==1
    /*=========================================================================
     * EVT: set event-7, event level high
     *=========================================================================*/
    evt.cpu 0xF

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0xF

 .elseif ENABLE_CHIRP_ACQ_WAIT==1
    /*=========================================================================
     * WAIT: wait.ext pos edge chirp acquisition done
     *=========================================================================*/
    wait.ext MIPI_EVENT_LINE

 .else
 .error "ENABLE_SW_EVT_WAIT=1 or ENABLE_CHIRP_ACQ_WAIT=1 must be defined."
 .endif

    /*=========================================================================
     * PDMA: transfer SDADC samples from chirp #0 of all channels from SRAM to OPRAM
     *=========================================================================*/
    pdma.ind .signext .16real .sysram2opram .async .notrace, SAMPLES_PER_CHIRP, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1

    /*=========================================================================
     * set WR_46, for custom left shift. By default, no shift.
     *=========================================================================*/
    set #0x0, WR_46
    sub .noshift .mod24 WR_3, WR_46, WR_46

    /*=========================================================================
     * WR intialization, used to skip the last chirp
     *=========================================================================*/
    set #0x0, WR_45

    /*=========================================================================
     * Prepare registers to help compute return value in WR_0
     *=========================================================================
     * WR_40: WR_40    - holds maxs result per chirp. intermediary needed to access OPRAM at slice level
     *        OR_4_0_0 - place to store the global max for REAL part, per chirp. To be incremented each chirp.
     * WR_41: WR_41    - holds maxs result per chirp. intermediary needed to access OPRAM at slice level
     *        OR_4_0_1 - place to store the global max for IMAG, per chirp. To be incremented each chirp.
     *=========================================================================*/
    set #(OR_4_0_0 | (WR_40 << 24)), WR_16
    set #(OR_4_0_1 | (WR_41 << 24)), WR_17

    /*=========================================================================
     * LOOP: loop #count is chirp number per frame divided by two as samples of two chirps are buffered
     *=========================================================================*/
    loop #(CHIRPS_PER_FRAME >> 1)

 .if ENABLE_SW_EVT_WAIT==1
        /*=========================================================================
         * EVT: set event-7, event level high
         *=========================================================================*/
        evt.cpu 0xF

        /*=========================================================================
         * WAIT: wait.ext SW generated event
         *=========================================================================*/
        wait.cpu 0xF

 .elseif ENABLE_CHIRP_ACQ_WAIT==1
        /*=========================================================================
         * WAIT: wait.ext pos edge chirp acquisition done
         *=========================================================================*/
        wait.ext MIPI_EVENT_LINE

 .else
 .error "ENABLE_SW_EVT_WAIT=1 or ENABLE_CHIRP_ACQ_WAIT=1 must be defined."
 .endif

        /*=========================================================================
         * PDMA: transfer SDADC samples from ODD chirp of all channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .16real .sysram2opram .async .notrace, SAMPLES_PER_CHIRP, RSDK_SPT_OTHER_BASE_ADDR, WR_12, 0x0, 0x1, 0x0, 0x1

        /*=========================================================================
         * COPY simple + R2I: combine CH#<n> with CH#<n+1> samples, n=+2 for real FFTs
         *=========================================================================*/
        copy.simple SAMPLES_PER_CHIRP, OR_0_0_0,   OR_1_0_0, 0x4, 0x1
        copy.simple SAMPLES_PER_CHIRP, OR_0_2_0, OR_1_128_0, 0x4, 0x1
        copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_0_1_0,   OR_1_0_0, 0x4, 0x1
        copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_0_3_0, OR_1_128_0, 0x4, 0x1

        /*=========================================================================
         * FFT1024 for CH#0 & CH#1
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win, prescaling)...5(split round), Twiddle in TR_0_0_0, Window in TR_0_160_0,
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_1_0_0, OR_0_0_0, 0x1, 0x1, TR_0_160_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, SAMPLES_PER_CHIRP, OR_1_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round4 .nosft, SAMPLES_PER_CHIRP, OR_1_0_0, OR_0_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_0_0_0, OR_1_0_0, 0x1, 0x1, TR_0_0_0

        /*=========================================================================
         * FFT1024 for CH#2 & CH#3
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win, prescaling)...5(split round), Twiddle in TR_0_0_0, Window in TR_0_160_0,
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_1_128_0, OR_0_128_0, 0x1, 0x1, TR_0_160_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, SAMPLES_PER_CHIRP, OR_0_128_0, OR_1_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, SAMPLES_PER_CHIRP, OR_1_128_0, OR_0_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, SAMPLES_PER_CHIRP, OR_0_128_0, OR_1_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round4 .nosft, SAMPLES_PER_CHIRP, OR_1_128_0, OR_0_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_0_128_0, OR_1_128_0, 0x1, 0x1, TR_0_0_0

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift.
         * Linear read, interleaved channel write: CH#0..CH#3
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH,   OR_1_0_0, OR_0_0_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH,  OR_1_64_0, OR_0_1_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_1_128_0, OR_0_2_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_1_192_0, OR_0_3_0, 0x1, 0x4

        /*=========================================================================
         * COPY 8x4 FWD transpose for all channels
         *=========================================================================*/
        copy.trans_fwd_8x4 CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_0_0_0, OR_1_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * PDMA: transfer(with skip) range FFT CP4D results of all channels from OPRAM to SRAM, EVEN chirp
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, RSDK_SPT_CUBE_BASE_ADDR, WR_13, 0x0, 0x1, (CHIRPS_PER_FRAME - 1), 0x1

        /*=========================================================================
         * MAXS global(1st): on the output data(abs pre-proc on REAL data)
         * MAXS global(2nd): on the output data(abs pre-proc on IMAG data)
         * The results obtained, are 24bit(1Q23) real pozitive number, stored in memory, for the final Global Max
         *=========================================================================*/
        maxs.gm .no_maxsn .real .abs_proc .in_24real, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_0_0_0, OR_3_0_0, 0x1, 0x1
        maxs.gm .no_maxsn .real .abs_proc .in_24im,   CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_0_0_0, OR_3_1_0, 0x1, 0x1

        /*=========================================================================
         * GET: get the values computed by maxs in intermediary registers
         *=========================================================================*/
        get OR_3_0_0, WR_40
        get OR_3_1_0, WR_41

        /*=========================================================================
         * SET: store the values computed by maxs in OPRAM in consecutive slices
         *=========================================================================*/
        set.ind WR_16
        set.ind WR_17

        /*=========================================================================
         * ADD: increment OPRAM offset for the next global MAXS (2 per chirp)
         *=========================================================================*/
        add .noshift .mod24 WR_16, #0x2, WR_16
        add .noshift .mod24 WR_17, #0x2, WR_17

        /*=========================================================================
         * ADD: increment SRAM offset in FFT result buffer to next EVEN chirp
         *=========================================================================*/
        add .noshift .mod24 WR_13, WR_15, WR_13

        /*=========================================================================
         * ADD, CMP, JUMP: If chirp loop #iteration (CHIRPS_PER_FRAME >> 1), then
         * skip acq and PDMA for last proccessed chirp
         *=========================================================================*/
        add .noshift .mod24 WR_45, #0x1, WR_45
        cmp WR_45, #(CHIRPS_PER_FRAME >> 1), WR_44
        jump .bit0, 44, skipLastChirp

 .if ENABLE_SW_EVT_WAIT==1
        /*=========================================================================
         * EVT: set event-7, event level high
         *=========================================================================*/
        evt.cpu 0xF

        /*=========================================================================
         * WAIT: wait.ext SW generated event
         *=========================================================================*/
        wait.cpu 0xF

 .elseif ENABLE_CHIRP_ACQ_WAIT==1
        /*=========================================================================
         * WAIT: wait.ext pos edge chirp acquisition done
         *=========================================================================*/
        wait.ext MIPI_EVENT_LINE

 .else
 .error "ENABLE_SW_EVT_WAIT=1 or ENABLE_CHIRP_ACQ_WAIT=1 must be defined."
 .endif

        /*=========================================================================
         * PDMA: transfer SDADC samples from EVEN chirp of all channels from SRAM to OPRAM
         *=========================================================================*/
        pdma.ind .signext .16real .sysram2opram .async .notrace, SAMPLES_PER_CHIRP, RSDK_SPT_OTHER_BASE_ADDR, WR_11, 0x0, 0x1, 0x0, 0x1

skipLastChirp:
        /*=========================================================================
         * COPY simple + R2I: combine CH#<n> with CH#<n+1> samples, n=+2 for real FFTs
         *=========================================================================*/
        copy.simple SAMPLES_PER_CHIRP, OR_2_0_0,   OR_3_0_0, 0x4, 0x1
        copy.simple SAMPLES_PER_CHIRP, OR_2_2_0, OR_3_128_0, 0x4, 0x1
        copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_2_1_0,   OR_3_0_0, 0x4, 0x1
        copy.partial_r2i .keep_orig, SAMPLES_PER_CHIRP, OR_2_3_0, OR_3_128_0, 0x4, 0x1

        /*=========================================================================
         * FFT1024 for CH#0 & CH#1
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win, prescaling)...5(split round), Twiddle in TR_0_0_0, Window in TR_0_160_0,
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_3_0_0, OR_2_0_0, 0x1, 0x1, TR_0_160_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, SAMPLES_PER_CHIRP, OR_3_0_0, OR_2_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round4 .nosft, SAMPLES_PER_CHIRP, OR_3_0_0, OR_2_0_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_2_0_0, OR_3_0_0, 0x1, 0x1, TR_0_0_0

        /*=========================================================================
         * FFT1024 for CH#2 & CH#3
         *=========================================================================
         *=========================================================================
         * RDX Round 0(+win, prescaling)...5(split round), Twiddle in TR_0_0_0, Window in TR_0_160_0,
         * prescaling with 8 to benefit of having OPRAM on 24bit (Input on 16bit)
         *=========================================================================*/
        rdx4 .cmplx .real_win_real_tram .qext .noovs .round0 .shift8, SAMPLES_PER_CHIRP, OR_3_128_0, OR_2_128_0, 0x1, 0x1, TR_0_160_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round1 .nosft, SAMPLES_PER_CHIRP, OR_2_128_0, OR_3_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round2 .nosft, SAMPLES_PER_CHIRP, OR_3_128_0, OR_2_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round3 .nosft, SAMPLES_PER_CHIRP, OR_2_128_0, OR_3_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx4 .cmplx .no_win .qext .noovs .round4 .nosft, SAMPLES_PER_CHIRP, OR_3_128_0, OR_2_128_0, 0x1, 0x1, TR_0_0_0, .mod0, 0x1
        rdx2 .cmplx .opsplit .noqext .noovs .round5 .nosft, SAMPLES_PER_CHIRP, OR_2_128_0, OR_3_128_0, 0x1, 0x1, TR_0_0_0

        /*=========================================================================
         * VMT: custom shift(WR_46). Default, no shift.
         * Linear read, interleaved channel write: CH#0..CH#3
         *=========================================================================*/
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH,   OR_3_0_0, OR_2_0_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH,  OR_3_64_0, OR_2_1_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_3_128_0, OR_2_2_0, 0x1, 0x4
        vmt.shift_sq2s2 .cmplx .rst_sum .in_48 .op_off .no_sq2s1 WR_46 .no_sq2s3, OUTPUT_SAMPLES_PER_CH, OR_3_192_0, OR_2_3_0, 0x1, 0x4

        /*=========================================================================
         * COPY 8x4 FWD transpose for all channels
         *=========================================================================*/
        copy.trans_fwd_8x4 CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_2_0_0, OR_3_0_0, 0x1, 0x1, 0x8, 0x8

        /*=========================================================================
         * PDMA: transfer(with skip) range FFT CP4D results of all channels from OPRAM to SRAM, ODD chirp
         *=========================================================================*/
        pdma.ind .signext .CP4D .opram2sysram .async .notrace, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, RSDK_SPT_CUBE_BASE_ADDR, WR_14, 0x0, 0x1, (CHIRPS_PER_FRAME - 1), 0x1

        /*=========================================================================
         * MAXS global(1st): on the output data(abs pre-proc on REAL data)
         * MAXS global(2nd): on the output data(abs pre-proc on IMAG data)
         * The results obtained, are 24bit(1Q23) real pozitive number, stored in memory, for the final Global Max
         *=========================================================================*/
        maxs.gm .no_maxsn .real .abs_proc .in_24real, CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_2_0_0, OR_1_0_0, 0x1, 0x1
        maxs.gm .no_maxsn .real .abs_proc .in_24im,   CHANNELS_NO*OUTPUT_SAMPLES_PER_CH, OR_2_0_0, OR_1_1_0, 0x1, 0x1

        /*=========================================================================
         * GET: get the values computed by maxs in intermediary registers
         *=========================================================================*/
        get OR_1_0_0, WR_40
        get OR_1_1_0, WR_41

        /*=========================================================================
         * SET: store the values computed by maxs in OPRAM in consecutive slices
         *=========================================================================*/
        set.ind WR_16
        set.ind WR_17

        /*=========================================================================
         * ADD: increment OPRAM offset for the next global MAXS (2 per chirp)
         *=========================================================================*/
        add .noshift .mod24 WR_16, #0x2, WR_16
        add .noshift .mod24 WR_17, #0x2, WR_17

        /*=========================================================================
         * ADD: increment SRAM offset in FFT result buffer to next ODD chirp
         *=========================================================================*/
        add .noshift .mod24 WR_14, WR_15, WR_14

    /*=========================================================================
     * NEXT: end of loop
     *=========================================================================*/
    next

    /*=========================================================================
     * Global MAXS over the pre-calculated global maxs(x2) on each chirp. No pre-processing.
     *=========================================================================*/
    set #0x0, OR_0_0_0
    maxs.gm .no_maxsn .real .no_preproc .in_24real, 2*CHIRPS_PER_FRAME, OR_4_0_0, OR_0_0_0, 0x1, 0x1

    /*=========================================================================
     * GET: get overall max value from OPRAM in WR_0.
     *=========================================================================*/
    get OR_0_0_0, WR_0

    /*=========================================================================
     * Workaround for errata ERR010997: the CPU is only allowed to read WR0 before the STOP instruction
     * and this can only be done using an EVT/WAIT handshake with the SPT kernel right before STOP.
     * Use 'lsb' event line for this.
     *=========================================================================*/
    evt.cpu 0

    /*=========================================================================
     * WAIT: wait.ext SW generated event
     *=========================================================================*/
    wait.cpu 0

/*=========================================================================
 * STOP: end of FFT1024 range program
 *=========================================================================*/
 stop

 .set RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d_size, .-RsdkSptRange1024smp256crp4ch3TxDdMimoCp4d
/*******************************************************************************
 * EOF
 ******************************************************************************/
/** @endcond */
